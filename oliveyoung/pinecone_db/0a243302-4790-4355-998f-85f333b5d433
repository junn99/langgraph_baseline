0), '\ub8fb\ud53c'(16), '\ub208\uc628\ub4a4'(17), 'godl****'(0), 'becky****'(0), '\uc774\uc9f1\ub618'(7), '\ud76c\uc9c42'(28), 'shii****'(0), '\ub8e8\ud53c\uc5d0\uc624'(1), 'Juiunnie'(0), '\ubb8c\ud5e8\uc758\ub538'(1) \ub4f1 \uc138\uc815\ub825\uc774 \ubd80\uc871\ud558\uac70\ub098 \uc0ac\uc6a9 \ud6c4 \uae08\ubc29 \uae30\ub984\uc9c0\uace0 \ub5a1\uc9c4\ub2e4\ub294 \ud53c\ub4dc\ubc31\uc774 \ube48\ubc88\ud558\uac8c \ub4f1\uc7a5\ud569\ub2c8\ub2e4. \ud2b9\ud788 '\uc138\uc815\ub825 \ubcf4\ud1b5/\uc544\uc26c\uc6cc\uc694'\ub77c\ub294 \ud3c9\uac00\uc640 \ud568\uaed8 '\uae30\ub984\uc9c4\ub2e4', '\ub5a1\uc9c4\ub2e4'\ub294 \ub0b4\uc6a9\uc774 \ub3d9\ubc18\ub418\ub294 \uacbd\uc6b0\uac00 \ub9ce\uc2b5\ub2c8\ub2e4.\n    *   **\ucee4\ubba4\ub2c8\ud2f0 \uacf5\uac10\ub3c4:** '\uc8e0\ud558'(38), '\ub8fb\ud53c'(16), '\ub208\uc628\ub450'(17), '\uc774\uc9f1\ub618'(7), '\ud76c\uc9c42'(28) \ub4f1\uc758 \ub9ac\ubdf0\ub294 \uc774 \ubb38\uc81c \ub610\ud55c \ub9ce\uc740 \uc0ac\uc6a9\uc790\uc758 \uacf5\uac10\uc744 \uc5bb\uace0 \uc788\uc74c\uc744 \ubcf4\uc5ec\uc90d\ub2c8\ub2e4. \ube44\ub85d \ub450\ud53c \ud2b8\ub7ec\ube14\ub9cc\ud07c\uc740 \uc544\ub2c8\uc9c0\ub9cc, \uc0f4\ud478 \ubcf8\uc5f0\uc758 '\uac1c\uc6b4\ud568'\uacfc '\uc0b0\ub73b\ud568'\uc744 \uc800\ud574\ud558\uc5ec \uc0ac\uc6a9 \uacbd\ud5d8\uc744 \ud06c\uac8c \ub5a8\uc5b4\ub728\ub9bd\ub2c8\ub2e4.\n    *   **\uadfc\ubcf8 \uc6d0\uc778 \uac00\uc124:** \uc81c\ud488\uc758 '\ub525 \ub9ac\ud398\uc5b4'\ub77c\ub294 \ucee8\uc149\uc744 \uc704\ud574 \uc720\ubd84\uac10\uc774 \ub192\uc740 \ubcf4\uc2b5 \uc131\ubd84\uc774\ub098 \ub2e8\ubc31\uc9c8 \uc131\ubd84\uc774 \uacfc\ub3c4\ud558\uac8c \ud568\uc720\ub418\uc5c8\uac70\ub098, \uacc4\uba74\ud65c\uc131\uc81c\uc758 \uc138\uc815\ub825\uc774 \ubd80\uc871\ud558\uc5ec \ub178\ud3d0\ubb3c\uacfc \uc720\ubd84\uc774 \ucda9\ubd84\ud788 \uc81c\uac70\ub418\uc9c0 \uc54a\ub294 \uac83\uc73c\ub85c \ucd94\uc815\ub429\ub2c8\ub2e4.\n\n3.  **\ud575\uc2ec \ud6a8\ub2a5\uc5d0 \ub300\ud55c \uae30\ub300 \ubd88\uc77c\uce58 (Moderate Frequency, High Impact)**\n    *   **\uc5b8\uae09 \ube48\ub3c4:** '\ub4dc\ub77c\ub9c8\ud2f1\ud55c \ubcc0\ud654\ub97c \ubaa8\ub974\uaca0\ub2e4', '\uc77c\ubc18 \uc0f4\ud478\uc640 \ucc28\uc774\ub97c \ubabb \ub290\uaf08\ub2e4', '\ub2e8\ubc31\uc9c8 \uacf5\uae09 \ud6a8\uacfc\ub97c \ubabb \ub290\uaf08\ub2e4' \ub4f1\uc758 \ub9ac\ubdf0\uac00 \uc0c1\ub300\uc801\uc73c\ub85c \uc801\uc740 \ube48\ub3c4\ub85c \ub098\ud0c0\ub098\uc9c0\ub9cc, '\ub9b0\uacf5\uc96c'(5), '\uc194\uc194'(18), 'nyj****'(3), 'tofrom'(0), '\ucfe0\ud558\ud558\uacf5\uc8fc\ub2d8'(0) \ub4f1\uc758 \ub9ac\ubdf0\uc5d0\uc11c \uc5b8\uae09\ub429\ub2c8\ub2e4. \ud2b9\ud788 '\uc194\uc194'(helpful_count: 18)\ub2d8\uc758 \ub9ac\ubdf0\ub294 \ud0c8\ubaa8 \uc0f4\ud478 \ub300\ube44 \ud6a8\uacfc \ubbf8\ubbf8\ub97c \uc5b8\uae09\ud558\uba70, '\ub9b0\uacf5\uc96c'(helpful_count: 5)\ub2d8\uc740 \ud0c0\uc0ac \uc81c\ud488\uacfc \ube44\uad50\ud558\uba70 \uc544\uc26c\uc6c0\uc744 \ud45c\ud588\uc2b5\ub2c8\ub2e4.\n    *   **\ucee4\ubba4\ub2c8\ud2f0 \uacf5\uac10\ub3c4:** \ud2b9\uc815 \ub9ac\ubdf0\uc758 'helpful_count'\uac00 \ub192\uc9c0\ub294 \uc54a\uc73c\ub098, '\ub2e8\ubc31\uc9c8 \uc570\ud50c \uc0f4\ud478'\ub77c\ub294 \uc81c\ud488\uba85\uacfc '\ub525 \ub370\ubbf8\uc9c0 \ub9ac\ud398\uc5b4'\ub77c\ub294 \ud45c\ubc29\ud558\ub294 \uae30\ub2a5\uc774 \uc2e4\uc81c \uc0ac\uc6a9\uc790 \uacbd\ud5d8\uacfc \uad34\ub9ac\uac10\uc744 \ubcf4\uc778\ub2e4\ub294 \uc810\uc5d0\uc11c, \ube0c\ub79c\ub4dc\uc758 \ud575\uc2ec \uba54\uc2dc\uc9c0\uc640 \uc81c\ud488 \uc131\ub2a5 \uac04\uc758 \ubd88\uc77c\uce58\ub294 \uc0ac\uc6a9\uc790\uc5d0\uac8c \ud070 \uc2e4\ub9dd\uac10\uc744 \uc548\uaca8\uc904 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub294 \ube0c\ub79c\ub4dc \uc774\ubbf8\uc9c0\uc640 \uc2e0\ub8b0\ub3c4\uc5d0 \uc7a5\uae30\uc801\uc73c\ub85c \ubd80\uc815\uc801\uc778 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4.\n    *   **\uadfc\ubcf8 \uc6d0\uc778 \uac00\uc124:** '\ub2e8\ubc31\uc9c8 \uc570\ud50c'\uc774\ub77c\ub294 \uac1c\ub150\uc774 \uc2e4\uc81c \uc81c\ud488 \ud3ec\ubbac\ub7ec\uc5d0 \ud6a8\uacfc\uc801\uc73c\ub85c \uad6c\ud604\ub418\uc9c0 \ubabb\ud588\uac70\ub098, \uc0ac\uc6a9\uc790\uc5d0\uac8c \uadf8 \ud6a8\uacfc\uac00 \uc778\uc9c0\ub418\uc9c0 \ubabb\ud560 \uc815\ub3c4\ub85c \ubbf8\ubbf8\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud639\uc740 '\uc190\uc0c1\ubaa8'\ub77c\ub294 \uba85\ud655\ud55c \ud0c0\uac9f\uad70\uc5d0\uac8c\ub3c4 \ucda9\ubd84\ud55c \ud6a8\uacfc\ub97c \uc81c\uacf5\ud558\uc9c0 \ubabb\ud558\ub294 \uc81c\ud615\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n### \ubb38\uc81c\uc810\uacfc \ud575\uc2ec \ud0c0\uac9f \uadf8\ub8f9 \uc5f0\uacb0\n\n\ubd84\uc11d\ub41c \ud575\uc2ec \ubb38\uc81c\uc810, \ud2b9\ud788 **\ub450\ud53c \ud2b8\ub7ec\ube14 \ubc0f \ube44\ub4ec \uc720\ubc1c**\uacfc **\ube60\ub978 \uae30\ub984\uc9d0/\ub5a1\uc9d0 \ud604\uc0c1**\uc740 **\uc9c0\uc131 \ubc0f \ubbfc\uac10\uc131 \ub450\ud53c**\ub97c \uac00\uc9c4 \uc0ac\uc6a9\uc790 \uadf8\ub8f9\uc5d0\uac8c\uc11c \ub450\ub4dc\ub7ec\uc9c0\uac8c \ub098\ud0c0\ub0a9\ub2c8\ub2e4.\n\n*   **\uc9c0\uc131 \ub450\ud53c \uc0ac\uc6a9\uc790:** '\uc8e0\ud558'(\uc9c0\uc131 \uc5bc\uad74, \uc911\uc131 \ub450\ud53c \uc5b8\uae09\ud558\uba70 \ube44\ub4ec/\ub5a1\uc9d0), 'wonks****'(\uc9c0\uc131, \uc9c0\ub8e8\uc131 \ub450\ud53c\uc5fc \uc5b8\uae09\ud558\uba70 \uac00\ub824\uc6c0), '\ubd88\ub8e8\ubca0\ub9ac'(\ubbfc\uac10 \uc9c0\uc131 \ub450\ud53c \uc5b8\uae09\ud558\uba70 \ub531\uc9c0, \uac04\uc9c0\ub7ec\uc6c0), '\uc7a5\uc601\uc8fc'(\uc9c0\ub8e8\uc131 \ub450\ud53c\uc5fc \uc5b8\uae09\ud558\uba70 \uac04\uc9c0\ub7ec\uc6c0, \ube60\ub978 \ub5a1\uc9d0), '\uc774\uc9f1\ub618'(\uc9c0\uc131\ub450\ud53c\uac00 \uc544\ub2d8\uc5d0\ub3c4 \uc720\ubd84\uae30 \uc62c\ub77c\uc640 \ub5a1\uc9d0), '\ud76c\uc9c42'(\uc9c0\uc131\ub450\ud53c \uc5b8\uae09\ud558\uba70 \ub5a1\uc9d0, \ud6a8\ub2a5 \ubbf8\ubbf8) \ub4f1\uc758 \ub9ac\ubdf0\uc5d0\uc11c \uc774 \ubb38\uc81c\uac00 \uc9d1\uc911\uc801\uc73c\ub85c \uc81c\uae30\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \uc774\ub4e4\uc740 \uc0f4\ud478\uc758 \uc138\uc815\ub825 \ubd80\uc871\uacfc \uacfc\ub3c4\ud55c \uc720\ubd84\uac10\uc73c\ub85c \uc778\ud574 \ub450\ud53c \uc0c1\ud0dc\uac00 \uc545\ud654\ub418\uac70\ub098 \ubd88\ucf8c\uac10\uc744 \ub290\ub07c\ub294 \uacbd\ud5a5\uc774 \uc788\uc2b5\ub2c8\ub2e4.\n*   **\ubbfc\uac10\uc131 \ub450\ud53c \uc0ac\uc6a9\uc790:** '\uc8e0\ud558'(\ub450\ud53c\uc5fc \ub9c8\ub0e5 \uac01\uc9c8), '\ubd88\ub8e8\ubca0\ub9ac'(\ubbfc\uac10 \uc9c0\uc131 \ub450\ud53c, \ub531\uc9c0, \uac04\uc9c0\ub7ec\uc6c0), 'a05****'(\ub450\ud53c \ud654\ub048, \ub530\uac00\uc6c0, \uac00\ub824\uc6c0, \ub208\uc379 \ubd80\uc74c) \ub4f1\uc740 \uc81c\ud488 \uc0ac\uc6a9 \uc2dc \ud53c\ubd80 \ubc18\uc751\uc774 \ub098\ud0c0\ub0a8\uc744 \uba85\ud655\ud788 \ubcf4\uc5ec\uc90d\ub2c8\ub2e4. \uc774\ub294 \uc81c\ud488 \uc131\ubd84\uc5d0 \ub300\ud55c \ubbfc\uac10\uc131\uc744 \uc2dc\uc0ac\ud569\ub2c8\ub2e4.\n\n\ub530\ub77c\uc11c, \uc6b0\ub9ac\ub294 **\uc9c0\uc131 \ubc0f \ubbfc\uac10\uc131 \ub450\ud53c\ub97c \uac00\uc9c4 \uc0ac\uc6a9\uc790\ub4e4\uc758 \ubd88\ud3b8\ud568\uc744 \uc6b0\uc120\uc801\uc73c\ub85c \ud574\uacb0\ud558\ub294 \ub370 \uc9d1\uc911**\ud574\uc57c \ud569\ub2c8\ub2e4. \uc774\ub4e4\uc740 \uc81c\ud488\uc758 \uc8fc\uc694 \uc7a0\uc7ac \uace0\uac1d\uc774 \ub420 \uc218 \uc788\uc74c\uc5d0\ub3c4 \ubd88\uad6c\ud558\uace0 \ud604\uc7ac \uc81c\ud488\uc73c\ub85c \uc778\ud574 \uac00\uc7a5 \ud070 \ubd80\uc815\uc801 \uacbd\ud5d8\uc744 \ud558\uace0 \uc788\ub294 \uadf8\ub8f9\uc785\ub2c8\ub2e4.\n\n### \ub370\uc774\ud130 \uae30\ubc18\uc758 \uc2e4\ud589 \uac00\ub2a5\ud55c \uc131\uc7a5 \uc804\ub7b5 \ub3c4\ucd9c\n\n**[\uc804\ub7b5 \uc81c\uc548 1] \ud3ec\ubbac\ub7ec \ubc0f \uad6c\uc131 \uc694\uc18c \uac1c\uc120 (Formula & Component Improvement)**\n\n**'\uac00\uc7a5 \uc2dc\uae09\ud55c Top 3 \ubb38\uc81c'**\uc778 \ub450\ud53c \ud2b8\ub7ec\ube14, \ube60\ub978 \uae30\ub984\uc9d0, \uc138\uc815\ub825 \ubd80\uc871\uc744 \ud574\uacb0\ud558\uae30 \uc704\ud55c R&D \uac1c\uc120\uc548\uc740 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4.\n\n*   **\ud575\uc2ec \ubb38\uc81c \ud574\uacb0:**\n    *   **\ub450\ud53c \ud2b8\ub7ec\ube14 \ubc0f \ube44\ub4ec \uc720\ubc1c \uac1c\uc120:** \ud604\uc7ac \ub9ce\uc740 \uc0ac\uc6a9\uc790\uc5d0\uac8c \uc790\uadf9\uc744 \uc8fc\ub294 \uac83\uc73c\ub85c \ucd94\uc815\ub418\ub294 **\uc18c\ub4d0\ub77c\uc6b0\ub808\uc2a4\uc124\ud398\uc774\ud2b8(SLS)**\uc640 \uac19\uc740 \uac15\ub825\ud55c \uacc4\uba74\ud65c\uc131\uc81c\ub97c \uc800\uc790\uadf9\uc131 \uc124\ud398\uc774\ud2b8 \ud504\ub9ac \uacc4\uba74\ud65c\uc131\uc81c(\uc608: \uc18c\ub4d0\ucf54\ucf54\uc77c\uc544\uc774\uc138\ud2f0\uc624\ub124\uc774\ud2b8, \ucf54\ucf54-\uae00\ub8e8\ucf54\uc0ac\uc774\ub4dc \ub4f1) \ub610\ub294 \uc124\ud398\uc774\ud2b8 \ud504\ub9ac \uc870\ud569\uc73c\ub85c \ub300\uccb4\ud558\ub294 \uac83\uc744 \ucd5c\uc6b0\uc120\uc73c\ub85c \uace0\ub824\ud569\ub2c8\ub2e4. \ub610\ud55c, \ube44\ub4ec \ubc0f \uac01\uc9c8 \uc720\ubc1c\uacfc \uad00\ub828\ub41c \uc7a0\uc7ac\uc801 \uc131\ubd84(\uc608: \ud2b9\uc815 \ud5a5\ub8cc, \uc5d0\uc13c\uc15c \uc624\uc77c, \uc54c\ucf54\uc62c \ub4f1)\uc758 \ud568\ub7c9\uc744 \uc904\uc774\uac70\ub098 \uc800\uc790\uadf9 \ub300\uccb4\uc7ac\ub85c \ubcc0\uacbd\ud558\ub294 \uac83\uc744 \uac80\ud1a0\ud569\ub2c8\ub2e4. \ub354\ubd88\uc5b4, \ub450\ud53c \uc9c4\uc815 \ubc0f \uc7a5\ubcbd \uac15\ud654\uc5d0 \ub3c4\uc6c0\uc774 \ub418\ub294 \uc131\ubd84(\uc608: \ud310\ud14c\ub180, \ub098\uc774\uc544\uc2e0\uc544\ub9c8\uc774\ub4dc, \ubcd1\ud480 \ucd94\ucd9c\ubb3c, \ud504\ub85c\ubc14\uc774\uc624\ud2f1\uc2a4 \uc720\ub798 \uc131\ubd84 \ub4f1)\uc744 \ud568\ub7c9\uc744 \ub192\uc5ec \ud3ec\ubbac\ub7ec\uc5d0 \ucd94\uac00\ud558\ub294 \ubc29\uc548\uc744 \uc81c\uc548\ud569\ub2c8\ub2e4.\n    *   **\uc138\uc815\ub825 \ubd80\uc871 \ubc0f \ube60\ub978 \uae30\ub984\uc9d0/\ub5a1\uc9d0 \ud604\uc0c1 \uac1c\uc120:** \uc81c\ud488\uc758 \uc804\ubc18\uc801\uc778 \uc138\uc815\ub825\uc744 \uac15\ud654\ud558\uba74\uc11c\ub3c4 \uac74\uc870\ud568\uc744 \uc720\ubc1c\ud558\uc9c0 \uc54a\ub3c4\ub85d \uade0\ud615\uc744 \ub9de\ucd94\ub294 \uac83\uc774 \uc911\uc694\ud569\ub2c8\ub2e4. \uc774\ub97c \uc704\ud574 \uc138\uc815\ub825\uc774 \ub6f0\uc5b4\ub098\uba74\uc11c\ub3c4 \ub450\ud53c\uc5d0 \uc21c\ud55c \ucc28\uc138\ub300 \uacc4\uba74\ud65c\uc131\uc81c \uc870\ud569\uc744 \ud0d0\uc0c9\ud558\uace0, \uc720\ubd84\uac10\uc774 \uacfc\ub3c4\ud558\uac8c \ub290\uaef4\uc9c0\ub294 \ud2b9\uc815 \ubcf4\uc2b5 \uc131\ubd84(\uc608: \uc2e4\ub9ac\ucf58\ub958, \uc77c\ubd80 \uc624\uc77c\ub958)\uc758 \uc885\ub958\ub098 \ud568\ub7c9\uc744 \uc7ac\uc870\uc815\ud558\uac70\ub098, \uc218\uc6a9\uc131 \ub610\ub294 \uacbd\ub7c9 \uc624\uc77c \uc131\ubd84\uc73c\ub85c \ub300\uccb4\ud558\ub294 \ubc29\uc548\uc744 \uace0\ub824\ud569\ub2c8\ub2e4. '\uac1c\uc6b4\ud55c \ub9c8\ubb34\ub9ac\uac10'\uc744 \uc120\ud638\ud558\ub294 \uc0ac\uc6a9\uc790\ub4e4\uc758 \ud53c\ub4dc\ubc31\uc744 \ubc18\uc601\ud558\uc5ec, \ud5f9\uad7c \uacfc\uc815\uc5d0\uc11c \uc794\uc5ec\uac10\uc774 \uc801\uace0 \uc0b0\ub73b\ud55c \ub290\ub08c\uc744 \uc8fc\ub294 \uc81c\ud615 \uac1c\ubc1c\uc5d0 \uc9d1\uc911\ud569\ub2c8\ub2e4.\n\n*   **\uc0ac\uc6a9\uc790 \uadf8\ub8f9\ubcc4 \ucd5c\uc801\ud654:**\n    *   **\uc9c0\uc131/\ubbfc\uac10\uc131 \ub450\ud53c \uc0ac\uc6a9\uc790:** \uc704\uc5d0\uc11c \uc5b8\uae09\ub41c \uc800\uc790\uadf9 \uacc4\uba74\ud65c\uc131\uc81c \ubc0f \ub450\ud53c \uc9c4\uc815 \uc131\ubd84 \uac15\ud654\ub294 \uc774\ub4e4\uc758 \ub2c8\uc988\ub97c \uc9c1\uc811\uc801\uc73c\ub85c \ucda9\uc871\uc2dc\ud0b5\ub2c8\ub2e4. \ub354\ubd88\uc5b4, \ub450\ud53c\uc5d0 \uac00\ubccd\uac8c \uc791\uc6a9\ud558\ub294 \uc0b0\ub73b\ud55c \uc81c\ud615\uac10\uc744 \uad6c\ud604\ud558\uae30 \uc704\ud574 \uc218\uc6a9\uc131 \ud3f4\ub9ac\uba38\ub098 \uc824 \ud0c0\uc785 \ud3ec\ubbac\ub7ec\ub97c \ub354\uc6b1 \ucd5c\uc801\ud654\ud558\ub294 \ubc29\ud5a5\uc744 \uace0\ub824\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n*   **\ubd88\ud544\uc694 \uc694\uc18c \uc81c\uac70:**\n    *   \ubbfc\uac10\ud55c \ub450\ud53c\ub97c \uc790\uadf9\ud560 \uc218 \uc788\ub294 \uc778\uacf5 \ud5a5\ub8cc, \uc0c9\uc18c, \ud30c\ub77c\ubca4 \ub4f1\uc740 \uac00\ub2a5\ud55c \ud55c \uc81c\uac70\ud558\uac70\ub098 \ucd5c\uc18c\ud654\ud558\uace0, \ucc9c\uc5f0 \uc720\ub798 \ub610\ub294 \uc800\uc790\uadf9 \ub300\uccb4 \uc131\ubd84\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc804\ubc18\uc801\uc778 \uc81c\ud488\uc758 \uc21c\ub3c4\ub97c \ub192\uc785\ub2c8\ub2e4. \ud604\uc7ac '\ud5a5'\uc5d0 \ub300\ud55c \ud3c9\uac00\ub294 \uae0d\uc815\uc801\uc778 \ud3b8\uc774\uc9c0\ub9cc, \ud5a5\ub8cc \uc131\ubd84\uc774 \ub450\ud53c \ud2b8\ub7ec\ube14\uc758 \uc6d0\uc778\uc774 \ub420 \uc218\ub3c4 \uc788\uc73c\ubbc0\ub85c, \uc800\uc790\uadf9 \ud5a5\ub8cc \uc0ac\uc6a9 \ub610\ub294 \ubb34\ud5a5 \uc81c\ud488 \ucd9c\uc2dc \uc635\uc158\ub3c4 \uc7a5\uae30\uc801\uc73c\ub85c \uace0\ub824\ud574 \ubcfc \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n**[\uc804\ub7b5 \uc81c\uc548 2] \uc81c\ud488 \ud3ec\ud2b8\ud3f4\ub9ac\uc624 \ubc0f \uacbd\uc7c1 \uc804\ub7b5 (Product Portfolio & Competitive Strategy)**\n\n*   **\uc2dc\uc7a5 \uae30\ud68c \uc815\uc758:**\n    \ubcf8 \uc81c\ud488\uc740 '\uc190\uc0c1\ubaa8 \ucf00\uc5b4', '\ubd80\ub4dc\ub7ec\uc6b4 \ubaa8\ubc1c'\uc774\ub77c\ub294 \uba85\ud655\ud55c \ub2c8\uc988\ub97c \uac00\uc9c4 \uace0\uac1d\uce35\uc5d0\uac8c \uc5b4\ud544\ud560 \uc218 \uc788\ub294 \uc7a0\uc7ac\ub825\uc744 \uac00\uc9c0\uace0 \uc788\uc2b5\ub2c8\ub2e4. \ud558\uc9c0\ub9cc \ud604\uc7ac\uc758 \ud3ec\ubbac\ub7ec\uc640 \ub9c8\ucf00\ud305\uc740 **'\uc9c0\uc131 \ub450\ud53c \ubc0f \ubbfc\uac10\uc131 \ub450\ud53c \uc0ac\uc6a9\uc790'\uc758 \ub2c8\uc988\ub97c \uac04\uacfc\ud558\uc5ec \uc774\ub4e4\uc744 \uc678\uba74\ud558\uace0 \uc624\ud788\ub824 \ubd80\uc815\uc801\uc778 \uacbd\ud5d8\uc744 \uc720\ubc1c**\ud558\uace0 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub294 \uc6b0\ub9ac\uc5d0\uac8c \ud070 \uae30\ud68c\uac00 \ub429\ub2c8\ub2e4. \uc989, \ud604\uc7ac \uc81c\ud488\uc73c\ub85c \uc778\ud574 \uc2e4\ub9dd\ud558\uace0 \ub2e4\ub978 \ub300\uc548\uc744 \ucc3e\ub294 \uc9c0\uc131/\ubbfc\uac10\uc131 \ub450\ud53c \uc0ac\uc6a9\uc790\ub4e4\uc5d0\uac8c \uc9c4\uc815\uc73c\ub85c \ud6a8\uacfc\uc801\uc778 \uc81c\ud488\uc744 \uc81c\uacf5\ud568\uc73c\ub85c\uc368 \uc2e0\uaddc \uace0\uac1d\uc744 \ud655\ubcf4\ud558\uace0 \uc2dc\uc7a5 \uc810\uc720\uc728\uc744 \ud655\ub300\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud2b9\ud788 '\ub2e8\ubc31\uc9c8 \uc570\ud50c'\uc774\ub77c\ub294 \ud0a4\uc6cc\ub4dc\ub294 \uc190\uc0c1\ubaa8 \uc2dc\uc7a5\uc5d0\uc11c \uc5ec\uc804\ud788 \uac15\ub825\ud55c \ubaa8\uba58\ud140\uc744 \uac00\uc9c0\uace0 \uc788\uc73c\ubbc0\ub85c, \uc774 \ubd80\ubd84\uc744 \uc81c\ub300\ub85c \uacf5\ub7b5\ud55c\ub2e4\uba74 \uacbd\uc7c1 \uc6b0\uc704\ub97c \ud655\ubcf4\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n*   **\ub450 \uac00\uc9c0 \uc804\ub7b5 \uc635\uc158 \uc81c\uc2dc:**\n\n    *   **\uc635\uc158 A: \uac1c\uc120 \ubc0f \ub9ac\ud3ec\uc9c0\uc154\ub2dd \uc804\ub7b5 (\uac1c\uc120 \ud6c4 \uae30\uc874 \uc81c\ud488 \uc720\uc9c0)**\n        *   **\uac1c\uc120:** \uc704\uc5d0\uc11c \uc81c\uc548\ud55c \ud3ec\ubbac\ub7ec \uac1c\uc120(\uc800\uc790\uadf9 \uacc4\uba74\ud65c\uc131\uc81c, \ub450\ud53c \uc9c4\uc815 \uc131\ubd84 \uac15\ud654, \uc720\ubd84\uac10 \uc870\uc808 \ub4f1)\uc744 \ud1b5\ud574 **'\ub450\ud53c \ud2b8\ub7ec\ube14 \uc720\ubc1c \ubc0f \ube60\ub978 \uae30\ub984\uc9d0' \ubb38\uc81c\ub97c \ud574\uacb0**\ud569\ub2c8\ub2e4.\n        *   **\ub9ac\ud3ec\uc9c0\uc154\ub2dd:** \uac1c\uc120\ub41c \uc81c\ud488\uc744 '\uadf9\uc190\uc0c1\ubaa8\ub97c \uc704\ud55c \uace0\uc601\uc591 \uc0f4\ud478'\ub85c \uba85\ud655\ud558\uac8c \ud3ec\uc9c0\uc154\ub2dd\ud569\ub2c8\ub2e4. \uae30\uc874\uc758 '\ub525 \ub370\ubbf8\uc9c0 \ub9ac\ud398\uc5b4' \ucee8\uc149\uc744 \uc720\uc9c0\ud558\ub418, '\uc9c0\uc131 \ub450\ud53c' \ub610\ub294 '\ubbfc\uac10\uc131 \ub450\ud53c'\ub97c \uc704\ud55c \uc81c\ud488\uc774\ub77c\ub294 \uc624\ud574\ub97c \ubd88\uc2dd\uc2dc\ud0a4\uae30 \uc704\ud574 \ub9c8\ucf00\ud305 \uba54\uc2dc\uc9c0\ub97c \uba85\ud655\ud788 \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \"\uc7a6\uc740 \uc5fc\uc0c9, \ud38c\uc73c\ub85c \uc778\ud574 \uc190\uc0c1\ub41c \ubaa8\ubc1c\uc5d0 \uc9d1\uc911\uc801\uc778 \ub2e8\ubc31\uc9c8 \ucf00\uc5b4\ub97c \uc6d0\ud558\ub294 \uace0\uac1d\uc5d0\uac8c \ucd5c\uc801\ud654\ub41c \uc0f4\ud478\"\uc640 \uac19\uc774 **\ud0c0\uac9f \uace0\uac1d\uc744 \uad6c\uccb4\ud654**\ud558\uace0, \ub450\ud53c \ud0c0\uc785\ubcc4 \uc0ac\uc6a9 \uad8c\uc7a5 \uc0ac\ud56d\uc744 \uba85\ud655\ud788 \uc548\ub0b4\ud569\ub2c8\ub2e4. \uc774\ub97c \ud1b5\ud574 \ud604\uc7ac\uc758 '\ubaa8\ub4e0 \uc0ac\ub78c\uc5d0\uac8c \ub9de\uc9c0 \uc54a\ub294' \uc81c\ud488\uc774\ub77c\ub294 \uc778\uc2dd\uc744 \uc804\ud658\ud558\uace0, \uba85\ud655\ud55c \ud0c0\uac9f \uace0\uac1d\uc5d0\uac8c \uae4a\uc740 \ub9cc\uc871\uac10\uc744 \uc81c\uacf5\ud558\ub294 \ud504\ub9ac\ubbf8\uc5c4 \uc81c\ud488\uc73c\ub85c \uc790\ub9ac\ub9e4\uae40\ud569\ub2c8\ub2e4.\n\n    *   **\uc635\uc158 B: \uc2e0\uaddc \ub77c\uc778 \ud655\uc7a5 \uc804\ub7b5 (\uc9c0\uc131/\ubbfc\uac10\uc131 \ub450\ud53c \ub77c\uc778 \ubcc4\ub3c4 \ucd9c\uc2dc)**\n        *   **\uc2dc\uc7a5 \uae30\ud68c \uacf5\ub7b5:** \ud604\uc7ac '\uc5b4\ub178\ube0c \ub525 \ub370\ubbf8\uc9c0 \ub9ac\ud398\uc5b4 \uc0f4\ud478'\ub294 \uadf8\ub300\ub85c \uc720\uc9c0\ud558\uac70\ub098 \uc18c\uaddc\ubaa8\ub85c \uc6b4\uc601\ud558\ub418, \uc774\ubc88 \ub9ac\ubdf0 \ubd84\uc11d\uc5d0\uc11c \uac00\uc7a5 \ub450\ub4dc\ub7ec\uc9c4 \ubb38\uc81c\uc810\uc778 **'\uc9c0\uc131/\ubbfc\uac10\uc131 \ub450\ud53c \ud2b8\ub7ec\ube14 \ubc0f \ube60\ub978 \uae30\ub984\uc9d0'\uc744 \ud574\uacb0\ud558\ub294 \uc0c8\ub85c\uc6b4 \uc0f4\ud478 \ub77c\uc778**\uc744 \ucd9c\uc2dc\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc5b4\ub178\ube0c \ud4e8\ub9ac\ud30c\uc789 \uc564 \uce74\ubc0d \uc0f4\ud478' \ub610\ub294 '\uc5b4\ub178\ube0c \ubc38\ub7f0\uc2f1 \uc0f4\ud478'\uc640 \uac19\uc774 \ub450\ud53c\uc758 \uc720\uc218\ubd84 \ubc38\ub7f0\uc2a4\ub97c \ub9de\ucd94\uace0 \uc9c4\uc815\uc2dc\ud0a4\ub294 \ub370 \ucd08\uc810\uc744 \ub9de\ucd98 \uc81c\ud488\uc744 \uac1c\ubc1c\ud569\ub2c8\ub2e4.\n        *   **\ub77c\uc778 \ud655\uc7a5:** \uc774 \uc0c8\ub85c\uc6b4 \ub77c\uc778\uc740 '\uae54\ub054\ud55c \uc138\uc815\ub825', '\ub450\ud53c \uc9c4\uc815', '\uac00\ub824\uc6c0 \uc644\ud654' \ub4f1\uc758 \uba85\ud655\ud55c \ud6a8\ub2a5\uc744 \uc55e\uc138\uc6cc, \uae30\uc874 \uc81c\ud488\uc774 \ud574\uacb0\ud558\uc9c0 \ubabb\ud588\ub358 \uace0\uac1d\uce35\uc744 \uc9c1\uc811\uc801\uc73c\ub85c \uacf5\ub7b5\ud569\ub2c8\ub2e4. \uc774\ub294 \uc5b4\ub178\ube0c \ube0c\ub79c\ub4dc\uac00 \ub2e4\uc591\ud55c \ub450\ud53c \ud0c0\uc785\uacfc \uace0\ubbfc\uc744 \uac00\uc9c4 \uace0\uac1d\uc744 \ud3ec\uad04\ud560 \uc218 \uc788\uc74c\uc744 \ubcf4\uc5ec\uc8fc\uba70, \ube0c\ub79c\ub4dc \uc774\ubbf8\uc9c0\ub97c \ub354\uc6b1 \uac15\ud654\ud560 \uc218 \uc788\ub294 \uc804\ub7b5\uc785\ub2c8\ub2e4. \ub610\ud55c, \ub2e5\ud130\ud3ec\ud5e4\uc5b4\uc640\uc758 \uc5f0\uad00\uc131\uc744 \uace0\ub824\ud558\uc5ec, \ub450\ud53c \uacfc\ud559\uc5d0 \uae30\ubc18\ud55c \uc804\ubb38\uc801\uc778 \uc194\ub8e8\uc158\uc744 \uc81c\uacf5\ud55c\ub2e4\ub294 \uc810\uc744 \uac15\uc870\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n**[\uc804\ub7b5 \uc81c\uc548 3] \ub9c8\ucf00\ud305 \ubc0f \ucee4\ubba4\ub2c8\ucf00\uc774\uc158 \ucd5c\uc801\ud654 (Marketing & Communication Optimization)**\n\n*   **\uac00\uce58 \uc81c\uc548(Promise) \uc7ac\uc815\uc758:**\n    '\ub2e8\ubc31\uc9c8 \uc570\ud50c \uc0f4\ud478', '\ub525 \ub370\ubbf8\uc9c0 \ub9ac\ud398\uc5b4'\ub77c\ub294 \ud45c\ud604\uc5d0\uc11c \ubc97\uc5b4\ub098, \uc2e4\uc81c \uc0ac\uc6a9\uc790\uac00 \uacbd\ud5d8\ud558\ub294 \uac00\uce58\ub97c \uba85\ud655\ud558\uace0 \uc194\uc9c1\ud558\uac8c \uc804\ub2ec\ud574\uc57c \ud569\ub2c8\ub2e4. \uae30\uc874\uc758 '\ubaa8\ub4e0 \uc190\uc0c1\ubaa8\ub97c \uc704\ud55c \ub9cc\ub2a5 \ud574\uacb0\ucc45'\uc774\ub77c\ub294 \ubaa8\ud638\ud55c \uc57d\uc18d \ub300\uc2e0, \ub2e4\uc74c\uacfc \uac19\uc774 \uad6c\uccb4\uc801\uc778 \uac00\uce58 \uc81c\uc548\uc73c\ub85c \ubcc0\uacbd\ud569\ub2c8\ub2e4.\n    *   **\ubcc0\uacbd \uc608\uc2dc:** \"\uc7a6\uc740 \uc5f4\uae30\uad6c \uc0ac\uc6a9, \ud654\ud559 \uc2dc\uc220\ub85c \uc778\ud574 \uac74\uc870\ud558\uace0 \ud478\uc11d\ud55c \ubaa8\ubc1c\uc744 \uac00\uc9c4 \ubd84\ub4e4\uc774 \uc0f4\ud478 \ud6c4\uc5d0\ub3c4 \ubd80\ub4dc\ub7ec\uc6c0\uc744 \ub290\ub07c\uace0 \uc2f6\uc744 \ub54c \uc0ac\uc6a9\ud558\uc138\uc694. \ud48d\uc131\ud55c \uac70\ud488\uacfc \uc740\uc740\ud55c \ud50c\ub85c\ub7f4 \ud5a5\uc73c\ub85c \uc0f4\ud478 \uc2dc\uac04\uc744 \uae30\ubd84 \uc88b\uac8c \ub9cc\ub4e4\uc5b4 \uc90d\ub2c8\ub2e4.\" (\ub9cc\uc57d \uc635\uc158 A \uc120\ud0dd \uc2dc)\n    *   **\uc2e0\uaddc \ub77c\uc778 \uc608\uc2dc:** \"\ubbfc\uac10\ud558\uace0 \uc27d\uac8c \uae30\ub984\uc9c0\ub294 \ub450\ud53c\ub85c \uc778\ud574 \uac00\ub824\uc6c0\uacfc \ud2b8\ub7ec\ube14\ub85c \uace0\uc0dd\ud558\ub294 \ubd84\ub4e4\uc744 \uc704\ud574 \uac1c\ubc1c\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \uc800\uc790\uadf9 \ud3ec\ubbac\ub7ec\uc640 \ub450\ud53c \uc9c4\uc815 \uc131\ubd84\uc774 \uac1c\uc6b4\ud558\uace0 \uc0b0\ub73b\ud55c \ub9c8\ubb34\ub9ac\uac10\uc744 \uc120\uc0ac\ud569\ub2c8\ub2e4.\" (\ub9cc\uc57d \uc635\uc158 B \uc120\ud0dd \uc2dc)\n\n*   **\uae30\ub300\uce58 \uad00\ub9ac \uac00\uc774\ub4dc(Proactive Guide):**\n    \ubc18\ubcf5\ub418\ub294 '\ub5a1\uc9d0', '\uae30\ub984\uc9d0', '\ub450\ud53c \ud2b8\ub7ec\ube14' \ub4f1\uc758 \ubd88\ub9cc\uc744 \uc608\ubc29\ud558\uae30 \uc704\ud574 \ub2e4\uc74c\uacfc \uac19\uc740 \uad6c\uccb4\uc801\uc778 \uac00\uc774\ub4dc\ub97c \uc81c\ud488 \uc0c1\uc138 \ud398\uc774\uc9c0, SNS \ucf58\ud150\uce20, \uace0\uac1d \uc11c\ube44\uc2a4 \ucc44\ub110 \ub4f1\uc744 \ud1b5\ud574 \uc801\uadf9\uc801\uc73c\ub85c \ub178\ucd9c\ud569\ub2c8\ub2e4.\n    *   **'\uc62c\ubc14\ub978 \uc0ac\uc6a9\ubc95' \uac00\uc774\ub4dc:**\n        *   \ub450\ud53c \ud0c0\uc785\ubcc4 \uc0ac\uc6a9\ub7c9 \ubc0f \ud69f\uc218 \uad8c\uc7a5: \"\uc9c0\uc131 \ub450\ud53c\uc774\uc2e0 \uacbd\uc6b0, \ud3c9\uc18c \uc0ac\uc6a9\ud558\ub294 \uc591\ubcf4\ub2e4 \uc18c\ub7c9\ub9cc \uc0ac\uc6a9\ud558\uac70\ub098 \uaca9\uc77c \uc0ac\uc6a9\uc744 \uad8c\uc7a5\ud569\ub2c8\ub2e4.\"\n        *   \uaf3c\uaf3c\ud55c \ud5f9\uad7c\uc758 \uc911\uc694\uc131 \uac15\uc870: \"\ubbf8\uc628\uc218\ub85c \ub450\ud53c\ub97c \ucda9\ubd84\ud788 \uc801\uc2e0 \ud6c4 \uc0f4\ud478\ub97c \uc0ac\uc6a9\ud558\uace0, \ud5f9\uad74 \ub54c\ub294 \uc794\uc5ec\ubb3c\uc774 \ub0a8\uc9c0 \uc54a\ub3c4\ub85d \uaf3c\uaf3c\ud558\uac8c \ud5f9\uad88\uc8fc\uc138\uc694.\"\n        *   \uc0f4\ud478 \ud6c4 \ub450\ud53c \ub9c8\uc0ac\uc9c0 \ubc29\ubc95 \uc548\ub0b4: \"\uc0f4\ud478 \uc2dc \uc190\uac00\ub77d \ub05d\uc73c\ub85c \ub450\ud53c \uc804\uccb4\ub97c \ubd80\ub4dc\ub7fd\uac8c \ub9c8\uc0ac\uc9c0\ud558\uc5ec \ub178\ud3d0\ubb3c \uc81c\uac70\ub97c \ub3d5\uc2b5\ub2c8\ub2e4.\"\n    *   **'\uc8fc\uc758\uc0ac\ud56d' \uba85\ud655\ud654:** \ubbfc\uac10\uc131 \ub610\ub294 \uc9c0\uc131 \ub450\ud53c \uc0ac\uc6a9\uc790\uc758 \uacbd\uc6b0, \uc0ac\uc6a9 \uc804 \ud328\uce58 \ud14c\uc2a4\ud2b8\ub97c \uad8c\uc7a5\ud558\uac70\ub098 \ud2b9\uc815 \ub450\ud53c \ucee8\ub514\uc158\uc5d0\uc11c\ub294 \uc0ac\uc6a9\uc744 \uc790\uc81c\ud558\ub3c4\ub85d \uc548\ub0b4\ud558\ub294 \ubb38\uad6c\ub97c \ucd94\uac00\ud569\ub2c8\ub2e4.\n\n*   **\uad11\uace0 \uba54\uc2dc\uc9c0 \ud604\uc2e4\ud654:**\n    '\uae30\uc801 \uac19\uc740 \ubcc0\ud654', '\uc644\ubcbd\ud55c \ubcf5\uad6c'\uc640 \uac19\uc774 \uacfc\uc7a5\ub41c \ud45c\ud604\uc740 \uc0ac\uc6a9\uc790 \uacbd\ud5d8\uacfc\uc758 \uad34\ub9ac\ub97c \ud0a4\uc6b8 \ubfd0\uc785\ub2c8\ub2e4. \ub300\uc2e0, \ub2e4\uc74c\uacfc \uac19\uc774 \ud604\uc2e4\uc801\uc774\uace0 \uac80\uc99d \uac00\ub2a5\ud55c \uba54\uc2dc\uc9c0\ub85c \uc804\ud658\ud569\ub2c8\ub2e4.\n    *   **\uc194\uc9c1\ud55c \uc804\ud6c4 \ube44\uad50:** \uc190\uc0c1\ub41c \ubaa8\ubc1c\uc774 \uc0f4\ud478 \uc0ac\uc6a9 \ud6c4 \uc5b4\ub5bb\uac8c \ub354 \ubd80\ub4dc\ub7ec\uc6cc\uc9c0\uace0 \ucc28\ubd84\ud574\uc9c0\ub294\uc9c0\uc5d0 \ub300\ud55c \uc0ac\uc2e4\uc801\uc778 \ube44\ud3ec&\uc560\ud504\ud130 \uc774\ubbf8\uc9c0\ub97c \ud65c\uc6a9\ud569\ub2c8\ub2e4. (\ub2e8, \uacfc\ub3c4\ud55c \ubcf4\uc815\uc774\ub098 \uc65c\uace1\uc740 \uc9c0\uc591)\n    *   **\uc131\ubd84 \ubc0f \ud6a8\ub2a5 \uc124\uba85 \uac15\ud654:** '\ub2e8\ubc31\uc9c8 \uc570\ud50c'\uc774\ub77c\ub294 \uc774\ub984\uc5d0 \uac78\ub9de\uac8c, \uc81c\ud488\uc5d0 \ud568\uc720\ub41c \uc8fc\uc694 \ub2e8\ubc31\uc9c8 \uc131\ubd84\uc774 \ubaa8\ubc1c\uc5d0 \uc5b4\ub5a4 \ubc29\uc2dd\uc73c\ub85c \uc791\uc6a9\ud558\uc5ec \ubd80\ub4dc\ub7ec\uc6c0\uc744 \ubd80\uc5ec\ud558\ub294\uc9c0 \uacfc\ud559\uc801\uc73c\ub85c \uc124\uba85\ud569\ub2c8\ub2e4. (\uc608: \uc800\ubd84\uc790 \ub2e8\ubc31\uc9c8\uc774 \ubaa8\ubc1c \ud050\ud2f0\ud074 \ud2c8\uc0c8\ub97c \ucc44\uc6cc \ubd80\ub4dc\ub7ec\uc6c0 \ubd80\uc5ec)\n    *   **\uc804\ubb38\uac00 \ub9ac\ubdf0 \ub610\ub294 \uc784\uc0c1 \uacb0\uacfc \uc81c\uc2dc:** \uac00\ub2a5\ud558\ub2e4\uba74, \ub450\ud53c \uc804\ubb38\uac00 \ub610\ub294 \ubaa8\ubc1c \uc804\ubb38\uac00\uc758 \ub9ac\ubdf0\ub098, \uac1d\uad00\uc801\uc778 \uc0ac\uc6a9\uac10 \ud14c\uc2a4\ud2b8(\uc608: \ubaa8\ubc1c \ubd80\ub4dc\ub7ec\uc6c0 \uac1c\uc120\ub3c4, \ub450\ud53c \uc218\ubd84\ub3c4 \uac1c\uc120 \ub4f1) \uacb0\uacfc\ub97c \uc81c\uc2dc\ud558\uc5ec \uc2e0\ub8b0\ub3c4\ub97c \ub192\uc785\ub2c8\ub2e4.\n\n\uc774\ub7ec\ud55c \uc804\ub7b5\ub4e4\uc744 \ud1b5\ud574 \uc5b4\ub178\ube0c \ub525 \ub370\ubbf8\uc9c0 \ub9ac\ud398\uc5b4 \uc0f4\ud478\ub294 \ub2e8\uc21c\ud55c \uc2e4\ud328 \uc81c\ud488\uc774 \uc544\ub2cc, \uace0\uac1d\uc758 \ubaa9\uc18c\ub9ac\uc5d0 \uadc0 \uae30\uc6b8\uc774\uace0 \ub04a\uc784\uc5c6\uc774 \uac1c\uc120\ud558\ub824\ub294 \ube0c\ub79c\ub4dc\uc758 \uc758\uc9c0\ub97c \ubcf4\uc5ec\uc8fc\ub294 '\uc131\uc7a5 \ub3d9\ub825'\uc774 \ub420 \uc218 \uc788\uc744 \uac83\uc785\ub2c8\ub2e4.", "ingredients": "\uc815\uc81c\uc218, \uc18c\ub4d0\ub77c\uc6b0\ub808\uc2a4\uc124\ud398\uc774\ud2b8, \uc554\ubaa8\ub284\ub77c\uc6b0\ub9b4\uc124\ud398\uc774\ud2b8, \ucf54\uce74\ubbf8\ub3c4\ud504\ub85c\ud544\ubca0\ud0c0\uc778, \ub2e4\uc774\ud504\ub85c\ud544\ub80c\uae00\ub77c\uc774\ucf5c, \ud53c\ud53c\uc9c0-3\ubbf8\ub9ac\uc2a4\ud2f8\uc5d0\ud130, \uc18c\ub4d0\ubca4\uc870\uc5d0\uc774\ud2b8, \ud3f4\ub9ac\ucffc\ud130\ub284-10, \uc18c\ub4d0\ud074\ub85c\ub77c