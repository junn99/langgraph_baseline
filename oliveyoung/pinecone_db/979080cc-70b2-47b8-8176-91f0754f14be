uc544\uc2a4\ud30c\ud2f1\uc560\uc528\ub4dc, \ub958\uc2e0, \uc54c\ub77c\ub2cc, \ub77c\uc774\uc2e0, \uc54c\uc9c0\ub2cc, \ud0c0\uc774\ub85c\uc2e0, \ud398\ub2d0\uc54c\ub77c\ub2cc, \ud504\ub864\ub9b0, \ud2b8\ub808\uc624\ub2cc, \ubc1c\ub9b0, 1,2-\ud5e5\uc0b0\ub2e4\uc774\uc62c, \uce74\ud504\ub9b4\ub9b4\uae00\ub77c\uc774\ucf5c, \uc544\uc774\uc18c\ub958\uc2e0, \uc2dc\ud2b8\ub9ad\uc560\uc528\ub4dc, \ud788\uc2a4\ud2f0\ub518, \uc2dc\uc2a4\ud14c\uc778, \uba54\ud2f0\uc624\ub2cc, \uc5d0\ud2f8\ud5e5\uc2e4\uae00\ub9ac\uc138\ub9b0, \uc138\ub77c\ub9c8\uc774\ub4dc\uc5d4\ud53c, \ud3ec\uc2a4\ud3ec\ub9ac\ud53c\ub4dc, \ud53c\ud1a0\uc2a4\ud551\uace0\uc2e0, \ud53c\ud1a0\uc2a4\ud14c\ub864, \uc5d0\ud0c4\uc62c, \ud3ec\ud0c0\uc298\ubca4\uc870\uc5d0\uc774\ud2b8, \ud3ec\ud0c0\uc298\uc194\ubca0\uc774\ud2b8, \ud5a5\ub8cc, \ud5e5\uc2e4\uc2e0\ub0a8\uc54c, \uc81c\ub77c\ub2c8\uc62c, \uc2dc\ud2b8\ub85c\ub12c\uc62c, \ub9ac\ubaa8\ub128, \uc54c\ud30c-\uc544\uc774\uc18c\uba54\ud2f8\uc544\uc774\uc624\ub17c\n[\uc6dc\ud398\ud0c8]\n\uc0ac\uc774\ud074\ub85c\ud39c\ud0c0\uc2e4\ub85d\uc138\uc778,\ub2e4\uc774\uba54\ud2f0\ucf58\uc62c,C12-15\uc54c\ud0ac \ubca4\uc870\uc5d0\uc774\ud2b8,\uc5d0\ud0c4\uc62c,\ub2e4\uc774\uba54\ud2f0\ucf58,\ud5a5\ub8cc,\uc544\ub974\uac04\ucee4\ub12c\uc624\uc77c,\ube44\ud0c0\ubbfc\ub098\ubb34\uc624\uc77c,\ud55c\ub828\ucd08\ucd94\ucd9c\ubb3c,\uc778\ub3c4\uba40\uad6c\uc2ac\ub098\ubb34\uc78e\ucd94\ucd9c\ubb3c,\ub4dc\ub7fc\uc2a4\ud2f1\uc528\uc624\uc77c,\ub3d9\ubc31\ub098\ubb34\uc528\uc624\uc77c,\ud574\ubc14\ub77c\uae30\uc528\uc624\uc77c,\ud558\uc774\ub4dc\ub864\ub77c\uc774\uc988\ub4dc\uc2e4\ud06c(10ppb),\uc62c\ub9ac\ube0c\uc624\uc77c,\ud558\uc774\ub4dc\ub864\ub77c\uc774\uc988\ub4dc\uc2dd\ubb3c\uc131\ub2e8\ubc31\uc9c8,\ud558\uc774\ub4dc\ub864\ub77c\uc774\uc988\ub4dc\ucf00\ub77c\ud2f4,\uc2e4\ud06c\uc544\ubbf8\ub178\uc0b0(1ppb),\uc2dd\ubb3c\uc131\uc544\ubbf8\ub178\uc0b0,\ud558\uc774\ub4dc\ub864\ub77c\uc774\uc988\ub4dc\ucf58\ud0a4\uc62c\ub9b0\ub2e8\ubc31\uc9c8,\uc815\uc81c\uc218,\uc0ac\uc774\ud074\ub85