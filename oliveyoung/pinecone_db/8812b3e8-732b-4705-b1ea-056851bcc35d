{"lc": 1, "type": "constructor", "id": ["langchain", "schema", "document", "Document"], "kwargs": {"metadata": {"name": "\ud074\ub9ac\uc624 \ud0ac\ube0c\ub85c\uc6b0 \uc624\ud1a0\ud558\ub4dc\ube0c\ub85c\uc6b0\ud39c\uc2ac \ub2e8\ud488/\uae30\ud68d", "brand": "\ud074\ub9ac\uc624", "category": ["\uba54\uc774\ud06c\uc5c5", "\uc544\uc774\uba54\uc774\ud06c\uc5c5", "\uc544\uc774\ube0c\ub85c\uc6b0"], "price": 20000, "volume": "\u25a0 0.31g", "manufacturer": "\u25a0 \ud1a0\ud0a4\uc640(TOKIWA) / (\uc8fc)\ud074\ub9ac\uc624", "review": "## \ud074\ub9ac\uc624 \ud0ac\ube0c\ub85c\uc6b0 \uc624\ud1a0\ud558\ub4dc\ube0c\ub85c\uc6b0\ud39c\uc2ac \ub2e8\ud488/\uae30\ud68d \uc81c\ud488 \ub9ac\ubdf0 \ubd84\uc11d \ubc0f \uc131\uc7a5 \uc804\ub7b5 \uc81c\uc548\n\n### \ud575\uc2ec \uc694\uc57d\n\n\ud074\ub9ac\uc624 \ud0ac\ube0c\ub85c\uc6b0 \uc624\ud1a0\ud558\ub4dc\ube0c\ub85c\uc6b0\ud39c\uc2ac \uc81c\ud488\uc740 \uc804\ubc18\uc801\uc73c\ub85c \ubb34\ub09c\ud55c \ubc1c\uc0c9\ub825\uacfc \uc9c0\uc18d\ub825\uc744 \uc81c\uacf5\ud558\uc9c0\ub9cc, **\ubc1c\ub9bc\uc131\uc5d0\uc11c\uc758 \ubb49\uce68 \ud604\uc0c1, \ub450\uaecd\uac8c \uadf8\ub824\uc9c0\ub294 \uc2ec\uc73c\ub85c \uc778\ud55c \uc12c\uc138\ud568 \ubd80\uc871, \uadf8\ub9ac\uace0 \uc81c\ud488 \uc6a9\uae30(\ube0c\ub7ec\uc26c \ud30c\uc190 \ub4f1)\uc758 \ub0b4\uad6c\uc131 \ubb38\uc81c**\uac00 \uc8fc\uc694 \ubd88\ub9cc \uc0ac\ud56d\uc73c\ub85c \ub4dc\ub7ec\ub0ac\uc2b5\ub2c8\ub2e4. \ud2b9\ud788, `\ubcc4\ubaa8\uc591\uc0ac\ud0d5` \ub2d8(\"\ubcc4\ubaa8\uc591\uc0ac\ud0d5\", helpful_count: 246)\uacfc `\ub098\ub098\ub098\ub098` \ub2d8(\"\ub098\ub098\ub098\ub098\", helpful_count: 11)\uc758 \ub9ac\ubdf0\ub294 \uac01\uac01 \uc6d0\uc0b0\uc9c0 \ud45c\uae30 \ub204\ub77d\uc73c\ub85c \uc778\ud55c \ubd88\uc2e0\uacfc \ucd5c\uc2e0 \ud2b8\ub80c\ub4dc\uc5d0 \ub4a4\ucc98\uc9c0\ub294 \uc81c\ud488 \ub514\uc790\uc778\uc5d0 \ub300\ud55c \uc544\uc26c\uc6c0\uc744 \uac15\ud558\uac8c \ud45c\ud604\ud558\uba70 \ub192\uc740 \uacf5\uac10\ub300\ub97c \uc5bb\uc5c8\uc2b5\ub2c8\ub2e4. \ub610\ud55c, `Juri` \ub2d8(\"Juri\", helpful_count: 10)\uc740 \ub9ac\ub274\uc5bc \ud6c4 \uc0c9\uc0c1 \ubcc0\ud654\uc5d0 \ub300\ud55c \uac15\ud55c \ubd88\ub9cc\uc744 \uc81c\uae30\ud558\uba70 \uae30\uc874 \uace0\uac1d\uc758 \uc774\ud0c8 \uac00\ub2a5\uc131\uc744 \uc2dc\uc0ac\ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ubb38\uc81c\uc810\ub4e4\uc740 \ud2b9\ud788 \uc544\uc774\ube0c\ub85c\uc6b0 \uba54\uc774\ud06c\uc5c5\uc5d0 \uc775\uc219\ud558\uc9c0 \uc54a\uc740 \ucd08\ubcf4 \uc0ac\uc6a9\uc790\ub4e4\uc5d0\uac8c \u2018\uc9f1\uad6c \ub208\uc379\u2019\uc774\ub77c\ub294 \ubd80\uc815\uc801\uc778 \uacb0\uacfc\ub85c \uc774\uc5b4\uc838 \uc81c\ud488 \ub9cc\uc871\ub3c4\ub97c \uc800\ud558\uc2dc\ud0a4\ub294 \uc8fc\uc694 \uc6d0\uc778\uc73c\ub85c \ud30c\uc545\ub429\ub2c8\ub2e4. \ub530\ub77c\uc11c \ubcf8 \ubcf4\uace0\uc11c\ub294 \uc774\ub7ec\ud55c \ubb38\uc81c\uc810\ub4e4\uc744 \uac1c\uc120\ud558\uace0, \uace0\uac1d\uc758 \uae30\ub300\ub97c \ucda9\uc871\uc2dc\ud0a4\uba70, \ube0c\ub79c\ub4dc \uc2e0\ub8b0\ub3c4\ub97c \ud68c\ubcf5\ud558\uae30 \uc704\ud55c \uad6c\uccb4\uc801\uc778 \uc131\uc7a5 \uc804\ub7b5\uc744 \uc81c\uc548\ud569\ub2c8\ub2e4.\n\n### \uc0c1\uc138 \ubd84\uc11d \ubc0f \uc6b0\uc120\uc21c\uc704\n\n\uc18c\ube44\uc790 \ub9ac\ubdf0 \ub370\uc774\ud130\ub97c \ubd84\uc11d\ud55c \uacb0\uacfc, \ud074\ub9ac\uc624 \ud0ac\ube0c\ub85c\uc6b0 \uc624\ud1a0\ud558\ub4dc\ube0c\ub85c\uc6b0\ud39c\uc2ac \uc81c\ud488\uc5d0\uc11c \ubc1c\uc0dd\ud558\ub294 \uc8fc\uc694 \ubd88\ub9cc \uc0ac\ud56d\ub4e4\uc740 \ub2e4\uc74c\uacfc \uac19\uc774 \ub2e4\uc12f \uac00\uc9c0 \uc601\uc5ed\uc73c\ub85c \ubd84\ub958\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n**1. \uc81c\ud615 \ubc0f \uc0ac\uc6a9\uac10:**\n\uac00\uc7a5 \ube48\ubc88\ud558\uac8c \uc9c0\uc801\ub418\ub294 \ubb38\uc81c\ub294 **\ubc1c\ub9bc\uc131\uc5d0\uc11c\uc758 \ubb49\uce68 \ud604\uc0c1**\uc785\ub2c8\ub2e4. \ub9ce\uc740 \uc0ac\uc6a9\uc790\ub4e4\uc774 \uc81c\ud488\uc774 \ubd80\ub4dc\ub7fd\uac8c \ubc1c\ub9ac\uc9c0\ub9cc \uace7\uc774\uc5b4 \ubb49\uce58\uac70\ub098, \ud639\uc740 \ud53c\ubd80\uc5d0 \ub530\ub77c \ub5a1\uc9c0\ub294 \ub290\ub08c\uc744 \ubc1b\ub294\ub2e4\uace0 \uc5b8\uae09\ud588\uc2b5\ub2c8\ub2e4. `rlacjd****`\ub2d8, `h\u3161h`\ub2d8, `\ubbf8\uc774\ub2c8`\ub2d8, `ciyga****`\ub2d8, `000120g****`\ub2d8, `\uccad\uc8fc\ud0c4\uc0b0\uc218`\ub2d8, `\ub9f4\uc559`\ub2d8, `\uaf41\uc5b8\ub2c8`\ub2d8, `\ub9ac\ud30c\ub9ac\ud574\ud30c\ub9ac\ud30c\ub9ac`\ub2d8, `\uc544\uaef4\uc904\uaebc\uc57c`\ub2d8, `\ub9c8\ub4e4\ub80c\uba54\ubaa8\ub9ac`\ub2d8, `sorikwon`\ub2d8, `\ub450\uce58\uc640\ubd80\uafb8`\ub2d8 \ub4f1 \ub2e4\uc218\uc758 \uc0ac\uc6a9\uc790\uac00 \uc774 \ubb38\uc81c\ub97c \uacbd\ud5d8\ud588\uc73c\uba70, \uc774\ub294 \uc81c\ud488\uc758 \uc0ac\uc6a9 \ud3b8\uc758\uc131\uacfc \uacb0\uacfc\ubb3c\uc758 \uc644\uc131\ub3c4\ub97c \uc800\ud574\ud558\ub294 \ud575\uc2ec \uc694\uc18c\uc785\ub2c8\ub2e4. \ud2b9\ud788 `\ub9f4\uc559`\ub2d8\uc740 \ud30c\uc6b0\ub354 \ucc98\ub9ac \ubc29\ubc95\uc744 \ubc14\uafe8\uc744 \ub54c \ub9cc\uc871\ub3c4\uac00 \uc62c\ub77c\uac14\ub2e4\uace0 \uc5b8\uae09\ud588\uc73c\ub098, \uc774\ub294 \ucd94\uac00\uc801\uc778 \uc81c\ud488 \uc0ac\uc6a9\uc744 \ud544\uc694\ub85c \ud558\uc5ec \ubd88\ud3b8\ud568\uc744 \uc57c\uae30\ud569\ub2c8\ub2e4. \ub610\ud55c, \ub450\uaebc\uc6b4 \uc2ec\uc73c\ub85c \uc778\ud574 \uc138\ubc00\ud55c \ud45c\ud604\uc774 \uc5b4\ub835\ub2e4\ub294 \uc810(`\ubbf8\uc774\ub2c8`\ub2d8, `000120g****`\ub2d8, `\ub9f4\uc559`\ub2d8, `\ub098\ub098\ub098\ub098`\ub2d8) \uc5ed\uc2dc \uc81c\ud615 \ubc0f \uc0ac\uc6a9\uac10 \uce21\uba74\uc5d0\uc11c \uc9c0\uc801\ub418\ub294 \ubd80\ubd84\uc785\ub2c8\ub2e4.\n\n**2. \uc131\ub2a5 \ubc0f \ud6a8\uacfc:**\n\uc9c0\uc18d\ub825\uc5d0 \ub300\ud55c \ud3c9\uac00\ub294 \ub2e4\uc18c \uc5c7\uac08\ub9ac\uc9c0\ub9cc, \"\ubcf4\ud1b5\uc774\uc5d0\uc694\"\ub77c\ub294 \uc758\uacac\uc774 \ub2e4\uc218\ub97c \uc774\ub8e8\ub294 \uac00\uc6b4\ub370 `wa****`\ub2d8, `k202505234****`\ub2d8, `\ub2ec\uc639`\ub2d8, `\ud558\uc789\ub9ac`\ub2d8, `\ub0d4\ub0d4\ub0d0`\ub2d8, `\ub9c8\ub4e4\ub80c\uba54\ubaa8\ub9ac`\ub2d8\uc740 **\uc9c0\uc18d\ub825\uc774 \uae30\ub300\ubcf4\ub2e4 \uc9e7\uac70\ub098 \uc608\uc0c1\ubcf4\ub2e4 \uc9e7\ub2e4**\uace0 \ud3c9\uac00\ud588\uc2b5\ub2c8\ub2e4. \ud2b9\ud788 `\ub2ec\uc639`\ub2d8\uacfc `\ub0d4\ub0d4\ub0d0`\ub2d8\uc740 \uc5ec\ub984\ucca0\uc5d0\ub294 \uac00\uc9c0\uace0 \ub2e4\ub2c8\uba74\uc11c \uc218\uc815\uc774 \ud544\uc694\ud560 \uc815\ub3c4\ub77c\uace0 \uc5b8\uae09\ud558\uba70 \uc9c0\uc18d\ub825\uc5d0 \ub300\ud55c \uc544\uc26c\uc6c0\uc744 \ud45c\ud604\ud588\uc2b5\ub2c8\ub2e4. \ub610\ud55c, `Juri`\ub2d8(\"Juri\", helpful_count: 10)\uc758 \ub9ac\ubdf0\ub294 \ub9ac\ub274\uc5bc \ud6c4 \uc0c9\uc0c1 \ubcc0\ud654\ub85c \uc778\ud574 \uc774\uc804\uacfc \uac19\uc740 \ub9cc\uc871\uac10\uc744 \uc5bb\uc9c0 \ubabb\ud558\uace0 \uc788\uc73c\uba70, \ud2b9\uc815 \uc0c9\uc0c1(\ub77c\uc774\ud2b8 \ube0c\ub77c\uc6b4, \ub0b4\ucd94\ub7f4 \ube0c\ub77c\uc6b4)\uc5d0 \ub300\ud55c \ubd88\ub9cc\uc774 \uc81c\uae30\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \uc774\ub294 \uc81c\ud488\uc758 \ud575\uc2ec \uc131\ub2a5 \uc911 \ud558\ub098\uc778 \uc0c9\uc0c1 \uad6c\ud604 \ubc0f \uc77c\uad00\uc131 \uc720\uc9c0\uc5d0 \ub300\ud55c \ubb38\uc81c\uac00 \uc788\uc74c\uc744 \uc2dc\uc0ac\ud569\ub2c8\ub2e4.\n\n**3. \uc2e0\uccb4\uc801/\uc0dd\ub9ac\uc801 \ubc18\uc751:**\n\uc774 \uc601\uc5ed\uc5d0\uc11c\ub294 \uc2ec\uac01\ud55c \ubb38\uc81c\uac00 \uc9c1\uc811\uc801\uc73c\ub85c \uc5b8\uae09\ub418\uc9c0\ub294 \uc54a\uc558\uc2b5\ub2c8\ub2e4. \ub2e4\ub9cc, `\ubbf8\uc774\ub2c8`\ub2d8\uc740 \ubbfc\uac10\uc131, \uc544\ud1a0\ud53c \ud53c\ubd80\uc784\uc5d0\ub3c4 \ubd88\uad6c\ud558\uace0 \ud2b9\ubcc4\ud55c \uc790\uadf9\uc774\ub098 \ud2b8\ub7ec\ube14\uc5d0 \ub300\ud55c \uc5b8\uae09\uc740 \uc5c6\uc5c8\uc2b5\ub2c8\ub2e4.\n\n**4. \ud3ec\uc7a5 \ubc0f \uc0ac\uc6a9 \ud3b8\uc758\uc131:**\n\uac00\uc7a5 \uc2ec\uac01\ud55c \ubd88\ub9cc \uc911 \ud558\ub098\ub294 **\uc81c\ud488 \uc790\uccb4\uc758 \ub0b4\uad6c\uc131 \ubc0f \uad6c\uc131\ud488 \uad00\ub828 \ubb38\uc81c**\uc785\ub2c8\ub2e4. `\ub9f4\uc559`\ub2d8\uc740 \uc2a4\ud06c\ub958 \ube0c\ub7ec\uc26c \ubd80\ubd84\uc774 \ub3cc\uc544\uac00\ub294 \ubd88\ud3b8\ud568\uc744 \uc5b8\uae09\ud588\uc73c\uba70, `\uc73c\ud5ff\uc5b4\ud5e3`\ub2d8(\"\uc73c\ud5ff\uc5b4\ud5e3\", helpful_count: 0, 0)\uc740 \ub450 \ubc88\uc5d0 \uac78\uccd0 \ube0c\ub7ec\uc26c \ubd80\ubd84\uc774 \ubd80\ub7ec\uc838 \uc0ac\uc6a9\ud560 \uc218 \uc5c6\ub2e4\uace0 \uac15\uc870\ud588\uc2b5\ub2c8\ub2e4. \ub610\ud55c, `Jfam`\ub2d8\ub3c4 \ube0c\ub7ec\uc26c \ubd80\ubd84\uc774 \ubcf8\uccb4\uc5d0\uc11c \ubd84\ub9ac\ub418\ub294 \ubb38\uc81c\ub97c \uc9c0\uc801\ud588\uc2b5\ub2c8\ub2e4. \ub354\ubd88\uc5b4, `Juri`\ub2d8(\"Juri\", helpful_count: 2)\uc740 \uc0c8 \uc81c\ud488\uc5d0\uc11c \uc0e4\ud504\ub108\uac00 \ub204\ub77d\ub41c \uacbd\ud5d8\uc744 \uacf5\uc720\ud588\uc73c\uba70, `dipriv****`\ub2d8\uacfc `k202505234****`\ub2d8\uc740 \uae30\ud68d \uc81c\ud488\uc73c\ub85c \uc8fc\ubb38\ud588\uc73c\ub098 \ub2e8\ud488\ub9cc \ubc30\uc1a1\ub418\ub294 \ubb38\uc81c\uc640 \uad00\ub828\ud558\uc5ec \uc624\ud574\uc758 \uc18c\uc9c0\uac00 \uc788\ub294 \ud310\ub9e4 \ubc29\uc2dd\uc5d0 \ub300\ud55c \ubd88\ub9cc\uc744 \ud45c\ucd9c\ud588\uc2b5\ub2c8\ub2e4.\n\n**5. \uac00\uce58 \ubc0f \uc804\ubc18\uc801 \uc778\uc2dd:**\n\uac00\uc7a5 \ub192\uc740 \uacf5\uac10\ub300\ub97c \uc5bb\uc740 \ub9ac\ubdf0\ub294 `\ubcc4\ubaa8\uc591\uc0ac\ud0d5`\ub2d8\uc758 \uc6d0\uc0b0\uc9c0(Made in Japan) \ud45c\uae30 \ub204\ub77d \ubc0f \uc774\uc5d0 \ub530\ub978 \ubd88\uc2e0\uc5d0 \ub300\ud55c \uac83\uc785\ub2c8\ub2e4. \ud574\ub2f9 \ub9ac\ubdf0\ub294 \ubb34\ub824 246\uac1c\uc758 '\uc88b\uc544\uc694'\ub97c \ubc1b\uc73c\uba70 \ub9ce\uc740 \uc18c\ube44\uc790\ub4e4\uc758 \uc6b0\ub824\ub97c \ub300\ubcc0\ud588\uc2b5\ub2c8\ub2e4. \ub610\ud55c, `\ub098\ub098\ub098\ub098`\ub2d8\uc740 \ube0c\ub85c\uc6b0 \ub9db\uc9d1 \ud64d\uc218 \uc2dc\ub300\uc5d0 \ud22c\ubc15\ud55c \ub514\uc790\uc778\uacfc \ucd5c\uc2e0 \ud2b8\ub80c\ub4dc\uc640\uc758 \uad34\ub9ac\ub85c \uc778\ud574 \ub354 \uc774\uc0c1 \uc7ac\uad6c\ub9e4 \uc758\uc0ac\uac00 \uc5c6\ub2e4\uace0 \ubc1d\ud788\uba70, \ube0c\ub79c\ub4dc\uc758 \ud601\uc2e0 \ubd80\uc7ac\uc5d0 \ub300\ud55c \uc544\uc26c\uc6c0\uc744 \ub098\ud0c0\ub0c8\uc2b5\ub2c8\ub2e4. `Juri`\ub2d8\uc758 \ub9ac\ub274\uc5bc \ud6c4 \uc0c9\uc0c1 \ubd88\ub9cc\uc871 \ub9ac\ubdf0 \uc5ed\uc2dc \uae30\uc874 \uace0\uac1d\uc758 \ucda9\uc131\ub3c4\ub97c \uc57d\ud654\uc2dc\ud0a4\ub294 \uc694\uc778\uc73c\ub85c \uc791\uc6a9\ud569\ub2c8\ub2e4.\n\n**\ube44\uc988\ub2c8\uc2a4 \uc784\ud329\ud2b8 \ubc0f \uc6b0\uc120\uc21c\uc704 \uacb0\uc815:**\n\nHelpful_count\ub97c \uae30\uc900\uc73c\ub85c \uac01 \ubb38\uc81c\uc810\uc758 \ube44\uc988\ub2c8\uc2a4 \uc784\ud329\ud2b8\ub97c \ubd84\uc11d\ud558\uace0 \uc6b0\uc120\uc21c\uc704\ub97c \ub3c4\ucd9c\ud558\uba74 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4.\n\n*   **1\uc21c\uc704: \ud3ec\uc7a5 \ubc0f \uc0ac\uc6a9 \ud3b8\uc758\uc131 - \ube0c\ub7ec\uc26c \ub0b4\uad6c\uc131 \ubc0f \uc6a9\uae30 \ubd88\ub7c9 (Helpful Count \ucd1d\ud569: 26)**\n    *   \ube0c\ub7ec\uc26c \ud30c\uc190(2\ud68c, `\ub9f4\uc559`\ub2d8, `\uc73c\ud5ff\uc5b4\ud5e3`\ub2d8, `Jfam`\ub2d8), \uc0e4\ud504\ub108 \ub204\ub77d(`Juri`\ub2d8), \uae30\ud68d/\ub2e8\ud488 \ud63c\ub3d9(`dipriv****`\ub2d8, `k202505234****`\ub2d8) \ub4f1\uc740 \uc81c\ud488 \uc790\uccb4\uc758 \ud488\uc9c8 \uad00\ub9ac\uc640 \uc2e0\ub8b0\ub3c4\uc5d0 \uc9c1\uacb0\ub418\ub294 \ubb38\uc81c\uc785\ub2c8\ub2e4. \ud2b9\ud788 \ube0c\ub7ec\uc26c \ud30c\uc190\uc740 \uc0ac\uc6a9 \uacbd\ud5d8 \uc790\uccb4\ub97c \ubd88\uac00\ub2a5\ud558\uac8c \ub9cc\ub4dc\ub294 \uce58\uba85\uc801\uc778 \uacb0\ud568\uc73c\ub85c, \ub192\uc740 '\uc88b\uc544\uc694' \uc218(\ub9f4\uc559\ub2d8 2, \uc73c\ud5ff\uc5b4\ud5e3\ub2d8 0+0, Jfam\ub2d8 0)\ub294 \uc0ac\uc6a9\uc790\ub4e4\uc758 \uc720\uc0ac\ud55c \uacbd\ud5d8 \uac00\ub2a5\uc131\uc744 \uc2dc\uc0ac\ud569\ub2c8\ub2e4. \uae30\ud68d/\ub2e8\ud488 \uad00\ub828 \uc774\uc288(`k202505234****`\ub2d8 0, `dipriv****`\ub2d8 0) \ub610\ud55c \uace0\uac1d\uc5d0\uac8c \ud63c\ub780\uacfc \ubd88\ub9cc\uc744 \uc57c\uae30\ud558\uba70 \ube0c\ub79c\ub4dc \uc774\ubbf8\uc9c0\uc5d0 \ubd80\uc815\uc801\uc778 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4.\n\n*   **2\uc21c\uc704: \uac00\uce58 \ubc0f \uc804\ubc18\uc801 \uc778\uc2dd - \uc6d0\uc0b0\uc9c0 \ud45c\uae30 \ub204\ub77d \ubc0f \ube0c\ub79c\ub4dc \uc2e0\ub8b0\ub3c4 \uc800\ud558 (Helpful Count: 246)**\n    *   `\ubcc4\ubaa8\uc591\uc0ac\ud0d5`\ub2d8\uc758 \ub9ac\ubdf0\ub294 \ub2e8\uc77c \ub9ac\ubdf0\ub85c\ub294 \uc555\ub3c4\uc801\uc778 \uacf5\uac10 \uc218\ub97c \uc5bb\uc5c8\uc73c\uba70, \uc774\ub294 \uc18c\ube44\uc790\ub4e4\uc758 \uc548\uc804 \ubc0f \ube0c\ub79c\ub4dc \uc724\ub9ac\uc5d0 \ub300\ud55c \ubbfc\uac10\uc131\uc744 \ub2e8\uc801\uc73c\ub85c \ubcf4\uc5ec\uc90d\ub2c8\ub2e4. \uc6d0\uc0b0\uc9c0 \ud45c\uae30 \ub204\ub77d\uc740 \uba85\ubc31\ud55c \uc815\ubcf4 \ube44\ub300\uce6d\uc774\uba70, \uc774\ub294 \ubd88\ub9e4 \uc6b4\ub3d9\uc73c\ub85c\uae4c\uc9c0 \ubc88\uc9c8 \uc218 \uc788\ub294 \ub9e4\uc6b0 \uc2ec\uac01\ud55c \ubb38\uc81c\uc785\ub2c8\ub2e4.\n\n*   **3\uc21c\uc704: \uc81c\ud615 \ubc0f \uc0ac\uc6a9\uac10 - \ubc1c\ub9bc\uc131 \ubb49\uce68 \ubc0f \uc12c\uc138\ud568 \ubd80\uc871 (Helpful Count \ucd1d\ud569: 23)**\n    *   \ubb49\uce68 \ud604\uc0c1\uacfc \ub450\uaebc\uc6b4 \uc2ec\uc73c\ub85c \uc778\ud55c \uc12c\uc138\ud568 \ubd80\uc871\uc740 `rlacjd****`\ub2d8, `h\u3161h`\ub2d8, `\ubbf8\uc774\ub2c8`\ub2d8, `ciyga****`\ub2d8, `000120g****`\ub2d8, `\uccad\uc8fc\ud0c4\uc0b0\uc218`\ub2d8, `\ub9f4\uc559`\ub2d8, `\uaf41\uc5b8\ub2c8`\ub2d8, `\ub9ac\ud30c\ub9ac\ud574\ud30c\ub9ac\ud30c\ub9ac`\ub2d8, `\uc544\uaef4\uc904\uaebc\uc57c`\ub2d8, `sorikwon`\ub2d8, `\ub450\uce58\uc640\ubd80\uafb8`\ub2d8 \ub4f1 \uc218\ub9ce\uc740 \uc0ac\uc6a9\uc790\uc5d0\uac8c \uacf5\ud1b5\uc801\uc73c\ub85c \ub098\ud0c0\ub098\ub294 \ubb38\uc81c\uc785\ub2c8\ub2e4. \ud2b9\ud788 \ucd08\ubcf4 \uc0ac\uc6a9\uc790\uc5d0\uac8c '\uc9f1\uad6c \ub208\uc379'\uc744 \uc720\ubc1c\ud558\ub294 \uc9c1\uc811\uc801\uc778 \uc6d0\uc778\uc774 \ub418\uae30\uc5d0, \uc81c\ud488 \uc0ac\uc6a9 \uacbd\ud5d8\uc758 \uc9c8\uc744 \ud06c\uac8c \ub5a8\uc5b4\ub728\ub9bd\ub2c8\ub2e4.\n\n\uc774 \uc138 \uac00\uc9c0 \ud575\uc2ec \uc774\uc288\ub294 \uace0\uac1d \ub9cc\uc871\ub3c4\ub97c \uc800\ud574\ud558\uace0 \ube0c\ub79c\ub4dc \uc2e0\ub8b0\ub3c4\ub97c \ud558\ub77d\uc2dc\ud0a4\ub294 \uc8fc\uc694 \uc694\uc778\uc73c\ub85c, \uc989\uac01\uc801\uc778 \uac1c\uc120 \ubc0f \ub300\uc751\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \ud2b9\ud788, \uc6d0\uc0b0\uc9c0 \ud45c\uae30 \ub204\ub77d\uc740 \ubc95\uaddc \uc704\ubc18 \uc18c\uc9c0\ub3c4 \uc788\uc73c\ubbc0\ub85c \ucd5c\uc6b0\uc120\uc801\uc778 \uc870\uce58\uac00 \uc694\uad6c\ub429\ub2c8\ub2e4.\n\n**\ud575\uc2ec \ud0c0\uac9f \uadf8\ub8f9 \uc5f0\uacb0:**\n\n\uc774\ubc88 \ubd84\uc11d\uc5d0\uc11c \uc81c\uae30\ub41c \ud575\uc2ec \ubb38\uc81c\uc810\ub4e4\uc740 \ud2b9\uc815 \ud53c\ubd80 \ud0c0\uc785\ubcf4\ub2e4\ub294 \uc544\uc774\ube0c\ub85c\uc6b0 \uba54\uc774\ud06c\uc5c5\uc744 \ud558\ub294 \ubaa8\ub4e0 \uc0ac\uc6a9\uc790\uc5d0\uac8c \uad11\ubc94\uc704\ud558\uac8c \ub098\ud0c0\ub098\uace0 \uc788\uc2b5\ub2c8\ub2e4. \uadf8\ub7ec\ub098 **\uac00\uc7a5 \ub450\ub4dc\ub7ec\uc9c0\uac8c \ubd88\ub9cc\uc744 \uc81c\uae30\ud558\ub294 \uc0ac\uc6a9\uc790 \uadf8\ub8f9\uc740 \uc544\uc774\ube0c\ub85c\uc6b0 \uba54\uc774\ud06c\uc5c5 \ucd08\ubcf4\uc790**\uc785\ub2c8\ub2e4. \uc774\ub4e4\uc740 '\uc9f1\uad6c \ub208\uc379'\uc774 \ub418\uae30 \uc27d\ub2e4\ub294 \uc810, \uc12c\uc138\ud55c \ud45c\ud604\uc774 \uc5b4\ub835\ub2e4\ub294 \uc810, \uadf8\ub9ac\uace0 \ubb49\uce68 \ud604\uc0c1\uc73c\ub85c \uc778\ud574 \uc218\uc815\uc774 \uc5b4\ub835\ub2e4\ub294 \uc810\uc744 \uac00\uc7a5 \ud06c\uac8c \ud638\uc18c\ud558\uace0 \uc788\uc2b5\ub2c8\ub2e4. \ub530\ub77c\uc11c, \ud074\ub9ac\uc624 \ud0ac\ube0c\ub85c\uc6b0 \uc624\ud1a0\ud558\ub4dc\ube0c\ub85c\uc6b0\ud39c\uc2ac \uc81c\ud488\uc758 \uac1c\uc120\uc740 **\uc544\uc774\ube0c\ub85c\uc6b0 \uba54\uc774\ud06c\uc5c5 \ucd08\ubcf4\uc790**\ub97c \ud575\uc2ec \ud0c0\uac9f \uadf8\ub8f9\uc73c\ub85c \uc0bc\uc544 \uc9c4\ud589\ud574\uc57c \ud569\ub2c8\ub2e4. \uc774\ub4e4\uc774 \uacaa\ub294 \uc5b4\ub824\uc6c0\uc744 \ud574\uacb0\ud574\uc8fc\ub294 \uac83\uc774 \uace7 \uc81c\ud488 \ub9cc\uc871\ub3c4 \ud5a5\uc0c1 \ubc0f \ube0c\ub79c\ub4dc \ucda9\uc131\ub3c4 \uac15\ud654\ub85c \uc774\uc5b4\uc9c8 \uac83\uc785\ub2c8\ub2e4.\n\n### \ub370\uc774\ud130 \uae30\ubc18\uc758 \uc2e4\ud589 \uac00\ub2a5\ud55c \uc131\uc7a5 \uc804\ub7b5 \uc81c\uc5b8\n\n\uc55e\uc11c \ubd84\uc11d\ud55c \ubb38\uc81c\uc810\uacfc \uc6b0\uc120\uc21c\uc704\ub97c \ubc14\ud0d5\uc73c\ub85c, \ud074\ub9ac\uc624 \ud0ac\ube0c\ub85c\uc6b0 \uc624\ud1a0\ud558\ub4dc\ube0c\ub85c\uc6b0\ud39c\uc2ac \uc81c\ud488\uc758 \uc131\uc7a5\uc744 \uc704\ud55c \uc138 \uac00\uc9c0 \uc804\ub7b5\uc744 \uc81c\uc548\ud569\ub2c8\ub2e4.\n\n**[\uc804\ub7b5 \uc81c\uc548 1] \ud3ec\ubbac\ub7ec \ubc0f \uad6c\uc131 \uc694\uc18c \uac1c\uc120**\n\n**\uac00\uc7a5 \uc2dc\uae09\ud55c Top 3 \ubb38\uc81c \ud574\uacb0\uc744 \uc704\ud55c R&D \uac1c\uc120\uc548:**\n\n*   **\ud575\uc2ec \ubb38\uc81c \ud574\uacb0 (\ubc1c\ub9bc\uc131 \ubb49\uce68, \uc12c\uc138\ud568 \ubd80\uc871):**\n    *   **\uc81c\ud615\uc758 \uacbd\ub3c4 \ubc0f \ub9c8\ucc30\ub825 \ucd5c\uc801\ud654:** \ud604\uc7ac \uc81c\ud488\uc758 \uc2ec\uc774 \ub2e4\uc18c \ubb34\ub974\uac70\ub098 \uc785\uc790\uac00 \uad75\uc5b4 \ubb49\uce68\uc744 \uc720\ubc1c\ud558\ub294 \uac83\uc73c\ub85c \ucd94\uc815\ub429\ub2c8\ub2e4. \uc641\uc2a4 \uc131\ubd84 \ub610\ub294 \uc2e4\ub9ac\ucf58\uc758 \ud568\ub7c9 \ubc0f \uc885\ub958\ub97c \uc870\uc808\ud558\uc5ec, \ud53c\ubd80\uc5d0 \uace0\ub974\uac8c \ud37c\uc9c0\uba74\uc11c\ub3c4 \uacfc\ub3c4\ud55c \ud45c\ud604\uc744 \ubc29\uc9c0\ud558\ub294 \ucd5c\uc801\uc758 \uacbd\ub3c4\ub97c \ucc3e\uc544\uc57c \ud569\ub2c8\ub2e4. \uc774\ub97c \ud1b5\ud574 \ubb49\uce68 \ud604\uc0c1\uc744 \uc904\uc774\uace0, \ud55c \uc62c \ud55c \uc62c \uc12c\uc138\ud558\uac8c \ud45c\ud604\ud560 \uc218 \uc788\ub3c4\ub85d \uc81c\ud615\uc744 \uac1c\uc120\ud574\uc57c \ud569\ub2c8\ub2e4. \ub610\ud55c, \ubb49\uce68 \ud604\uc0c1\uc758 \uc6d0\uc778\uc774 \ub420 \uc218 \uc788\ub294 \ud2b9\uc815 \uc131\ubd84\uc758 \ud568\ub7c9\uc744 \uc904\uc774\uac70\ub098, \ub9c8\ucc30\ub825\uc744 \ub192\uc5ec\uc8fc\ub294 \uc131\ubd84(\uc608: \ubbf8\uc138 \uc2e4\ub9ac\uce74 \ub4f1)\uc758 \uc0ac\uc6a9\uc744 \uace0\ub824\ud558\uc5ec \ubcf4\ub2e4 \uade0\uc77c\ud55c \ub3c4\ud3ec\uac00 \uac00\ub2a5\ud558\ub3c4\ub85d \uc5f0\uad6c\ud569\ub2c8\ub2e4. (\ucd94\uc815 \uc131\ubd84: \ud2b9\uc815 \uc641\uc2a4 \ub610\ub294 \uc624\uc77c\ub958\uc758 \uacfc\ub2e4 \ud568\ub7c9)\n    *   **\uc2ec\uc758 \ub2e8\uba74 \ub514\uc790\uc778 \uac1c\uc120:** \ud604\uc7ac\uc758 \uc721\uac01\ud615 \ub610\ub294 \uc6d0\ud615 \ub2e8\uba74 \uc678\uc5d0, \uc880 \ub354 \uc815\uad50\ud55c \ub77c\uc778 \ud45c\ud604\uc774 \uac00\ub2a5\ud55c \uce7c\ub0a0\ud615(Blade-type) \ub610\ub294 \ub4c0\uc5bc \ucef7(Dual-cut) \ub514\uc790\uc778\uc758 \uc2ec\uc744 \uac1c\ubc1c\ud558\uc5ec \uc12c\uc138\ud55c \ub208\uc379 \uaf2c\ub9ac \ud45c\ud604\uc744 \uc6a9\uc774\ud558\uac8c \ud569\ub2c8\ub2e4. \uc774\ub294 \ubb49\ud22d\ud558\uac8c \uadf8\ub824\uc9c0\ub294 \ub2e8\uc810\uc744 \ubcf4\uc644\ud558\uc5ec \ucd08\ubcf4 \uc0ac\uc6a9\uc790\ub3c4 \uc790\uc5f0\uc2a4\ub7ec\uc6b4 \ub208\uc379 \ubaa8\uc591\uc744 \uc5f0\ucd9c\ud560 \uc218 \uc788\ub3c4\ub85d \ub3c4\uc6b8 \uac83\uc785\ub2c8\ub2e4.\n\n*   **\uc0ac\uc6a9\uc790 \uadf8\ub8f9\ubcc4 \ucd5c\uc801\ud654 (\ucd08\ubcf4 \uc0ac\uc6a9\uc790):**\n    *   **\uc18c\ud504\ud2b8 \ub9b4\ub9ac\uc988(Soft Release) \uae30\uc220 \uc801\uc6a9:** \uba54\uc774\ud06c\uc5c5 \ucd08\ubcf4\uc790\ub4e4\uc774 \uac00\uc7a5 \uc5b4\ub824\uc6cc\ud558\ub294 '\uc9c4\ud558\uac8c \ubc1c\uc0c9\ub418\uc5b4 \uc9f1\uad6c \ub208\uc379\uc774 \ub418\ub294 \uac83'\uc744 \ubc29\uc9c0\ud558\uae30 \uc704\ud574, \ucd5c\ucd08 \ud130\uce58 \uc2dc\uc5d0\ub294 \uc740\uc740\ud558\uac8c \ubc1c\uc0c9\ub418\uace0 \ub808\uc774\uc5b4\ub9c1\ud560\uc218\ub85d \uc6d0\ud558\ub294 \uc0c9\uac10\uc744 \uc5bb\uc744 \uc218 \uc788\ub294 \uc18c\ud504\ud2b8 \ub9b4\ub9ac\uc988 \uae30\uc220\uc744 \uc801\uc6a9\ud569\ub2c8\ub2e4. \uc774\ub294 \uc989\uac01\uc801\uc778 \ubc1c\uc0c9\ubcf4\ub2e4\ub294 \uc810\uc9c4\uc801\uc778 \ubc1c\uc0c9\uc744 \ud1b5\ud574 \uc0ac\uc6a9\uc790\uac00 \uc0c9\uac10 \uc870\uc808\uc744 \uc27d\uac8c \ud558\ub3c4\ub85d \ub3d5\uc2b5\ub2c8\ub2e4.\n    *   **\ube0c\ub7ec\uc26c \ud488\uc9c8 \ubc0f \uace0\uc815\ub825 \uac15\ud654:** \ud30c\uc190 \ubc0f \ubd84\ub9ac\ub418\ub294 \ube0c\ub7ec\uc26c \ubb38\uc81c\ub294 \uc81c\ud488 \uc0ac\uc6a9 \uacbd\ud5d8\uc744 \uc2ec\uac01\ud558\uac8c \uc800\ud574\ud569\ub2c8\ub2e4. \ub0b4\uad6c\uc131\uc774 \ub6f0\uc5b4\ub09c \uc18c\uc7ac\ub97c \uc0ac\uc6a9\ud558\uace0, \ube0c\ub7ec\uc26c\uc640 \ubcf8\uccb4 \uac04\uc758 \uacb0\ud569\ub825\uc744 \uac15\ud654\ud558\uc5ec \uc0ac\uc6a9\uc790 \ud3b8\uc758\uc131\uc744 \ub192\uc5ec\uc57c \ud569\ub2c8\ub2e4. \uac00\ub2a5\ud558\ub2e4\uba74 \ube0c\ub7ec\uc26c\uac00 \ubcf8\uccb4\uc5d0 \uacac\uace0\ud558\uac8c \uace0\uc815\ub418\ub294 \ub514\uc790\uc778\uc73c\ub85c \ubcc0\uacbd\ud558\ub294 \uac83\uc744 \uace0\ub824\ud569\ub2c8\ub2e4.\n\n*   **\ubd88\ud544\uc694 \uc694\uc18c \uc81c\uac70:**\n    *   **\uc0c9\uc0c1 \uade0\uc77c\uc131 \ubc0f \uc7ac\ud604\uc131 \ud655\ubcf4:** \ub9ac\ub274\uc5bc \ud6c4 \ud2b9\uc815 \uc0c9\uc0c1(\uc608: \ub0b4\ucd94\ub7f4 \ube0c\ub77c\uc6b4, \ub77c\uc774\ud2b8 \ube0c\ub77c\uc6b4)\uc758 \uc0c9\uac10 \ubcc0\ud654 \ubc0f \uc608\uce21 \ubd88\uac00\ub2a5\uc131\uc5d0 \ub300\ud55c \ubd88\ub9cc\uc774 \uc81c\uae30\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \uae30\uc874 \uace0\uac1d\uce35\uc758 \ub9cc\uc871\ub3c4\ub97c \uc720\uc9c0\ud558\uae30 \uc704\ud574, \uc804 \uc0c9\uc0c1\uc5d0 \uac78\uccd0 \uc77c\uad00\ub41c \uc0c9\uac10\uc744 \uc720\uc9c0\ud558\uace0 \ud53c\ubd80 \ud1a4 \ubc0f \ubaa8\ubc1c \uc0c9\uc0c1\uacfc\uc758 \uc870\ud654\ub3c4\ub97c \ub192\uc774\uae30 \uc704\ud55c \uceec\ub7ec \uc5f0\uad6c\ub97c \uac15\ud654\ud574\uc57c \ud569\ub2c8\ub2e4. \ud2b9\ud788 \ubd89\uc740 \ub07c\uc5d0 \ub300\ud55c \ud53c\ub4dc\ubc31\uc744 \ubc18\uc601\ud558\uc5ec, \ub2e4\uc591\ud55c \ud1a4\uc758 \uadf8\ub808\uc774, \uc560\uc26c \uacc4\uc5f4 \uceec\ub7ec \ub77c\uc778\uc5c5\uc744 \uac15\ud654\ud558\uac70\ub098 \uae30\uc874 \uceec\ub7ec\uc758 \ubd89\uc740 \ub07c\ub97c \uc644\ud654\ud558\ub294 \ubc29\ud5a5\uc73c\ub85c \uac1c\uc120\ud569\ub2c8\ub2e4. (\ucd94\uc815 \ubd88\ud544\uc694 \uc694\uc18c: \uacfc\ub3c4\ud55c \ubd89\uc740 \uc0c9\uc18c, \uc608\uce21 \uc5b4\ub824\uc6b4 \uc5fc\ub8cc \ubc30\ud569)\n    *   **\uc6d0\uc0b0\uc9c0 \uc815\ubcf4 \uba85\ud655\ud654:** \ud574\uc678 \uc0dd\uc0b0 \uc2dc\uc5d0\ub3c4 \uc81c\ud488 \ud328\ud0a4\uc9c0 \ubc0f \uc0c1\uc138 \uc124\uba85\uc5d0 \uc6d0\uc0b0\uc9c0\ub97c \uba85\ud655\ud558\uac8c \ud45c\uae30\ud558\uc5ec \uc18c\ube44\uc790 \uc2e0\ub8b0\ub97c \ud655\ubcf4\ud574\uc57c \ud569\ub2c8\ub2e4. \uc774\ub294 \ub354 \uc774\uc0c1 \ud0c0\ud611\ud560 \uc218 \uc5c6\ub294 \ud544\uc218\uc801\uc778 \uc870\uce58\uc785\ub2c8\ub2e4.\n\n**[\uc804\ub7b5 \uc81c\uc548 2] \uc81c\ud488 \ud3ec\ud2b8\ud3f4\ub9ac\uc624 \ubc0f \uacbd\uc7c1 \uc804\ub7b5**\n\n*   **\uc2dc\uc7a5 \uae30\ud68c \uc815\uc758:**\n    \ud074\ub9ac\uc624 \ud0ac\ube0c\ub85c\uc6b0 \uc624\ud1a0\ud558\ub4dc\ube0c\ub85c\uc6b0\ud39c\uc2ac\uc740 \ud604\uc7ac **\ucd08\ubcf4 \uc0ac\uc6a9\uc790 \ubc0f \uc12c\uc138\ud55c \uba54\uc774\ud06c\uc5c5\uc744 \uc120\ud638\ud558\ub294 \uc0ac\uc6a9\uc790 \uadf8\ub8f9\uc744 \ub9cc\uc871\uc2dc\ud0a4\uc9c0 \ubabb\ud558\uace0 \uc788\uc2b5\ub2c8\ub2e4.** \ud2b9\ud788, \uc587\uace0 \uc790\uc5f0\uc2a4\ub7ec\uc6b4 \ud55c \uc62c \ud55c \uc62c \ud45c\ud604\uc744 \uc911\uc2dc\ud558\ub294 \ucd5c\uc2e0 \uc544\uc774\ube0c\ub85c\uc6b0 \ud2b8\ub80c\ub4dc\uc640\ub294 \uac70\ub9ac\uac00 \uc788\uc2b5\ub2c8\ub2e4. \ud558\uc9c0\ub9cc \uc774\ub294 \uace7 '\ucd08\ubcf4\uc790\ub3c4 \uc27d\uac8c \uc0ac\uc6a9\ud560 \uc218 \uc788\ub294', '\ubb49\uce68 \uc5c6\uc774 \uc790\uc5f0\uc2a4\ub7ec\uc6b4 \ud45c\ud604\uc774 \uac00\ub2a5\ud55c' \ud639\uc740 '\uc138\ubc00\ud55c \ud45c\ud604\uc5d0 \ud2b9\ud654\ub41c' \uc544\uc774\ube0c\ub85c\uc6b0 \uc81c\ud488\uc5d0 \ub300\ud55c \ub192\uc740 \uc2dc\uc7a5 \uc218\uc694\uac00 \uc874\uc7ac\ud568\uc744 \uc758\ubbf8\ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc2dc\uc7a5\uc758 \ube48\ud2c8\uc740 \ud074\ub9ac\uc624\uc5d0\uac8c \uc0c8\ub85c\uc6b4 \uc131\uc7a5 \ub3d9\ub825\uc744 \uc81c\uacf5\ud560 \uc218 \uc788\ub294 \uae30\ud68c\uc785\ub2c8\ub2e4. \ub610\ud55c, \ube0c\ub85c\uc6b0 \uc81c\ud488\uc758 '\ub0b4\uad6c\uc131' \ubc0f '\uc131\ubd84 \uc548\uc804\uc131'\uc5d0 \ub300\ud55c \uc18c\ube44\uc790\ub4e4\uc758 \uad00\uc2ec\uc774 \ub192\uc544\uc9c0\uace0 \uc788\ub294 \uc810\ub3c4 \uc8fc\ubaa9\ud574\uc57c \ud560 \ubd80\ubd84\uc785\ub2c8\ub2e4.\n\n*   **\uc804\ub7b5 \uc635\uc158:**\n\n    *   **\uc635\uc158 A: \uac1c\uc120 \ubc0f \ub9ac\ud3ec\uc9c0\uc154\ub2dd \uc804\ub7b5**\n        *   **\uc81c\ud488 \uac1c\uc120:** \uc0c1\uae30 \uc81c\uc548\ub41c \uc81c\ud615, \uc2ec \ub514\uc790\uc778, \ube0c\ub7ec\uc26c \ub0b4\uad6c\uc131 \uac1c\uc120\uc744 \ud1b5\ud574 \uc81c\ud488 \uc790\uccb4\uc758 \ud488\uc9c8\uc744 \ub192\uc785\ub2c8\ub2e4.\n        *   **\ud0c0\uac9f \uc7ac\uc815\uc758 \ubc0f \uba54\uc2dc\uc9c0 \uac15\ud654:** \u2018\ubc14\uc05c \uc544\uce68, \uc27d\uace0 \ube60\ub974\uac8c \uc644\uc131\ud558\ub294 \uc644\ubcbd\ud55c \ub208\uc379\u2019\uc774\ub77c\ub294 \uae30\uc874\uc758 \uba54\uc2dc\uc9c0\ub97c \uc720\uc9c0\ud558\ub418, \u2018\ubb49\uce68 \uc5c6\uc774 \uc790\uc5f0\uc2a4\ub7ec\uc6b4 \ud45c\ud604\u2019 \ubc0f \u2018\ucd08\ubcf4\uc790\ub3c4 \ud504\ub85c\ucc98\ub7fc\u2019\uc774\ub77c\ub294 \ud0a4\uc6cc\ub4dc\ub97c \uac15\ud654\ud569\ub2c8\ub2e4. \ub610\ud55c, \ub9ac\ub274\uc5bc \ud6c4 \uc0c9\uc0c1 \ubcc0\ud654\uc5d0 \ub300\ud55c \ubd80\uc815\uc801 \ud53c\ub4dc\ubc31\uc744 \ud574\uc18c\ud558\uace0, \ub2e4\uc591\ud55c \ud1a4\uc758 \ubaa8\ubc1c\uc0c9\uc5d0 \ub9de\ub294 \uc644\ubcbd\ud55c \uceec\ub7ec \uc120\ud0dd \uac00\uc774\ub4dc\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4.\n        *   **\ud328\ud0a4\uc9c0 \uac1c\uc120:** \ube0c\ub7ec\uc26c \uace0\uc815\ub825\uc744 \uac15\ud654\ud558\uace0, \uc6d0\uc0b0\uc9c0 \ud45c\uae30\ub97c \uba85\ud655\ud788 \ud558\uba70, \uac04\uacb0\ud558\uace0 \uba85\ud655\ud55c \uc0c9\uc0c1 \uc815\ubcf4 \uc804\ub2ec\uc774 \uac00\ub2a5\ud55c \ud328\ud0a4\uc9c0 \ub514\uc790\uc778\uc73c\ub85c \ubcc0\uacbd\ud569\ub2c8\ub2e4.\n        *   **\ub9ac\ud3ec\uc9c0\uc154\ub2dd:** '\ud558\ub4dc \ud3ec\ubbac\ub7ec'\ub77c\ub294 \uae30\uc874 \uac15\uc810\uc744 \uc720\uc9c0\ud558\uba74\uc11c\ub3c4, \uc81c\ud615 \uac1c\uc120\uc744 \ud1b5\ud574 \u2018\ubb49\uce68 \uc5c6\uc774 \ubd80\ub4dc\ub7fd\uac8c \ubc1c\ub9ac\uc9c0\ub9cc \uc790\uc5f0\uc2a4\ub7ec\uc6b4 \ud558\ub4dc\ud568\u2019\uc744 \uac16\ucd98 \uc81c\ud488\uc73c\ub85c \ud3ec\uc9c0\uc154\ub2dd\ud558\uc5ec, \u2018\uc774\uc9c0(easy)\u2019\uc640 \u2018\ub0b4\ucd94\ub7f4(natural)\u2019\uc744 \ub3d9\uc2dc\uc5d0 \ucd94\uad6c\ud558\ub294 \uace0\uac1d\uce35\uc744 \uacf5\ub7b5\ud569\ub2c8\ub2e4.\n\n    *   **\uc635\uc158 B: \uc2e0\uaddc \ub77c\uc778 \ud655\uc7a5 \uc804\ub7b5**\n        *   **'\ud074\ub9ac\uc624 \ud0ac\ube0c\ub85c\uc6b0 \uc2ac\ub9bc \ud39c\uc2ac\u2019 \ub610\ub294 \u2018\ud074\ub9ac\uc624 \ud0ac\ube0c\ub85c\uc6b0 \uc5e3\uc9c0 \ud39c\uc2ac\u2019 \ub77c\uc778 \ucd9c\uc2dc:** \uc587\uace0 \uc815\uad50\ud55c \uc2ec(\uc608: 1.5mm \uc774\ud558)\uc744 \ucc44\ud0dd\ud558\uace0, \ud39c\uc2ac \uc81c\ud615 \uc5ed\uc2dc \ubd80\ub4dc\ub7fd\uac8c \ubc1c\ub9ac\uba74\uc11c\ub3c4 \uac00\ub8e8\ub0a0\ub9bc\uc774\ub098 \ubb49\uce68\uc774 \uc801\uc740 \ud0c0\uc785\uc73c\ub85c \uac1c\ubc1c\ud558\uc5ec, \ud55c \uc62c \ud55c \uc62c \uc12c\uc138\ud558\uac8c \ub208\uc379\uc744 \ud45c\ud604\ud558\uace0\uc790 \ud558\ub294 \uace0\uac1d\uce35\uc744 \uacf5\ub7b5\ud569\ub2c8\ub2e4. \uc774\ub294 \ud604\uc7ac \ud074\ub9ac\uc624\uac00 \uc9c1\uc811\uc801\uc73c\ub85c \uacf5\ub7b5\ud558\uc9c0 \ubabb\ud558\uace0 \uc788\ub294 \uc138\ubc00 \ud45c\ud604 \uc2dc\uc7a5\uc744 \ub300\uccb4\uc7ac(\uc288\uc5d0\ubb34\ub77c, \ud558\ub4dc**\ub77c \ub4f1)\ub85c\ubd80\ud130 \ud0c8\ud658\ud558\ub294 \uc804\ub7b5\uc785\ub2c8\ub2e4.\n        *   **\u2018\ud074\ub9ac\uc624 \ud0ac\ube0c\ub85c\uc6b0 \ud074\ub9b0 \ud3ec\ubbac\ub7ec\u2019 \ub77c\uc778 \ucd9c\uc2dc:** \ucd5c\uadfc \ud074\ub9b0 \ubdf0\ud2f0\uc5d0 \ub300\ud55c \uad00\uc2ec\uc774 \ub192\uc544\uc9c0\ub294 \ucd94\uc138\ub97c \ubc18\uc601\ud558\uc5ec, \ubbfc\uac10\uc131 \ud53c\ubd80\ub3c4 \uc548\uc2ec\ud558\uace0 \uc0ac\uc6a9\ud560 \uc218 \uc788\ub294 \uc800\uc790\uadf9 \uc131\ubd84 \uae30\ubc18\uc758 \uc544\uc774\ube0c\ub85c\uc6b0 \uc81c\ud488 \ub77c\uc778\uc744 \ucd9c\uc2dc\ud569\ub2c8\ub2e4. \uc774\ub294 \ud658\uacbd \ubc0f \uc131\ubd84\uc5d0 \ub300\ud55c \ubbfc\uac10\ub3c4\ub97c \uac00\uc9c4 \uc18c\ube44\uc790\uce35\uc744 \ud655\ubcf4\ud558\uace0 \ube0c\ub79c\ub4dc \uc774\ubbf8\uc9c0\ub97c \uc81c\uace0\ud558\ub294 \uae30\ud68c\uac00 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n        *   \uc774\ub7ec\ud55c \uc2e0\uaddc \ub77c\uc778 \ucd9c\uc2dc\uc640 \ud568\uaed8, \uae30\uc874 \uc624\ud1a0\ud558\ub4dc\ube0c\ub85c\uc6b0\ud39c\uc2ac\uc758 \uac15\uc810(\ud3b8\uc758\uc131, \uc77c\ubd80 \uc0ac\uc6a9\uc790 \ub9cc\uc871\ub3c4)\uc740 \uc720\uc9c0\ud558\uba70 \ud3ec\ud2b8\ud3f4\ub9ac\uc624\ub97c \ud655\uc7a5\ud558\uc5ec \ub2e4\uc591\ud55c \uace0\uac1d \ub2c8\uc988\ub97c \ucda9\uc871\uc2dc\ud0b5\ub2c8\ub2e4.\n\n**[\uc804\ub7b5 \uc81c\uc548 3] \ub9c8\ucf00\ud305 \ubc0f \ucee4\ubba4\ub2c8\ucf00\uc774\uc158 \ucd5c\uc801\ud654**\n\n*   **\uac00\uce58 \uc81c\uc548(Promise) \uc7ac\uc815\uc758:**\n    \uae30\uc874\uc758 \"\uc790\uc5f0\uc2a4\ub7ec\uc6b4 \ub208\uc379 \uc5f0\ucd9c\"\uc774\ub77c\ub294 \ubaa8\ud638\ud55c \uc57d\uc18d \ub300\uc2e0, **\"\uc544\uc774 \uba54\uc774\ud06c\uc5c5 \ucd08\ubcf4\uc790\ub3c4 \ud558\ub8e8 3\ubd84 \uc548\uc5d0 \uc644\uc131\ud558\ub294, \ubb49\uce68 \uc5c6\uc774 \ub610\ub837\ud558\uace0 \uc790\uc5f0\uc2a4\ub7ec\uc6b4 \ub208\uc379\"**\uacfc \uac19\uc774 \uad6c\uccb4\uc801\uc778 \ud0c0\uac9f\uacfc \uc2dc\uac04, \uadf8\ub9ac\uace0 \uc5bb\uc744 \uc218 \uc788\ub294 \uacb0\uacfc\ubb3c\uc744 \uba85\ud655\ud788 \uc81c\uc2dc\ud569\ub2c8\ub2e4. \ub610\ud55c, \ud2b9\uc815 \uceec\ub7ec(\uc608: \uadf8\ub808\uc774 \ube0c\ub77c\uc6b4)\uac00 \uc5b4\ub5a4 \ud5e4\uc5b4 \uceec\ub7ec \ubc0f \ud53c\ubd80 \ud1a4\uc5d0 \uc798 \uc5b4\uc6b8\ub9ac\ub294\uc9c0\uc5d0 \ub300\ud55c \uba85\ud655\ud55c \uac00\uc774\ub4dc\ub77c\uc778\uc744 \uc81c\uacf5\ud558\uc5ec, \uceec\ub7ec \uc120\ud0dd\uc758 \ud63c\ub780\uc744 \uc904\uc785\ub2c8\ub2e4.\n\n*   **\uae30\ub300\uce58 \uad00\ub9ac \uac00\uc774\ub4dc(Proactive Guide):**\n    *   **\uc628\ub77c\uc778 \uc0c1\uc138 \ud398\uc774\uc9c0 \ubc0f SNS \ucf58\ud150\uce20 \uac15\ud654:** \uc81c\ud488 \uc0c1\uc138 \ud398\uc774\uc9c0\uc5d0 \u2018\ud074\ub9ac\uc624 \ud0ac\ube0c\ub85c\uc6b0, \uc774\uac83\ub9cc\uc740 \uc54c\uace0 \uc4f0\uc138\uc694!\u2019\uc640 \uac19\uc774 **\u2018\ucd08\ubcf4\uc790\ub97c \uc704\ud55c \ubb49\uce68 \ubc29\uc9c0 \uafc0\ud301\u2019**, \u2018\ub0b4 \ub208\uc379 \uceec\ub7ec \ucc3e\uae30 \uac00\uc774\ub4dc\u2019, \u2018\ube0c\ub7ec\uc26c \uc81c\ub300\ub85c \uc0ac\uc6a9\ud558\uae30\u2019 \ub4f1 \ud575\uc2ec \ubb38\uc81c\uc810\uc744 \uc608\ubc29\ud560 \uc218 \uc788\ub294 \uc2e4\uc9c8\uc801\uc778 \ud301\uacfc \uc601\uc0c1\uc744 \uc0c1\uc138\ud558\uac8c \uc81c\uacf5\ud569\ub2c8\ub2e4.\n    *   **\ub9ac\ubdf0 \uae30\ubc18 FAQ \uad6c\uc131:** \uc2e4\uc81c \uc18c\ube44\uc790\ub4e4\uc758 \uc9c8\ubb38\uc744 \ubc14\ud0d5\uc73c\ub85c \uc790\uc8fc \ubb3b\ub294 \uc9c8\ubb38(FAQ) \uc139\uc158\uc744 \uac15\ud654\ud558\uc5ec, \ubb49\uce68 \ud604\uc0c1, \uc0c9\uc0c1 \uc120\ud0dd, \ube0c\ub7ec\uc26c \uad00\ub9ac \ub4f1 \uc8fc\uc694 \uc774\uc288\uc5d0 \ub300\ud55c \uc0ac\uc804 \uc815\ubcf4\ub97c \uc81c\uacf5\ud568\uc73c\ub85c\uc368 \ubd88\ud544\uc694\ud55c \ubd88\ub9cc\uc744 \uc904\uc785\ub2c8\ub2e4.\n\n*   **\uad11\uace0 \uba54\uc2dc\uc9c0 \ud604\uc2e4\ud654:**\n    *   **\u2018\uae30\uc801 \uac19\uc740 \ubcc0\ud654\u2019 \ub300\uc2e0 \u2018\uc2e4\uc81c \uc0ac\uc6a9 \ud6c4 \ubcc0\ud654\u2019 \uac15\uc870:** \uacfc\uc7a5\ub41c \ud45c\ud604\uc744 \uc9c0\uc591\ud558\uace0, \uc81c\ud488 \uac1c\uc120 \ud6c4 **\ud604\uc2e4\uc801\uc778 \uc804\ud6c4 \ube44\uad50 \uc0ac\uc9c4\uc774\ub098 \uc9e7\uc740 \uc601\uc0c1 \ucf58\ud150\uce20**\ub97c \uc81c\uc791\ud558\uc5ec \uc18c\ube44\uc790\ub4e4\uc5d0\uac8c \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \u2018\uba54\uc774\ud06c\uc5c5 \ucd08\ubcf4 5\uc77c\ucc28 \uc0ac\uc6a9\uc790\uc758 \ub208\uc379 \ubcc0\ud654\u2019\uc640 \uac19\uc774 \uc2e4\uc81c \uc0ac\uc6a9 \uacfc\uc815\uc744 \ubcf4\uc5ec\uc8fc\uba70 \uc81c\ud488\uc758 \uac1c\uc120 \ud6a8\uacfc\ub97c \uc790\uc5f0\uc2a4\ub7fd\uac8c \uc804\ub2ec\ud569\ub2c8\ub2e4.\n    *   **\uc6d0\uc0b0\uc9c0 \uc815\ubcf4 \ud22c\uba85 \uacf5\uac1c:** \ubaa8\ub4e0 \ub9c8\ucf00\ud305 \ucc44\ub110\uc5d0\uc11c \uc81c\ud488\uc758 \uc6d0\uc0b0\uc9c0 \uc815\ubcf4\ub97c \uba85\ud655\ud558\uac8c \ud45c\uae30\ud558\uc5ec \ube0c\ub79c\ub4dc\uc758 \ud22c\uba85\uc131\uacfc \uc2e0\ub8b0\ub3c4\ub97c \ub192\uc785\ub2c8\ub2e4. \uc774\ub294 \uacfc\uac70\uc758 \uc2e4\uc218\ub85c\ubd80\ud130 \ubc30\uc6b0\uace0 \uc18c\ube44\uc790 \uc2e0\ub8b0\ub97c \ud68c\ubcf5\ud558\uae30 \uc704\ud55c \ud544\uc218\uc801\uc778 \uacfc\uc815\uc785\ub2c8\ub2e4.\n    *   **\uc778\ud50c\ub8e8\uc5b8\uc11c \ud611\uc5c5 \uc2dc \uc194\uc9c1\ud55c \ub9ac\ubdf0 \uc720\ub3c4:** \uc2e0\ub8b0\ub3c4\uac00 \ub192\uc740 \ubdf0\ud2f0 \uc778\ud50c\ub8e8\uc5b8\uc11c\uc640 \ud611\uc5c5 \uc2dc, \uc81c\ud488\uc758 \uc7a5\uc810\ubfd0\ub9cc \uc544\ub2c8\ub77c \uac1c\uc120\uc774 \ud544\uc694\ud55c \ubd80\ubd84\uc5d0 \ub300\ud55c \uc194\uc9c1\ud55c \ud53c\ub4dc\ubc31\uc744 \ucf58\ud150\uce20\uc5d0 \ud3ec\ud568\ud558\ub3c4\ub85d \uc720\ub3c4\ud558\uc5ec \uc18c\ube44\uc790\ub4e4\uc5d0\uac8c \ud604\uc2e4\uc801\uc778 \uc815\ubcf4\ub97c \uc81c\uacf5\ud558\uace0 \ube0c\ub79c\ub4dc\uc758 \ud22c\uba85\uc131\uc744 \uac15\uc870\ud569\ub2c8\ub2e4.\n\n\uc774\ub7ec\ud55c \uc804\ub7b5\ub4e4\uc744 \ud1b5\ud574 \ud074\ub9ac\uc624 \ud0ac\ube0c\ub85c\uc6b0 \uc624\ud1a0\ud558\ub4dc\ube0c\ub85c\uc6b0\ud39c\uc2ac \uc81c\ud488\uc740 \uae30\uc874\uc758 \ubb38\uc81c\uc810\ub4e4\uc744 \uadf9\ubcf5\ud558\uace0 \uc18c\ube44\uc790 \ub9cc\uc871\ub3c4\ub97c \ub192\uc774\uba70, \ub098\uc544\uac00 \ube0c\ub79c\ub4dc\uc758 \uc2e0\ub8b0\ub3c4\ub97c \ud68c\ubcf5\ud558\uace0 \uc9c0\uc18d\uc801\uc778 \uc131\uc7a5\uc744 \uc774\ub8f0 \uc218 \uc788\uc744 \uac83\uc785\ub2c8\ub2e4.", "ingredients": "01 \n\uc2a4\ud14c\uc544\ub9ad\uc560\uc528\ub4dc\n\ub9c8\uc774\uce74\n\ud751\uc0c9\uc0b0\ud654\ucca0\n\ud669\uc0c9\uc0b0\ud654\ucca0\n\uac80\uc591\uc63b\ub098\ubb34\uc5f4\ub9e4\uc641\uc2a4\n\uc801\uc0c9\uc0b0\ud654\ucca0\n\ud558\uc774\ub4dc\ub85c\uc81c\ub124\uc774\ud2f0\ub4dc\uce90\uc2a4\ud130\uc624\uc77c\n\uc218\ud06c\ub85c\uc624\uc2a4\ud14c\ud2b8\ub77c\uc2a4\ud14c\uc544\ub808\uc774\ud2b8\ud2b8\ub77c\uc774\uc544\uc138\ud14c\uc774\ud2b8\nC10-30\ucf5c\ub808\uc2a4\ud14c\ub864/\ub77c\ub178\uc2a4\ud14c\ub864\uc5d0\uc2a4\ud130\n\ud2f0\ud0c0\ub284\ub514\uc625\uc0ac\uc774\ub4dc\n\ud2b8\ub77c\uc774\uc5d0\ud2f8\ud5e5\uc0ac\ub178\uc778\n\uc194\ube44\ud0c4\uc138\uc2a4\ud034\uc62c\ub9ac\uc5d0\uc774\ud2b8\n\uc54c\ub8e8\ubbf8\ub284\ud558\uc774\ub4dc\ub85d\uc0ac\uc774\ub4dc\n\ud1a0\ucf54\ud398\ub864\n\n02 \n\ud669\uc0c9\uc0b0\ud654\ucca0\n\uc2a4\ud14c\uc544\ub9ad\uc560\uc528\ub4dc\n\ud2f0\ud0c0\ub284\ub514\uc625\uc0ac\uc774\ub4dc\n\uac80\uc591\uc63b\ub098\ubb34\uc5f4\ub9e4\uc641\uc2a4\n\uc801\uc0c9\uc0b0\ud654\ucca0\n\ud558\uc774\ub4dc\ub85c\uc81c\ub124\uc774\ud2f0\ub4dc\uce90\uc2a4\ud130\uc624\uc77c\n\ub9c8\uc774\uce74\n\ud751\uc0c9\uc0b0\ud654\ucca0\n\uc218\ud06c\ub85c\uc624\uc2a4\ud14c\ud2b8\ub77c\uc2a4\ud14c\uc544\ub808\uc774\ud2b8\ud2b8\ub77c\uc774\uc544\uc138\ud14c\uc774\ud2b8\nC10-30\ucf5c\ub808\uc2a4\ud14c\ub864/\ub77c\ub178\uc2a4\ud14c\ub864\uc5d0\uc2a4\ud130\n\ud2b8\ub77c\uc774\uc5d0\ud2f8\ud5e5\uc0ac\ub178\uc778\n\uc194\ube44\ud0c4\uc138\uc2a4\ud034\uc62c\ub9ac\uc5d0\uc774\ud2b8\n\uc54c\ub8e8\ubbf8\ub284\ud558\uc774\ub4dc\ub85d\uc0ac\uc774\ub4dc\n\ud1a0\ucf54\ud398\ub864\n\n03\n\ub9c8\uc774\uce74\n\uc2a4\ud14c\uc544\ub9ad\uc560\uc528\ub4dc\n\ud669\uc0c9\uc0b0\ud654\uc