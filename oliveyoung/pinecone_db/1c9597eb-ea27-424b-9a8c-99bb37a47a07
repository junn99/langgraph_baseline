9\uc0b0\ud654\ucca0,\ud751\uc0c9\uc0b0\ud654\ucca0,\ud669\uc0c9\uc0b0\ud654\ucca0.[GLOW BALM]\ub2e4\uc774\ud39c\ud0c0\uc5d0\ub9ac\uc2a4\ub9ac\ud2f8\ud5e5\uc0ac\ud558\uc774\ub4dc\ub85d\uc2dc\uc2a4\ud14c\uc544\ub808\uc774\ud2b8/\ud5e5\uc0ac\uc2a4\ud14c\uc544\ub808\uc774\ud2b8/\ud5e5\uc0ac\ub85c\uc9c0\ub124\uc774\ud2b8,\ub9c8\uce74\ub2e4\ubbf8\uc544\uc528\uc624\uc77c\ud3f4\ub9ac\uae00\ub9ac\uc138\ub9b4-6\uc5d0\uc2a4\ud130\uc2a4\ubca0\ud5e4\ub124\uc774\ud2b8,\ud2b8\ub77c\uc774\uc5d0\ud2f8\ud5e5\uc0ac\ub178\uc778,\uc625\ud2f8\ub3c4\ub370\uce78\uc62c,\uc544\uc774\uc18c\ub178\ub2d0\uc544\uc774\uc18c\ub178\ub098\ub178\uc5d0\uc774\ud2b8,\ud558\uc774\ub4dc\ub85c\uc81c\ub124\uc774\ud2f0\ub4dc\ud3f4\ub9ac(C6-14\uc62c\ub808\ud540),\ube44\uc2a4-\ub2e4\uc774\uae00\ub9ac\uc138\ub9b4\ud3f4\ub9ac\uc544\uc2e4\uc544\ub514\ud398\uc774\ud2b8-2,\ud3f4\ub9ac\uae00\ub9ac\uc138\ub9b4-2\ud2b8\ub77c\uc774\uc544\uc774\uc18c\uc2a4\ud14c\uc544\ub808\uc774\ud2b8,\ud2f0\ud0c0\ub284\ub514\uc625\uc0ac\uc774\ub4dc,\ud569\uc131\uc641\uc2a4,\ud3f4\ub9ac\uba54\ud2f8\uc2e4\uc138\uc2a4\ud034\uc625\uc138\uc778,\ub9c8\uc774\ud06c\ub85c\ud06c\ub9ac\uc2a4\ud0c8\ub9b0\uc641\uc2a4,\ub9c8\uc774\uce74,\ud569\uc131\ud50c\ub8e8\uc624\ub974\ud50c\ub85c\uace0\ud30c\uc774\ud2b8,\ud569\uc131\ube44\uc988\uc641\uc2a4,\uc194\ube44\ud0c4\uc544\uc774\uc18c\uc2a4\ud14c\uc544\ub808\uc774\ud2b8,C13-15\uc54c\ucf00\uc778,\uc138\ud2f8\ud53c\uc774\uc9c0/\ud53c\ud53c\uc9c0-10/1\ub2e4\uc774\uba54\ud2f0\ucf58,\ud3f4\ub9ac\uae00\ub9ac\uc138\ub9b4-3\ud3f4\ub9ac\ub9ac\uc2dc\ub180\ub9ac\uc5d0\uc774\ud2b8,\uc801\uc0c9\uc0b0\ud654\ucca0,\uce74\ud504\ub9b4\ub9ad/\uce74\ud504\ub9ad\uae00\ub9ac\uc138\ub77c\uc774\uc988,\uce74\ud504\ub9b4\ub9b4\uae00\ub77c\uc774\ucf5c,\uc2a4\ud14c\uc544\ub9ad\uc560\uc528\ub4dc,\ud1a0\ucf54\ud398\ub9b4\uc544\uc138\ud14c\uc774\ud2b8,\ub2e4\uc774\uba54\ud2f0\ucf58,\uce74\ubbfc,\ub2e4\uc774\uc2a4\ud14c\uc544\ub2e4\uc774\ubaa8\ub284\ud5e5\ud1a0\ub77c\uc774\ud2b8,\ud751\uc0c9\uc0b0\ud654\ucca0,\ud2b8\ub77c\uc774\uc5d0\ud1a1\uc2dc\uce74\ud504\ub9b4\ub9b4\uc2e4\ub808\uc778,\ud1a0\ucf54\ud398\ub864,\ud39c\ud0c0\uc5d0\ub9ac\uc2a4\ub9ac\ud2f8\ud14c\ud2b8\ub77c-\ub2e4\uc774-t-\ubd80\ud2f8\ud558\uc774\ub4dc\ub85d\uc2dc\ud558\uc774\ub4dc\ub85c\uc2e0\ub098\uba54\uc774\ud2b8\n\n[03 \ub77c\ubca4\ub354 \ud50c\ub808\uc800]\n[MATTE BASE]\ub9c8\uc774\uce74,\ud2f0\ud0c0\ub284\ub514\uc625\uc0ac\uc774\ub4dc,\ud5e5\uc2e4\ub77c\uc6b0\ub808\uc774\ud2b8,\ub2e4\uc774\uba54\ud2f0\ucf58,\ub2e4\uc774\uba54\ud2f0\ucf58/\ube44\ub2d0\ub2e4\uc774\uba54\ud2f0\ucf58\ud06c\ub85c\uc2a4\ud3f4\ub9ac\uba38,\ud398\ub2d0\ud2b8\ub77c\uc774\uba54\ud2f0\ucf58,\uc2e4\ub9ac\uce74,\ud3f4\ub9ac\uba54\ud2f8\uc2e4\uc138\uc2a4\ud034\uc625\uc138\uc778,\ub2e4\uc774\ud39c\ud0c0\uc5d0\ub9ac\uc2a4\ub9ac\ud2f8\ud5e5\uc0ac\ud558\uc774\ub4dc\ub85d\uc2dc\uc2a4\ud14c\uc544\ub808\uc774\ud2b8/\ud5e5\uc0ac\uc2a4\ud14c\uc544\ub808\uc774\ud2b8/\ud5e5\uc0ac\ub85c\uc9c0\ub124\uc774\ud2b8,\uce74\ud504\ub9b4\ub9ad/\uce74\ud504\ub9ad\ud2b8\ub77c\uc774\uae00\ub9ac\uc138\ub77c\uc774\ub4dc,\ub2e4\uc774\uba54\ud2f0\ucf58\ud06c\ub85c\uc2a4\ud3f4\ub9ac\uba38,\uba54\ud2f0\ucf58,\uce74\ud504\ub9b4\ub9b4\uae00\ub77c\uc774\ucf5c,\uce74\ubbfc,1,2-\ud5e5\uc0b0\ub2e4\uc774\uc62c,\uc6b8\ud2b8\ub77c\ub9c8\ub9b0,\ud2b8\ub77c\uc774\uc5d0\ud1a1\uc2dc\uce74\ud504\ub9b4\ub9b4\uc2e4\ub808\uc778,\uc54c\ub8e8\ubbf8\ub284\ud558\uc774\ub4dc\ub85d\uc0ac\uc774\ub4dc,\uc801\uc0c9\uc0b0\ud654\ucca0,\ud751\uc0c9\uc0b0\ud654\ucca0.[SHIMMER]\ud569\uc131\ud50c\ub8e8\uc624\ub974\ud50c\ub85c\uace0\ud30c\uc774\ud2b8,\ud2f0\ud0c0\ub284\ub514\uc625\uc0ac\uc774\ub4dc,\ub9c8\uc774\uce74,\ud0e4\ud06c,\ud398\ub2d0\ud2b8\ub77c\uc774\uba54\ud2f0\ucf58,\ud2b8\ub77c\uc774\uc5d0\ud2f8\ud5e5\uc0ac\ub178\uc778,\uc9d5\ud06c\uc2a4\ud14c\uc544\ub808\uc774\ud2b8,\uba54\ud2f8\uba54\ud0c0\ud06c\ub9b4\ub808\uc774\ud2b8\ud06c\ub85c\uc2a4\ud3f4\ub9ac\uba38 ,\ud558\uc774\ub4dc\ub85c\uc81c\ub124\uc774\ud2f0\ub4dc\ud3f4\ub9ac\uc544\uc774\uc18c\ubd80\ud150,\ube44\uc2a4-\ubca0\ud5e4\ub2d0/\uc544\uc774\uc18c\uc2a4\ud14c\uc544\ub9b4/\ud53c\ud1a0\uc2a4\ud14c\ub9b4\ub2e4\uc774\uba38\ub2e4\uc774\ub9ac\ub180\ub808\uc77c\ub2e4\uc774\uba38\ub2e4\uc774\ub9ac\ub180\ub9ac\uc5d0\uc774\ud2b8,\ud3f4\ub9ac\uae00\ub9ac\uc138\ub9b4-2\ud2b8\ub77c\uc774\uc544\uc774\uc18c\uc2a4\ud14c\uc544\ub808\uc774\ud2b8,\ub098\uc77c\ub860-12,\uc5d0\ud2f8\ud5e5\uc2e4\uae00\ub9ac\uc138\ub9b0,\uce74\ubbfc,\ud2b8\ub77c\uc774\uc5d0\ud1a1\uc2dc\uce74\ud504\ub9b4\ub9b4\uc2e4\ub808\uc778,\uae00\ub9ac\uc138\ub9b4\uce74\ud504\ub9b4\ub808\uc774\ud2b8,\uc801\uc0c9\uc0b0\ud654\ucca0,\ud398\ub9ad\ud398\ub85c\uc2dc\uc544\ub098\uc774\ub4dc,\ud2f4\uc625\uc0ac\uc774\ub4dc.[MATTE BALM]\uc544\uc774\uc18c\ub178\ub2d0\uc544\uc774\uc18c\ub178\ub098\ub178\uc5d0\uc774\ud2b8,\uc2e4\ub9ac\uce74,\ud2f0\ud0c0\ub284\ub514\uc625\uc0ac\uc774\ub4dc,\ub2e4\uc774\uc544\uc774\uc18c\uc2a4\ud14c\uc544\ub9b4\ub9d0\ub808\uc774\ud2b8,\ub2e4\uc774\uba54\ud2f0\ucf58,\ud569\uc131\uc641\uc2a4,\ud3f4\ub9ac\uc544\uc774\uc18c\ubd80\ud150,\ub2e4\uc774\uba54\ud2f0\ucf58/\ube44\ub2d0\ub2e4\uc774\uba54\ud2f0\ucf58\ud06c\ub85c\uc2a4\ud3f4\ub9ac\uba38,\ub9c8\uc774\ud06c\ub85c\ud06c\ub9ac\uc2a4\ud0c8\ub9b0\uc641\uc2a4,\ud39c\ud2f8\ub80c\uae00\ub77c\uc774\ucf5c,\uc194\ube44\ud0c4\uc544\uc774\uc18c\uc2a4\ud14c\uc544\ub808\uc774\ud2b8,\uba54\ud2f0\ucf58,\uce74\ubbfc,\uce74\ud504\ub9b4\ub9b4\uae00\ub77c\uc774\ucf5c,\ud669\uc0c9\uc0b0\ud654\ucca0,\uccad\uc0c91\ud638.[MATTE MEDIUM]\ub9c8\uc774\uce74,\ud5e5\uc2e4\ub77c\uc6b0\ub808\uc774\ud2b8,\ud2f0\ud0c0\ub284\ub514\uc625\uc0ac\uc774\ub4dc,\ub2e4\uc774\uba54\ud2f0\ucf58,\ub2e4\uc774\uba54\ud2f0\ucf58/\ube44\ub2d0\ub2e4\uc774\uba54\ud2f0\ucf58\ud06c\ub85c\uc2a4\ud3f4\ub9ac\uba38,\ud398\ub2d0\ud2b8\ub77c\uc774\uba54\ud2f0\ucf58,\uc2e4\ub9ac\uce74,\ud3f4\ub9ac\uba54\ud2f8\uc2e4\uc138\uc2a4\ud034\uc625\uc138\uc778,\ub2e4\uc774\ud39c\ud0c0\uc5d0\ub9ac\uc2a4\ub9ac\ud2f8\ud5e5\uc0ac\ud558\uc774\ub4dc\ub85d\uc2dc\uc2a4\ud14c\uc544\ub808\uc774\ud2b8/\ud5e5\uc0ac\uc2a4\ud14c\uc544\ub808\uc774\ud2b8/\ud5e5\uc0ac\ub85c\uc9c0\ub124\uc774\ud2b8,\uce74\ud504\ub9b4\ub9ad/\uce74\ud504\ub9ad\ud2b8\ub77c\uc774\uae00\ub9ac\uc138\ub77c\uc774\ub4dc,\ub2e4\uc774\uba54\ud2f0\ucf58\ud06c\ub85c\uc2a4\ud3f4\ub9ac\uba38,\uce74\ubbfc,\uc6b8\ud2b8\ub77c\ub9c8\ub9b0,\uba54\ud2f0\ucf58,\uce74\ud504\ub9b4\ub9b4\uae00\ub77c\uc774\ucf5c,1,2-\ud5e5\uc0b0\ub2e4\uc774\uc62c,\uc801\uc0c9\uc0b0\ud654\ucca0,\ud2b8\ub77c\uc774\uc5d0\ud1a1\uc2dc\uce74\ud504\ub9b4\ub9b4\uc2e4\ub808\uc778,\uc54c\ub8e8\ubbf8\ub284\ud558\uc774\ub4dc\ub85d\uc0ac\uc774\ub4dc,\ud751\uc0c9\uc0b0\ud654\ucca0.[GLITTER]\uce7c\uc298\ud2f0\ud0c0\ub284\ubcf4\ub85c\uc2e4\ub9ac\ucf00\uc774\ud2b8,\ub2e4\uc774\ud398\ub2d0\uc2e4\ub85d\uc2dc\ud398\ub2d0\ud2b8\ub77c\uc774\uba54\ud2f0\ucf58,\uce7c\uc298\uc54c\ub8e8\ubbf8\ub284\ubcf4\ub85c\uc2e4\ub9ac\ucf00\uc774\ud2b8,\ud3f4\ub9ac\ud504\ub85c\ud544\ub80c,\ube44\uc2a4-\ubca0\ud5e4\ub2d0/\uc544\uc774\uc18c\uc2a4\ud14c\uc544\ub9b4/\ud53c\ud1a0\uc2a4\ud14c\ub9b4\ub2e4\uc774\uba38\ub2e4\uc774\ub9ac\ub180\ub808\uc77c\ub2e4\uc774\uba38\ub2e4\uc774\ub9ac\ub180\ub9ac\uc5d0\uc774\ud2b8,\ub9c8\uc774\uce74,\ud2f0\ud0c0\ub284\ub514\uc625\uc0ac\uc774\ub4dc,\ube44\uc2a4-\ub2e4\uc774\uae00\ub9ac\uc138\ub9b4\ud3f4\ub9ac\uc544\uc2e4\uc544\ub514\ud398\uc774\ud2b8-2,\ud3f4\ub9ac\uae00\ub9ac\uc138\ub9b4-2\ud2b8\ub77c\uc774\uc544\uc774\uc18c\uc2a4\ud14c\uc544\ub808\uc774\ud2b8,\uce74\ud504\ub9b4\ub9ad/\uce74\ud504\ub9ad\ud2b8\ub77c\uc774\uae00\ub9ac\uc138\ub77c\uc774\ub4dc,\uc54c\ub8e8\ubbf8\ub284\uc804\ubd84\uc625\ud14c\ub2d0\uc11d\uc2dc\ub124\uc774\ud2b8,\ud3f4\ub9ac\uba54\ud2f8\uc2e4\uc138\uc2a4\ud034\uc625\uc138\uc778,\ud558\uc774\ub4dc\ub85c\uc81c\ub124\uc774\ud2f0\ub4dc\uc720\ucc44\uc528\uc624\uc77c,\uc2e4\ub9ac\uce74,\uc5d0\ud2f8\ud5e5\uc2e4\uae00\ub9ac\uc138\ub9b0,\ud2f4\uc625\uc0ac\uc774\ub4dc,\uae00\ub9ac\uc138\ub9b4\uce74\ud504\ub9b4\ub808\uc774\ud2b8,\uc801\uc0c9\uc0b0\ud654\ucca0,\uce74\ubbfc,\ud398\ub9ad\ud398\ub85c\uc2dc\uc544\ub098\uc774\ub4dc.[GLOW BALM]\ub2e4\uc774\ud39c\ud0c0\uc5d0\ub9ac\uc2a4\ub9ac\ud2f8