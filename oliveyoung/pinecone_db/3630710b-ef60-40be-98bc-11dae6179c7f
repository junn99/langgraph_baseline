ud5e5\uc2e4\uae00\ub9ac\uc138\ub9b0, \ud5a5\ub8cc, \ub9ac\ub0a0\ub8f0, \uc801\uc0c9\uc0b0\ud654\ucca0 (CI 77491), \uc801\uc0c9226\ud638 (CI 73360), \ud669\uc0c9\uc0b0\ud654\ucca0 (CI 77492), \ud751\uc0c9\uc0b0\ud654\ucca0 (CI 77499)\n\n[11\ud638 \ub7f0\ub358 \ube0c\ub77c\uc6b4 \ube14\ub7ec\ub9c1 \uae30\ud68d]\n\ub9c8\uc774\uce74,\ud0e4\ud06c,\ub2e4\uc774\uba54\ud2f0\ucf58,\ud2f0\ud0c0\ub284\ub514\uc625\uc0ac\uc774\ub4dc,\ub2e4\uc774\uc544\uc774\uc18c\uc2a4\ud14c\uc544\ub9b4\ub9d0\ub808\uc774\ud2b8,\ub2e4\uc774\ud398\ub2d0\uc2e4\ub85d\uc2dc\ud398\ub2d0\ud2b8\ub77c\uc774\uba54\ud2f0\ucf58,\ub2e4\uc774\uba54\ud2f0\ucf58\ud06c\ub85c\uc2a4\ud3f4\ub9ac\uba38,\ud558\uc774\ub4dc\ub85c\uc81c\ub124\uc774\ud2f0\ub4dc\ud3f4\ub9ac(C6-14\uc62c\ub808\ud540),\ub2e4\uc774\uba54\ud2f0\ucf58/\ube44\ub2d0\ub2e4\uc774\uba54\ud2f0\ucf58\ud06c\ub85c\uc2a4\ud3f4\ub9ac\uba38,\uc194\ube44\ud0c4\uc62c\ub9ac\ubca0\uc774\ud2b8,\uc63b\ub098\ubb34\uaecd\uc9c8\uc641\uc2a4,\uba54\ud2f0\ucf58,\uc801\uc0c9\uc0b0\ud654\ucca0,\ud669\uc0c9\uc0b0\ud654\ucca0,\uc54c\ub8e8\ubbf8\ub284\ubbf8\ub9ac\uc2a4\ud14c\uc774\ud2b8,1,2-\ud5e5\uc0b0\ub2e4\uc774\uc62c,\ud669\uc0c94\ud638,\ud398\ub179\uc2dc\uc5d0\ud0c4\uc62c,\ud751\uc0c9\uc0b0\ud654\ucca0,\uc54c\ub8e8\ubbf8\ub284\ud558\uc774\ub4dc\ub85d\uc0ac\uc774\ub4dc,\uc801\uc0c9226\ud638,\uc2e4\ub9ac\uce74,\ud1a0\ucf54\ud398\ub864\n\n[12\ud638 \ud074\ub798\uc2dd \ube0c\ub77c\uc6b4 \uae30\ud68d]\n\ub9c8\uc774\uce74,\ud0e4\ud06c,\ub2e4\uc774\uba54\ud2f0\ucf58,\ud2f0\ud0c0\ub284\ub514\uc625\uc0ac\uc774\ub4dc,\ub2e4\uc774\uc544\uc774\uc18c\uc2a4\ud14c\uc544\ub9b4\ub9d0\ub808\uc774\ud2b8,\ub2e4\uc774\ud398\ub2d0\uc2e4\ub85d\uc2dc\ud398\ub2d0\ud2b8\ub77c\uc774\uba54\ud2f0\ucf58,\ub2e4\uc774\uba54\ud2f0\ucf58\ud06c\ub85c\uc2a4\ud3f4\ub9ac\uba38,\ud558\uc774\ub4dc\ub85c\uc81c\ub124\uc774\ud2f0\ub4dc\ud3f4\ub9ac(C6-14\uc62c\ub808\ud540),\ub2e4\uc774\uba54\ud2f0\ucf58/\ube44\ub2d0\ub2e4\uc774\uba54\ud2f0\ucf58\ud06c\ub85c\uc2a4\ud3f4\ub9ac\uba38,\uc194\ube44\ud0c4\uc62c\ub9ac\ubca0\uc774\ud2b8,\uc63b\ub098\ubb34\uaecd\uc9c8\uc641\uc2a4,\uc801\uc0c9\uc0b0\ud654\ucca0,\uba54\ud2f0\ucf58,\uc54c\ub8e8\ubbf8\ub284\ubbf8\ub9ac\uc2a4\ud14c\uc774\ud2b8,1,2-\ud5e5\uc0b0\ub2e4\uc774\uc62c,\ud751\uc0c9\uc0b0\ud654\ucca0,\ud398\ub179\uc2dc\uc5d0\ud0c4\uc62c,\ud669\uc0c94\ud638,\uc54c\ub8e8\ubbf8\ub284\ud558\uc774\ub4dc\ub85d\uc0ac\uc774\ub4dc,\uc801\uc0c9226\ud638,\uc2e4\ub9ac\uce74,\ud1a0\ucf54\ud398\ub864\n\n[11\ud638 \ub7f0\ub358 \ube0c\ub77c\uc6b4 \ube14\ub7ec\ub9c1 \ub2e8\ud488]\n[\ud50c\ub808\uc778]\ud0e4\ud06c,\ud569\uc131\ud50c\ub8e8\uc624\ub974\ud50c\ub85c\uace0\ud30c\uc774\ud2b8,\ud2f0\ud0c0\ub284\ub514\uc625\uc0ac\uc774\ub4dc (CI 77891),\ub9c8\uc774\uce74 (CI 77019),\ub124\uc624\ud39c\ud2f8\uae00\ub77c\uc774\ucf5c\ub2e4\uc774\uc5d0\ud2f8\ud5e5\uc0ac\ub178\uc5d0\uc774\ud2b8,\uc2e4\ub9ac\uce74,\ud398\ub2d0\ud2b8\ub77c\uc774\uba54\ud2f0\ucf58,\ub2e4\uc774\ud39c\ud0c0\uc5d0\ub9ac\uc2a4\ub9ac\ud2f8\ud5e5\uc0ac\ud558\uc774\ub4dc\ub85d\uc2dc\uc2a4\ud14c\uc544\ub808\uc774\ud2b8/\ud5e5\uc0ac\uc2a4\ud14c\uc544\ub808\uc774\ud2b8/\ud5e5\uc0ac\ub85c\uc9c0\ub124\uc774\ud2b8,\ub2e4\uc774\uc544\uc774\uc18c\uc2a4\ud14c\uc544\ub9b4\ub9d0\ub808\uc774\ud2b8,\uc544\uc774\uc18c\uc2a4\ud14c\uc544\ub9b4\ub124\uc624\ud39c\ud0c0\ub178\uc5d0\uc774\ud2b8,\uc625\ud2f8\ub3c4\ub370\uc2e4\uc2a4\ud14c\uc544\ub85c\uc77c\uc2a4\ud14c\uc544\ub808\uc774\ud2b8,\uc801\uc0c9\uc0b0\ud654\ucca0 (CI 77491),\ub9c8\uce74\ub2e4\ubbf8\uc544\uc528\uc624\uc77c,\ub9c8\uadf8\ub124\uc298\ubbf8\ub9ac\uc2a4\ud14c\uc774\ud2b8,\uba54\ud2f8\ud504\ub85c\ud310\ub2e4\uc774\uc62c,\ub2e4\uc774\uba54\ud2f0\ucf58,\ub9c8\uadf8\ub124\uc298\uc2a4\ud14c\uc544\ub808\uc774\ud2b8,\ud2b8\ub77c\uc774\uc5d0\ud1a1\uc2dc\uce74\ud504\ub9b4\ub9b4\uc2e4\ub808\uc778,\ud3f4\ub9ac\ubd80\ud150,\ud504\ub85c\ud310\ub2e4\uc774\uc62c,\ub2e4\uc774\uba54\ud2f0\ucf58\uc62c\uc2a4\ud14c\uc544\ub808\uc774\ud2b8,\ub098\uc77c\ub860-12,\uc54c\ub8e8\ubbf8\ub284\ud558\uc774\ub4dc\ub85d\uc0ac\uc774\ub4dc,\uba54\ud2f0\ucf58,\ud2f4\uc625