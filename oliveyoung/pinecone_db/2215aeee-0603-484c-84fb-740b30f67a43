{"lc": 1, "type": "constructor", "id": ["langchain", "schema", "document", "Document"], "kwargs": {"metadata": {"name": "[\ud734\ub300\uc6a9\uae30&\ube14\ub80c\ub529\ud37c\ud504 \uc99d\uc815] \uc9c0\ubca0\ub974\ub2c8 \ubc00\ucc29 \ucee4\ubc84 \ud30c\uc6b4\ub370\uc774\uc158 30ml (\ub2e8\ud488/\uae30\ud68d)", "brand": "\uc9c0\ubca0\ub974\ub2c8", "category": ["\uba54\uc774\ud06c\uc5c5", "\ubca0\uc774\uc2a4\uba54\uc774\ud06c\uc5c5", "\ud30c\uc6b4\ub370\uc774\uc158"], "price": 33000, "volume": "30ml", "manufacturer": "\ud55c\uad6d\ucf5c\ub9c8\u321c / (\uc8fc)\ube44\uc564\uc5d0\uc774\uce58\ucf54\uc2a4\uba54\ud2f1", "review": "## \uc9c0\ubca0\ub974\ub2c8 \ubc00\ucc29 \ucee4\ubc84 \ud30c\uc6b4\ub370\uc774\uc158 \ub9ac\ubdf0 \ubd84\uc11d \ubc0f \uc131\uc7a5 \uc804\ub7b5 \ubcf4\uace0\uc11c\n\n**\ubcf4\uace0\uc11c \ubaa9\uc801:** \ubcf8 \ubcf4\uace0\uc11c\ub294 [\ud734\ub300\uc6a9\uae30&\ube14\ub80c\ub529\ud37c\ud504 \uc99d\uc815] \uc9c0\ubca0\ub974\ub2c8 \ubc00\ucc29 \ucee4\ubc84 \ud30c\uc6b4\ub370\uc774\uc158 30ml (\ub2e8\ud488/\uae30\ud68d) \uc81c\ud488\uc5d0 \ub300\ud55c \uc0ac\uc6a9\uc790 \ub9ac\ubdf0 \ub370\uc774\ud130\ub97c \uc885\ud569\uc801\uc73c\ub85c \ubd84\uc11d\ud558\uc5ec \uc81c\ud488\uc758 \uc2e4\ud328 \uc6d0\uc778\uc744 \ud30c\uc545\ud558\uace0, \uc774\ub97c \uae30\ubc18\uc73c\ub85c \uc81c\ud488 \uac1c\uc120, \uc0c8\ub85c\uc6b4 \uc2dc\uc7a5 \uae30\ud68c \ud3ec\ucc29, \ube0c\ub79c\ub4dc \uc2e0\ub8b0\ub3c4 \ud68c\ubcf5\uc744 \uc704\ud55c \uad6c\uccb4\uc801\uc778 \uc131\uc7a5 \uc804\ub7b5\uc744 \uc81c\uc2dc\ud558\ub294 \uac83\uc744 \ubaa9\ud45c\ub85c \ud569\ub2c8\ub2e4.\n\n### \ud575\uc2ec \uc694\uc57d (Executive Summary)\n\n\uc9c0\ubca0\ub974\ub2c8 \ubc00\ucc29 \ucee4\ubc84 \ud30c\uc6b4\ub370\uc774\uc158\uc740 \ub9ce\uc740 \uc0ac\uc6a9\uc790\ub4e4\uc5d0\uac8c '\ubc00\ucc29\ub825'\uacfc '\uc0c9\uc0c1' \uce21\uba74\uc5d0\uc11c \uae0d\uc815\uc801\uc778 \ud3c9\uac00\ub97c \ubc1b\uc558\uc73c\ub098, **'\uc2ec\uac01\ud55c \ub2e4\ud06c\ub2dd', '\ub4e4\ub738 \ubc0f \uac01\uc9c8 \ubd80\uac01', '\ud2b8\ub7ec\ube14 \uc720\ubc1c \uac00\ub2a5\uc131'**\uc774\ub77c\ub294 \uce58\uba85\uc801\uc778 \ub2e8\uc810\uc73c\ub85c \uc778\ud574 \uc804\ubc18\uc801\uc778 \uc0ac\uc6a9\uc790 \ub9cc\uc871\ub3c4\uac00 \uc800\ud558\ub418\uace0 \uc7ac\uad6c\ub9e4 \uc758\uc0ac\uac00 \ub0ae\uac8c \ub098\ud0c0\ub0ac\uc2b5\ub2c8\ub2e4. \ud2b9\ud788 '\ub9ac\uc624' \uc0ac\uc6a9\uc790\uc758 \ub9ac\ubdf0('helpful_count': 175)\ub294 \uc774\ub7ec\ud55c \ubb38\uc81c\uc810\uc744 \uac00\uc7a5 \uba85\ud655\ud558\uac8c \ubcf4\uc5ec\uc8fc\uba70, \uc774\ub294 \ub2e8\uc21c\ud788 \uac1c\uc778\uc801\uc778 \uacbd\ud5d8\uc744 \ub118\uc5b4 \uc81c\ud488\uc758 \uadfc\ubcf8\uc801\uc778 \uc131\ub2a5 \ubc0f \uc131\ubd84 \uc774\uc288\ub97c \uc2dc\uc0ac\ud569\ub2c8\ub2e4.\n\n\uac00\uc7a5 \uc2dc\uae09\ud558\uac8c \uac1c\uc120\ud574\uc57c \ud560 \ud575\uc2ec \ubb38\uc81c\uc810\uc740 **\u2460 \uc2ec\uac01\ud55c \ub2e4\ud06c\ub2dd \ud604\uc0c1, \u2461 \ub4e4\ub738 \ubc0f \uac01\uc9c8 \ubd80\uac01, \u2462 \ubbfc\uac10\uc131 \ud53c\ubd80 \ud2b8\ub7ec\ube14 \uc720\ubc1c \uac00\ub2a5\uc131**\uc73c\ub85c \ud30c\uc545\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \uc774 \ubb38\uc81c\uc810\ub4e4\uc740 \ud2b9\ud788 **\ubbfc\uac10\uc131 \ud53c\ubd80**\ub97c \uac00\uc9c4 \uc0ac\uc6a9\uc790\ub4e4\uc5d0\uac8c \ub354\uc6b1 \ub450\ub4dc\ub7ec\uc9c0\uac8c \ub098\ud0c0\ub098\uace0 \uc788\uc73c\uba70, \uc774\ub294 \ud574\ub2f9 \ud0c0\uac9f \uadf8\ub8f9\uc758 \ub9cc\uc871\ub3c4\ub97c \uc800\ud574\ud558\ub294 \uc8fc\uc694 \uc694\uc778\uc785\ub2c8\ub2e4.\n\n\uc774\ub7ec\ud55c \ubd84\uc11d\uc744 \ubc14\ud0d5\uc73c\ub85c, \ubcf8 \ubcf4\uace0\uc11c\ub294 \ud3ec\ubbac\ub7ec \uac1c\uc120, \ud0c0\uac9f \ub9c8\ucf00\ud305 \uac15\ud654, \uadf8\ub9ac\uace0 \uba85\ud655\ud55c \uac00\uce58 \uc81c\uc548 \uc7ac\uc815\ub9bd\uc744 \ud3ec\ud568\ud558\ub294 \ub2e4\uac01\uc801\uc778 \uc131\uc7a5 \uc804\ub7b5\uc744 \uc81c\uc548\ud569\ub2c8\ub2e4. \uc774\ub97c \ud1b5\ud574 \ud604\uc7ac \uc81c\ud488\uc758 \uc2e4\ud328\ub97c \uc131\uc7a5 \ub3d9\ub825\uc73c\ub85c \uc804\ud658\ud558\uace0 \ube0c\ub79c\ub4dc\uc5d0 \ub300\ud55c \uc2e0\ub8b0\ub97c \ud68c\ubcf5\ud560 \uc218 \uc788\uc744 \uac83\uc785\ub2c8\ub2e4.\n\n### \uc0c1\uc138 \ubd84\uc11d \ubc0f \uc6b0\uc120\uc21c\uc704 (Detailed Analysis & Prioritization)\n\n\ubd80\uc815 \ub9ac\ubdf0 \ub370\uc774\ud130\ub97c \ubc14\ud0d5\uc73c\ub85c \uc81c\ud488\uc758 \ud575\uc2ec \ubb38\uc81c\uc810\uc744 \ubd84\ub958\ud558\uace0, 'helpful_count'\ub97c \uae30\uc900\uc73c\ub85c \uc0ac\uc6a9\uc790\ub4e4\uc758 \uacf5\uac10\ub3c4 \ubc0f \ubb38\uc81c\uc758 \uc2ec\uac01\uc131\uc744 \ud30c\uc545\ud558\uc5ec \uc6b0\uc120\uc21c\uc704\ub97c \ub3c4\ucd9c\ud588\uc2b5\ub2c8\ub2e4.\n\n**1. \uc81c\ud615 \ubc0f \uc0ac\uc6a9\uac10 \uc601\uc5ed:**\n\n*   **\ub4e4\ub738 \ubc0f \uac01\uc9c8 \ubd80\uac01:** '\ub85c\uba54\uc778' (helpful: 2), '\ud654\uc7a5\ud488\uc740\uc131\ubd84\uc774\ub2f5\uc774\ub2e4' (helpful: 18, 8), '\ub9ac\ub85c' (helpful: 175), '\ub77c\uc720\ub2c8' (helpful: 4), '\uac1c\uad74\uac1c\uad74' (helpful: 1) \ub4f1 \ub2e4\uc218\uc758 \uc0ac\uc6a9\uc790\uac00 \uac01\uc9c8 \ubd80\uac01 \ubc0f \ud53c\ubd80 \ub4e4\ub738 \ud604\uc0c1\uc744 \uc9c0\uc801\ud588\uc2b5\ub2c8\ub2e4. \uc774\ub294 \uac74\uc870\ud558\uac70\ub098 \uac01\uc9c8\uc774 \uc788\ub294 \ud53c\ubd80 \uc0c1\ud0dc\uc5d0\uc11c \uc81c\ud488 \uc0ac\uc6a9 \uc2dc \ub354\uc6b1 \ub450\ub4dc\ub7ec\uc9c0\uba70, \uc0ac\uc6a9\uac10\uc774 \ub9cc\uc871\uc2a4\ub7fd\uc9c0 \ubabb\ud55c \uc8fc\uc694 \uc6d0\uc778 \uc911 \ud558\ub098\uc785\ub2c8\ub2e4.\n*   **\ub9e4\ud2b8\ud568 \ubc0f \uac74\uc870\ud568:** '\ud55c\uc5ec\ub984\ubcc4', 'y4k', '\ubbfc\uaf41min', '\uac1c\uad74\uac1c\uad74', '\uc624\uc774', 'p02****' \ub4f1 \uc5ec\ub7ec \uc0ac\uc6a9\uc790\uac00 \uc81c\ud488\uc758 \ub9e4\ud2b8\ud55c \uc81c\ud615\uacfc \uac74\uc870\ud568\uc744 \uc5b8\uae09\ud588\uc2b5\ub2c8\ub2e4. \ud2b9\ud788 \uac74\uc131 \ud53c\ubd80 \uc0ac\uc6a9\uc790\ub4e4\uc5d0\uac8c\uc11c \uc774\ub7ec\ud55c \ud53c\ub4dc\ubc31\uc774 \ub450\ub4dc\ub7ec\uc838, \uc81c\ud488\uc774 \uac74\uc870\ud55c \ud53c\ubd80\uc5d0 \uc801\ud569\ud558\uc9c0 \uc54a\uc74c\uc744 \uc2dc\uc0ac\ud569\ub2c8\ub2e4.\n*   **\uc0ac\uc6a9 \uc5b4\ub824\uc6c0 \ubc0f \ubb49\uce68:** '\ub9ac\ub85c' (helpful: 175) \uc0ac\uc6a9\uc790\ub294 \ubbf8\uac04, \ucf54 \uc606, \uc778\uc911 \ubd80\ubd84\uc5d0\uc11c\uc758 \ud30c\ub370 \ubb49\uce68 \ubc0f \ub4e4\ub738 \ud604\uc0c1\uc744 \uac15\ud558\uac8c \uc9c0\uc801\ud588\uc73c\uba70, '\ud654\uc7a5\ud488\uc740\uc131\ubd84\uc774\ub2f5\uc774\ub2e4' (helpful: 18) \uc5ed\uc2dc \ub07c\uc784\uacfc \uc794\uc8fc\ub984, \uc785\uac00 \uac74\uc870\ud568\uc744 \uc5b8\uae09\ud588\uc2b5\ub2c8\ub2e4. \uc774\ub294 \uc81c\ud488\uc758 \uc81c\ud615\uc774 \ud2b9\uc815 \ubd80\uc704\uc5d0 \uace0\ub974\uac8c \ubc00\ucc29\ub418\uc9c0 \uc54a\uace0 \ubb49\uce58\ub294 \uad6c\uc870\uc801 \ubb38\uc81c\ub97c \uac00\uc9c0\uace0 \uc788\uc74c\uc744 \ub098\ud0c0\ub0c5\ub2c8\ub2e4.\n\n**2. \uc131\ub2a5 \ubc0f \ud6a8\uacfc \uc601\uc5ed:**\n\n*   **\uc2ec\uac01\ud55c \ub2e4\ud06c\ub2dd:** '\uc720\ubaa9\ubbfc2' (helpful: 0), '\ub8e8\ud53c\ubd95\uc5b4\ube75' (helpful: 1), 'taeye****' (helpful: 2), '\uac00\ubbd0' (helpful: 0), '\uc911\ub3c5\uc911\ub3c5\uc790' (helpful: 8), '\ubd80\uc0b0\ub9b0\u20dd\uac00\ub9c1' (helpful: 16), '\uc591\ud30c\ub9c1\uac00\ub9c1' (helpful: 0) \ub4f1 \ub9ce\uc740 \uc0ac\uc6a9\uc790\uac00 \uc2ec\uac01\ud55c \ub2e4\ud06c\ub2dd \ud604\uc0c1\uc744 \uacbd\ud5d8\ud588\ub2e4\uace0 \ubc1d\ud614\uc2b5\ub2c8\ub2e4. \ud2b9\ud788 '\uc911\ub3c5\uc911\ub3c5\uc790' \uc0ac\uc6a9\uc790\ub294 \"\ub098\uac08 \ub54c\ub294 19\ud638 \ub3cc\uc544\uc62c \ub54c\ub294 25\ud638\"\ub77c\ub294 \ud45c\ud604\uc73c\ub85c \uadf8 \uc2ec\uac01\uc131\uc744 \uc804\ub2ec\ud588\uc73c\uba70, \uc774\ub294 \uc81c\ud488\uc758 \uceec\ub7ec \uc720\uc9c0\ub825\uc5d0 \ub300\ud55c \uadfc\ubcf8\uc801\uc778 \ubb38\uc81c\ub97c \uc2dc\uc0ac\ud569\ub2c8\ub2e4.\n*   **\uc9c0\uc18d\ub825 \ubd80\uc871 \ubc0f \ubb34\ub108\uc9d0:** '\ud55c\uc5ec\ub984\ubcc4', '\ub8e8\ud53c\ubd95\uc5b4\ube75', 'y4k', 'kissm****', 'taeye****', '9ucci', '\uc0e4\uc0ac\uc9f1', '\ucc44\ub9ac\ubdf0' \ub4f1 \uc0c1\ub2f9\uc218\uc758 \uc0ac\uc6a9\uc790\uac00 \uc608\uc0c1\ubcf4\ub2e4 \uc9e7\uc740 \uc9c0\uc18d\ub825\uacfc \uc608\uc058\uc9c0 \uc54a\uc740 \ubb34\ub108\uc9d0\uc744 \uacbd\ud5d8\ud588\ub2e4\uace0 \uc5b8\uae09\ud588\uc2b5\ub2c8\ub2e4. \ud2b9\ud788 'taeye****' \uc0ac\uc6a9\uc790\ub294 \uccb4\uc721 \uc2dc\uac04 \ud6c4 \uac70\uc758 \uc9c0\uc6cc\uc9c4 \uc218\uc900\uc774\ub77c\uace0 \ud45c\ud604\ud588\uc73c\uba70, '9ucci' \uc0ac\uc6a9\uc790\ub294 30\ubd84 \ud6c4 \uae30\ub984\uc774 \uc62c\ub77c\uc624\uace0 \ud53c\ubd80\uac00 \ubc97\uaca8\uc9c4\ub2e4\uace0 \uc9c0\uc801\ud588\uc2b5\ub2c8\ub2e4. \uc774\ub294 \uc81c\ud488\uc758 \ubc00\ucc29\ub825\uc774 \ucd08\ubc18\uc5d0\ub294 \uc88b\ub354\ub77c\ub3c4 \uc7a5\uc2dc\uac04 \uc720\uc9c0\ub418\uc9c0 \ubabb\ud558\uba70, \uc2dc\uac04\uc774 \uc9c0\ub0a8\uc5d0 \ub530\ub77c \ud53c\ubd80 \uc694\ucca0\uc774\ub098 \ubaa8\uacf5\uc744 \ubd80\uac01\uc2dc\ud0a4\uba70 \ubb34\ub108\uc9c0\ub294 \ud328\ud134\uc744 \ubcf4\uc778\ub2e4\ub294 \uac83\uc744 \uc758\ubbf8\ud569\ub2c8\ub2e4.\n\n**3. \uc2e0\uccb4\uc801/\uc0dd\ub9ac\uc801 \ubc18\uc751 \uc601\uc5ed:**\n\n*   **\ud2b8\ub7ec\ube14 \uc720\ubc1c \ubc0f \uc790\uadf9:** 'gayoun****' (helpful: 2), 'taeye****' (helpful: 2), '\ubbc0\ub77c\ub9c8' (helpful: 3), 'p02****' (helpful: 0), '\ubc31\uc218\ud638\uc18c\uc778' (helpful: 0), 'siyoon****' (helpful: 0) \ub4f1 \uc77c\ubd80 \uc0ac\uc6a9\uc790\ub294 \uc81c\ud488 \uc0ac\uc6a9 \ud6c4 \ud53c\ubd80 \ud2b8\ub7ec\ube14, \ubd89\uc5b4\uc9d0, \uac00\ub824\uc6c0\uc99d, \ub530\uac00\uc6c0 \ub4f1\uc758 \ubbfc\uac10\ud55c \ubc18\uc751\uc744 \uacbd\ud5d8\ud588\ub2e4\uace0 \ubc1d\ud614\uc2b5\ub2c8\ub2e4. \ud2b9\ud788 'gayoun****'\uc640 '\ubc31\uc218\ud638\uc18c\uc778' \uc0ac\uc6a9\uc790\ub294 \uc81c\ud488 \uc0ac\uc6a9 \ud6c4 \ud53c\ubd80\uac00 \ub4a4\uc9d1\uc5b4\uc84c\ub2e4\uace0 \uc5b8\uae09\ud558\uba70, \ubbfc\uac10\uc131 \ud53c\ubd80 \uc0ac\uc6a9\uc790\uc5d0\uac8c\ub294 \uce58\uba85\uc801\uc778 \ubb38\uc81c\uc810\uc73c\ub85c \uc791\uc6a9\ud560 \uc218 \uc788\uc74c\uc744 \uc2dc\uc0ac\ud569\ub2c8\ub2e4. 'taeye****' \uc0ac\uc6a9\uc790\ub294 '\uc131\ubd84\uc774 \uc88b\uc740 \ud3b8\uc740 \uc544\ub2cc\ub4ef\ud558\ub2e4'\uace0 \uc9c1\uc811\uc801\uc73c\ub85c \uc5b8\uae09\ud588\uc2b5\ub2c8\ub2e4.\n\n**4. \ud3ec\uc7a5 \ubc0f \uc0ac\uc6a9 \ud3b8\uc758\uc131 \uc601\uc5ed:**\n\n*   \uc99d\uc815\uc6a9\uc73c\ub85c \uc81c\uacf5\ub41c \ube0c\ub7ec\uc26c\uc5d0 \ub300\ud55c \ubd88\ub9cc\uc871\uc774 \uc77c\ubd80 \uc874\uc7ac\ud588\uc2b5\ub2c8\ub2e4. ('\ucc44\ub9ac\ubdf0' - \"\ube0c\ub7ec\uc26c \uae30\ub2a5 \ubabb \ud55c\ub2e4\", '\ub77c\uc784\uadf8\ub9b0' - \"\ubd93\uc740 \ub2e4\ub978 \uc6a9\ub3c4\ub85c \uc4f8\uae4c \uc2f6\ub2e4\"). \ud558\uc9c0\ub9cc \uc774\ub294 \ubcf8 \uc81c\ud488 \uc790\uccb4\uc758 \ud575\uc2ec \ubb38\uc81c\uc810\uc774\ub77c\uae30\ubcf4\ub2e4\ub294 \uc99d\uc815\ud488\uc5d0 \ub300\ud55c \uc544\uc26c\uc6c0\uc73c\ub85c \ud310\ub2e8\ub429\ub2c8\ub2e4.\n\n**5. \uac00\uce58 \ubc0f \uc804\ubc18\uc801 \uc778\uc2dd \uc601\uc5ed:**\n\n*   **\ub192\uc740 \uac00\uaca9 \ub300\ube44 \ub9cc\uc871\ub3c4 \uc800\ud558:** '\uc720\ubaa9\ubbfc2' (helpful: 0) \uc0ac\uc6a9\uc790\ub294 \"\uc774 \uac00\uaca9\uc5d0 \uad73\uc774? \uc2f6\ub2e4\"\uace0 \uc5b8\uae09\ud588\uc73c\uba70, '\ud654\uc7a5\ud488\uc740\uc131\ubd84\uc774\ub2f5\uc774\ub2e4' (helpful: 8) \uc0ac\uc6a9\uc790 \ub610\ud55c \"\uc9c0\ubca0\ub974\ub2c8\ub294 \uac00\uaca9\uc774 \ube44\uc2f8\uc11c \uc7ac\uad6c\ub9e4\ub294 \uc548 \ud558\uaca0\ub2e4. \ube44\uc2b7\ud55c \uc131\ubd84\ub4e4 \uc694\uc0c8 \ub9cc\uc6d0\ub300 \ub108\ubb34 \ub9ce\ub2e4\"\uace0 \uc9c0\uc801\ud588\uc2b5\ub2c8\ub2e4. \uc774\ub294 \uc81c\ud488\uc758 \uc131\ub2a5 \ub300\ube44 \uac00\uaca9 \uacbd\uc7c1\ub825\uc774 \ubd80\uc871\ud558\ub2e4\ub294 \uc778\uc2dd\uc744 \ubcf4\uc5ec\uc90d\ub2c8\ub2e4.\n*   **\uacfc\uc7a5\ub41c \uad11\uace0 \ub610\ub294 \uae30\ub300 \ubd88\uc77c\uce58:** '\ud55c\uc5ec\ub984\ubcc4' (helpful: 0) \uc0ac\uc6a9\uc790\ub294 \uacfc\uac70 \uc0d8\ud50c \uc0ac\uc6a9 \uacbd\ud5d8\uc774 \uc88b\uc544 \uad6c\ub9e4\ud588\uc9c0\ub9cc \uae30\ub300\uc5d0 \ubbf8\uce58\uc9c0 \ubabb\ud588\ub2e4\uace0 \uc5b8\uae09\ud588\uc73c\uba70, '\ucf69\ucf54\uc624\uc624\uc63c\uc639\ucf69' (helpful: 0) \uc0ac\uc6a9\uc790\ub294 \"\uc65c \uc774\ub807\uac8c\uae4c\uc9c0 \uc778\uae30\uac00 \ub9ce\uc740\uc9c0 \ubaa8\ub974\uaca0\ub2e4\"\uace0 \ubc1d\ud788\uba70 \uad11\uace0\ub098 \uc785\uc18c\ubb38\uacfc \uc2e4\uc81c \uacbd\ud5d8 \uc0ac\uc774\uc758 \uad34\ub9ac\uac00 \uc788\uc74c\uc744 \uc2dc\uc0ac\ud569\ub2c8\ub2e4.\n\n---\n\n**1-B. '\ub3c4\uc6c0\ub3fc\uc694' \uc9c0\ud45c\ub97c \ud65c\uc6a9\ud55c \ud575\uc2ec \ubb38\uc81c \uc6b0\uc120\uc21c\uc704\ud654**\n\n\uc885\ud569\uc801\uc778 \ub9ac\ubdf0 \ubd84\uc11d \uacb0\uacfc, \ub2e4\uc74c\uacfc \uac19\uc774 \uc138 \uac00\uc9c0 \ud575\uc2ec \ubb38\uc81c\uc810\uc744 \uc6b0\uc120\uc21c\uc704 1\uc21c\uc704\ub85c \uc120\uc815\ud569\ub2c8\ub2e4.\n\n1.  **\uc2ec\uac01\ud55c \ub2e4\ud06c\ub2dd \ubc0f \uceec\ub7ec \ubcc0\ud654 (\uac00\uc7a5 \ub192\uc740 \uacf5\uac10\ub3c4 \ubc0f \ube48\ub3c4):** '\ub9ac\ub85c' (175), '\uc911\ub3c5\uc911\ub3c5\uc790' (8), '\ubd80\uc0b0\ub9b0\u20dd\uac00\ub9c1' (16) \ub4f1 'helpful_count'\uac00 \ub192\uc740 \ub9ac\ubdf0\uc5d0\uc11c \uacf5\ud1b5\uc801\uc73c\ub85c \uc9c0\uc801\ub41c \uac00\uc7a5 \uce58\uba85\uc801\uc778 \ubb38\uc81c\uc785\ub2c8\ub2e4. \uc774\ub294 \uc81c\ud488\uc758 \ud575\uc2ec\uc801\uc778 \uc131\ub2a5\uc778 \uc0c9\uc0c1 \uc720\uc9c0\ub825\uc5d0 \ub300\ud55c \uc2ec\uac01\ud55c \uacb0\ud568\uc774\uba70, \uc0ac\uc6a9\uc790\ub294 \ud558\ub8e8 \uc885\uc77c \ud53c\ubd80\ud1a4\uc744 \ubcf4\uc815\ud558\uae30\ubcf4\ub2e4\ub294 \uc624\ud788\ub824 \ud53c\ubd80\ud1a4\uc744 \uc5b4\ub461\uac8c \ub9cc\ub4dc\ub294 \uc5ed\ud6a8\uacfc\ub97c \uacbd\ud5d8\ud558\uac8c \ub429\ub2c8\ub2e4. \uc774\ub294 \uace7 \uc81c\ud488 \uc0ac\uc6a9\uc758 \ubaa9\uc801 \uc790\uccb4\ub97c \ud1f4\uc0c9\uc2dc\ud0a4\ub294 \uc694\uc778\uc785\ub2c8\ub2e4.\n2.  **\ub4e4\ub738 \ubc0f \uac01\uc9c8 \ubd80\uac01 (\ub192\uc740 \uacf5\uac10\ub3c4 \ubc0f \ube48\ub3c4):** '\ub9ac\ub85c' (175), '\ub85c\uba54\uc778' (2), '\ud654\uc7a5\ud488\uc740\uc131\ubd84\uc774\ub2f5\uc774\ub2e4' (18, 8) \ub4f1\uc758 \ub9ac\ubdf0\uc5d0\uc11c \ubc18\ubcf5\uc801\uc73c\ub85c \uc5b8\uae09\ub418\uba70, \ud2b9\ud788 \ubbfc\uac10\uc131 \ubc0f \uac74\uc131 \ud53c\ubd80 \uc0ac\uc6a9\uc790\ub4e4\uc5d0\uac8c \ud070 \ubd88\ud3b8\ud568\uc744 \uc57c\uae30\ud569\ub2c8\ub2e4. \uc774\ub294 \uc81c\ud488\uc758 \uc81c\ud615\uc774 \ud53c\ubd80\uc758 \uc790\uc5f0\uc2a4\ub7ec\uc6b4 \uacb0\uc774\ub098 \uc0c1\ud0dc\ub97c \uace0\ub824\ud558\uc9c0 \ubabb\ud558\uace0 \uac01\uc9c8\uc744 \ub3c4\ub4dc\ub77c\uc9c0\uac8c \ub9cc\ub4e4\uac70\ub098 \ub4e4\ub728\ub294 \ubb38\uc81c\ub97c \uac00\uc9c0\uace0 \uc788\uc74c\uc744 \ub098\ud0c0\ub0c5\ub2c8\ub2e4.\n3.  **\ubbfc\uac10\uc131 \ud53c\ubd80 \ud2b8\ub7ec\ube14 \uc720\ubc1c \uac00\ub2a5\uc131 (\ub0ae\uc740 \ube48\ub3c4, \ub192\uc740 \uc2ec\uac01\uc131):** 'gayoun****' (2), 'taeye****' (2), '\ubc31\uc218\ud638\uc18c\uc778' (0) \ub4f1\uc758 \ub9ac\ubdf0\uc5d0\uc11c \uc5b8\uae09\ub418\uc5c8\uc9c0\ub9cc, \ud53c\ubd80 \ud2b8\ub7ec\ube14\uc740 \ub9e4\uc6b0 \ubbfc\uac10\ud558\uace0 \uce58\uba85\uc801\uc778 \ubb38\uc81c\uc785\ub2c8\ub2e4. \ube44\ub85d \ube48\ub3c4\ub294 \ub0ae\uc9c0\ub9cc, \uc774\ub294 \uc7a0\uc7ac\uc801\uc778 \uace0\uac1d \uc774\ud0c8 \ubc0f \ube0c\ub79c\ub4dc \uc774\ubbf8\uc9c0 \uc190\uc0c1\uc73c\ub85c \uc9c1\uacb0\ub420 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \uce58\uba85\uc801 \ubb38\uc81c\uc785\ub2c8\ub2e4. \ud2b9\ud788 \uc2a4\ud14c\uc544\ub9ad\uc560\uc528\ub4dc\uc640 \uac19\uc740 \ud2b9\uc815 \uc131\ubd84\uc774 \uc6d0\uc778\uc73c\ub85c \uc9c0\ubaa9\ub418\ub294 \uacbd\uc6b0\ub3c4 \uc788\uc5b4 \uc131\ubd84 \uac80\ud1a0\uac00 \ud544\uc694\ud569\ub2c8\ub2e4.\n\n\uc774 \uc138 \uac00\uc9c0 \ubb38\uc81c\ub97c \uc911\uc2ec\uc73c\ub85c \uc81c\ud488 \uac1c\uc120 \ubc0f \uc804\ub7b5 \uc218\ub9bd\uc774 \uc2dc\uae09\ud569\ub2c8\ub2e4.\n\n---\n\n**2. \ubb38\uc81c\uc810\uacfc \ud575\uc2ec \ud0c0\uac9f \uadf8\ub8f9 \uc5f0\uacb0**\n\n\uc55e\uc11c \uc6b0\uc120\uc21c\uc704\ub85c \uc120\uc815\ub41c \ud575\uc2ec \ubb38\uc81c\uc810\ub4e4\uc774 \ud2b9\uc815 \ud53c\ubd80 \ud0c0\uc785\uc5d0\uc11c \ub354\uc6b1 \ub450\ub4dc\ub7ec\uc9c0\ub294 \uacbd\ud5a5\uc744 \ubcf4\uc785\ub2c8\ub2e4.\n\n\uac00\uc7a5 \ub450\ub4dc\ub7ec\uc9c0\ub294 \ud0c0\uac9f \uadf8\ub8f9\uc740 **\ubbfc\uac10\uc131 \ud53c\ubd80** \uc0ac\uc6a9\uc790\uc785\ub2c8\ub2e4.\n*   **\ud2b8\ub7ec\ube14 \uc720\ubc1c:** 'gayoun****', 'taeye****', '\ubc31\uc218\ud638\uc18c\uc778' \ub4f1 \ubbfc\uac10\uc131 \ud53c\ubd80 \uc0ac\uc6a9\uc790\ub4e4\uc740 \uc81c\ud488 \uc0ac\uc6a9 \ud6c4 \ud53c\ubd80 \ud2b8\ub7ec\ube14, \ubd89\uc5b4\uc9d0, \ub4a4\uc9d1\uc5b4\uc9d0 \ub4f1\uc758 \uc2ec\uac01\ud55c \ubc18\uc751\uc744 \uacbd\ud5d8\ud558\ub294 \uacbd\uc6b0\uac00 \ub9ce\uc558\uc2b5\ub2c8\ub2e4.\n*   **\ub4e4\ub738 \ubc0f \uac01\uc9c8 \ubd80\uac01:** '\ub85c\uba54\uc778' (\ubbfc\uac10\uc131, \uac01\uc9c8), '\ub9ac\ub85c' (\ubbfc\uac10\uc131, \uac01\uc9c8) \ub4f1 \ubbfc\uac10\uc131 \ud53c\ubd80\ub97c \uac00\uc9c4 \uc0ac\uc6a9\uc790\ub4e4\uc740 \uac01\uc9c8 \ubd80\uac01 \ubc0f \ub4e4\ub738 \ud604\uc0c1\uc744 \ub354 \ud06c\uac8c \ud638\uc18c\ud558\ub294 \uacbd\ud5a5\uc744 \ubcf4\uc600\uc2b5\ub2c8\ub2e4. \uc774\ub294 \ubbfc\uac10\uc131 \ud53c\ubd80\uac00 \uc77c\ubc18 \ud53c\ubd80\ubcf4\ub2e4 \ub354 \uc12c\uc138\ud55c \uc81c\ud615\uacfc \uc131\ubd84\uc744 \uc694\uad6c\ud558\uae30 \ub54c\ubb38\uc73c\ub85c \ubd84\uc11d\ub429\ub2c8\ub2e4.\n\n\ub530\ub77c\uc11c **\ubbfc\uac10\uc131 \ud53c\ubd80**\ub97c \uac00\uc9c4 \uc0ac\uc6a9\uc790 \uadf8\ub8f9\uc774 \ud604\uc7ac \uc81c\ud488\uc5d0\uc11c \uac00\uc7a5 \ud070 \ubd88\ud3b8\ud568\uc744 \ub290\ub07c\uace0 \uc788\uc73c\uba70, \uc774\ub4e4\uc758 \ubd88\ub9cc \uc0ac\ud56d\uc744 \ud574\uacb0\ud558\ub294 \uac83\uc774 \uc81c\ud488 \uac1c\uc120\uc758 \ud575\uc2ec \uacfc\uc81c\uac00 \ub420 \uac83\uc785\ub2c8\ub2e4.\n\n---\n\n**3. \ub370\uc774\ud130 \uae30\ubc18\uc758 \uc2e4\ud589 \uac00\ub2a5\ud55c \uc131\uc7a5 \uc804\ub7b5 \uc81c\uc5b8**\n\n### [\uc804\ub7b5 \uc81c\uc548 1] \ud3ec\ubbac\ub7ec \ubc0f \uad6c\uc131 \uc694\uc18c \uac1c\uc120 (Formula & Component Improvement)\n\n**\ud575\uc2ec \ubb38\uc81c \ud574\uacb0 (\ub2e4\ud06c\ub2dd, \ub4e4\ub738/\uac01\uc9c8, \ud2b8\ub7ec\ube14 \uc720\ubc1c):**\n\n*   **\ub2e4\ud06c\ub2dd \ubc29\uc9c0 \ud3ec\ubbac\ub7ec \uac1c\ubc1c:** \uae30\uc874 \ud30c\uc6b4\ub370\uc774\uc158\uc758 \ub2e4\ud06c\ub2dd \uc720\ubc1c \uc6d0\uc778\uc774 \ub418\ub294 \uc131\ubd84 \ub610\ub294 \uc81c\ud615\uc758 \ud2b9\uc131\uc744 \ud30c\uc545\ud558\uace0, \uc774\ub97c \uac1c\uc120\ud558\ub294 \ubc29\ud5a5\uc73c\ub85c R&D\ub97c \uc9c4\ud589\ud574\uc57c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, **(\ucd94\uc815) \uc0b0\ud654\ub418\uae30 \uc26c\uc6b4 \uc720\ubd84 \uc131\ubd84\uc744 \uc548\uc815\ud654\uc2dc\ud0a4\uac70\ub098, \uc548\ub8cc\uc758 \uc0b0\ud654 \ubc29\uc9c0 \ucf54\ud305 \uae30\uc220\uc744 \uc801\uc6a9**\ud558\uc5ec \uc0c9\uc0c1 \ubcc0\ud654\ub97c \ucd5c\uc18c\ud654\ud558\ub294 \ubc29\uc548\uc744 \uac80\ud1a0\ud569\ub2c8\ub2e4. \ub610\ud55c, **(\ucd94\uc815) \uc720\uae30 \uc790\uc678\uc120 \ucc28\ub2e8 \uc131\ubd84\uc758 \ud568\ub7c9 \ub610\ub294 \uc885\ub958 \uc870\uc808**\uc744 \ud1b5\ud574 \uad11\uc548\uc815\uc131\uc744 \ub192\uc774\ub294 \uc5f0\uad6c\ub3c4 \ud544\uc694\ud569\ub2c8\ub2e4.\n*   **\ud53c\ubd80 \ubc00\ucc29\ub825 \ubc0f \ubcf4\uc2b5\ub825 \uac15\ud654:** \uac01\uc9c8 \ubd80\uac01 \ubc0f \ub4e4\ub738 \ud604\uc0c1\uc744 \uc644\ud654\ud558\uae30 \uc704\ud574 \uc81c\ud615\uc758 **\ubcf4\uc2b5\uac10\uc744 \uac15\ud654\ud558\uac70\ub098, \uc2e4\ub9ac\ucf58 \uc5d8\ub77c\uc2a4\ud1a0\uba38\uc640 \uac19\uc740 \uc720\uc5f0\ud654 \uc131\ubd84\uc744 \ucd94\uac00\ud558\uc5ec \ud53c\ubd80 \uc694\ucca0\uc744 \ub354 \ubd80\ub4dc\ub7fd\uac8c \uba54\uc6cc\uc8fc\ub294 \ubc29\uc2dd**\uc744 \uace0\ub824\ud569\ub2c8\ub2e4. **(\ucd94\uc815) \ud788\uc54c\ub8e8\ub860\uc0b0, \uc138\ub77c\ub9c8\uc774\ub4dc \ub4f1\uc758 \ubcf4\uc2b5 \uc131\ubd84\uc744 \ucd94\uac00\ud558\uac70\ub098, \uc2e4\ub9ac\ucf58 \uc624\uc77c \ub300\uc2e0 \uc5d0\ubab0\ub9ac\uc5b8\ud2b8 \uc624\uc77c\uc758 \uc885\ub958 \ubc0f \ud568\ub7c9\uc744 \uc870\uc808**\ud558\uc5ec \uac74\uc870\ud568 \uc5c6\uc774 \ud53c\ubd80\uc5d0 \ubd80\ub4dc\ub7fd\uac8c \ubc00\ucc29\ub418\ub294 \uc81c\ud615\uc744 \uac1c\ubc1c\ud569\ub2c8\ub2e4.\n*   **\uc800\uc790\uadf9 \ud3ec\ubbac\ub7ec \uc124\uacc4:** \ubbfc\uac10\uc131 \ud53c\ubd80 \uc0ac\uc6a9\uc790\ub4e4\uc758 \ud2b8\ub7ec\ube14 \uc720\ubc1c \uac00\ub2a5\uc131\uc744 \ub0ae\ucd94\uae30 \uc704\ud574 **\ud5a5\ub8cc, \uc5d0\ud0c4\uc62c, \ud2b9\uc815 \uc5d0\uc13c\uc15c \uc624\uc77c \ub4f1 \uc7a0\uc7ac\uc801 \uc790\uadf9 \uc131\ubd84\uc744 \uc81c\uac70\ud558\uac70\ub098 \ud568\ub7c9\uc744 \ucd5c\uc18c\ud654**\ud558\ub294 \ubc29\ud5a5\uc73c\ub85c \ud3ec\ubbac\ub7ec\ub97c \uc7ac\uc124\uacc4\ud569\ub2c8\ub2e4. **(\ucd94\uc815) \uc2a4\ud14c\uc544\ub9ad\uc560\uc528\ub4dc \uc131\ubd84 \ub610\ud55c \ub17c\ub780\uc758 \uc5ec\uc9c0\uac00 \uc788\ub294 \uc131\ubd84\uc73c\ub85c \ubd84\ub958\ub420 \uc218 \uc788\uc73c\ubbc0\ub85c, \ub300\uccb4 \uc131\ubd84\uc744 \ud0d0\uc0c9\ud558\uac70\ub098 \ud568\ub7c9\uc744 \uc870\uc808**\ud558\ub294 \ubc29\uc548\uc744 \uace0\ub824\ud569\ub2c8\ub2e4. \ud53c\ubd80 \uc7a5\ubcbd \uac15\ud654\uc5d0 \ub3c4\uc6c0\uc744 \uc904 \uc218 \uc788\ub294 \uc131\ubd84(\uc608: \ud310\ud14c\ub180, \uc138\ub77c\ub9c8\uc774\ub4dc)\uc744 \ucd94\uac00\ud558\uc5ec \ud3ec\ubbac\ub7ec\uc758 \uc804\ubc18\uc801\uc778 \ud53c\ubd80 \uce5c\ud654\uc131\uc744 \ub192\uc785\ub2c8\ub2e4.\n\n### [\uc804\ub7b5 \uc81c\uc548 2] \uc81c\ud488 \ud3ec\ud2b8\ud3f4\ub9ac\uc624 \ubc0f \uacbd\uc7c1 \uc804\ub7b5 (Product Portfolio & Competitive Strategy)\n\n**\uc2dc\uc7a5 \uae30\ud68c \uc815\uc758:**\n\n\ud604\uc7ac \uc81c\ud488\uc740 '\ubc00\ucc29 \ucee4\ubc84'\ub77c\ub294 \uba85\ud655\ud55c \uac15\uc810\uc744 \ub0b4\uc138\uc6e0\uc9c0\ub9cc, \uacb0\uacfc\uc801\uc73c\ub85c \ub9ce\uc740 \uc0ac\uc6a9\uc790, \ud2b9\ud788 **\ubbfc\uac10\uc131 \ud53c\ubd80\ub97c \uac00\uc9c4 10\ub300 \ud6c4\ubc18~20\ub300 \ucd08\ubc18\uc758 \ud53c\ubd80 \uace0\ubbfc\uc774 \ub9ce\uc740 \uace0\uac1d\uce35**\uc744 \ub9cc\uc871\uc2dc\ud0a4\uc9c0 \ubabb\ud588\uc2b5\ub2c8\ub2e4. \uc774\ub4e4\uc740 \ud2b8\ub7ec\ube14, \uac01\uc9c8, \uac74\uc870\ud568, \uc9c0\uc18d\ub825 \ubd80\uc871, \ub2e4\ud06c\ub2dd \ub4f1 \ub2e4\uc591\ud55c \ud53c\ubd80 \uace0\ubbfc\uc744 \uac00\uc9c0\uace0 \uc788\uc73c\uba70, \uc774\ub7ec\ud55c \ub2c8\uc988\ub97c \ucda9\uc871\uc2dc\ud0a4\uc9c0 \ubabb\ud588\ub2e4\ub294 \uc810\uc5d0\uc11c \uc624\ud788\ub824 \uc0c8\ub85c\uc6b4 \uae30\ud68c\ub97c \ubc1c\uacac\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub294 \uace7 **\"\ubbfc\uac10\uc131 \ud53c\ubd80\ub97c \uc704\ud55c \uc800\uc790\uadf9, \uace0\ubc00\ucc29, \ub2e4\ud06c\ub2dd \uc5c6\ub294 \ucee4\ubc84 \ud30c\uc6b4\ub370\uc774\uc158\"** \uc2dc\uc7a5\uc5d0 \ub300\ud55c \uc7a0\uc7ac\uc801 \uae30\ud68c\uac00 \uc874\uc7ac\ud568\uc744 \uc758\ubbf8\ud569\ub2c8\ub2e4. \uae30\uc874 \uc81c\ud488\uc758 \uc2e4\ud328\ub294 \uc774 \uc2dc\uc7a5\uc758 \uc911\uc694\uc131\uc744 \ud655\uc778\uc2dc\ucf1c \uc8fc\ub294 \uc9c0\ud45c\uac00 \ub429\ub2c8\ub2e4.\n\n**\uc804\ub7b5 \uc635\uc158:**\n\n*   **\uc635\uc158 A: \uae30\uc874 \uc81c\ud488 \uac1c\uc120 \ubc0f \ub9ac\ud3ec\uc9c0\uc154\ub2dd \uc804\ub7b5**\n    *   **\uac1c\uc120:** \uc55e\uc11c \uc81c\uc548\ub41c \ud3ec\ubbac\ub7ec \uac1c\uc120\uc548\uc744 \uc801\uc6a9\ud558\uc5ec \uae30\uc874 '\ubc00\ucc29 \ucee4\ubc84 \ud30c\uc6b4\ub370\uc774\uc158'\uc744 '\uc548\uc2ec \ucee4\ubc84 \ud30c\uc6b4\ub370\uc774\uc158' \ub610\ub294 '\ub871\uc6e8\uc5b4 \ud54f \ud30c\uc6b4\ub370\uc774\uc158' \ub4f1\uc73c\ub85c \uc7ac\uc815\uc758\ud569\ub2c8\ub2e4. \ud2b9\ud788 \ub2e4\ud06c\ub2dd \ubc29\uc9c0 \ubc0f \uc800\uc790\uadf9 \uc131\ubd84 \uac15\ud654\uc5d0 \ucd08\uc810\uc744 \ub9de\ucda5\ub2c8\ub2e4.\n    *   **\ub9ac\ud3ec\uc9c0\uc154\ub2dd:** '\ubbfc\uac10\uc131 \ud53c\ubd80\ub3c4 \uc548\uc2ec\ud558\uace0 \uc4f8 \uc218 \uc788\ub294 \ucee4\ubc84 \ud30c\uc6b4\ub370\uc774\uc158'\uc73c\ub85c \uba85\ud655\ud558\uac8c \ud3ec\uc9c0\uc154\ub2dd\ud569\ub2c8\ub2e4. \uc774\ub97c \uc704\ud574 \uc131\ubd84 \ub9ac\uc2a4\ud2b8\ub97c \ud22c\uba85\ud558\uac8c \uacf5\uac1c\ud558\uace0, \ud53c\ubd80 \uc800\uc790\uadf9 \ud14c\uc2a4\ud2b8 \uc644\ub8cc \uc0ac\uc2e4\uc744 \uac15\uc870\ud569\ub2c8\ub2e4. \ub610\ud55c, 17\ud638 \uceec\ub7ec\ub294 \ud1a4\uc5c5 \ud6a8\uacfc\uc640 \ud568\uaed8 \ub2e4\ud06c\ub2dd \uc5c6\ub294 \ud654\uc0ac\ud568\uc744 \uc720\uc9c0\uc2dc\ucf1c \uc900\ub2e4\ub294 \uc810\uc744 \ubd80\uac01\ud558\uace0, 21\ud638 \uc0ac\uc6a9\uc790\ub97c \uc704\ud574\uc11c\ub294 21\ud638 \uc790\uccb4\uc758 \uceec\ub7ec \uac1c\uc120\uc774\ub098 \ud1a4 \ubcf4\uc815 \ud6a8\uacfc\ub97c \uac15\ud654\ud569\ub2c8\ub2e4.\n\n*   **\uc635\uc158 B: \uc2e0\uaddc \ub77c\uc778 \ud655\uc7a5 \uc804\ub7b5 (\uc800\uc790\uadf9&\uc548\uc815\uc131 \uac15\ud654 \ub77c\uc778)**\n    *   **\uc2e0\uaddc \ub77c\uc778 \ucd9c\uc2dc:** '\uc9c0\ubca0\ub974\ub2c8 \ucef4\ud3ec\ud2b8 \ud54f \ub77c\uc778' \ub610\ub294 '\uc9c0\ubca0\ub974\ub2c8 \uc820\ud2c0 \ucee4\ubc84 \ub77c\uc778'\uacfc \uac19\uc774 \uc800\uc790\uadf9 \uc131\ubd84\uc744 \uc804\uba74\uc801\uc73c\ub85c \ub0b4\uc138\uc6b4 \uc0c8\ub85c\uc6b4 \ud30c\uc6b4\ub370\uc774\uc158 \ub77c\uc778\uc744 \ucd9c\uc2dc\ud569\ub2c8\ub2e4. \uc774 \ub77c\uc778\uc740 \ubbfc\uac10\uc131 \ud53c\ubd80 \ud14c\uc2a4\ud2b8 \uc644\ub8cc, \ubb34\ud5a5\ub8cc/\ubb34\uc0c9\uc18c/\uc800\uc790\uadf9 \uc131\ubd84 \uc0ac\uc6a9\uc744 \ud575\uc2ec \uac00\uce58\ub85c \ud569\ub2c8\ub2e4.\n    *   **\ud0c0\uac9f \uc138\ubd84\ud654:** \uc774 \uc2e0\uaddc \ub77c\uc778\uc740 \uae30\uc874 '\ubc00\ucc29 \ucee4\ubc84 \ud30c\uc6b4\ub370\uc774\uc158'\uacfc\ub294 \ubcc4\uac1c\ub85c, \ud53c\ubd80 \ud2b8\ub7ec\ube14, \ubbfc\uac10\uc131, \uc18d\uac74\uc870 \ub4f1\uc758 \uace0\ubbfc\uc744 \uac00\uc9c4 \uc18c\ube44\uc790\ub4e4\uc744 \uc9c1\uc811\uc801\uc73c\ub85c \uacf5\ub7b5\ud569\ub2c8\ub2e4. \uc9c0\uc18d\ub825 \ub610\ud55c \uc77c\ubc18\uc801\uc778 \uc138\ubbf8\ub9e4\ud2b8 \ud30c\uc6b4\ub370\uc774\uc158 \uc218\uc900\uc73c\ub85c \uc720\uc9c0\ud558\ub418, \ub2e4\ud06c\ub2dd \ud604\uc0c1\uc744 \ucd5c\uc18c\ud654\ud558\ub294 \ub370 \uc9d1\uc911\ud569\ub2c8\ub2e4. \uc774\ub294 \ube0c\ub79c\ub4dc \ud3ec\ud2b8\ud3f4\ub9ac\uc624\ub97c \ud655\uc7a5\ud558\uace0 \ub2e4\uc591\ud55c \uc18c\ube44\uc790 \ub2c8\uc988\ub97c \ucda9\uc871\uc2dc\ud0ac \uc218 \uc788\ub294 \uae30\ud68c\uac00 \ub420 \uac83\uc785\ub2c8\ub2e4.\n\n**\ub450 \uc635\uc158 \ubaa8\ub450 \uc7a5\ub2e8\uc810\uc774 \uc788\uc73c\ub098, \ube0c\ub79c\ub4dc\uc758 \uc790\uc6d0\uacfc \uc2dc\uc7a5 \ubc18\uc751\uc744 \uace0\ub824\ud558\uc5ec \ucd5c\uc801\uc758 \uc804\ub7b5\uc744 \uc120\ud0dd\ud574\uc57c \ud569\ub2c8\ub2e4. \ud558\uc9c0\ub9cc \ud604\uc7ac '\ubc00\ucc29 \ucee4\ubc84 \ud30c\uc6b4\ub370\uc774\uc158'\uc758 \uadfc\ubcf8\uc801\uc778 \uc81c\ud615 \uc774\uc288\uac00 \ud06c\ubbc0\ub85c, \uc635\uc158 A\ub97c \uc6b0\uc120\uc801\uc73c\ub85c \uace0\ub824\ud558\ub418, \uc131\uacf5\uc801\uc778 \uac1c\uc120\uc744 \ud1b5\ud574 '\uc548\uc2ec\ud558\uace0 \uc0ac\uc6a9\ud560 \uc218 \uc788\ub294 \ucee4\ubc84 \ud30c\uc6b4\ub370\uc774\uc158'\uc774\ub77c\ub294 \uae0d\uc815\uc801\uc778 \uc774\ubbf8\uc9c0\ub97c \uad6c\ucd95\ud55c \ud6c4, \uc635\uc158 B\ub85c \ub77c\uc778 \ud655\uc7a5\uc744 \uace0\ub824\ud558\ub294 \uac83\uc774 \ub9ac\uc2a4\ud06c\ub97c \uc904\uc774\ub294 \ubc29\uc548\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4.**\n\n### [\uc804\ub7b5 \uc81c\uc548 3] \ub9c8\ucf00\ud305 \ubc0f \ucee4\ubba4\ub2c8\ucf00\uc774\uc158 \ucd5c\uc801\ud654 (Marketing & Communication Optimization)\n\n**\uac00\uce58 \uc81c\uc548(Promise) \uc7ac\uc815\uc758:**\n\n*   \uae30\uc874\uc758 '\ubc00\ucc29 \ucee4\ubc84'\ub77c\ub294 \ubaa8\ud638\ud55c \uc7a5\uc810 \ub300\uc2e0, **\"\ud558\ub8e8 \uc885\uc77c \ubb34\ub108\uc9d0 \uc5c6\uc774 \ud654\uc0ac\ud568\uc744 \uc720\uc9c0\ud558\ub294 \ucee4\ubc84\ub825\", \"\ubbfc\uac10\uc131 \ud53c\ubd80\ub3c4 \ud3b8\uc548\ud558\uac8c \uc0ac\uc6a9\ud560 \uc218 \uc788\ub294 \uc800\uc790\uadf9 \ud3ec\ubbac\ub7ec\"**\uc640 \uac19\uc774 \uad6c\uccb4\uc801\uc774\uace0 \ud604\uc2e4\uc801\uc778 \uac00\uce58\ub97c \uc81c\uc2dc\ud569\ub2c8\ub2e4.\n*   \uc608\uc2dc: \"**[\ubbfc\uac10\uc131 \ud53c\ubd80 \uc548\uc2ec \ucee4\ubc84] \uc9c0\ubca0\ub974\ub2c8 \ub871\uc6e8\uc5b4 \ud54f \ud30c\uc6b4\ub370\uc774\uc158: 12\uc2dc\uac04 \ub2e4\ud06c\ub2dd \uc5c6\uc774 \ud654\uc0ac\ud558\uac8c, \ud2b8\ub7ec\ube14 \uac71\uc815 \uc5c6\uc774 \ud3b8\uc548\ud558\uac8c.**\" \uc640 \uac19\uc774 \uc81c\ud488\uc758 \uac1c\uc120\ub41c \ud575\uc2ec \ud6a8\ub2a5\uacfc \ud0c0\uac9f \uace0\uac1d\uc744 \uba85\ud655\ud788 \ud569\ub2c8\ub2e4.\n\n**\uae30\ub300\uce58 \uad00\ub9ac \uac00\uc774\ub4dc (Proactive Guide):**\n\n*   **\uc0ac\uc6a9\ubc95 \uac00\uc774\ub4dc \uac15\ud654:** \uac01\uc9c8 \ubc0f \ub4e4\ub738 \ud604\uc0c1\uc744 \ubc29\uc9c0\ud558\uae30 \uc704\ud55c **'\uc0ac\uc6a9 \uc804 \ucda9\ubd84\ud55c \uc218\ubd84 \uacf5\uae09', '\uc18c\ub7c9\uc529 \uc587\uac8c \ud3b4 \ubc14\ub974\uae30', '\ud37c\ud504 \ub610\ub294 \ube0c\ub7ec\uc26c\uc758 \uac01\ub3c4 \uc870\uc808'** \ub4f1\uc758 \uad6c\uccb4\uc801\uc778 \uac00\uc774\ub4dc\ub97c \uc81c\ud488 \uc0c1\uc138 \ud398\uc774\uc9c0, \uacf5\uc2dd SNS \ucc44\ub110, \ub3d9\ubd09\ub41c \uc548\ub0b4\ubb38\uc5d0 \uba85\ud655\ud558\uac8c \uba85\uc2dc\ud569\ub2c8\ub2e4.\n*   **\uc131\ubd84 \uc815\ubcf4 \ud22c\uba85 \uacf5\uac1c:** \ubbfc\uac10\uc131 \uc0ac\uc6a9\uc790\ub4e4\uc744 \uc704\ud574 \uc81c\ud488\uc5d0 \ud3ec\ud568\ub41c \uc8fc\uc694 \uc131\ubd84, \ud2b9\ud788 \uc7a0\uc7ac\uc801 \uc790\uadf9 \uc131\ubd84\uc5d0 \ub300\ud55c \uc815\ubcf4\uc640 \uadf8 \uc774\uc720, \ub610\ub294 \ub300\uccb4 \uc131\ubd84\uc5d0 \ub300\ud55c \uc124\uba85\uc744 \ud22c\uba85\ud558\uac8c \uc81c\uacf5\ud558\uc5ec \uc2e0\ub8b0\ub97c \uad6c\ucd95\ud569\ub2c8\ub2e4.\n\n**\uad11\uace0 \uba54\uc2dc\uc9c0 \ud604\uc2e4\ud654:**\n\n*   **\ud604\uc2e4\uc801\uc778 \uc804\ud6c4 \ube44\uad50 \ucf58\ud150\uce20 \uc81c\uc791:** '\uae30\uc801 \uac19\uc740 \ud6a8\uacfc' \ub4f1\uc758 \uacfc\uc7a5\ub41c \ubb38\uad6c \ub300\uc2e0, \uac1c\uc120\ub41c \ud3ec\ubbac\ub7ec\ub97c \uc801\uc6a9\ud55c \uc81c\ud488\uc744 \uc0ac\uc6a9\ud558\uc5ec **\uc2e4\uc81c \ubbfc\uac10\uc131 \ud53c\ubd80 \uc0ac\uc6a9\uc790\uac00 \uc81c\ud488\uc744 \uc0ac\uc6a9\ud55c \uc804\ud6c4 \ube44\uad50 \uc601\uc0c1 \ub610\ub294 \uc0ac\uc9c4 \ucf58\ud150\uce20**\ub97c \uc81c\uc791\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \"\uc624\uc804 9\uc2dc: \ub9d1\uace0 \ud654\uc0ac\ud55c \ud53c\ubd80 \ud45c\ud604\", \"\uc624\ud6c4 3\uc2dc: \ub208\uc5d0 \ub744\ub294 \ub2e4\ud06c\ub2dd\uc774\ub098 \ub4e4\ub738 \uc5c6\uc774 \uc720\uc9c0\ub418\ub294 \ud53c\ubd80\", \"\uc800\ub141 7\uc2dc: \ud3b8\uc548\ud558\uace0 \uc790\uadf9 \uc5c6\ub294 \ub9c8\ubb34\ub9ac\uac10\"\uacfc \uac19\uc774 \uc2dc\uac04 \uacbd\uacfc\uc5d0 \ub530\ub978 \ubcc0\ud654\ub97c \uc0ac\uc2e4\uc801\uc73c\ub85c \ubcf4\uc5ec\uc90d\ub2c8\ub2e4.\n*   **\ub9ac\ubdf0 \ud65c\uc6a9 \ub9c8\ucf00\ud305:** \uac1c\uc120\ub41c \uc81c\ud488\uc5d0 \ub300\ud55c \uae0d\uc815\uc801\uc778 \uc0ac\uc6a9\uc790 \ub9ac\ubdf0\ub97c \uc801\uadf9\uc801\uc73c\ub85c \ub9c8\ucf00\ud305 \ucc44\ub110\uc5d0 \ud65c\uc6a9\ud558\uc5ec \uc2e0\ub8b0\ub3c4\ub97c \ub192\uc785\ub2c8\ub2e4. \ud2b9\ud788 \ubbfc\uac10\uc131 \ud53c\ubd80 \uc0ac\uc6a9\uc790 \ub610\ub294 \uacfc\uac70 \ubd80\uc815\uc801\uc778 \uacbd\ud5d8\uc744 \ud588\ub358 \uc0ac\uc6a9\uc790\ub4e4\uc774 \uac1c\uc120\ub41c \uc81c\ud488\uc5d0 \ub300\ud574 \uae0d\uc815\uc801\uc778 \ud3c9\uac00\ub97c \ub0a8\uae30\ub294 \ucf58\ud150\uce20\uc5d0 \uc9d1\uc911\ud569\ub2c8\ub2e4.\n\n\uc774\ub7ec\ud55c \uc804\ub7b5\ub4e4\uc744 \ud1b5\ud574 \uc9c0\ubca0\ub974\ub2c8 \ubc00\ucc29 \ucee4\ubc84 \ud30c\uc6b4\ub370\uc774\uc158\uc740 \ud604\uc7ac\uc758 \uc2e4\ud328\ub97c \ubc1c\ud310 \uc0bc\uc544 \ube0c\ub79c\ub4dc \uc2e0\ub8b0\ub3c4\ub97c \ud68c\ubcf5\ud558\uace0, \ud2b9\uc815 \uace0\uac1d\uce35\uc758 \ub2c8\uc988\ub97c \ucda9\uc871\uc2dc\ud0a4\ub294 \uc131\uacf5\uc801\uc778 \uc81c\ud488\uc73c\ub85c \uc7ac\ub3c4\uc57d\ud560 \uc218 \uc788\uc744 \uac83\uc785\ub2c8\ub2e4.", "ingredients": "[17\ud638 \ud3ec\uc2ac\ub9b0]\n\uc815\uc81c\uc218, \uc0ac\uc774\ud074\ub85c\ud39c\ud0c0\uc2e4\ub85d\uc138\uc778, \ud2f0\ud0c0\ub284\ub514\uc625\uc0ac\uc774\ub4dc, \uae00\ub9ac\uc138\ub9b0, \uc544\uc774\uc18c\ub3c4\ub370\ucf00\uc778, \ub2e4\uc774\uce74\ud504\ub9b4\ub9b4\uce74\ubcf4\ub124\uc774\ud2b8, \ubd80\ud2f8\ub80c\uae00\ub77c\uc774\ucf5c, \uc5d0\ud0c4\uc62c, \uce74\ud504\ub9b4\ub9ad/\uce74\ud504\ub9ad\ud2b8\ub77c\uc774\uae00\ub9ac\uc138\ub77c\uc774\ub4dc, \ucf54\ucf54-\uce74\ud504\ub9b4\ub808\uc774\ud2b8/\uce74\ud504\ub808\uc774\ud2b8, \ub77c\uc6b0\ub9b4\ud53c\uc774\uc9c0-10\ud2b8\ub9ac\uc2a4(\ud2b8\ub77c\uc774\uba54\ud2f8\uc2e4\ub85d\uc2dc)\uc2e4\ub9b4\uc5d0\ud2f8\ub2e4\uc774\uba54\ud2f0\ucf58, \uba54\ud2f8\uba54\ud0c0\ud06c\ub9b4\ub808\uc774\ud2b8\ud06c\ub85c\uc2a4\ud3f4\ub9ac\uba38, \uce74\ud504\ub9b4\ub9b4\uba54\ud2f0\ucf58, \ud39c\ud0c0\uc5d0\ub9ac\uc2a4\ub9ac\ud2f8\ud14c\ud2b8\ub77c\uc544\uc774\uc18c\uc2a4\ud14c\uc544\ub808\uc774\ud2b8, \ub2e4\uc774\uc2a4\ud14c\uc544\ub2e4\uc774\ubaa8\ub284\ud5e5\ud1a0\ub77c\uc774\ud2b8, \ub9c8\uadf8\ub124\uc298\uc124\ud398\uc774\ud2b8, \ub098\ud314\uc218\uc120\ud654\ucd94\ucd9c\ubb3c, \ub9c8\ub3c8\ub098\ubc31\ud569\ube44\ub298\uc904\uae30\ucd94\ucd9c\ubb3c, \ube14\ub8e8\ud50c\ub798\uadf8\uc544\uc774\ub9ac\uc2a4\ucd94\ucd9c\ubb3c, \uc5d0\ub378\ubc14\uc774\uc2a4\uaf43/\uc78e\ucd94\ucd9c\ubb3c, \uc5f0\uaf43\uaf43\ucd94\ucd9c\ubb3c, \uc7a5\ubbf8\ucd94\ucd9c\ubb3c, \ucee4\uba3c\uc790\uc2a4\ubbfc\uaf43/\uc78e\ucd94\ucd9c\ubb3c, \ud504\ub9ac\uc9c0\uc5b4\ucd94\ucd9c\ubb3c, \uc9d5\ud06c\uc625\uc0ac\uc774\ub4dc, \ub2e4\uc774\uba54\ud2f0\ucf58/\ube44\ub2d0\ub2e4\uc774\uba54\ud2f0\ucf58\ud06c\ub85c\uc2a4\ud3f4\ub9ac\uba38, \ub2e4\uc774\uba54\ud2f0\ucf58, \ud3f4\ub9ac\uae00\ub9ac\uc138\ub9b4-4\uc544\uc774\uc18c\uc2a4\ud14c\uc544\ub808\uc774\ud2b8, \ud2b8\ub77c\uc77