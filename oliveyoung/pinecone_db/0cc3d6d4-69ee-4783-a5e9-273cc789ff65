\uc73c\ub85c \ub098\ud0c0\ub0ac\uc2b5\ub2c8\ub2e4. \ud2b9\ud788 '\uce58\uc774\uce74\uc640\uc655' \uc0ac\uc6a9\uc790\uc758 \ub9ac\ubdf0(helpful_count 162)\ub294 \uc774\ub7ec\ud55c \ubb38\uc81c\uc810\ub4e4\uc744 \ub9e4\uc6b0 \uad6c\uccb4\uc801\uc73c\ub85c \uc9c0\uc801\ud558\uba70 \uc555\ub3c4\uc801\uc778 \uacf5\uac10\uc744 \uc5bb\uc5c8\uc2b5\ub2c8\ub2e4. \ud574\ub2f9 \uc81c\ud488\uc740 \uc8fc\ub85c \ubcf5\ud569\uc131 \ud53c\ubd80 \ud0c0\uc785 \uc0ac\uc6a9\uc790\uc5d0\uac8c\uc11c \uc774\ub7ec\ud55c \ubd80\uc815\uc801\uc778 \uacbd\ud5d8\uc774 \uc9d1\uc911\uc801\uc73c\ub85c \ub098\ud0c0\ub098\uace0 \uc788\uc73c\uba70, \uc774\ub294 \uc81c\ud488\uc758 \uc81c\ud615 \ubc0f \uc131\ubd84 \uad6c\uc131\uc5d0 \ub300\ud55c \uadfc\ubcf8\uc801\uc778 \uac1c\uc120 \ud544\uc694\uc131\uc744 \uc2dc\uc0ac\ud569\ub2c8\ub2e4. \ubcf8 \ubcf4\uace0\uc11c\ub294 \uc774\ub7ec\ud55c \ubb38\uc81c\uc810\ub4e4\uc744 \ud574\uacb0\ud558\uace0 \uc81c\ud488 \uacbd\uc7c1\ub825\uc744 \uac15\ud654\ud558\uae30 \uc704\ud55c \uad6c\uccb4\uc801\uc778 R&D, \ud3ec\ud2b8\ud3f4\ub9ac\uc624, \ub9c8\ucf00\ud305 \uc804\ub7b5\uc744 \uc81c\uc2dc\ud569\ub2c8\ub2e4.\n\n### \uc0c1\uc138 \ubd84\uc11d \ubc0f \uc6b0\uc120\uc21c\uc704 (Detailed Analysis & Prioritization)\n\n#### 1-A. \ubb38\uc81c\uc810 \uccb4\uacc4\uc801 \ubd84\ub958 \ubc0f \uadfc\ubcf8 \uc6d0\uc778 \ubd84\uc11d\n\n**1. \uc81c\ud615 \ubc0f \uc0ac\uc6a9\uac10 \uc601\uc5ed:**\n\uac00\uc7a5 \ube48\ubc88\ud558\uac8c \uc5b8\uae09\ub418\ub294 \ubb38\uc81c\ub294 **'\ubc00\ub9bc \ubc0f \ubb49\uce68 \ud604\uc0c1'**\uc785\ub2c8\ub2e4. '\uce58\uc774\uce74\uc640\uc655' (162), 'Sol' (86, 11), '\uc800\ud584\ub9d8\uc778\ub3a8\uc5ec' (11, 8), '\uc62c\ud0f1\uc774' (0), '\uadf8\ub9cc\uac00\uc838\uac00' (1), '\uacf5\uc8fc\ub4f1\uc7a5' (6) \ub4f1 \ub2e4\uc218\uc758 \uc0ac\uc6a9\uc790\ub4e4\uc774 \uc81c\ud488 \uc0ac\uc6a9 \uc2dc \ub9c8\uce58 \ub54c\ucc98\ub7fc \ubc00\ub824 \ub098\uc624\uac70\ub098, \ud654\uc7a5\uc774 \ubc00\ub9ac\ub294 \ud604\uc0c1\uc744 \uacbd\ud5d8\ud55c\ub2e4\uace0 \uc9c0\uc801\ud588\uc2b5\ub2c8\ub2e4. \uc774\ub294 **\uc81c\ud488\uc758 \ud2b9\uc815 \uc131\ubd84 \uac04\uc758 \uc0c1\ud638\uc791\uc6a9 \ubb38\uc81c, \ub610\ub294 \uc81c\ud615 \uc790\uccb4\uc758 \uc548\uc815\uc131 \ubd80\uc871**\uc744 \uc2dc\uc0ac\ud569\ub2c8\ub2e4.\n\n\ub450 \ubc88\uc9f8\ub85c \ube48\ubc88\ud55c \ubd88\ub9cc\uc740 **'\uacfc\ub3c4\ud55c \ubc88\ub4e4\uac70\ub9bc'**\uc785\ub2c8\ub2e4. 'Sy222' (1), 'Lvyn' (0), '\uccb4\ub098\ube14\ub77c\uc378' (0), 'mym****' (0), 'kjo****' (1) \ub4f1\uc758 \uc0ac\uc6a9\uc790\uac00 \uc81c\ud488 \uc0ac\uc6a9 \ud6c4 \uc5bc\uad74\uc774 \ubc88\ub4e4\uac70\ub9ac\uac70\ub098 \uac1c\uae30\ub984\uc774 \ub9ce\uc774 \ub080\ub2e4\uace0 \uc5b8\uae09\ud588\uc2b5\ub2c8\ub2e4. \uc774\ub294 **\uc81c\ud488\uc5d0 \ud3ec\ud568\ub41c \uc720\ubd84 \uc131\ubd84\uc758 \uacfc\ub2e4\ud568 \ub610\ub294 \ud2b9\uc815 \uc720\ud654 \uc2dc\uc2a4\ud15c\uc758 \ubb38\uc81c**\uc77c \uac00\ub2a5\uc131\uc774 \uc788\uc2b5\ub2c8\ub2e4.\n\n\ub610\ud55c, '\ud1a4\uc5c5' \uae30\ub2a5\uc5d0 \ub300\ud55c \uae30\ub300\uce58\uc640 \uc2e4\uc81c \uacb0\uacfc \uac04\uc758 \uad34\ub9ac\ub3c4 \uc9c0\uc801\ub418\uc5c8\uc2b5\ub2c8\ub2e4. 'Lvyn' (0)\uc740 \ud1a4\uc5c5 \ud6a8\uacfc\ub294 \uc608\uc058\uc9c0\ub9cc \ubc88\ub4e4\uac70\ub9bc\uc744 \uc5b8\uae09\ud588\uace0, '\uce58\uc774\uce74\uc640\uc655' (162)\uc740 \ud0c0 \uc81c\ud488 \ub300\ube44 \ud1a4\uc5c5 \uc815\ub3c4\uac00 \uc57d\ud558\uac70\ub098 \uc6dc\ud1a4st\ub85c \ud1a4\uc5c5\ub41c\ub2e4\uace0 \ud3c9\uac00\ud588\uc2b5\ub2c8\ub2e4. 'JSOily' (0)\ub294 \ud1a4\uc5c5\ubcf4\ub2e4\ub294 \ud558\uc597\uac8c \ubc1c\ub9ac\ub294 \ub290\ub08c\uc774\uba70 \uc790\uc5f0\uc2a4\ub7fd\uc9c0 \uc54a\ub2e4\uace0 \uc9c0\uc801\ud588\uc2b5\ub2c8\ub2e4. \uc774\ub294 **\ud1a4\uc5c5 \ud6a8\uacfc\ub97c \uc704\ud55c \uc0c9\uc18c \uc785\uc790\uc758 \ubc30\ud569 \ubc0f \ubc1c\ub9bc\uc131 \ucd5c\uc801\ud654 \ubd80\uc871**\uc744 \uc758\ubbf8\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n**2. \uc2e0\uccb4\uc801/\uc0dd\ub9ac\uc801 \ubc18\uc751 \uc601\uc5ed:**\n\uc77c\ubd80 \uc0ac\uc6a9\uc790\ub4e4\uc740 **\ud53c\ubd80 \uc790\uadf9, \ub530\uac00\uc6c0, \ud2b8\ub7ec\ube14 \uc720\ubc1c** \ub4f1\uc758 \ubb38\uc81c\ub97c \uacbd\ud5d8\ud588\uc2b5\ub2c8\ub2e4. '\uc608\uc9c0\uc778\uc624\ub385' (1)\uc740 \"\ud53c\ubd80 \ub09c\ub9ac \ub0ac\uc5b4\uc694\"\ub77c\uace0 \ud45c\ud604\ud588\uc73c\uba70, 'gi****' (0)\ub294 \uc0ac\uc6a9 \uc989\uc2dc \ub530\uac00\uc6c0\uc744 \ub290\uaf08\ub2e4\uace0 \ud588\uc2b5\ub2c8\ub2e4. 'kimese****' (0)\ub294 \ud2b8\ub7ec\ube14\uc774 \uc62c\ub77c\uc654\ub2e4\uace0 \uc5b8\uae09\ud588\uc73c\uba70, 'thdwlsdk****' (1)\ub294 \uac04\uc9c0\ub7ec\uc6c0\uacfc \ud568\uaed8 \ubb50\uac00 \ub9ce\uc774 \ub0ac\ub2e4\uace0 \uac15\ud558\uac8c \ube44\ud310\ud588\uc2b5\ub2c8\ub2e4. \uc774\ub294 **\uc81c\ud488\uc5d0 \ud3ec\ud568\ub41c \ud2b9\uc815 \uc131\ubd84(\uc5b4\uc131\ucd08 \uc678 \uae30\ud0c0 \uc131\ubd84 \ud3ec\ud568 \uac00\ub2a5\uc131)\uc774 \ud2b9\uc815 \ud53c\ubd80 \ud0c0\uc785\uc5d0 \ub9de\uc9c0 \uc54a\uac70\ub098, \uc81c\ud615\uc758 \uc548\uc815\ud654 \uacfc\uc815\uc5d0\uc11c \ubc1c\uc0dd\ud560 \uc218 \uc788\ub294 \uc790\uadf9 \uc694\uc18c**\uc5d0 \ub300\ud55c \uc6b0\ub824\ub97c \uc81c\uae30\ud569\ub2c8\ub2e4.\n\n\ub208 \uc2dc\ub9bc \uc5ed\uc2dc \uc77c\ubd80 \uc0ac\uc6a9\uc790\ub4e4\uc5d0\uac8c \ubd88\ud3b8\ud568\uc744 \uc57c\uae30\ud588\uc2b5\ub2c8\ub2e4. 'mym****' (0)\uc640 '\uce74\uc698' (0)\uc740 \ub208 \uc2dc\ub9bc\uc774 \uc788\ub2e4\uace0 \uc5b8\uae09\ud558\uba70, \ud2b9\ud788 '\uce74\uc698'\uc740 \ub208 \uc2dc\ub9bc \uc5c6\ub2e4\ub294 \ud6c4\uae30\ub97c \ubcf4\uace0 \uad6c\ub9e4\ud588\uc73c\ub098 \uc2e4\ub9dd\ud588\ub2e4\uace0 \uc804\ud588\uc2b5\ub2c8\ub2e4. \uc774\ub294 **\uc81c\ud488\uc758 \ud718\ubc1c\uc131 \uc131\ubd84 \ub610\ub294 \ubbf8\uc138 \uc785\uc790\uac00 \ub208\uac00 \uc810\ub9c9\uc744 \uc790\uadf9**\ud560 \uac00\ub2a5\uc131\uc744 \ubcf4\uc5ec\uc90d\ub2c8\ub2e4.\n\n**3. \ud3ec\uc7a5 \ubc0f \uc0ac\uc6a9 \ud3b8\uc758\uc131 \uc601\uc5ed:**\n\uc8fc\ub41c \ubd88\ub9cc\uc740 \uc544\ub2c8\uc9c0\ub9cc, 'pj****' (0) \uc0ac\uc6a9\uc790\ub294 \uba38\ub9ac\uce74\ub77d\uc774 \ubd99\uc5b4\uc788\ub294 \uc81c\ud488\uc744 \ubc1b\uc544 \ubd88\ucf8c\uac10\uc744 \ud45c\ud604\ud588\uc2b5\ub2c8\ub2e4. \uc774\ub294 **\uc0dd\uc0b0 \ubc0f \ud3ec\uc7a5 \uacfc\uc815\uc5d0\uc11c\uc758 \uc704\uc0dd \uad00\ub9ac \ubd80\uc871**\uc744 \uc2dc\uc0ac\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n**4. \uac00\uce58 \ubc0f \uc804\ubc18\uc801 \uc778\uc2dd \uc601\uc5ed:**\n\ud5a5\uc5d0 \ub300\ud55c \ubd88\ub9cc\ub3c4 \uc77c\ubd80 \uc874\uc7ac\ud588\uc2b5\ub2c8\ub2e4. 'kjo****' (1)\ub294 \ud398\uc778\ud2b8 \ud5a5 \uac19\ub2e4\uace0 \uc5b8\uae09\ud588\uace0, '\ud53c\ubd80\ucf00\uc5b4\ub7ec' (0)\uc640 '\ud4e8\uc5b4\ub9ac' (1)\ub294 \ub0c4\uc0c8\uac00 \uac70\uc2ac\ub824 \uc0ac\uc6a9\uc744 \uc911\ub2e8\ud558\uac70\ub098 \uc7ac\uad6c\ub9e4 \uc758\uc0ac\uac00 \uc5c6\ub2e4\uace0 \ubc1d\ud614\uc2b5\ub2c8\ub2e4. \uc774\ub294 **\uc81c\ud488\uc758 \ud5a5\ub8cc \uc131\ubd84 \ub610\ub294 \ud5a5\ub8cc \uc790\uccb4\uc758 \uc0ac\uc6a9**\uc774 \uc77c\ubd80 \uc0ac\uc6a9\uc790\uc5d0\uac8c \ubd80\uc815\uc801\uc778 \uacbd\ud5d8\uc744 \uc8fc\uace0 \uc788\uc74c\uc744 \ub098\ud0c0\ub0c5\ub2c8\ub2e4.\n\n**\ube44\uc988\ub2c8\uc2a4 \uc784\ud329\ud2b8 \ubd84\uc11d (helpful_count \uae30\ubc18):**\n'\uce58\uc774\uce74\uc640\uc655'\uc758 162\ub77c\ub294 \uc555\ub3c4\uc801\uc778 helpful_count\ub294 '\ubc00\ub9bc/\ubb49\uce68 \ud604\uc0c1'\uc774 \uc0ac\uc6a9\uc790\ub4e4\uc5d0\uac8c \uac00\uc7a5 \ud070 \ubd88\ud3b8\uc744 \ucd08\ub798\ud558\uace0 \uc788\uc74c\uc744 \uba85\ud655\ud788 \ubcf4\uc5ec\uc90d\ub2c8\ub2e4. \ub610\ud55c 'Sol'\uc758 86\uacfc 11, '\uc800\ud584\ub9d8\uc778\ub3a8\uc5ec'\uc758 11\uacfc 8 \uc5ed\uc2dc '\ubc00\ub9bc \ud604\uc0c1'\uc774 \uc804\ubc18\uc801\uc73c\ub85c \uc2ec\uac01\ud55c \ubb38\uc81c\uc784\uc744 \ub4b7\ubc1b\uce68\ud569\ub2c8\ub2e4. \uc774\uc640 \ub354\ubd88\uc5b4 '\uc608\uc9c0\uc778\uc624\ub385'(1), 'gi****'(0), 'kimese****'(0), 'thdwlsdk****'(1) \ub4f1 \uc790\uadf9 \ubc0f \ud2b8\ub7ec\ube14 \uad00\ub828 \uc5b8\uae09\ub3c4 \uc801\uc9c0 \uc54a\uc740 \uacf5\uac10\uc744 \uc5bb\uace0 \uc788\uc5b4 \uc8fc\ubaa9\ud574\uc57c \ud569\ub2c8\ub2e4.\n\n#### 1-B. '\ub3c4\uc6c0\ub3fc\uc694' \uc9c0\ud45c\ub97c \ud65c\uc6a9\ud55c \ud575\uc2ec \ubb38\uc81c \uc6b0\uc120\uc21c\uc704\ud654\n\n\uc885\ud569\uc801\uc778 \ubd84\uc11d \uacb0\uacfc, \ubcf8 \uc81c\ud488\uc758 \ud574\uacb0\uc774 \uc2dc\uae09\ud55c Top 3 Critical Issues\ub294 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4.\n\n1.  **1\uc21c\uc704: \uc2ec\uac01\ud55c \ubc00\ub9bc \ubc0f \ubb49\uce68 \ud604\uc0c1 (Critical Issue 1: Severe Pilling & Clumping)**\n    *   **\uadfc\uac70:** \uc555\ub3c4\uc801\uc73c\ub85c \ub192\uc740 'helpful_count' (\uce58\uc774\uce74\uc640\uc655 162, Sol 86, \uc800\ud584\ub9d8\uc778\ub3a8\uc5ec 11, 8 \ub4f1)\ub97c \ud1b5\ud574 \uc0ac\uc6a9\uc790\ub4e4\uc758 \uad11\ubc94\uc704\ud558\uace0 \uae4a\uc740 \ubd88\ud3b8\ud568\uc744 \ud655\uc778\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub294 \uc81c\ud488 \uc0ac\uc6a9 \uacbd\ud5d8 \uc790\uccb4\ub97c \uc800\ud574\ud558\ub294 \uac00\uc7a5 \uce58\uba85\uc801\uc778 \ubb38\uc81c\uc785\ub2c8\ub2e4. \uc81c\ud615 \ubd88\uc548\uc815\uc131 \ub610\ub294 \uc131\ubd84 \ubc30\ud569 \uc624\ub958\uac00 \uadfc\ubcf8 \uc6d0\uc778\uc73c\ub85c \ucd94\uc815\ub429\ub2c8\ub2e4.\n\n2.  **2\uc21c\uc704: \uacfc\ub3c4\ud55c \ubc88\ub4e4\uac70\ub9bc \ubc0f \uc720\ubd84\uac10 (Critical Issue 2: Excessive Greasiness & Oiliness)**\n    *   **\uadfc\uac70:** '\ubc88\ub4e4\uac70\ub9bc'\uc740 \ud1a4\uc5c5 \uc120\ud06c\ub9bc\uc758 \uc8fc\uc694 \ubd88\ub9cc \uc0ac\ud56d \uc911 \ud558\ub098\ub85c \uc5ec\ub7ec \ub9ac\ubdf0\uc5d0\uc11c \ubc18\ubcf5\uc801\uc73c\ub85c \uc5b8\uae09\ub418\uc5c8\uc2b5\ub2c8\ub2e4 (Sy222, Lvyn, \uccb4\ub098\ube14\ub77c\uc378, mym****, kjo**** \ub4f1). \uc774\ub294 \ud2b9\ud788 \uc9c0\uc131 \ubc0f \ubcf5\ud569\uc131 \ud53c\ubd80 \ud0c0\uc785 \uc0ac\uc6a9\uc790\ub4e4\uc5d0\uac8c \uc5ec\ub984\ucca0 \uc0ac\uc6a9\uc744 \uc5b4\ub835\uac8c \ub9cc\ub4e4\uace0 \ub9cc\uc871\ub3c4\ub97c \ud06c\uac8c \ub5a8\uc5b4\ub728\ub9ac\ub294 \uc694\uc778\uc785\ub2c8\ub2e4. \uc720\ubd84 \uc131\ubd84\uc758 \uacfc\ub2e4\ud568\uc774 \uc6d0\uc778\uc73c\ub85c \ucd94\uc815\ub429\ub2c8\ub2e4.\n\n3.  **3\uc21c\uc704: \ud53c\ubd80 \uc790\uadf9 \ubc0f \ud2b8\ub7ec\ube14 \uc720\ubc1c \uac00\ub2a5\uc131 (Critical Issue 3: Potential for Skin Irritation & Breakouts)**\n    *   **\uadfc\uac70:** \ube44\ub85d \uc5b8\uae09 \ube48\ub3c4\uac00 \uc55e\uc120 \ub450 \ubb38\uc81c\ub9cc\ud07c \ub192\uc9c0\ub294 \uc54a\uc9c0\ub9cc, '\uc608\uc9c0\uc778\uc624\ub385', 'gi****', 'kimese****', 'thdwlsdk****' \ub4f1 \uc790\uadf9, \ub530\uac00\uc6c0, \ud2b8\ub7ec\ube14 \uc720\ubc1c\uc744 \uacbd\ud5d8\ud55c \uc0ac\uc6a9\uc790\ub4e4\uc758 \ub9ac\ubdf0\ub294 '\uc5b4\uc131\ucd08 \uc9c4\uc815'\uc774\ub77c\ub294 \uc81c\ud488\uc758 \ud575\uc2ec \ucee8\uc149\uacfc \uc0c1\ubc18\ub418\ub294 \uacb0\uacfc\uc785\ub2c8\ub2e4. \uc774\ub294 \uc18c\uc218\uc5d0\uac8c \ub9e4\uc6b0 \uce58\uba85\uc801\uc778 \ubb38\uc81c\ub85c, \uc81c\ud488\uc758 \uc548\uc804\uc131 \ubc0f \uc2e0\ub8b0\ub3c4\uc5d0 \uc9c1\uc811\uc801\uc778 \uc601\ud5a5\uc744 \ubbf8\uce60 \uc218 \uc788\uc73c\uba70, \uc228\uaca8\uc9c4 \uce58\uba85\uc801 \ubb38\uc81c\ub85c \uac04\uc8fc\ub429\ub2c8\ub2e4.\n\n\uc774 \uc138 \uac00\uc9c0 \ubb38\uc81c\uc810\uc744 \ucd5c\uc6b0\uc120\uc73c\ub85c \ud574\uacb0\ud558\ub294 \ub370 \uc9d1\uc911\ud574\uc57c \ud569\ub2c8\ub2e4.\n\n### \ubb38\uc81c\uc810\uacfc \ud575\uc2ec \ud0c0\uac9f \uadf8\ub8f9 \uc5f0\uacb0 (Link Issues to Key Target Segments)\n\n\uc774\ub7ec\ud55c \ud575\uc2ec \ubb38\uc81c\uc810\ub4e4\uc740 \uc8fc\ub85c **\ubcf5\ud569\uc131 \ud53c\ubd80 \ud0c0\uc785** \uc0ac\uc6a9\uc790\uc5d0\uac8c\uc11c \ub450\ub4dc\ub7ec\uc9c0\uac8c \ub098\ud0c0\ub0a9\ub2c8\ub2e4. \uc804\uccb4 \ub9ac\ubdf0 \uc911 \uc57d 70% \uc774\uc0c1\uc774 '\ubcf5\ud569\uc131' \ud53c\ubd80 \ud0c0\uc785\uc744 \uc5b8\uae09\ud558\uac70\ub098, \ud53c\ubd80 \ud0c0\uc785 \ud3c9\uac00\uc5d0\uc11c '\ubcf5\ud569\uc131\uc5d0 \uc88b\uc544\uc694'\ub77c\uace0 \ud45c\uae30\ud558\uace0 \uc788\uc2b5\ub2c8\ub2e4. \ubcf5\ud569\uc131 \ud53c\ubd80\ub294 T\uc874\uc740 \uc9c0\uc131, U\uc874\uc740 \uac74\uc131\uc778 \uacbd\uc6b0\uac00 \ub9ce\uc544 \ub2e4\uc591\ud55c \uc0ac\uc6a9\uac10\uc5d0 \ubbfc\uac10\ud55c \ud3b8\uc785\ub2c8\ub2e4. '\ubc00\ub9bc', '\ubc88\ub4e4\uac70\ub9bc', '\uac74\uc870\ud568\uc73c\ub85c \uc778\ud55c \uac01\uc9c8 \ubd80\uac01', '\ud2b8\ub7ec\ube14' \ub4f1 \ub2e4\uc591\ud55c \ubb38\uc81c\uac00 \ubcf5\ud569\uc801\uc73c\ub85c \ub098\ud0c0\ub098\ub294 \uc774\uc720\uac00 \uc5ec\uae30\uc5d0 \uc788\uc2b5\ub2c8\ub2e4. \ub530\ub77c\uc11c \uc6b0\ub9ac\ub294 **\ubcf5\ud569\uc131 \ud53c\ubd80 \ud0c0\uc785 \uc0ac\uc6a9\uc790\ub4e4\uc758 \ub2c8\uc988\ub97c \ucda9\uc871\uc2dc\ud0a4\uae30 \uc704\ud55c \uc81c\ud488 \uac1c\uc120\uc5d0 \uc9d1\uc911**\ud574\uc57c \ud569\ub2c8\ub2e4.\n\n### \ub370\uc774\ud130 \uae30\ubc18\uc758 \uc2e4\ud589 \uac00\ub2a5\ud55c \uc131\uc7a5 \uc804\ub7b5 \ub3c4\ucd9c (Formulate Data-Driven Growth Strategies)\n\n#### \uc804\ub7b5 \uc81c\uc548 1: \ud3ec\ubbac\ub7ec \ubc0f \uad6c\uc131 \uc694\uc18c \uac1c\uc120 (Formula & Component Improvement)\n\n**1. \ud575\uc2ec \ubb38\uc81c \ud574\uacb0:**\n*   **\ubc00\ub9bc/\ubb49\uce68 \ud604\uc0c1 \uc644\ud654:** \uc0ac\uc6a9\uc790 \uacbd\ud5d8\uc744 \uc2ec\uac01\ud558\uac8c \uc800\ud574\ud558\ub294 '\ubc00\ub9bc \ubc0f \ubb49\uce68 \ud604\uc0c1'\uc744 \ud574\uacb0\ud558\uae30 \uc704\ud574 **(\ucd94\uc815) \uace0\ubd84\uc790\ub7c9\uc758 \uc99d\uc810\uc81c\ub098 \ud2b9\uc815 \uc720\ud654\uc81c\uc758 \ubc30\ud569 \ubb38\uc81c\ub97c \uc810\uac80\ud558\uace0 \uc218\uc815**\ud574\uc57c \ud569\ub2c8\ub2e4. \uc785\uc790 \uac04 \uc751\uc9d1\ub825\uc744 \ub192\uc774\ub294 \ub3d9\uc2dc\uc5d0 \ud53c\ubd80 \uc704\uc5d0\uc11c \ubd80\ub4dc\ub7fd\uac8c \ud37c\uc9c0\ub294 \uc0c8\ub85c\uc6b4 **\uace0\ubd84\uc790 \uac94 \ub124\ud2b8\uc6cc\ud06c \uc2dc\uc2a4\ud15c**\uc744 \ub3c4\uc785\ud558\uac70\ub098, **(\ucd94\uc815) \ud544\ub984 \ud615\uc131\uc81c\uc758 \uc885\ub958 \ubc0f \ud568\ub7c9\uc744 \uc870\uc808**\ud558\uc5ec \ubb49\uce68 \uc5c6\uc774 \uade0\uc77c\ud558\uac8c \ub3c4\ud3ec\ub418\ub3c4\ub85d \uac1c\uc120\ud558\ub294 \ubc29\uc548\uc744 \uc81c\uc548\ud569\ub2c8\ub2e4. \ud14d\uc2a4\ucc98\ub97c \uc720\uc5f0\ud558\uac8c \ub9cc\ub4e4 \uc218 \uc788\ub294 **(\ucd94\uc815) \uc2e4\ub9ac\ucf58 \uc5d8\ub77c\uc2a4\ud1a0\uba38** \ub610\ub294 **\ucf54\ud3f4\ub9ac\uba38 \uacc4\uc5f4\uc758 \uc131\ubd84 \ud568\ub7c9 \uc870\uc808**\uc744 \ud1b5\ud574 \uc0ac\uc6a9\uac10 \uac1c\uc120\uc744 \ubaa8\uc0c9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n*   **\ubc88\ub4e4\uac70\ub9bc \uc5b5\uc81c \ubc0f \uc720\ubd84\uac10 \uc870\uc808:** '\ubc88\ub4e4\uac70\ub9bc' \ubb38\uc81c \ud574\uacb0\uc744 \uc704\ud574 **(\ucd94\uc815) \uc624\uc77c \ud761\ucc29 \ud30c\uc6b0\ub354(\uc2e4\ub9ac\uce74, \uc804\ubd84 \uc720\ub3c4\uccb4 \ub4f1)\uc758 \ud568\ub7c9\uc744 \ub298\ub9ac\uac70\ub098 \uc785\uc790 \ud06c\uae30\ub97c \uc870\uc808**\ud558\uc5ec \ud53c\uc9c0 \ubd84\ube44\uc5d0 \ub530\ub978 \ubc88\ub4e4\uac70\ub9bc\uc744 \ud6a8\uacfc\uc801\uc73c\ub85c \uc81c\uc5b4\ud560 \uc218 \uc788\ub3c4\ub85d \uac1c\uc120\ud569\ub2c8\ub2e4. \ub610\ud55c, \uc218\ubd84\uac10\uc744 \uc81c\uacf5\ud558\uba74\uc11c\ub3c4 \ub048\uc801\uc784 \uc5c6\ub294 \ub9c8\ubb34\ub9ac\uac10\uc744 \uc120\uc0ac\ud558\ub294 **\ud558\uc774\ub4dc\ub85c\uac94 \uae30\ubc18\uc758 \uc218\ubd84 \uc804\ub2ec \uc2dc\uc2a4\ud15c**\uc744 \ub3c4\uc785\ud558\ub294 \uac83\uc744 \uace0\ub824\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n*   **\ud53c\ubd80 \uc790\uadf9 \ubc0f \ud2b8\ub7ec\ube14 \uc720\ubc1c \uac00\ub2a5\uc131 \ucd5c\uc18c\ud654:** '\uc5b4\uc131\ucd08 \uc9c4\uc815'\uc774\ub77c\ub294 \ucee8\uc149\uc5d0 \ubd80\ud569\ud558\ub3c4\ub85d \uc81c\ud488\uc758 \uc804\ubc18\uc801\uc778 **\uc21c\uc751\ub3c4\ub97c \ub192\uc5ec\uc57c \ud569\ub2c8\ub2e4.** **(\ucd94\uc815) \ud5a5\ub8cc, \uc5d0\ud0c4\uc62c, \ud639\uc740 \uc77c\ubd80 \ubc29\ubd80 \uc2dc\uc2a4\ud15c\uc758 \ud568\ub7c9\uc744 \ub0ae\ucd94\uac70\ub098 \uc800\uc790\uadf9 \ub300\uccb4\uc7ac\ub85c \ubcc0\uacbd**\ud558\ub294 \uac83\uc744 \ucd5c\uc6b0\uc120\uc73c\ub85c \uac80\ud1a0\ud569\ub2c8\ub2e4. \ubbfc\uac10\uc131 \ud53c\ubd80\ub97c \uac00\uc9c4 \uc0ac\uc6a9\uc790\ub4e4\uc774 \uc548\uc2ec\ud558\uace0 \uc0ac\uc6a9\ud560 \uc218 \uc788\ub3c4\ub85d **\ud53c\ubd80 \ud14c\uc2a4\ud2b8 \ubc0f \uc548\uc815\uc131 \ud14c\uc2a4\ud2b8\ub97c \uac15\ud654**\ud558\uace0, \uc5b4\uc131\ucd08 \uc678\uc5d0\ub3c4 \ud310\ud14c\ub180, \ubcd1\ud480 \ucd94\ucd9c\ubb3c \ub4f1 \ucd94\uac00\uc801\uc778 \uc9c4\uc815 \uc131\ubd84\uc744 \ubc30\ud569\ud558\uc5ec \uc2dc\ub108\uc9c0\ub97c \ub192\uc774\ub294 \ubc29\uc548\uc744 \uace0\ub824\ud569\ub2c8\ub2e4.\n\n**2. \uc0ac\uc6a9\uc790 \uadf8\ub8f9\ubcc4 \ucd5c\uc801\ud654:**\n\ubcf5\ud569\uc131 \ud53c\ubd80 \ud0c0\uc785 \uc0ac\uc6a9\uc790\ub4e4\uc774 \ub9cc\uc871\ud560 \uc218 \uc788\ub3c4\ub85d, T\uc874\uc758 \uc720\ubd84\uac10\uc740 \uc7a1\uc544\uc8fc\uba74\uc11c U\uc874\uc758 \uac74\uc870\ud568\uc740 \ucf00\uc5b4\ud560 \uc218 \uc788\ub294 **\uade0\ud615 \uc7a1\ud78c \ubcf4\uc2b5 \ubc0f \uc720\ubd84 \uc870\uc808 \uae30\ub2a5\uc744 \uac15\ud654**\ud569\ub2c8\ub2e4. \ubc1c\ub9bc\uc131 \uba74\uc5d0\uc11c\ub294 \ubb49\uce68 \uc5c6\uc774 \ubd80\ub4dc\ub7fd\uac8c \ud3b4 \ubc1c\ub9ac\uba74\uc11c\ub3c4, \uacfc\ub3c4\ud55c \uad11\ucc44\ubcf4\ub2e4\ub294 **\uc740\uc740\ud55c \uad11\ucc44 \ub610\ub294 \uc138\ubbf8\ub9e4\ud2b8\ud55c \ub9c8\ubb34\ub9ac\uac10**\uc744 \uc81c\uacf5\ud558\uc5ec \ud30c\uc6b4\ub370\uc774\uc158\uacfc\uc758 \uad81\ud569\uc744 \uc88b\uac8c \ub9cc\ub4dc\ub294 \ubc29\ud5a5\uc73c\ub85c \uc81c\ud615\uc744 \ucd5c\uc801\ud654\ud569\ub2c8\ub2e4.\n\n**3. \ubd88\ud544\uc694 \uc694\uc18c \uc81c\uac70:**\n\uc81c\ud488 \ubcf8\uc5f0\uc758 \uae30\ub2a5(\uc790\uc678\uc120 \ucc28\ub2e8, \ud1a4\uc5c5)\uc5d0 \ubd80\uc815\uc801\uc778 \uc601\ud5a5\uc744 \ubbf8\uce58\uac70\ub098 \uc0ac\uc6a9\uc790 \uacbd\ud5d8\uc744 \ud574\uce58\ub294 \ubd88\ud544\uc694\ud55c \uc694\uc18c\ub4e4\uc744 \uc81c\uac70\ud569\ub2c8\ub2e4. \ud2b9\ud788 **\ubd88\ud638\uac00 \uac08\ub9ac\ub294 \uac15\ud55c \ud5a5\uc740 \ucd5c\ub300\ud55c \uc904\uc774\uac70\ub098, \uc740\uc740\ud558\uace0 \uc790\uc5f0\uc2a4\ub7ec\uc6b4 \uc794\ud5a5\uc73c\ub85c \ubcc0\uacbd**\ud558\ub294 \uac83\uc744 \uace0\ub824\ud569\ub2c8\ub2e4. \ub610\ud55c, \uacfc\ub3c4\ud55c \ubc31\ud0c1\uc774\ub098 \ubb49\uce68\uc744 \uc720\ubc1c\ud560 \uc218 \uc788\ub294 \ud2b9\uc815 **\uc0c9\uc18c \ubc30\ud569\uc744 \uc7ac\uac80\ud1a0**\ud558\uace0 \uc790\uc5f0\uc2a4\ub7ec\uc6b4 \ud1a4\uc5c5 \ud6a8\uacfc\ub97c \uad6c\ud604\ud560 \uc218 \uc788\ub294 \ubc29\ud5a5\uc73c\ub85c \uc218\uc815\ud569\ub2c8\ub2e4.\n\n#### \uc804\ub7b5 \uc81c\uc548 2: \uc81c\ud488 \ud3ec\ud2b8\ud3f4\ub9ac\uc624 \ubc0f \uacbd\uc7c1 \uc804\ub7b5 (Product Portfolio & Competitive Strategy)\n\n**\uc2dc\uc7a5 \uae30\ud68c \uc815\uc758:**\n\ud574\ub2f9 \uc81c\ud488\uc740 '\ud1a4\uc5c5 \uc120\ud06c\ub9bc'\uc774\ub77c\ub294 \uce74\ud14c\uace0\ub9ac \ub0b4\uc5d0\uc11c **'\ubc00\ub9bc', '\ubc88\ub4e4\uac70\ub9bc', '\uc790\uadf9'**\uc774\ub77c\ub294 \uba85\ud655\ud55c \ubb38\uc81c\uc810\uc744 \uac00\uc9c0\uace0 \uc788\uc5b4, \uae30\uc874 \uad6c\ub2ec\uc758 \ud1a4\uc5c5 \uc120\ud06c\ub9bc \ub77c\uc778\uc5d0 \ub300\ud55c \ucda9\uc131 \uace0\uac1d\uce35\ubfd0\ub9cc \uc544\ub2c8\ub77c \uc2e0\uaddc \uace0\uac1d\uce35\uc5d0\uac8c\ub3c4 \ubd80\uc815\uc801\uc778 \uc778\uc2dd\uc744 \uc2ec\uc5b4\uc8fc\uc5c8\uc2b5\ub2c8\ub2e4. \ud2b9\ud788 \ubcf5\ud569\uc131, \uc9c0\uc131 \ud53c\ubd80\ub97c \uac00\uc9c4 \uc0ac\uc6a9\uc790\ub4e4\uc740 \uc774\ub7ec\ud55c \ubb38\uc81c\ub85c \uc778\ud574 \ud1a4\uc5c5 \uc120\ud06c\ub9bc \uc0ac\uc6a9\uc744 \ub9dd\uc124\uc774\uac70\ub098 \ub2e4\ub978 \ub300\uc548\uc744 \ucc3e\uace0 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub294 **'\uc790\uadf9 \uc5c6\uc774 \ubc00\ub9bc \uc5c6\uc774 \uc790\uc5f0\uc2a4\ub7fd\uac8c \ud1a4\uc5c5\ub418\ub294 \uc120\ud06c\ub9bc'**\uc5d0 \ub300\ud55c \uac15\ub825\ud55c \uc2dc\uc7a5 \ub2c8\uc988\uac00 \uc874\uc7ac\ud568\uc744 \uc2dc\uc0ac\ud558\uba70, \uad6c\ub2ec\uc774 \uc774 \uc2dc\uc7a5 \uacf5\ubc31\uc744 \uacf5\ub7b5\ud560 \uc218 \uc788\ub294 \uc808\ud638\uc758 \uae30\ud68c\uc785\ub2c8\ub2e4. \ud604\uc7ac\uc758 \uc2e4\ud328\ub294 \uc624\ud788\ub824 \ud0c0\uac9f \uace0\uac1d\uc758 \uba85\ud655\ud55c \ub2c8\uc988\ub97c \ud30c\uc545\ud558\uace0, \uc774\ub97c \ucda9\uc871\uc2dc\ud0a4\ub294 \ucc28\uc138\ub300 \uc81c\ud488 \uac1c\ubc1c\uc758 \ubc1c\ud310\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n**\uc804\ub7b5 \uc635\uc158:**\n\n*   **\uc635\uc158 A: \uac1c\uc120 \ubc0f \ub9ac\ud3ec\uc9c0\uc154\ub2dd \uc804\ub7b5 (\uae30\uc874 \uc81c\ud488 \uac15\ud654)**\n    *   **\uc804\ub7b5 \uac1c\uc694:** \uc55e\uc11c \uc81c\uc548\ub41c \ud3ec\ubbac\ub7ec \uac1c\uc120\uc744 \ud1b5\ud574 '\ubc00\ub9bc/\ubb49\uce68', '\ubc88\ub4e4\uac70\ub9bc', '\uc790\uadf9' \ubb38\uc81c\ub97c \ud574\uacb0\ud55c \ud6c4, \uc81c\ud488\uc758 \uac15\uc810(\uc608: \ud1a4\uc5c5 \ud6a8\uacfc\uc758 \uc790\uc5f0\uc2a4\ub7ec\uc6c0, \ucd09\ucd09\ud568 \ub4f1 \uc794\uc874\ud558\ub294 \uae0d\uc815\uc801 \uc694\uc18c)\uc744 \ubd80\uac01\ud558\uba70 **'\ubcf5\ud569\uc131 \ud53c\ubd80\ub97c \uc704\ud55c \ubc00\ub9bc \uc5c6\ub294 \uc790\uc5f0\uc2a4\ub7ec\uc6b4 \ud1a4\uc5c5 \uc120\ud06c\ub9bc'**\uc73c\ub85c \ud3ec\uc9c0\uc154\ub2dd\uc744 \uc7ac\uc815\uc758\ud569\ub2c8\ub2e4.\n    *   **\uc2e4\ud589 \ubc29\uc548:**\n        *   \uc81c\ud488 \ub124\uc774\ubc0d\uc5d0 '\ubc00\ub9bc \ubc29\uc9c0', '\ud53c\ubd80 \uc800\uc790\uadf9' \ub4f1\uc758 \ud0a4\uc6cc\ub4dc\ub97c \ucd94\uac00\ud558\uc5ec \uac1c\uc120\ub41c \uc81c\ud488\uc784\uc744 \uba85\ud655\ud788 \ud569\ub2c8\ub2e4.\n        *   \ub9c8\ucf00\ud305 \ucea0\ud398\uc778\uc744 \ud1b5\ud574 \uac1c\uc120\ub41c \uc0ac\uc6a9\uac10(\uc608: \ub864\ub9c1 \ud14c\uc2a4\ud2b8, \ud30c\uc6b4\ub370\uc774\uc158 \ubc00\ucc29 \ud14c\uc2a4\ud2b8)\uc744 \uc2dc\uac01\uc801\uc73c\ub85c \ubcf4\uc5ec\uc8fc\uba70 \uc2e0\ub8b0\ub97c \uad6c\ucd95\ud569\ub2c8\ub2e4.\n        *   \uae30\uc874 \uad6c\ub2ec\uc758 '\uc5b4\uc131\ucd08 \uc9c4\uc815' \ub77c\uc778\uacfc\uc758 \uc5f0\uad00\uc131\uc744 \uc720\uc9c0\ud558\ub418, '\ubc00\ub9bc \uc5c6\ub294 \uc5b4\uc131\ucd08 \uc9c4\uc815 \ud1a4\uc5c5 \uc120\ud06c\ub9bc'\uacfc \uac19\uc774 \uc81c\ud488\uc758 \ud575\uc2ec \uac1c\uc120 \uc0ac\ud56d\uc744 \uac15\uc870\ud569\ub2c8\ub2e4.\n\n*   **\uc635\uc158 B: \uc2e0\uaddc \ub77c\uc778 \ud655\uc7a5 \uc804\ub7b5 (\uc0c8\ub85c\uc6b4 \ud601\uc2e0 \uc2dc\ub3c4)**\n    *   **\uc804\ub7b5 \uac1c\uc694:** \uc774\ubc88 \uc81c\ud488\uc758 \uc2e4\ud328\uc5d0\uc11c \uc5bb\uc740 \uad50\ud6c8\uc744 \ubc14\ud0d5\uc73c\ub85c, **'\ud53c\ubd80 \ud0c0\uc785\ubcc4 \ub9de\ucda4 \ud1a4\uc5c5 \uc120\ud06c\ub9bc'** \ub77c\uc778\uc744 \uc0c8\ub86d\uac8c \uae30\ud68d\ud569\ub2c8\ub2e4. '\ubc00\ub9bc \uc5c6\ub294 \ubcf5\ud569\uc131 \ud53c\ubd80\uc6a9', '\uc0b0\ub73b\ud55c \uc9c0\uc131 \ud53c\ubd80\uc6a9', '\ucd09\ucd09\ud55c \uac74\uc131 \ud53c\ubd80\uc6a9' \ub4f1 \uc138\ubd84\ud654\ub41c \ub2c8\uc988\ub97c \ucda9\uc871\uc2dc\ud0a4\ub294 \ub2e4\uc591\ud55c \uc81c\ud615\uacfc \uae30\ub2a5\uc758 \ud1a4\uc5c5 \uc120\ud06c\ub9bc\uc744 \ucd9c\uc2dc\ud558\uc5ec \uc2dc\uc7a5 \uc9c0\ubc30\ub825\uc744 \uac15\ud654\ud569\ub2c8\ub2e4.\n    *   **\uc2e4\ud589 \ubc29\uc548:**\n        *   \uac00\uc7a5 \uc2dc\uae09\ud55c \uac1c\uc120\uc774 \ud544\uc694\ud55c \ubcf5\ud569\uc131 \ud53c\ubd80\uc6a9 \ud1a4\uc5c5 \uc120\ud06c\ub9bc\uc744 '\ud504\ub85c\uc81d\ud2b8 \uba85: \uc820\ud2c0\ud1a4(GentleTone)'\uc73c\ub85c \uba85\uba85\ud558\uace0, \ucd5c\uc2e0 \uc81c\ud615 \uae30\uc220\uc744 \uc801\uc6a9\ud558\uc5ec \ucd9c\uc2dc\ud569\ub2c8\ub2e4.\n        *   \uc774\ud6c4, \uc9c0\uc131 \ud53c\ubd80\ub97c \uc704\ud55c \uac15\ub825\ud55c \ud53c\uc9c0 \ucee8\ud2b8\ub864 \uae30\ub2a5\uacfc \uc0b0\ub73b\ud55c \ub9c8\ubb34\ub9ac\uac10\uc744 \uac16\ucd98 '\ub9e4\ud2b8\ud1a4(MatteTone)', \uac74\uc131 \ud53c\ubd80\ub97c \uc704\ud55c \uc9c0\uc18d\uc801\uc778 \ubcf4\uc2b5\uacfc \uc740\uc740\ud55c \uad11\ucc44\ub97c \uc81c\uacf5\ud558\ub294 '\ud558\uc774\ub4dc\ub77c\ud1a4(HydraTone)' \ub77c\uc778\uc744 \uc21c\ucc28\uc801\uc73c\ub85c \ucd9c\uc2dc\ud569\ub2c8\ub2e4.\n        *   \uac01 \ub77c\uc778\ubcc4\ub85c \uba85\ud655\ud55c \ud0c0\uac9f \uace0\uac1d\uce35\uacfc \ucc28\ubcc4\ud654\ub41c \uc0ac\uc6a9\uac10\uc744 \uac15\uc870\ud558\uba70 \ub9c8\ucf00\ud305\uc744 \uc804\uac1c\ud569\ub2c8\ub2e4.\n\n#### \uc804\ub7b5 \uc81c\uc548 3: \ub9c8\ucf00\ud305 \ubc0f \ucee4\ubba4\ub2c8\ucf00\uc774\uc158 \ucd5c\uc801\ud654 (Marketing & Communication Optimization)\n\n**1. \uac00\uce58 \uc81c\uc548(Promise) \uc7ac\uc815\uc758:**\n\uae30\uc874\uc758 \ubaa8\ud638\ud55c '\ub9d1\uc740 \uc5b4\uc131\ucd08 \uc9c4\uc815 \uc218\ubd84 \ud1a4\uc5c5'\uc774\ub77c\ub294 \uc57d\uc18d\uc5d0\uc11c \ubc97\uc5b4\ub098, **'\ubc00\ub9bc, \ubb49\uce68, \ubc88\ub4e4\uac70\ub9bc \uc5c6\uc774 \ubcf5\ud569\uc131 \ud53c\ubd80\ub3c4 \ud3b8\uc548\ud558\uac8c \uc0ac\uc6a9\ud560 \uc218 \uc788\ub294 \uc790\uc5f0\uc2a4\ub7ec\uc6b4 \ud1a4\uc5c5 \uc120\ud06c\ub9bc'**\uc73c\ub85c \uac00\uce58 \uc81c\uc548\uc744 \uba85\ud655\ud788 \ud569\ub2c8\ub2e4.\n\uc608\uc2dc: \"\ubbfc\uac10\ud558\uace0 \ubcf5\ud569\uc131\uc778 \ud53c\ubd80\ub3c4 \ud558\ub8e8 \uc885\uc77c \ubc00\ub9bc \uc5c6\uc774 \uc0b0\ub73b\ud558\uac8c! \uad6c\ub2ec [\uac1c\uc120\ub41c \uc81c\ud488\uba85]\uc73c\ub85c \uc790\uc5f0\uc2a4\ub7ec\uc6b4 \ud1a4\uc5c5\uacfc \ud655\uc2e4\ud55c \uc790\uc678\uc120 \ucc28\ub2e8\uc744 \uacbd\ud5d8\ud558\uc138\uc694.\"\n\n**2. \uae30\ub300\uce58 \uad00\ub9ac \uac00\uc774\ub4dc (Proactive Guide):**\n\ubc18\ubcf5\ub418\ub294 '\ubc00\ub9bc' \ud604\uc0c1\uc744 \uc608\ubc29\ud558\uae30 \uc704\ud574, \uc81c\ud488 \uc0c1\uc138 \ud398\uc774\uc9c0, \uc720\ud29c\ube0c \uc1fc\uce20, \uc778\uc2a4\ud0c0\uadf8\ub7a8 \ub9b4\uc2a4 \ub4f1 \uc8fc\uc694 \ucc44\ub110\uc5d0 **'\uad6c\ub2ec \ud1a4\uc5c5 \uc120\ud06c\ub9bc 100% \ud65c\uc6a9\ubc95'**\uacfc \uac19\uc740 \ucf58\ud150\uce20\ub97c \uc801\uadf9\uc801\uc73c\ub85c \ub178\ucd9c\ud569\ub2c8\ub2e4.\n*   **\ucd94\ucc9c \uc0ac\uc6a