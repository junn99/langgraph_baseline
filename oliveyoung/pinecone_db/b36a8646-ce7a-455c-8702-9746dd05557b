b2e4.\n        *   **\ub2e4\uc591\ud55c \ud0c0\uc785 \uc81c\uacf5**: '\ud38c\ud551 \ud0c0\uc785' (\uc62c \ud074\ub9ac\uc5b4 \ub354\ube14 \uc6cc\uc2dc \ud3fc)\uc740 \uac04\ud3b8\ud55c \uc0ac\uc6a9\uac10\uc744, '\ud29c\ube0c \ud0c0\uc785' (\uc62c \ud074\ub9ac\uc5b4 \ub354\ube14 \uc6cc\uc2dc)\uc740 \ud48d\ubd80\ud558\uace0 \ucac0\ucac0\ud55c \uac70\ud488 \uacbd\ud5d8\uc744 \uc81c\uacf5\ud558\uc5ec \uc0ac\uc6a9\uc790\uc758 \uc120\ud638\uc5d0 \ub530\ub77c \uc120\ud0dd\uc9c0\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4. (\uae30\ud68d\uc138\ud2b8\uc758 \uc8fc \uc81c\ud488\uc740 \ud29c\ube0c \ud0c0\uc785\uc73c\ub85c \ubcf4\uc784)\n\n## 4. \uace0\uac1d \ub9ac\ubdf0 \uc2ec\uce35 \ubd84\uc11d (In-depth Review Analysis)\n\n*   **\ub9ac\ubdf0 \uc694\uc57d \ubc0f \uac10\uc131 \ubd84\uc11d**: (\uc2e4\uc81c \uace0\uac1d \ub9ac\ubdf0 \ub370\uc774\ud130\ub294 \uc81c\uacf5\ub418\uc9c0 \uc54a\uc558\uc73c\ubbc0\ub85c, \uc81c\ud488\uc758 \ucee8\uc149 \ubc0f \ub9c8\ucf00\ud305 \uba54\uc2dc\uc9c0\ub97c \uae30\ubc18\uc73c\ub85c \uc608\uc0c1\ub418\ub294 \uc18c\ube44\uc790 \ubc18\uc751\uc744 \ubd84\uc11d\ud569\ub2c8\ub2e4.)\n    *   \uc81c\ud488\uc740 '\uc62c\ud0ac \ud074\ub80c\uc9d5', '2-in-1', '\ub525 \ud074\ub80c\uc9d5', '\uc800\uc790\uadf9', '\ubcf4\uc2b5' \ub4f1\uc758 \ud0a4\uc6cc\ub4dc\ub85c \ud64d\ubcf4\ub418\uace0 \uc788\uc73c\uba70, \uc18c\ube44\uc790\ub294 \uc774\ub7ec\ud55c \ud6a8\ub2a5\uacfc \ud3b8\ub9ac\ud568\uc5d0 \uae0d\uc815\uc801\uc778 \ubc18\uc751\uc744 \ubcf4\uc77c \uac83\uc73c\ub85c \uc608\uc0c1\ub429\ub2c8\ub2e4.\n    *   \ud2b9\ud788, \ubcf5\uc7a1\ud55c \ud074\ub80c\uc9d5 \ub2e8\uacc4\ub97c \uc904\uc774\uace0 \uba54\uc774\ud06c\uc5c5\uacfc \ub178\ud3d0\ubb3c\uc744 \ud655\uc2e4\ud788 \uc81c\uac70\ud558\uba74\uc11c\ub3c4 \ud53c\ubd80 \ubd80\ub2f4\uc744 \uc904\uc5ec\uc8fc\ub294 \uc810\uc5d0 \ub9cc\uc871\ud560 \uac00\ub2a5\uc131\uc774 \ub192\uc2b5\ub2c8\ub2e4.\n\n*   **\uae0d\uc815 \ub9ac\ubdf0 \ud575\uc2ec \ud14c\ub9c8 (Praised For)**:\n    *   **\ud6a8\ub2a5**: \uc9c4\ud55c \uba54\uc774\ud06c\uc5c5, \uaf3c\uaf3c\ud55c \uc120\ud06c\ub9bc, \ubaa8\uacf5 \uc18d \ub178\ud3d0\ubb3c\uae4c\uc9c0 \ub9d0\ub054\ud558\uac8c \uc9c0\uc6cc\uc9c4\ub2e4\ub294 \uc810. \ud074\ub80c\uc9d5 \ud6a8\uacfc\uc5d0 \ub300\ud55c \ub9cc\uc871\ub3c4\uac00 \ub192\uc744 \uac83\uc73c\ub85c \uc608\uc0c1\ub429\ub2c8\ub2e4.\n    *   **\uc0ac\uc6a9\uac10/\uc81c\ud615**: \ucac0\ucac0\ud558\uac70\ub098 \ud48d\ubd80\ud55c \uac70\ud488\uc758 \uc0ac\uc6a9\uac10, \uadf8\ub9ac\uace0 \uc138\uc548 \ud6c4 \ud53c\ubd80\uac00 \ub2f9\uae30\uc9c0 \uc54a\uace0 \ubd80\ub4dc\ub7ec\uc6b0\uba70 \ucd09\ucd09\ud55c \ub9c8\ubb34\ub9ac\uac10\uc5d0 \ub300\ud55c \uce6d\ucc2c\uc774 \uc608\uc0c1\ub429\ub2c8\ub2e4.\n    *   **\uc790\uadf9\uc131**: \ubbfc\uac10\ud55c \ud53c\ubd80\uc5d0\ub3c4 \uc21c\ud558\uac8c \uc0ac\uc6a9\ud560 \uc218 \uc788\ub2e4\ub294 \uc810, \uc790\uadf9\uc774 \uc801\ub2e4\ub294 \uc810\uc774 \uc8fc\uc694 \uce6d\ucc2c \ud3ec\uc778\ud2b8\uac00 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n*   **\uae30\ud68d \uc778\uc0ac\uc774\ud2b8 (Actionable Insights)**:\n    *   **\uba85\ud655\ud55c \ubb38\uc81c \ud574\uacb0**: \uc18c\ube44\uc790\ub4e4\uc774 \ud074\ub80c\uc9d5 \uacfc\uc815\uc5d0\uc11c \uacaa\ub294 \ubd88\ud3b8\ud568(\ubc88\uac70\ub85c\uc6c0, \ubd80\uc871\ud55c \uc138\uc815\ub825, \uc790\uadf9, \uac74\uc870\ud568)\uc744 \uc815\ud655\ud788 \uc9da\uc5b4\ub0b4\uace0 \uc774\ub97c '2-in-1', '\uc62c\ud0ac', '\uc800\uc790\uadf9', '\ubcf4\uc2b5'\uc774\ub77c\ub294 \ud575\uc2ec \ud6a8\ub2a5\uc73c\ub85c \ud574\uacb0\ud574\uc8fc\ub294 \uc810\uc774 \uac15\ub825\ud55c \uc131\uacf5 \uc694\uc778\uc774 \ub420 \uac83\uc785\ub2c8\ub2e4.\n    *   **\uacbd\ud5d8 \uae30\ubc18 \ub9c8\ucf00\ud305**: '\ub9c8\uc774\ud06c\ub85c \ud074\ub9ac\uc5b4 \ud14c\ud06c\ub180\ub85c\uc9c0'\uc640 '\uc2e4\ud06c \uc5d0\uc13c\uc2a4', '\ub354\ube14 \ud788\uc54c\ub8e8\ub860\uc0b0'\uacfc \uac19\uc740 \uc131\ubd84 \ubc0f \uae30\uc220\uba85\uc744 \ud1b5\ud574 \uc81c\ud488\uc758 \ud6a8\ub2a5\uacfc \ucc28\ubcc4\uc810\uc744 \uad6c\uccb4\uc801\uc73c\ub85c \uc81c\uc2dc\ud558\ub294 \uac83\uc774 \uc18c\ube44\uc790 \uc2e0\ub8b0\ub97c \uc5bb\ub294 \ub370 \uc911\uc694\ud569\ub2c8\ub2e4.\n    *   **\uc2dc\uac01\uc801 \uc99d\uba85**: \ube14\ub799\ud5e4\ub4dc \uc81c\uac70 \uc804\ud6c4 \uc0ac\uc9c4 \ub4f1\uc740 \ud074\ub80c\uc9d5 \ud6a8\uacfc\ub97c \uc2dc\uac01\uc801\uc73c\ub85c \ud655\uc2e4\ud558\uac8c \ubcf4\uc5ec\uc8fc\uc5b4 \uc18c\ube44\uc790\uc758 \uad6c\ub9e4 \uacb0\uc815\uc744 \ub3d5\uc2b5\ub2c8\ub2e4.\n\n## 5. \uc2dc\uac01\uc801 \ucee8\uc149 \ubd84\uc11d (Visual Concept Analysis)\n\n*   **\uba54\uc778 \uceec\ub7ec \ud314\ub808\ud2b8**:\n    *   **\uc8fc\uc870\uc0c9 (Primary)**:\n        *   **\uc0c9\uc0c1**: \ub77c\uc774\ud2b8 \ube14\ub8e8 / \uc544\ucfe0\uc544 \ube14\ub8e8 (Light Blue / Aqua Blue)\n        *   **\ud32c\ud1a4 \ucf54\ub4dc (\ub300\ud45c\uc801)**: 306 C\n        *   **\uc758\ubbf8**: \uccad\ub7c9\ud568, \uae68\ub057\ud568, \uc218\ubd84\uac10, \uc2e0\uc120\ud568, \ud22c\uba85\ud568. \uc81c\ud488\uc758 \ud074\ub80c\uc9d5 \uae30\ub2a5\uacfc \ubcf4\uc2b5 \ud6a8\uacfc\ub97c \uc2dc\uac01\uc801\uc73c\ub85c \uc804\ub2ec\ud569\ub2c8\ub2e4.\n    *   **\ubcf4\uc870\uc0c9 (Secondary)**:\n        *   **\uc0c9\uc0c1**: \ud654\uc774\ud2b8 (White)\n        *   **\ud32c\ud1a4 \ucf54\ub4dc (\ub300\ud45c\uc801)**: White\n        *   **\uc758\ubbf8**: \uc21c\uc218\ud568, \uae68\ub057\ud568, \ubd80\ub4dc\ub7ec\uc6c0, \uc548\uc804\ud568. \uc81c\ud488\uc758 \uc800\uc790\uadf9\uc131 \ubc0f \uc21c\ud55c \uc0ac\uc6a9\uac10\uc744 \uac15\uc870\ud558\ub294 \ub370 \uc0ac\uc6a9\ub429\ub2c8\ub2e4. \uac70\ud488\uc758 \uc774\ubbf8\uc9c0\uc640\ub3c4 \uc5f0\uacb0\ub429\ub2c8\ub2e4.\n    *   **\uac15\uc870\uc0c9 (Accent)**:\n        *   **\uc0c9\uc0c1**: \ud551\ud06c / \ud53c\uce58 (Pink / Peach)\n        *   **\ud32c\ud1a4 \ucf54\ub4dc (\ub300\ud45c\uc801)**: 1755 C\n        *   **\uc758\ubbf8**: \ubd80\ub4dc\ub7ec\uc6c0, \uce5c\uadfc\ud568, \uadc0\uc5ec\uc6c0. \ub9c8\uc2a4\ucf54\ud2b8 \uce90\ub9ad\ud130\uc5d0 \uc0ac\uc6a9\ub418\uc5b4 \uc81c\ud488\uc758 \uc811\uadfc\uc131\uacfc \uce5c\uadfc\uac10\uc744 \ub192\uc785\ub2c8\ub2e4.\n        *   **\uc0c9\uc0c1**: \ud2f8 / \ubbfc\ud2b8 \uadf8\ub9b0 (Teal / Mint Green)\n        *   **\ud32c\ud1a4 \ucf54\ub4dc (\ub300\ud45c\uc801)**: 325 C\n        *   **\uc758\ubbf8**: \uc0c1\ucf8c\ud568, \uc790\uc5f0\uc2a4\ub7ec\uc6c0. \ud074\ub80c\uc9d5 \uc6cc\ud130 \uc81c\ud488 \ub4f1\uc5d0 \uc0ac\uc6a9\ub418\uc5b4 \ucc28\ubcc4\ud654\ub41c \ub290\ub08c\uc744 \uc90d\ub2c8\ub2e4.\n        *   **\uc0c9\uc0c1**: \uc610\ub85c\uc6b0 (Yellow)\n        *   **\ud32c\ud1a4 \ucf54\ub4dc (\ub300\ud45c\uc801)**: 108 C\n        *   **\uc758\ubbf8**: \ud2b9\ubcc4\ud568, \uac00\uce58, \ud61c\ud0dd. '+15g'\uc640 \uac19\uc740 \ud504\ub85c\ubaa8\uc158 \uc815\ubcf4\uc5d0 \uc0ac\uc6a9\ud558\uc5ec \uc8fc\ubaa9\ub3c4\ub97c \ub192\uc785\ub2c8\ub2e4.\n\n*   **\ud575\uc2ec \uc2dc\uac01 \uc694\uc18c (Key Visuals)**:\n    *   **\uc81c\ud488 \uc774\ubbf8\uc9c0**: \uc81c\ud488\uc758 \uc6a9\uae30(\ud29c\ube0c, \ud38c\ud504)\uc640 \ud14d\uc2a4\ucc98(\uac70\ud488)\ub97c \uba85\ud655\ud558\uac8c \ubcf4\uc5ec\uc8fc\ub294 \uc774\ubbf8\uc9c0.\n    *   **\ub9c8\uc2a4\ucf54\ud2b8 \uce90\ub9ad\ud130**: \uadc0\uc5fd\uace0 \uce5c\uadfc\ud55c \uce90\ub9ad\ud130 \ub514\uc790\uc778\uc744 \ud65c\uc6a9\ud558\uc5ec \uc81c\ud488\uc758 \ubd80\ub4dc\ub7ec\uc6c0, \uc21c\ud568, \uc0ac\uc6a9\uc758 \uc990\uac70\uc6c0\uc744 \uc804\ub2ec\ud569\ub2c8\ub2e4.\n    *   **\uac70\ud488/\ubb3c\ubc29\uc6b8 \uadf8\ub798\ud53d**: \ud074\ub80c\uc9d5 \ud6a8\uacfc\uc640 \uc218\ubd84\uac10\uc744 \uc2dc\uac01\uc801\uc73c\ub85c \ud45c\ud604\ud558\ub294 \uc694\uc18c\ub85c \ubc18\ubcf5\uc801\uc73c\ub85c \uc0ac\uc6a9\ub429\ub2c8\ub2e4.\n    *   **Before & After \uc774\ubbf8\uc9c0**: \ud53c\ubd80 \uac1c\uc120 \ud6a8\uacfc\ub97c \uc9c1\uad00\uc801\uc73c\ub85c \ubcf4\uc5ec\uc8fc\uc5b4 \uc81c\ud488\uc758 \uc131\ub2a5\uc744 \uc99d\uba85\ud569\ub2c8\ub2e4.\n    *   **\uc544\uc774\ucf58 \ubc0f \ud3ec\uc778\ud2b8 \uc124\uba85**: '2in1', 'POINT 1, 2, 3, 4' \ub4f1 \ud575\uc2ec \ud2b9\uc9d5\uc744 \uba85\ud655\ud558\uace0 \uc2dc\uac01\uc801\uc73c\ub85c \uc778\uc9c0\ud558\uae30 \uc27d\uac8c \uc804\ub2ec\ud558\ub294 \uadf8\ub798\ud53d \uc694\uc18c\ub4e4.\n    *   **\ud14d\uc2a4\ud2b8 \uc560\ub2c8\uba54\uc774\uc158/\ud0c0\uc774\ud3ec\uadf8\ub798\ud53c**: '\uc62c\ud0ac \ud074\ub80c\uc9d5', '\ub525 \ud074\ub80c\uc9d5' \ub4f1 \ud575\uc2ec \uba54\uc2dc\uc9c0\ub97c \uac15\uc870\ud558\ub294 \ub3d9\uc801\uc778 \ud0c0\uc774\ud3ec\uadf8\ub798\ud53c\ub97c \uc0ac\uc6a9\ud569\ub2c8\ub2e4.", "type": "Document"}}