6e8\uc774\ud06c\uba54\uc774\ud06c X \ud0dc\ub2dd \ud3ec\ucc28\ucf54 \ucf5c\ub77c\ubcf4 \uc5d0\ub514\uc158\n\n# 1. \uc81c\ud488 \uae30\ubcf8 \uc815\ubcf4 (Product Identity)\n- **\uc81c\ud488\uba85**: \uc6e8\uc774\ud06c\uba54\uc774\ud06c \ud5ec\uc2dc \uae00\ub85c\uc6b0 \ubc24 \uc2a4\ud2f1 (\ud0dc\ub2dd \ud3ec\ucc28\ucf54 \ucf5c\ub77c\ubcf4 \uc5d0\ub514\uc158)\n- **\ube0c\ub79c\ub4dc**: \uc6e8\uc774\ud06c\uba54\uc774\ud06c (wakemake)\n- **\ud575\uc2ec \ud6a8\ub2a5**: \ub9d1\uace0 \uac74\uac15\ud55c \uc0dd\uae30 \uae00\ub85c\uc6b0 \uc5f0\ucd9c, \uc785\uc220 \ubcf4\uc2b5 \ubc0f \uc601\uc591 \uacf5\uae09, \ud3b8\uc548\ud55c \ubc00\ucc29\uac10\n\n# 2. \ucee8\uc149 \uc2ec\uce35 \ubd84\uc11d (In-depth Concept Analysis)\n- **\ud0c0\uac9f \uace0\uac1d \ubc0f \ubb38\uc81c \uc81c\uae30 (Problem)**:\n  - **\ud0c0\uac9f**:\n    - \uadc0\uc5fd\uace0 \uc0ac\ub791\uc2a4\ub7ec\uc6b4 \uce90\ub9ad\ud130 \ucf5c\ub77c\ubcf4\ub808\uc774\uc158\uc744 \uc120\ud638\ud558\ub294 10\ub300 \ud6c4\ubc18 ~ 20\ub300 \uc911\ubc18\uc758 \uace0\uac1d\uce35.\n    - \uafb8\ubbfc \ub4ef \uc548 \uafb8\ubbfc \ub4ef \uc790\uc5f0\uc2a4\ub7ec\uc6b4 \uba54\uc774\ud06c\uc5c5\uc744 \uc120\ud638\ud558\ub294 \uace0\uac1d.\n    - \uac74\uc870\ud558\uac70\ub098 \uc0dd\uae30 \uc5c6\ub294 \uc785\uc220\uc5d0 \uace0\ubbfc\uc744 \uac00\uc9c4 \uace0\uac1d.\n    - \ub9bd \uc81c\ud488 \ud558\ub098\ub85c \uc5ec\ub7ec \ubd80\uc704\uc5d0 \ud65c\uc6a9 \uac00\ub2a5\ud55c \uba40\ud2f0 \uc544\uc774\ud15c\uc744 \ucc3e\ub294 \uace0\uac1d.\n  - **\uace0\ubbfc**:\n    - \uce59\uce59\ud558\uace0 \uc0dd\uae30 \uc5c6\ub294 \uc785\uc220 \ud1a4.\n    - \uac74\uc870\ud568\uc73c\ub85c \uc778\ud55c \uc785\uc220 \uac08\ub77c\uc9d0 \ubc0f \uac01\uc9c8 \ubd80\uac01.\n    - \ub2f5\ub2f5\ud558\uace0 \ubb34\uac70\uc6b4 \ub9bd \uc81c\ud615\uc5d0 \ub300\ud55c \ubd80\ub2f4\uac10.\n    - \uba54\uc774\ud06c\uc5c5 \uc2dc \uc5b4\ub514\uc5d0\ub098 \uc790\uc5f0\uc2a4\ub7fd\uac8c \uc5b4\uc6b8\ub9b4 \uceec\ub7ec\ub97c \ucc3e\ub294 \uc5b4\ub824\uc6c0.\n    - \uc18c\uc7a5 \uc695\uad6c\ub97c \uc790\uadf9\ud558\ub294 \uac1c\uc131 \uc788\uace0 \ud2b8\ub80c\ub514\ud55c \ub514\uc790\uc778 \uc81c\ud488\uc5d0 \ub300\ud55c \ub2c8\uc988.\n- **\ud575\uc2ec \ucee8\uc149 \ubc0f \ud574\uacb0\ucc45 (Solution)**:\n  - **\ud55c \uc904 \uc815\uc758**: \uadc0\uc5ec\uc6b4 \ud3ec\ucc28\ucf54 \uce90\ub9ad\ud130\uc640 \ud568\uaed8, \uc790\uc5f0\uc2a4\ub7ec\uc6b4 \uc0dd\uae30 \uae00\ub85c\uc6b0\uc640 \ucd09\ucd09\ud55c \ubcf4\uc2b5\uac10\uc744 \uc120\uc0ac\ud558\ub294 3-in-1 \uba40\ud2f0 \ub9bd \uc2a4\ud2f1.\n  - **\ud574\uacb0 \ubc29\uc2dd**:\n    - '\ub77c\uc988\ubca0\ub9ac\uc528 \uc624\uc77c'\uacfc '\uae00\ub85c\uc2dc \uc624\uc77c'\uc758 \uacb0\ud569\uc73c\ub85c \uc785\uc220\uc5d0 \uc218\ubd84\uacfc \uc601\uc591\uc744 \uacf5\uae09\ud558\uace0, \ube5b\uc744 \ubc18\uc0ac\uc2dc\ucf1c \uac74\uac15\ud558\uace0 \ub9d1\uc740 \uc0dd\uae30 \uae00\ub85c\uc6b0\ub97c \uc5f0\ucd9c\ud569\ub2c8\ub2e4.\n    - \ub2e8\ub2e8\ud55c \ubc24 \ud0c0\uc785 \uc2a4\ud2f1 \uc81c\ud615\uc73c\ub85c \ub9d1\uace0 \uc5ec\ub9bf\ud558\uac8c \uceec\ub7ec\ub97c \uc313\uc544 \uc62c\ub9b4 \uc218 \uc788\uc73c\uba70, \uc785\uc220\ubfd0\ub9cc \uc544\ub2c8\ub77c \uce58\ud06c, \uc5bc\uad74 \ub77c\uc778 \ub4f1 \uc6d0\ud558\ub294 \uacf3\uc5d0 \uc0dd\uae30\ub97c \ub354\ud558\ub294 \uba40\ud2f0 \uc720\uc988 \uae30\ub2a5\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4.\n    - \ubd80\ub4dc\ub7ec\uc6b4 \uc2ac\ub77c\uc774\ub529 \uc81c\ud615\uc73c\ub85c \uc785\uc220\uc5d0 \ud3b8\uc548\ud558\uac8c \ubc00\ucc29\ub418\uba70, \ubc14\uc05c \uc77c\uc0c1\uc5d0\uc11c\ub3c4 \uc27d\uace0 \ube60\ub974\uac8c \uc0ac\uc6a9\ud560 \uc218 \uc788\ub294 \uc774\uc9c0 \ud130\uce58\uc5c5 \uc2a4\ud2f1\uc785\ub2c8\ub2e4.\n    - \ud3ec\ucc28\ucf54 \uce90\ub9ad\ud130\uc640\uc758 \ucf5c\ub77c\ubcf4\ub808\uc774\uc158\uc744 \ud1b5\ud574 \uc81c\ud488\uc758 \uc18c\uc7a5 \uac00\uce58\ub97c \ub192\uc774\uace0 \uc2dc\uac01\uc801\uc778 \uc990\uac70\uc6c0\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4.\n- **\uc2a4\ud1a0\ub9ac\ud154\ub9c1 \ubc0f \ucc28\ubcc4\uc810 (Differentiation)**:\n  - **\ub3c5\uc790 \uc131\ubd84/\uae30\uc220**: '\ub77c\uc988\ubca0\ub9ac\uc528 \uc624\uc77c' (\uc218\ubd84, \uc601\uc591 \uacf5\uae09, \uac01\uc9c8 \ucf00\uc5b4), '\uae00\ub85c\uc2dc \uc624\uc77c' (\ube5b \ubc18\uc0ac, \ud5ec\uc2dc \uae00\ub85c\uc6b0 \uc5f0\ucd9c), '3-in-1 \uba40\ud2f0 \uc720\uc988' (\ub9bd, \uce58\ud06c, \uc5bc\uad74 \ub77c\uc778), '\uc18c\ud504\ud2b8 \uc2ac\ub77c\uc774\ub529 \uc81c\ud615' (\ud3b8\uc548\ud55c \ubc00\ucc29\uac10), '\ucee4\ube0c \ucef7\ud305' (\uc785\uc220 \uace1\uc120 \ub9de\ucda4).\n  - **\ud575\uc2ec \uc2ac\ub85c\uac74**: \"\uceec\ub7ec\ub294 \uc6e8\uc774\ud06c\uba54\uc774\ud06c\", \"MY LIPS, BUT HEALTHIER\", \"\ud5ec\uc2dc&\ud1a0\uc2a4\ud2f0 \uc378\uba38 LOOK\".\n  - **\ud575\uc2ec \uc6d0\ub8cc\uc640 \uadf8 \ud2b9\uc9d5\uacfc \uae30\ub2a5**:\n    - **\ub77c\uc988\ubca0\ub9ac\uc528 \uc624\uc77c**: \ud478\uc11d\ud558\uace0 \uac08\ub77c\uc9c4 \uc785\uc220\uc5d0 \ubcf4\uc2b5\uc744 \ub354\ud558\uace0 \uac01\uc9c8\uc744 \ucf00\uc5b4\ud558\uc5ec \ud65c\ub825\uc744 \ubd80\uc5ec\ud569\ub2c8\ub2e4.\n    - **\uae00\ub85c\uc2dc \uc624\uc77c**: \ube5b\uc744 \ud6a8\uacfc\uc801\uc73c\ub85c \ubc18\uc0ac\uc2dc\ucf1c \uac74\uac15\ud558\uace0 \ucd09\ucd09\ud55c \uc724\uad11\uc744 \ud45c\ud604\ud569\ub2c8\ub2e4.\n  - **\uae30\ud68d \uc778\uc0ac\uc774\ud2b8 (Actionable Insights)**:\n    - **\uce90\ub9ad\ud130 \ucf5c\ub77c\ubcf4\uc758 \uc131\uacf5 \uac00\ub2a5\uc131**: \uc778\uae30 \uce90\ub9ad\ud130 '\ud3ec\ucc28\ucf54'\uc640\uc758 \ud611\uc5c5\uc740 \ud0c0\uac9f \uace0\uac1d\uce35\uc758 \uad6c\ub9e4 \uc695\uad6c\ub97c \uac15\ud558\uac8c \uc790\uadf9\ud558\uba70, \ud55c\uc815\ud310\uc774\ub77c\ub294 \ud76c\uc18c\uc131\uc740 \uc18c\uc7a5 \uac00\uce58\ub97c \ub192\uc785\ub2c8\ub2e4.\n    - **'\uac74\uac15\ud55c \uc724\uad11' \ud2b8\ub80c\ub4dc \ubc18\uc601**: \uacfc\ub3c4\ud55c \uae00\ub85c\uc2dc\ud568\uc774 \uc544\ub2cc, \uc790\uc5f0\uc2a4\ub7fd\uace0 \uac74\uac15\ud574 \ubcf4\uc774\ub294 '\ud5ec\uc2dc \uae00\ub85c\uc6b0'\uc640 '\ud1a4\uc628\ud1a4' \uba54\uc774\ud06c\uc5c5 \ud2b8\ub80c\ub4dc\ub97c \ud6a8\uacfc\uc801\uc73c\ub85c \ubc18\uc601\ud588\uc2b5\ub2c8\ub2e4.\n    - **\uc2e4\uc6a9\uc131\uacfc \ud3b8\uc758\uc131**: 3-in-1 \uba40\ud2f0 \uc720\uc988 \uae30\ub2a5\uacfc \uc26c\uc6b4 \uc0ac\uc6a9\ubc95\uc740 \ubc14\uc05c \ud604\ub300 \uc18c\ube44\uc790\ub4e4\uc774 \ucd94\uad6c\ud558\ub294 \uc2e4\uc6a9\uc131\uacfc \ud3b8\ub9ac\uc131\uc744 \ub9cc\uc871\uc2dc\ud0b5\ub2c8\ub2e4.\n\n# 3. \uae30\uc220 \ubc0f \uac80\uc99d \ub370\uc774\ud130 (Technical & Evidential Data)\n- **\uc784\uc0c1/\uc2dc\ud5d8 \ub370\uc774\ud130**:\n  - \uc81c\uacf5\ub41c \uc790\ub8cc\uc5d0\uc11c \ud2b9\uc815 \uc784\uc0c1/\uc2dc\ud5d8 \uae30\uad00, \uc2dc\ud5d8 \ub300\uc0c1, \uc2dc\ud5d8\uba85, \uc2dc\ud5d8 \uacb0\uacfc \uc218\uce58\uc5d0 \ub300\ud55c \uad6c\uccb4\uc801\uc778 \uc815\ubcf4\ub294 \ud655\uc778\ub418\uc9c0 \uc54a\uc558\uc2b5\ub2c8\ub2e4.\n- **\uc0ac\uc6a9 \uacbd\ud5d8 \uc124\uacc4 (UX Design)**:\n  - **\uc0ac\uc6a9\ubc95 \ud2b9\uc9d5**:\n    - **3-in-1 \uba40\ud2f0 \uc720\uc988**: \ub9bd, \uce58\ud06c, \uc5bc\uad74 \ub77c\uc778 \ub4f1 \ub2e4\uc591\ud55c \ubd80\uc704\uc5d0 \ud65c\uc6a9 \uac00\ub2a5\ud558\uc5ec \ud65c\uc6a9\ub3c4\uac00 \ub192\uc2b5\ub2c8\ub2e4.\n    - **\uc18c\ud504\ud2b8 \uc2ac\ub77c\uc774\ub529**: \uc785\uc220\uc5d0 \uc2a4\uba70\ub4e4\ub4ef \ubd80\ub4dc\ub7fd\uac8c \ubc1c\ub9ac\uace0 \ud3b8\uc548\ud558\uac8c \ubc00\ucc29\ub418\ub294 \uc0ac\uc6a9\uac10\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4.\n    - **\uc774\uc9c0 \ud130\uce58\uc5c5**: \ubc14\uc05c \uc77c\uc0c1 \uc18d\uc5d0\uc11c\ub3c4 \uc27d\uace0 \ube60\ub974\uac8c \ub367\ubc14\ub974\uac70\ub098 \uc218\uc815\ud558\uae30 \uc6a9\uc774\ud569\ub2c8\ub2e4.\n    - **\ucee4\ube0c \ucef7\ud305**: \uc785\uc220\uc758 \uc790\uc5f0\uc2a4\ub7ec\uc6b4 \uace1\uc120\uc5d0 \ub9de\ucdb0 \uc124\uacc4\ub41c \ucef7\ud305\uc73c\ub85c \uc12c\uc138\ud558\uace0 \uc790\uc5f0\uc2a4\ub7ec\uc6b4 \ud45c\ud604\uc774 \uac00\ub2a5\ud569\ub2c8\ub2e4.\n    - **\ud1a4\uc628\ud1a4 \ubb34\ub4dc**: \uac19\uc740 \uacc4\uc5f4\uc758 \uceec\ub7ec\ub85c \uc785\uc220\uacfc \uce58\ud06c, \uc5bc\uad74 \ub77c\uc778\uc5d0 \ud1b5\uc77c\uac10\uc744 \uc8fc\uc5b4 \uc870\ud654\ub85c\uc6b4 \uba54\uc774\ud06c\uc5c5 \uc5f0\ucd9c\uc744 \ub3d5\uc2b5\ub2c8\ub2e4.\n\n# 4. \uace0\uac1d \ub9ac\ubdf0 \uc2ec\uce35 \ubd84\uc11d (In-depth Review Analysis)\n- **\ub9ac\ubdf0 \uc694\uc57d \ubc0f \uac10\uc131 \ubd84\uc11d**: (\uc81c\uacf5\ub41c \ud14d\uc2a4\ud2b8\ub294 \ud504\ub85c\ubaa8\uc158 \uc815\ubcf4\uc774\ubbc0\ub85c, \uace0\uac1d \ub9ac\ubdf0 \ub300\uc2e0 '\ub9c8\ucf00\ud305\uc801 \uae30\ub300 \ubc18\uc751'\uc73c\ub85c \ud574\uc11d)\n  \uc804\ubc18\uc801\uc73c\ub85c \uadc0\uc5ec\uc6b4 \ud3ec\ucc28\ucf54 \uce90\ub9ad\ud130 \ub514\uc790\uc778\uacfc \ud568\uaed8 '\uac74\uac15\ud55c \uc0dd\uae30', '\ucd09\ucd09\ud568', '\uc790\uc5f0\uc2a4\ub7ec\uc6b4 \uceec\ub7ec\uac10'\uc5d0 \ub300\ud55c \uae0d\uc815\uc801\uc778 \uae30\ub300\uac10\uc744 \uc870\uc131\ud569\ub2c8\ub2e4. \ud1a4\uc564\ub9e4\ub108\ub294 \ubc1d\uace0 \ud654\uc0ac\ud558\uba70, '\ud2b9\ubcc4\ud55c \uc120\ubb3c' \uac19\uc740 \ub290\ub08c\uc744 \uac15\uc870\ud569\ub2c8\ub2e4.\n- **\uae0d\uc815 \ub9ac\ubdf0 \ud575\uc2ec \ud14c\ub9c8 (Praised For)**:\n  - **\ud6a8\ub2a5**:\n    - **\uac74\uac15\ud558\uace0 \ub9d1\uc740 \uc0dd\uae30 \uae00\ub85c\uc6b0**: \uc790\uc5f0\uc2a4\ub7ec\uc6b4 \uc724\uae30\uc640 \ud608\uc0c9\uc744 \ubd80\uc5ec\ud558\uc5ec \uc0dd\uae30 \uc788\uc5b4 \ubcf4\uc774\ub294 \uc778\uc0c1\uc744 \uc90d\ub2c8\ub2e4.\n    - **\ucd09\ucd09\ud55c \ubcf4\uc2b5\uac10**: \uc785\uc220 \uc18d\uae4c\uc9c0 \ucc44\uc6cc\uc8fc\ub294 \ub4ef\ud55c \ubcf4\uc2b5\ub825\uc73c\ub85c \uac74\uc870\ud568\uc744 \ud574\uc18c\ud569\ub2c8\ub2e4.\n    - **\uc790\uc5f0\uc2a4\ub7ec\uc6b4 \ubc1c\uc0c9**: \ub9d1\uace0 \ud22c\uba85\ud558\uac8c \uc62c\ub77c\uc624\ub294 \uceec\ub7ec\ub85c \ubcf8\uc5f0\uc758 \uc785\uc220\uc0c9\ucc98\ub7fc \uc790\uc5f0\uc2a4\ub7fd\uc2b5\ub2c8\ub2e4.\n  - **\uc0ac\uc6a9\uac10/\uc81c\ud615**:\n    - **\ubd80\ub4dc\ub7fd\uace0 \ud3b8\uc548\ud55c \ubc00\ucc29\uac10**: \uc785\uc220\uc5d0 \ucc29 \ub2ec\ub77c\ubd99\ub294 \ub4ef\ud55c \uac00\ubcbc\uc6c0\uacfc \ubd80\ub4dc\ub7ec\uc6b4 \ubc1c\ub9bc\uc131\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4.\n    - **\ub048\uc801\uc784 \uc5c6\ub294 \ub9c8\ubb34\ub9ac**: \uae00\ub85c\uc2dc\ud568\uc5d0\ub3c4 \ubd88\uad6c\ud558\uace0 \ub048\uc801\uc784 \uc5c6\uc774 \uc0b0\ub73b\ud55c \ub9c8\ubb34\ub9ac\uac10\uc744 \uc120\uc0ac\ud569\ub2c8\ub2e4.\n  - **\uc790\uadf9\uc131**:\n    - \ud574\ub2f9 \uc815\ubcf4\ub294 \uc81c\uacf5\ub41c \ud14d\uc2a4\ud2b8\uc5d0 \uba85\uc2dc\uc801\uc73c\ub85c \ub098\ud0c0\ub098\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.\n- **\uae30\ud68d \uc778\uc0ac\uc774\ud2b8 (Actionable Insights)**:\n  - **\ucf5c\ub77c\ubcf4\uc758 \ub9e4\ub825 \uadf9\ub300\ud654**: \ud3ec\ucc28\ucf54 \uce90\ub9ad\ud130\uc758 \uadc0\uc5ec\uc6c0\uacfc \uc81c\ud488\uc758 '\uac74\uac15\ud55c \uc724\uad11' \ucee8\uc149\uc744 \uc5f0\uacb0\ud558\uc5ec \uac10\uc131\uc801\uc778 \ub9cc\uc871\uac10\uc744 \ub192\uc774\ub294 \uac83\uc774 \uc911\uc694\ud569\ub2c8\ub2e4.\n  - **\uba40\ud2f0 \uc720\uc988 \uac15\uc870**: \ub9bd \uc678\uc5d0 \uce58\ud06c, \ud558\uc774\ub77c\uc774\ud130 \ub4f1 \ub2e4\uc591\ud55c \ud65c\uc6a9\ubc95\uc744 \uba85\ud655\ud788 \uc81c\uc2dc\ud558\uc5ec \uc81c\ud488\uc758 \uc2e4\uc6a9\uc131\uc744 \uc5b4\ud544\ud574\uc57c \ud569\ub2c8\ub2e4.\n  - **\uc81c\ud615 \ubc0f \uceec\ub7ec\uc758 \uc790\uc5f0\uc2a4\ub7ec\uc6c0**: \uc778\uc704\uc801\uc778 \uad11\uc774 \uc544\ub2cc '\uac74\uac15\ud55c \uc724\uae30'\uc640 '\ubcf8\uc5f0\uc758 \uc0c9\ucc98\ub7fc' \uc790\uc5f0\uc2a4\ub7ec\uc6b4 \uceec\ub7ec \ud45c\ud604\uc5d0 \ub300\ud55c \ub2c8\uc988\uac00 \ub192\uc73c\ubbc0\ub85c, \uc774 \ubd80\ubd84\uc744 \uc2dc\uac01\uc801\uc73c\ub85c \uc798 \uc804\ub2ec\ud574\uc57c \ud569\ub2c8\ub2e4.\n\n# 5. \uc2dc\uac01\uc801 \ucee8\uc149 \ubd84\uc11d (Visual Concept Analysis)\n- **\uba54\uc778 \uceec\ub7ec \ud314\ub808\ud2b8**:\n  - **\uc8fc\uc870\uc0c9 (Primary)**:\n    - **\ud30c\uc2a4\ud154 \ube14\ub8e8 & \ud654\uc774\ud2b8**: \ubd80\ub4dc\ub7ec\uc6b4 \uc2a4\ud2b8\ub77c\uc774\ud504 \ud328\ud134\uc740 \uc2dc\uc6d0\ud558\uace0 \uae68\ub057\ud55c \uc5ec\ub984 \ubd84\uc704\uae30\uc640 \uc21c\uc218\ud55c \ub290\ub08c\uc744 \uc804\ub2ec\ud558\uba70, \ube0c\ub79c\ub4dc\uc758 \uc0b0\ub73b\ud568\uc744 \ub098\ud0c0\ub0c5\ub2c8\ub2e4. (\ud32c\ud1a4 \ucf54\ub4dc \ubbf8\uc81c\uacf5)\n  - **\ubcf4\uc870\uc0c9 (Secondary)**:\n    - **\ud30c\uc2a4\ud154 \ud551\ud06c, \ucf54\ub784, \ubca0\uc774\uc9c0**: \uc81c\ud488 \ud328\ud0a4\uc9c0, \uadf8\ub798\ud53d, \ub9bd \ubc1c\uc0c9 \uc0f7\uc5d0\uc11c \uc8fc\ub85c \uc0ac\uc6a9\ub418\uba70, \ub530\ub73b\ud558\uace0 \ubd80\ub4dc\ub7ec\uc6b4, \uc0ac\ub791\uc2a4\ub7ec\uc6b4 \ubd84\uc704\uae30\ub97c \uc5f0\ucd9c\ud569\ub2c8\ub2e4. (\ud32c\ud1a4 \ucf54\ub4dc \ubbf8\uc81c\uacf5)\n  - **\uac15\uc870\uc0c9 (Accent)**:\n    - **\ud3ec\ucc28\ucf54 \uce90\ub9ad\ud130 \uc0c9\uc0c1 (\ube0c\ub77c\uc6b4, \ube14\ub799, \ud551\ud06c)**: \uce90\ub9ad\ud130 \uc790\uccb4\uc758 \uc0dd\ub3d9\uac10\uacfc \uadc0\uc5ec\uc6c0\uc744 \uac15\uc870\ud558\uba70 \uc8fc\ubaa9\ub3c4\ub97c \ub192\uc785\ub2c8\ub2e4.\n    - **\ud56b\ud551\ud06c, \ub808\ub4dc \uacc4\uc5f4**: \uc77c\ubd80 \uc81c\ud488 \uceec\ub7ec \ubc0f \uadf8\ub798\ud53d \ud3ec\uc778\ud2b8\uc5d0 \uc0ac\uc6a9\ub418\uc5b4 \ud65c\ub825\uacfc \ud3ec\uc778\ud2b8\ub97c \ub354\ud569\ub2c8\ub2e4. (\ud32c\ud1a4 \ucf54\ub4dc \ubbf8\uc81c\uacf5)\n- **\ud575\uc2ec \uc2dc\uac01 \uc694\uc18c (Key Visuals)**:\n  - **\ud3ec\ucc28\ucf54 \uce90\ub9ad\ud130 \uc77c\ub7ec\uc2a4\ud2b8**: \uc120\uae00\ub77c\uc2a4\ub97c \ub07c\uace0 \ud574\ubcc0\uc5d0 \ub204\uc6cc\uc788\ub294 \ubaa8\uc2b5, \ud558\ud2b8 \ubaa8\uc591 \ud0a4\ub9c1 \ub4f1 \ucf5c\ub77c\ubcf4\ub808\uc774\uc158\uc758 \ud575\uc2ec \uc544\uc774\ucf58\uc73c\ub85c \ubc18\ubcf5\uc801\uc73c\ub85c \uc0ac\uc6a9\ub429\ub2c8\ub2e4.\n  - **\uc81c\ud488\ucef7 \ubc0f \uc0ac\uc6a9 \uc608\uc2dc**: \ub9bd \uc2a4\ud2f1 \uc790\uccb4\uc758 \ub514\uc790\uc778, \uc81c\ud615\uac10(\uae00\ub85c\uc2dc\ud568, \ubc1c\ub9bc\uc131)\uc744 \ubcf4\uc5ec\uc8fc\ub294 \ud074\ub85c\uc988\uc5c5 \uc0f7, \uc785\uc220\uacfc \uce58\ud06c\uc5d0 \uc801\uc6a9\ub41c \ubaa8\uc2b5\uc774 \uac15\uc870\ub429\ub2c8\ub2e4.\n  - **\ud14d\uc2a4\ud2b8 \uadf8\ub798\ud53d \uc694\uc18c**: \"Special Gift Line-up\", \"Check Point!\", \"Color Chart\", \"Best & New Color\" \ub4f1\uc758 \ud0a4 \uba54\uc2dc\uc9c0\ub97c \uc2dc\uac01\uc801\uc73c\ub85c \ub3cb\ubcf4\uc774\uac8c \ud558\ub294 \ub514\uc790\uc778 \uc694\uc18c\ub4e4\uc774 \uc0ac\uc6a9\ub429\ub2c8\ub2e4.\n  - **\uc5ec\ub984/\ud734\uc591\uc9c0 \ubaa8\ud2f0\ube0c**: \uc57c\uc790\uc218, \ud30c\ub77c\uc194, \uc870\uac1c \ub4f1 \uc5ec\ub984 \uc2dc\uc98c\uacfc \ucf5c\ub77c\ubcf4 \ucee8\uc149\uc744 \uc2dc\uac01\uc801\uc73c\ub85c \uc5f0\uacb0\ud558\ub294 \uc694\uc18c\ub4e4\uc774 \ud3ec\ud568\ub429\ub2c8\ub2e4.", "type": "Document"}}