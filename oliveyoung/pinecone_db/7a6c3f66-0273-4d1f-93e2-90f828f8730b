{"lc": 1, "type": "constructor", "id": ["langchain", "schema", "document", "Document"], "kwargs": {"metadata": {"name": "[\ub2e8\ub3c5\uae30\ud68d] \ud22c\ucfe8\ud3ec\uc2a4\ucfe8 \ud504\ub85c\ud0c0\uc8fc \ud39c\uc2ac", "brand": "\ud22c\ucfe8\ud3ec\uc2a4\ucfe8", "category": ["\uba54\uc774\ud06c\uc5c5", "\uc544\uc774\uba54\uc774\ud06c\uc5c5", "\uc544\uc774\ub77c\uc774\ub108"], "price": 12000, "volume": "1.1g", "manufacturer": "\uc2a4\uc644 / (\uc8fc)\ud22c\ucfe8\ud3ec\uc2a4\ucfe8", "review": "## \ud22c\ucfe8\ud3ec\uc2a4\ucfe8 \ud504\ub85c\ud0c0\uc8fc \ud39c\uc2ac \uc0ac\uc6a9\uc790 \ub9ac\ubdf0 \ubd84\uc11d \ubcf4\uace0\uc11c\n\n### \ud575\uc2ec \uc694\uc57d (Executive Summary)\n\n\ubcf8 \ubcf4\uace0\uc11c\ub294 \ud22c\ucfe8\ud3ec\uc2a4\ucfe8 \ud504\ub85c\ud0c0\uc8fc \ud39c\uc2ac \uc81c\ud488\uc5d0 \ub300\ud55c \uc0ac\uc6a9\uc790 \ub9ac\ubdf0 \ub370\uc774\ud130\ub97c \uc2ec\uce35 \ubd84\uc11d\ud558\uc5ec, \uc81c\ud488\uc758 \uc8fc\uc694 \ubb38\uc81c\uc810\uacfc \uc774\ub97c \uadf9\ubcf5\ud558\uae30 \uc704\ud55c \uc131\uc7a5 \uc804\ub7b5\uc744 \uc81c\uc2dc\ud569\ub2c8\ub2e4. \ubd84\uc11d \uacb0\uacfc, '\ub0ae\uc740 \uc9c0\uc18d\ub825'\uacfc '\uc81c\ud488 \ud30c\uc190 \ubc0f \uc0ac\uc6a9 \ud3b8\uc758\uc131 \ubd80\uc871'\uc774 \uc0ac\uc6a9\uc790\ub4e4\uc5d0\uac8c \uac00\uc7a5 \ud070 \ubd88\ub9cc\uc871\uc744 \uc57c\uae30\ud558\ub294 \ud575\uc2ec \ubb38\uc81c\ub85c \ub3c4\ucd9c\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \ud2b9\ud788 '\ub9ac\ubdf0\ub300\ub9c8\uc655'\ub2d8\uc758 \ub9ac\ubdf0\ub294 43\uac1c\uc758 '\ub3c4\uc6c0\ub3fc\uc694'\ub97c \uae30\ub85d\ud558\uba70 \uc81c\ud488\uc758 \uc2ec\uac01\ud55c \uc0ac\uc6a9\uac10 \ubb38\uc81c\ub97c \ub300\ud45c\uc801\uc73c\ub85c \ubcf4\uc5ec\uc90d\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ubb38\uc81c\ub4e4\uc740 \ud2b9\ud788 \ud53c\ubd80\uac00 \ubbfc\uac10\ud558\uac70\ub098 \uc12c\uc138\ud55c \uba54\uc774\ud06c\uc5c5\uc744 \uc120\ud638\ud558\ub294 \uc0ac\uc6a9\uc790\uce35\uc5d0\uac8c \ub354\uc6b1 \ub450\ub4dc\ub7ec\uc9c0\uac8c \ub098\ud0c0\ub098\ub294 \uacbd\ud5a5\uc744 \ubcf4\uc785\ub2c8\ub2e4. \uc774\uc5d0 \ub530\ub77c, \uc81c\ud488\uc758 \uc81c\ud615 \uac1c\uc120 \ubc0f \ub0b4\uad6c\uc131 \uac15\ud654, \uadf8\ub9ac\uace0 \uc0ac\uc6a9\uc790 \uacbd\ud5d8 \uc99d\uc9c4\uc744 \uc704\ud55c \ucee4\ubba4\ub2c8\ucf00\uc774\uc158 \uc804\ub7b5\uc744 \ud3ec\ud568\ud55c \uc2e4\ud589 \uac00\ub2a5\ud55c \uc131\uc7a5 \uc804\ub7b5\uc744 \uc81c\uc548\ud569\ub2c8\ub2e4.\n\n### \uc0c1\uc138 \ubd84\uc11d \ubc0f \uc6b0\uc120\uc21c\uc704 (Detailed Analysis & Prioritization)\n\n\uc18c\ube44\uc790 \ub9ac\ubdf0 \ub370\uc774\ud130\ub97c \uba74\ubc00\ud788 \ubd84\uc11d\ud55c \uacb0\uacfc, \ud22c\ucfe8\ud3ec\uc2a4\ucfe8 \ud504\ub85c\ud0c0\uc8fc \ud39c\uc2ac\uc740 \ub2e4\uc74c\uacfc \uac19\uc740 \uc8fc\uc694 \uc601\uc5ed\uc5d0\uc11c \ubd80\uc815\uc801\uc778 \ud53c\ub4dc\ubc31\uc744 \ubc1b\uace0 \uc788\uc5c8\uc2b5\ub2c8\ub2e4.\n\n**1. \uc81c\ud615 \ubc0f \uc0ac\uc6a9\uac10 \uc601\uc5ed:**\n\ub2e4\uc218\uc758 \uc0ac\uc6a9\uc790\uac00 \uc81c\ud488\uc758 \ubc1c\ub9bc\uc131\uc774 \uac74\uc870\ud558\uace0 \uac70\uce60\uc5b4 \ub208\uac00\uc5d0 \uc790\uadf9\uc744 \uc8fc\uac70\ub098 \ud1b5\uc99d\uc744 \uc720\ubc1c\ud55c\ub2e4\uace0 \uc5b8\uae09\ud588\uc2b5\ub2c8\ub2e4. '\ub9ac\ubdf0\ub300\ub9c8\uc655'\ub2d8\uc740 \"\uc560\uad50\uc0b4\uc5d0 \ubc14\ub97c \ub54c \ud53c\ubd80\uac00 \uc544\ud30c\uc694\", \"\ub208\ub450\ub369\uc774\ub098 \ubcfc\uc5d0 \ubc1c\ub77c\ubcf4\ub824\uace0 \uc5ec\ub7ec\ubc88 \uc2dc\ub3c4\ud574\ubd24\ub294\ub370 \uc77c\ub2e8 \ubc1c\uc0c9\uc774 \uc798 \uc548\ub3fc\uc11c \ub2e4\ub978 \uc81c\ud488 \ud55c\ub450\ubc88 \uc4f0\uc73d \ubc1c\uc0c9\ud558\uba74 \ub420\uac78 \uc774\uac74 \uba87\ubc88\uc529 \ubb38\uc9c8\ub7ec\uc57c\ud558\uace0 \uadf8 \uacfc\uc815\uc5d0\uc11c \ud53c\ubd80\uac00 \uc4f8\ub824\uc694\"\ub77c\uace0 \uc9c0\uc801\ud558\uba70, \ubc1c\ub9bc\uc131 \ubd80\uc871\uc774 \uc2ec\uac01\ud55c \uc0ac\uc6a9\uc790 \uacbd\ud5d8 \uc800\ud558\ub97c \uc57c\uae30\ud568\uc744 \ubcf4\uc5ec\uc90d\ub2c8\ub2e4. \ub610\ud55c, '\ub9d0\ud2f0\uce04'\ub2d8\uc740 \"\uc601\uc5ed \ucee8\ud2b8\ub864 \uc5b4\ub824\uc6c0. \uc544\ubb34\ub798\ub3c4 \uc5f0\ud544\ucc98\ub7fc \ub450\uaebc\uc6b4 \ud39c\uc2ac\uc774\ub2c8\uae50 \ubc14\ub97c \ub54c\ub3c4 \uc138\ubc00\ud558\uac8c \ubc14\ub974\uae30 \uc5b4\ub835\ub2ec\uae4c?\"\ub77c\uba70 \uc81c\ud488\uc758 \uc81c\ud615\uc774 \ub450\uaebc\uc6cc \uc815\uad50\ud55c \uc0ac\uc6a9\uc774 \uc5b4\ub835\ub2e4\ub294 \uc810\uc744 \uc9c0\uc801\ud588\uc2b5\ub2c8\ub2e4. \ucd1d '\ub3c4\uc6c0\ub3fc\uc694' 43\uac1c\ub97c \uae30\ub85d\ud55c '\ub9ac\ubdf0\ub300\ub9c8\uc655'\ub2d8\uc758 \ub9ac\ubdf0\uc5d0\uc11c \uc81c\uae30\ub41c \ubc1c\ub9bc\uc131 \ubb38\uc81c\ub294 \uc81c\ud488\uc758 \ud575\uc2ec \uae30\ub2a5 \uc218\ud589\uc5d0 \uc9c1\uc811\uc801\uc778 \uc601\ud5a5\uc744 \ubbf8\uce58\uba70, \uc0ac\uc6a9\uc790 \uacbd\ud5d8 \uc804\ubc18\uc5d0 \uac78\uccd0 \ubd80\uc815\uc801\uc778 \uc778\uc2dd\uc744 \ud615\uc131\ud558\ub294 \uc8fc\uc694 \uc694\uc778\uc73c\ub85c \ud310\ub2e8\ub429\ub2c8\ub2e4.\n\n**2. \uc131\ub2a5 \ubc0f \ud6a8\uacfc \uc601\uc5ed:**\n\uac00\uc7a5 \ube48\ubc88\ud558\uac8c \uc9c0\uc801\ub41c \ubb38\uc81c\ub294 '\uc9e7\uc740 \uc9c0\uc18d\ub825'\uc785\ub2c8\ub2e4. '\ub9d0\ud2f0\uce04'\ub2d8\uc740 \"\uc598\uac00 \uc81c\uc77c \uc9c0\uc18d\ub825\uc774 \uc57d\ud55c \ub290\ub08c\uc774\uc57c.. \uc194\uc9c1\ud788 \uc9c0\uc18d\ub825\uc774\ub77c\uace0 \ud560 \uac83\ub3c4 \ub531\ud788 \uc5c6\ub294 \ub290\ub08c? \uadf8\ub0e5 \ubc14\ub974\uace0\ub098\uba74.. \uc5b4\ub290\uc21c\uac04 \uc5c6\uc5b4\uc838\uc788\uc5b4\", 'mingki'\ub2d8\uc740 \"\uc9c0\uc18d\ub825 \uac1c\ub625. \uc800\ub294 \uc544\uc774\uba54\uc774\ud06c\uc5c5\uc744 \uc798\ud574\uc694... \uadf8\ub798\uc11c \uc774 \uc81c\ud488 \uc9c0\uc18d\ub825 \ub625\ub9dd\uc774\ub77c\ub294 \ud6c4\uae30 \uc815\ub9d0 \ub9ce\uc558\ub294\ub370... \uc57d a\uac04 \uc624\ubc14\ub97c \ubcf4\ud0dc\uc790\uba74 \uc9d1 \ub098\uc11c\ub294 \uc21c\uac04 \ub2e4 \ub0a0\uc544\uac00\ub294 \uac83 \uac19\uc544\uc694.\"\ub77c\uace0 \uc5b8\uae09\ud558\uba70 \uc81c\ud488\uc758 \uc9c0\uc18d\ub825\uc774 \ub9e4\uc6b0 \ub0ae\uc74c\uc744 \uac15\uc870\ud588\uc2b5\ub2c8\ub2e4. \ub610\ud55c, \uc77c\ubd80 \uc0ac\uc6a9\uc790\ub4e4\uc740 \ubc1c\uc0c9\ub825\uc774 \uae30\ub300\uc5d0 \ubbf8\uce58\uc9c0 \ubabb\ud55c\ub2e4\ub294 \uc758\uacac\uc744 \uc81c\uc2dc\ud588\uc2b5\ub2c8\ub2e4. '\ub9ac\ube59'\ub2d8\uc758 \uacbd\uc6b0 \"\uc800 \ub77c\uc774\ud2b8\ud1a4\uc778\ub370\ub3c4 \uc774\uac74 \uc880 \uc544\ub2cc \uac83 \uac19\uc2b5\ub2c8\ub2e4. \uc0ac\uc6a9\ud558\uae30\uac00 \ub108\ubb34 \uc5b4\ub835\uace0 \uc190\uc774 \uc548 \uac00\uc694.\"\ub77c\uace0 \uc5b8\uae09\ud558\uba70, \ud2b9\uc815 \ud53c\ubd80\ud1a4\uc5d0\uc11c\ub294 \ubc1c\uc0c9\uc774 \uc5b4\ub835\ub2e4\ub294 \uc810\uc744 \uc2dc\uc0ac\ud588\uc2b5\ub2c8\ub2e4. '\ub9d0\ud2f0\uce04'\ub2d8\uc758 \ub9ac\ubdf0\uc5d0 \uc5b8\uae09\ub41c \uc9e7\uc740 \uc9c0\uc18d\ub825\uacfc \ub354\ubd88\uc5b4 'mingki'\ub2d8\uc758 \uc9c0\uc18d\ub825\uc5d0 \ub300\ud55c \uac15\ud55c \ubd80\uc815\uc801 \ud53c\ub4dc\ubc31\uc740 \ub192\uc740 '\ub3c4\uc6c0\ub3fc\uc694' \uc218\ub97c \uae30\ub85d\ud558\uba70 \uc774 \ubb38\uc81c\uac00 \ub9ce\uc740 \uc0ac\uc6a9\uc790\uc5d0\uac8c \uacf5\uac10\uc744 \uc5bb\uace0 \uc788\uc74c\uc744 \ubcf4\uc5ec\uc90d\ub2c8\ub2e4.\n\n**3. \ud3ec\uc7a5 \ubc0f \uc0ac\uc6a9 \ud3b8\uc758\uc131 \uc601\uc5ed:**\n\uc81c\ud488\uc758 \ub192\uc740 \ud30c\uc190 \ube48\ub3c4 \ub610\ud55c \uc2ec\uac01\ud55c \ubb38\uc81c\uc810\uc73c\ub85c \uc9c0\uc801\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \uc5ec\ub7ec \ub9ac\ubdf0\uc5d0\uc11c \"\uc5f4\uc790\ub9c8\uc790 \ubd80\ub7ec\uc9d0\", \"\ub69c\uaed1 \uc5f4\uc790\ub9c8\uc790 \ub0b4\uc6a9\ubb3c \uc800\ub530\uad6c\ub85c \ubd84\ub9ac\ub410\ub294\ub370 \uc384\uac8c \ubd80\ub52a\ud78c \uac83\ub3c4 \uc544\ub2c8\uace0 \uadf8\ub0e5 \ud1a1\ud558\uace0 \u314b\u314b \ubd80\uc11c\uc9d0\", \"\uc624\ub298 \uad6c\ub9e4\ud558\uace0 \uac1c\ubd09\ud558\uc790\ub9c8\uc790.... \uc0c9\uae54\ud14c\uc2a4\ud2b8\ud574\ubcf4\ub824\uace0 \uc0b4\uc9dd \ub204\ub974\uc790\ub9c8\uc790!!!!\u3160\u3160\u3160\u3160\ub9e4\uc7a5 \ud14c\uc2a4\ud130\ub4e4\uc774 \uc65c \ub2e4 \uc9e7\uace0 \ubd80\ub7ec\uc838\uc788\ub294\uc9c0 \uc9c1\uc811 \uc368\ubcf4\uace0\uc57c \uc54c\uc558\uc5b4\uc694 \uc9c4\uc9dc \ud574\ub3c4\ud574\ub3c4\ub108\ubb34\ud55c \ub0b4\uad6c\uc131 \u3160\u3160\"\uc640 \uac19\uc740 \ub0b4\uc6a9\uc774 \ubc18\ubcf5\uc801\uc73c\ub85c \uc5b8\uae09\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \uc774\ub294 \uc81c\ud488 \uc790\uccb4\uc758 \ub0b4\uad6c\uc131 \ubb38\uc81c \ub610\ub294 \ud3ec\uc7a5 \ubc0f \uc6b4\uc1a1 \uacfc\uc815\uc5d0\uc11c\uc758 \ucda9\uaca9 \ud761\uc218 \ubd80\uc871\uc744 \uc2dc\uc0ac\ud569\ub2c8\ub2e4. \ub610\ud55c, \uc81c\ud488\uc744 \uc0ac\uc6a9\ud558\uae30 \uc704\ud574\uc11c\ub294 \ubcc4\ub3c4\uc758 \uc804\uc6a9 \uc0e4\ud504\ub108 \uad6c\ub9e4\uac00 \ud544\uc694\ud558\uac70\ub098, \uce7c\ub85c \uae4e\uc744 \uacbd\uc6b0\uc5d0\ub3c4 \uc2ec\uc774 \ubd80\uc11c\uc9c0\uac70\ub098 \uae38\uc774\uac00 \uc9e7\uc544\uc9c0\ub294 \ub4f1 \uc0ac\uc6a9 \ud3b8\uc758\uc131\uc774 \ub9e4\uc6b0 \ub0ae\ub2e4\ub294 \ubd88\ub9cc\uc774 \uc81c\uae30\ub418\uc5c8\uc2b5\ub2c8\ub2e4. '\ub9d0\ud2f0\uce04'\ub2d8\uc740 \"\uc798\ubd80\ub7ec\uc9d0 + \uac00\uc131\ube44\u2b07\ufe0f (\ud560\ub9d0\ub9ce\uc74c\uc8fc\uc758)\"\ub77c\ub294 \ud56d\ubaa9\uc5d0\uc11c \uc774\ub7ec\ud55c \ubb38\uc81c\uc810\uc744 \ud1b5\ud569\uc801\uc73c\ub85c \uc9c0\uc801\ud558\uba70, \uc2e4\uc9c8\uc801\uc778 \uc81c\ud488 \uc0ac\uc6a9\uc5d0 \ud070 \ubd88\ud3b8\uc744 \ucd08\ub798\ud558\uace0 \uc788\uc74c\uc744 \uac15\uc870\ud588\uc2b5\ub2c8\ub2e4.\n\n**4. \uac00\uce58 \ubc0f \uc804\ubc18\uc801 \uc778\uc2dd \uc601\uc5ed:**\n\uc55e\uc11c \uc5b8\uae09\ub41c \uc81c\ud615, \uc131\ub2a5, \uc0ac\uc6a9 \ud3b8\uc758\uc131 \ubb38\uc81c\ub4e4\ub85c \uc778\ud574 \uc804\ubc18\uc801\uc778 \uac00\uce58 \uc778\uc2dd \ub610\ud55c \ub0ae\uac8c \ub098\ud0c0\ub0ac\uc2b5\ub2c8\ub2e4. '\ub9d0\ud2f0\uce04'\ub2d8\uc740 \"\uc190\uc774 \uc798 \uc548\uac00\u3160\", '\ub9ac\ubdf0\ub300\ub9c8\uc655'\ub2d8\uc740 \"\uc5ec\ub7ec\ubd84\ub4e4\uc5d0\uac8c\ub3c4 \ucd94\ucc9c\uc548\ud574\uc694. \uc5ec\ub7ec\ubd84\uc758 \uc9c0\uac11\uc744 \uc9c0\ucf1c\ub4dc\ub9b4\uac8c\uc694\", 'mingki'\ub2d8\uc740 \"\uc644\uc804 \uc2e4\ud328\ud588\uc5b4\uc694. \ucc98\ubc15\ud15c +1\"\uc640 \uac19\uc774 \uc81c\ud488\uc5d0 \ub300\ud55c \ub0ae\uc740 \ub9cc\uc871\ub3c4\ub97c \ud45c\ud604\ud588\uc2b5\ub2c8\ub2e4. \ub610\ud55c, \uc77c\ubd80 \uc0ac\uc6a9\uc790\ub4e4\uc740 \uc81c\ud488\uc758 \ud5a5\uc5d0 \ub300\ud55c \ubd80\uc815\uc801\uc778 \uc758\uacac\ub3c4 \uc81c\uc2dc\ud588\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc804\ubc18\uc801\uc778 \ubd80\uc815\uc801 \uc778\uc2dd\uc740 \ube0c\ub79c\ub4dc \uc774\ubbf8\uc9c0\uc5d0\ub3c4 \uc601\ud5a5\uc744 \ubbf8\uce60 \uc218 \uc788\ub294 \uc911\uc694\ud55c \uc0ac\uc548\uc785\ub2c8\ub2e4.\n\n**'\ub3c4\uc6c0\ub3fc\uc694' \uc9c0\ud45c\ub97c \ud65c\uc6a9\ud55c \ud575\uc2ec \ubb38\uc81c \uc6b0\uc120\uc21c\uc704\ud654:**\n\n\uc885\ud569\uc801\uc778 \ub9ac\ubdf0 \ubd84\uc11d \ubc0f '\ub3c4\uc6c0\ub3fc\uc694' \uc218\uce58\ub97c \uae30\uc900\uc73c\ub85c \ubcfc \ub54c, \ub2e4\uc74c\uacfc \uac19\uc740 'Top 3 Critical Issues'\ub97c \uc6b0\uc120\uc801\uc73c\ub85c \ud574\uacb0\ud574\uc57c \ud560 \uacfc\uc81c\ub85c \uc120\uc815\ud569\ub2c8\ub2e4.\n\n1.  **\uc81c\ud488 \ud30c\uc190 \ubc0f \uc0ac\uc6a9 \ud3b8\uc758\uc131 \ubd80\uc871 (\uc6b0\uc120\uc21c\uc704 1):** '\ub3c4\uc6c0\ub3fc\uc694' \uc218\uac00 43\uac1c\uc5d0 \ub2ec\ud558\ub294 '\ub9ac\ubdf0\ub300\ub9c8\uc655'\ub2d8\uc744 \ube44\ub86f\ud558\uc5ec \uc218\ub9ce\uc740 \ub9ac\ubdf0\uc5d0\uc11c \uac1c\ubd09 \uc9c1\ud6c4 \ub610\ub294 \uc0ac\uc6a9 \uc911\uc5d0 \uc81c\ud488\uc774 \ubd80\uc11c\uc9c0\uac70\ub098 \uc81c\ub300\ub85c \uae4e\uc774\uc9c0 \uc54a\ub294\ub2e4\ub294 \ubb38\uc81c\uac00 \ubc18\ubcf5\uc801\uc73c\ub85c \uc81c\uae30\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \uc774\ub294 \uc81c\ud488 \uc790\uccb4\uc758 \ubcf8\uc9c8\uc801\uc778 \uacb0\ud568\uc73c\ub85c, \uc0ac\uc6a9\uc790\uac00 \uc81c\ud488\uc744 \uad6c\ub9e4\ud558\uace0\ub3c4 \uc81c\ub300\ub85c \uc0ac\uc6a9\ud558\uc9c0 \ubabb\ud558\uac8c \ud558\ub294 \uce58\uba85\uc801\uc778 \ubb38\uc81c\uc785\ub2c8\ub2e4. \ub530\ub77c\uc11c \ucd5c\uc6b0\uc120\uc801\uc73c\ub85c \uac1c\uc120\ud574\uc57c \ud569\ub2c8\ub2e4.\n2.  **\ub0ae\uc740 \uc9c0\uc18d\ub825 (\uc6b0\uc120\uc21c\uc704 2):** '\ub9d0\ud2f0\uce04'\ub2d8, 'mingki'\ub2d8, 'ha\ub290\ub9ac'\ub2d8 \ub4f1 \ub2e4\uc218\uc758 \ub9ac\ubdf0\uc5d0\uc11c \uc9c0\uc18d\ub825\uc774 \ub9e4\uc6b0 \uc9e7\ub2e4\ub294 \uc9c0\uc801\uc774 \uacf5\ud1b5\uc801\uc73c\ub85c \ub098\ud0c0\ub0ac\uc2b5\ub2c8\ub2e4. \uc774\ub294 \uc560\uad50\uc0b4 \uba54\uc774\ud06c\uc5c5\uc758 \ud575\uc2ec \uae30\ub2a5 \uc911 \ud558\ub098\uc778 \uc9c0\uc18d\ub825\uc744 \ucda9\uc871\uc2dc\ud0a4\uc9c0 \ubabb\ud558\ub294 \uacb0\uacfc\ub85c \uc774\uc5b4\uc838 \uc0ac\uc6a9\uc790 \ub9cc\uc871\ub3c4\ub97c \ud06c\uac8c \uc800\ud558\uc2dc\ud0b5\ub2c8\ub2e4.\n3.  **\uc81c\ud615\uc758 \uac74\uc870\ud568 \ubc0f \uc790\uadf9 (\uc6b0\uc120\uc21c\uc704 3):** '\ub9ac\ubdf0\ub300\ub9c8\uc655'\ub2d8\uacfc '\uac10\uc774\uc9c4'\ub2d8 \ub4f1 \uc5ec\ub7ec \uc0ac\uc6a9\uc790\uac00 \uc81c\ud615\uc774 \uac74\uc870\ud558\uace0 \uac70\uce60\uc5b4 \ub208\uac00\uc5d0 \ud1b5\uc99d\uc774\ub098 \uc790\uadf9\uc744 \uc900\ub2e4\uace0 \uc5b8\uae09\ud588\uc2b5\ub2c8\ub2e4. \uc774\ub294 \uc81c\ud488 \uc0ac\uc6a9 \uc790\uccb4\ub97c \uc5b4\ub835\uac8c \ub9cc\ub4e4\uace0, \ubbfc\uac10\ud55c \ubd80\uc704\uc5d0 \uc0ac\uc6a9\ud574\uc57c \ud558\ub294 \uba54\uc774\ud06c\uc5c5 \uc81c\ud488\uc758 \ud2b9\uc131\uc744 \uace0\ub824\ud560 \ub54c \uac04\uacfc\ud560 \uc218 \uc5c6\ub294 \ubb38\uc81c\uc785\ub2c8\ub2e4.\n\n\uc774 \uc678\uc5d0\ub3c4 \ubc1c\uc0c9\ub825 \ubd80\uc871, \ubb49\ud22d\ud55c \uc2ec, \uc804\uc6a9 \uc0e4\ud504\ub108 \uad6c\ub9e4 \ud544\uc694\uc131 \ub4f1\uc758 \ubb38\uc81c\ub3c4 \uc874\uc7ac\ud558\uc9c0\ub9cc, \uc704\uc758 \uc138 \uac00\uc9c0 \ubb38\uc81c\uac00 \uc0ac\uc6a9\uc790 \uacbd\ud5d8\uc5d0 \uac00\uc7a5 \uc9c1\uc811\uc801\uc774\uace0 \uc2ec\uac01\ud55c \uc601\ud5a5\uc744 \ubbf8\uce58\uace0 \uc788\uc73c\uba70, '\ub3c4\uc6c0\ub3fc\uc694' \uc218\uce58\ub97c \ud1b5\ud574 \uadf8 \uc911\uc694\uc131\uc774 \uc785\uc99d\ub418\uc5c8\uc2b5\ub2c8\ub2e4.\n\n### \ubb38\uc81c\uc810\uacfc \ud575\uc2ec \ud0c0\uac9f \uadf8\ub8f9 \uc5f0\uacb0\n\n\ubd84\uc11d \uacb0\uacfc, **\uc9c0\uc131 \ud53c\ubd80 \ud0c0\uc785**\uc744 \uac00\uc9c4 \uc0ac\uc6a9\uc790\ub4e4\uc774 \uc81c\ud488 \uc0ac\uc6a9\uc5d0 \ub354 \ud070 \uc5b4\ub824\uc6c0\uc744 \uacaa\uace0 \uc788\uc5c8\uc2b5\ub2c8\ub2e4. '\ub9d0\ud2f0\uce04'\ub2d8\uacfc 'ha\ub290\ub9ac'\ub2d8, 'hyuunhye'\ub2d8 \ub4f1 \ub2e4\uc218\uc758 \uc9c0\uc131 \ud53c\ubd80 \uc0ac\uc6a9\uc790\ub4e4\uc774 \uc9c0\uc18d\ub825 \ubd80\uc871, \uc81c\ud615 \ubb38\uc81c, \ud30c\uc190 \ubb38\uc81c \ub4f1\uc744 \uc5b8\uae09\ud588\uc2b5\ub2c8\ub2e4. \ud2b9\ud788 \uc9c0\uc131 \ud53c\ubd80\ub294 \uc720\ubd84\uc774 \ub9ce\uc740 \ud3b8\uc778\ub370, \uc81c\ud488 \uc81c\ud615\uc758 \uac74\uc870\ud568\uacfc \ub9de\ubb3c\ub824 \uc0ac\uc6a9 \uc2dc \ub354\uc6b1 \ubd88\ud3b8\ud568\uc744 \ub290\uaf08\uc744 \uac00\ub2a5\uc131\uc774 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ud55c, '\ubcf5\ud569\uc131' \ud53c\ubd80 \uc0ac\uc6a9\uc790 \uc5ed\uc2dc \ubc1c\ub9bc\uc131, \uc9c0\uc18d\ub825, \ud30c\uc190 \ubb38\uc81c\uc5d0 \ub300\ud55c \ubd88\ub9cc\uc744 \ub2e4\uc218 \uc81c\uae30\ud588\uc2b5\ub2c8\ub2e4. \ub530\ub77c\uc11c \ud604\uc7ac\ub85c\uc11c\ub294 **\uc9c0\uc131 \ubc0f \ubcf5\ud569\uc131 \ud53c\ubd80 \uc0ac\uc6a9\uc790**\uac00 \uacaa\ub294 \ubd88\ud3b8\ud568\uc5d0 \uc9d1\uc911\ud558\uc5ec \ubb38\uc81c \ud574\uacb0 \ubc29\uc548\uc744 \ubaa8\uc0c9\ud558\ub294 \uac83\uc774 \ud6a8\uc728\uc801\uc785\ub2c8\ub2e4.\n\n### \ub370\uc774\ud130 \uae30\ubc18\uc758 \uc2e4\ud589 \uac00\ub2a5\ud55c \uc131\uc7a5 \uc804\ub7b5 \ub3c4\ucd9c\n\n#### [\uc804\ub7b5 \uc81c\uc548 1] \ud3ec\ubbac\ub7ec \ubc0f \uad6c\uc131 \uc694\uc18c \uac1c\uc120\n\n**'\uac00\uc7a5 \uc2dc\uae09\ud55c Top 3 \ubb38\uc81c'**\ub97c \ud574\uacb0\ud558\uae30 \uc704\ud55c \uad6c\uccb4\uc801\uc778 R&D \uac1c\uc120\uc548\uc740 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4.\n\n*   **\ud575\uc2ec \ubb38\uc81c \ud574\uacb0 (\uc81c\ud488 \ud30c\uc190 \ubc0f \uc0ac\uc6a9 \ud3b8\uc758\uc131, \uc9c0\uc18d\ub825, \uc81c\ud615 \uac1c\uc120):**\n    *   **\ub0b4\uad6c\uc131 \uac15\ud654 \ubc0f \uc81c\ud615 \uc5f0\ud654:** \uc81c\ud488 \ud30c\uc190\uc758 \uadfc\ubcf8 \uc6d0\uc778\uc73c\ub85c \ucd94\uc815\ub418\ub294 \uc81c\ud615\uc758 \uacfc\ub3c4\ud55c \uac74\uc870\ud568 \ubc0f \uacbd\ub3c4\ub97c \uac1c\uc120\ud574\uc57c \ud569\ub2c8\ub2e4. **(\ucd94\uc815) \uc218\ubd84 \ubcf4\uc720\ub825\uc774 \ub192\uc740 \uc624\uc77c \uc131\ubd84\uc744 \uc77c\ubd80 \ucd94\uac00\ud558\uac70\ub098, \uc81c\ud615 \uc548\uc815\uc131\uc744 \ub192\uc774\ub294 \uc724\ud65c \uc131\ubd84\uc744 \ud568\uc720\ud558\ub3c4\ub85d \ud3ec\ubbac\ub7ec\ub97c \uac1c\uc120\ud558\uc5ec \uac74\uc870\ud568\uacfc \uac70\uce5c \ubc1c\ub9bc\uc131\uc744 \uc644\ud654\ud574\uc57c \ud569\ub2c8\ub2e4.** \uc774\ub294 \ubc1c\ub9bc\uc131 \uac1c\uc120\uacfc \ud568\uaed8, \uae4e\uc744 \ub54c \uc2ec\uc774 \ubd80\ub7ec\uc9c0\ub294 \ud604\uc0c1\uc744 \uc904\uc5ec \uc0ac\uc6a9 \ud3b8\uc758\uc131\uc744 \ub192\uc774\ub294 \ub370 \uae30\uc5ec\ud560 \uac83\uc785\ub2c8\ub2e4. \ub610\ud55c, **(\ucd94\uc815) \uc9c0\uc18d\ub825\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce58\ub294 \ud718\ubc1c\uc131 \uc131\ubd84\uc758 \ube44\uc728\uc744 \uc870\uc815\ud558\uac70\ub098, \ud53d\uc11c \uae30\ub2a5\uc774 \uc788\ub294 \uc131\ubd84\uc744 \uc18c\ub7c9 \ud568\uc720\ud558\uc5ec \uc0ac\uc6a9 \ud6c4 \uc9c0\uc18d\ub825\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\ub294 \ubc29\uc548\uc744 \uac80\ud1a0\ud574\uc57c \ud569\ub2c8\ub2e4.**\n    *   **\uc2ac\ub9bc\ud55c \ud39c\uc2ac \ub514\uc790\uc778 \uac80\ud1a0:** \ub450\uaebc\uc6b4 \ud39c\uc2ac \ub514\uc790\uc778\uc740 \uc12c\uc138\ud55c \uc560\uad50\uc0b4 \uc5f0\ucd9c\uc5d0 \ubc29\ud574\uac00 \ub41c\ub2e4\ub294 \uc9c0\uc801\uc774 \uc788\uc5c8\uc2b5\ub2c8\ub2e4. **(\ucd94\uc815) \uae30\uc874 \ub300\ube44 \uc587\uc740 \uc2ec\uc744 \uac00\uc9c4 \ud39c\uc2ac \ub514\uc790\uc778\uc73c\ub85c \ubcc0\uacbd\ud558\uac70\ub098, \uae4e\uc774\ub294 \ubd80\ubd84\uc744 \ub354\uc6b1 \uc815\uad50\ud558\uac8c \ub514\uc790\uc778\ud558\uc5ec \uc0ac\uc6a9\uc790\uc758 \uc138\ubc00\ud55c \ucee8\ud2b8\ub864\uc744 \ub3c4\uc6b8 \uc218 \uc788\ub3c4\ub85d \uac1c\uc120\ud574\uc57c \ud569\ub2c8\ub2e4.**\n    *   **\uc0e4\ud504\ub108 \uc99d\uc815 \ub610\ub294 \ub0b4\uc7a5\ud615 \ub514\uc790\uc778 \uace0\ub824:** \uc0ac\uc6a9 \ud3b8\uc758\uc131\uc744 \ub192\uc774\uae30 \uc704\ud574, **\uae30\ud68d \uc138\ud2b8 \uc2dc \uc804\uc6a9 \uc0e4\ud504\ub108\ub97c \uae30\ubcf8 \uc99d\uc815\ud558\uac70\ub098, \uc81c\ud488 \uc790\uccb4\uc5d0 \uc0e4\ud504\ub108\ub97c \ub0b4\uc7a5\ud558\ub294 \ubc29\uc548\uc744 \uace0\ub824\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.** \uc774\ub294 \ucd94\uac00 \ube44\uc6a9 \uc5c6\uc774 \uc0ac\uc6a9\uc790 \ud3b8\uc758\uc131\uc744 \ud06c\uac8c \uc99d\ub300\uc2dc\ud0ac \uc218 \uc788\ub294 \ubc29\uc548\uc785\ub2c8\ub2e4.\n\n*   **\uc0ac\uc6a9\uc790 \uadf8\ub8f9\ubcc4 \ucd5c\uc801\ud654 (\uc9c0\uc131/\ubcf5\ud569\uc131 \ud53c\ubd80):**\n    *   \uc9c0\uc131 \ubc0f \ubcf5\ud569\uc131 \ud53c\ubd80 \uc0ac\uc6a9\uc790\ub4e4\uc774 \uacaa\ub294 \uc9c0\uc18d\ub825 \ubd80\uc871 \ubb38\uc81c\ub97c \ud574\uacb0\ud558\uae30 \uc704\ud574, **(\ucd94\uc815) \uc720\ubd84 \ud761\ucc29 \ud6a8\uacfc\uac00 \uc788\ub294 \ud30c\uc6b0\ub354\ub9ac\ud55c \uc131\ubd84\uc744 \uc18c\ub7c9 \ud568\uc720\ud558\uac70\ub098, \ub540\uacfc \ud53c\uc9c0\uc5d0 \uac15\ud55c \ucf54\ud305 \uae30\uc220\uc744 \uc801\uc6a9\ud55c \uc81c\ud615 \uac1c\ubc1c\uc744 \uace0\ub824\ud574\uc57c \ud569\ub2c8\ub2e4.** \uc774\ub294 \ubc88\uc9d0 \uc5c6\uc774 \uba54\uc774\ud06c\uc5c5\uc744 \uc624\ub798 \uc720\uc9c0\ud558\ub294 \ub370 \ub3c4\uc6c0\uc744 \uc904 \uac83\uc785\ub2c8\ub2e4.\n\n*   **\ubd88\ud544\uc694 \uc694\uc18c \uc81c\uac70 \ub610\ub294 \ucd5c\uc18c\ud654:**\n    *   \uc77c\ubd80 \ub9ac\ubdf0\uc5d0\uc11c \uc5b8\uae09\ub41c \uc5f0\ud544 \ub0c4\uc0c8\uc5d0 \ub300\ud55c \ubd88\ub9cc\uc744 \ud574\uc18c\ud558\uae30 \uc704\ud574, **(\ucd94\uc815) \ubb34\ud5a5 \ub610\ub294 \uc800\uc790\uadf9 \ubb34\ud5a5\ub8cc\ub97c \uc0ac\uc6a9\ud558\uac70\ub098, \ud5a5\ub8cc \ud568\ub7c9\uc744 \ucd5c\uc18c\ud654\ud558\uc5ec \uc0ac\uc6a9\uc790 \uacbd\ud5d8\uc744 \uac1c\uc120\ud574\uc57c \ud569\ub2c8\ub2e4.** \ub610\ud55c, \uacfc\ub3c4\ud55c \ud384\uac10\uc5d0 \ub300\ud55c \uc5b8\uae09\ub3c4 \uc77c\ubd80 \uc788\uc5c8\uc73c\ubbc0\ub85c, **\uc0ac\uc6a9\uc790 \uadf8\ub8f9\ubcc4 \uc120\ud638\ub3c4\uc5d0 \ub9de\ucdb0 \ud384\uc758 \uc785\uc790 \ud06c\uae30\ub098 \ud568\ub7c9\uc744 \uc870\uc808\ud55c \uc81c\ud488 \ub77c\uc778\uc5c5 \ud655\uc7a5\uc744 \uace0\ub824\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.**\n\n#### [\uc804\ub7b5 \uc81c\uc548 2] \uc81c\ud488 \ud3ec\ud2b8\ud3f4\ub9ac\uc624 \ubc0f \uacbd\uc7c1 \uc804\ub7b5\n\n**\uc2dc\uc7a5 \uae30\ud68c \uc815\uc758:**\n\ud22c\ucfe8\ud3ec\uc2a4\ucfe8 \ud504\ub85c\ud0c0\uc8fc \ud39c\uc2ac\uc740 \ub9e4\ub825\uc801\uc778 \uc0c9\uc0c1\uacfc \ud384\uac10\uc744 \uc81c\uacf5\ud558\uc9c0\ub9cc, \ub0ae\uc740 \uc9c0\uc18d\ub825, \uc5b4\ub824\uc6b4 \uc0ac\uc6a9\uac10, \uadf8\ub9ac\uace0 \uce58\uba85\uc801\uc778 \ub0b4\uad6c\uc131 \ubb38\uc81c\ub85c \uc778\ud574 \ub9ce\uc740 \uc0ac\uc6a9\uc790\ub4e4\uc5d0\uac8c \uc2e4\ub9dd\uac10\uc744 \uc548\uaca8\uc8fc\uace0 \uc788\uc2b5\ub2c8\ub2e4. \ud2b9\ud788 \uc9c0\uc131/\ubcf5\ud569\uc131 \ud53c\ubd80\ub97c \uac00\uc9c4 \uc18c\ube44\uc790\ub4e4\uc740 \uc81c\ud488\uc758 \uc0ac\uc6a9\uc131\uacfc \uc9c0\uc18d\ub825\uc5d0 \ub300\ud55c \ubd88\ub9cc\uc774 \ub354 \ub450\ub4dc\ub7ec\uc84c\uc2b5\ub2c8\ub2e4. \uc774\ub294 \ud604\uc7ac \uc2dc\uc7a5\uc5d0\uc11c \uace0\uac1d\uc758 \uae30\ub300\ub97c \uc644\uc804\ud788 \ucda9\uc871\uc2dc\ud0a4\uc9c0 \ubabb\ud558\ub294 **'\uc560\uad50\uc0b4 \uba54\uc774\ud06c\uc5c5 \uc81c\ud488\uc758 \uc9c0\uc18d\ub825 \ubc0f \uc0ac\uc6a9 \ud3b8\uc758\uc131'**\uc774\ub77c\ub294 \uba85\ud655\ud55c \uc2dc\uc7a5 \uacf5\ubc31\uc744 \uc2dc\uc0ac\ud569\ub2c8\ub2e4. \uc774 \uacf5\ubc31\uc740 \uc18c\ube44\uc790\ub4e4\uc774 \uc560\uad50\uc0b4 \uba54\uc774\ud06c\uc5c5\uc758 \ud6a8\uacfc\ub97c \uc6d0\ud558\uc9c0\ub9cc, \uae30\uc874 \uc81c\ud488\ub4e4\uc758 \ub2e8\uc810 \ub54c\ubb38\uc5d0 \ubd88\ud3b8\ud568\uc744 \ub290\ub07c\uac70\ub098 \ub2e4\ub978 \ub300\uc548\uc744 \ucc3e\uace0 \uc788\ub2e4\ub294 \uac83\uc744 \uc758\ubbf8\ud558\uba70, \uc774\ub294 \uc6b0\ub9ac\uc5d0\uac8c **'\uc0ac\uc6a9\ud558\uae30 \uc27d\uace0, \uc624\ub798 \uc9c0\uc18d\ub418\uba70, \ub2e4\uc591\ud55c \ud53c\ubd80 \ud0c0\uc785\uc5d0 \uc801\ud569\ud55c \uc560\uad50\uc0b4 \uba54\uc774\ud06c\uc5c5 \uc81c\ud488'**\uc774\ub77c\ub294 \uc0c8\ub85c\uc6b4 \uc131\uc7a5 \uae30\ud68c\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4.\n\n**\ub450 \uac00\uc9c0 \uc804\ub7b5 \uc635\uc158:**\n\n*   **\uc635\uc158 A: \uac1c\uc120 \ubc0f \ub9ac\ud3ec\uc9c0\uc154\ub2dd \uc804\ub7b5**\n    *   **\uae30\uc874 \uc81c\ud488 \uac1c\uc120:** \uc55e\uc11c \uc81c\uc548\ub41c \ud3ec\ubbac\ub7ec \ubc0f \ub514\uc790\uc778 \uac1c\uc120\uc744 \ud1b5\ud574 \uc81c\ud488\uc758 \ud575\uc2ec\uc801\uc778 \ubb38\uc81c\uc810(\ud30c\uc190, \uc9c0\uc18d\ub825, \ubc1c\ub9bc\uc131)\uc744 \ud574\uacb0\ud569\ub2c8\ub2e4.\n    *   **\ud0c0\uac9f \uace0\uac1d \uba85\ud655\ud654 \ubc0f \ub9ac\ud3ec\uc9c0\uc154\ub2dd:** \uac1c\uc120\ub41c \uc81c\ud488\uc744 **'\uc27d\uace0 \ube60\ub974\uac8c \uc560\uad50\uc0b4 \ubcfc\ub968\uac10\uc744 \uc5f0\ucd9c\ud558\uace0 \uc2f6\uc740 10\ub300 \ud6c4\ubc18~20\ub300 \ucd08\ubc18\uc758 \uba54\uc774\ud06c\uc5c5 \ucd08\ubcf4\uc790'** \ub610\ub294 **'\uc12c\uc138\ud55c \uba54\uc774\ud06c\uc5c5 \ud45c\ud604\uc744 \ucd94\uad6c\ud558\ub294 \uc0ac\uc6a9\uc790'**\ub85c \uba85\ud655\ud558\uac8c \uc7ac\uc815\uc758\ud569\ub2c8\ub2e4.\n    *   **\ub9c8\ucf00\ud305 \uba54\uc2dc\uc9c0 \ubcc0\ud654:** '\uc560\uad50\uc0b4 \ud39c\uc2ac'\uc774\ub77c\ub294 \uae30\uc874\uc758 \uae30\ub2a5\uc801 \uc124\uba85\uc5d0\uc11c \ub098\uc544\uac00, '\uc624\ub79c \uc2dc\uac04 \ubc88\uc9d0 \uc5c6\uc774 \ub610\ub837\ud55c \uc560\uad50\uc0b4 \uc5f0\ucd9c', '\uac74\uc870\ud568 \uc5c6\uc774 \ubd80\ub4dc\ub7ec\uc6b4 \ubc1c\ub9bc\uc131' \ub4f1 \uac1c\uc120\ub41c \uc81c\ud488\uc758 \uc7a5\uc810\uc744 \uba85\ud655\ud788 \uac15\uc870\ud558\uba70, \ud2b9\ud788 **\uc9c0\uc131/\ubcf5\ud569\uc131 \ud53c\ubd80 \uc0ac\uc6a9\uc790\ub4e4\uc5d0\uac8c \ucd5c\uc801\ud654\ub41c \uc81c\ud488\uc784\uc744 \uc5b4\ud544**\ud569\ub2c8\ub2e4.\n    *   **\ud575\uc2ec \uceec\ub7ec '\ud074\ub798\uc2dc \ud718\uadf8' \ub4f1 \uc778\uae30 \uceec\ub7ec\uc758 \uc81c\ud615 \uac1c\uc120:** \ub192\uc740 \uc778\uae30\ub97c \uc5bb\uc5c8\uc9c0\ub9cc \uc0ac\uc6a9\uc790 \ubd88\ub9cc\ub3c4 \ub9ce\uc558\ub358 \uceec\ub7ec\uc758 \uc81c\ud615\uc744 \uc6b0\uc120\uc801\uc73c\ub85c \uac1c\uc120\ud558\uc5ec, \uace0\uac1d\uc758 \uae30\uc874 \ub2c8\uc988\ub97c \ucda9\uc871\uc2dc\ud0a4\uba74\uc11c\ub3c4 \ubd80\uc815\uc801\uc778 \uacbd\ud5d8\uc744 \ub9cc\ud68c\ud569\ub2c8\ub2e4.\n\n*   **\uc635\uc158 B: \uc2e0\uaddc \ub77c\uc778 \ud655\uc7a5 \uc804\ub7b5**\n    *   **'\ud504\ub85c\ud0c0\uc8fc \ud39c\uc2ac' \ube0c\ub79c\ub4dc \uc544\uc774\ub374\ud2f0\ud2f0 \uc720\uc9c0 \ub610\ub294 \uc7ac\uc815\uc758:** '\ud504\ub85c\ud0c0\uc8fc'\ub77c\ub294 \ube0c\ub79c\ub4dc\uc758 \uace0\uc720\ud55c \ud384\uac10\uc774\ub098 \ucf58\uc149\ud2b8\ub294 \uc720\uc9c0\ud558\ub418, \uc0ac\uc6a9\uc790 \ubd88\ub9cc\uc871\uc758 \uadfc\ubcf8 \uc6d0\uc778\uc774 \ub418\ub294 \uc81c\ud615 \ubc0f \ub0b4\uad6c\uc131 \ubb38\uc81c\ub97c \ud574\uacb0\ud55c **\uc0c8\ub85c\uc6b4 \ub77c\uc778\uc5c5\uc744 \uac1c\ubc1c**\ud569\ub2c8\ub2e4.\n    *   **\uc0c8\ub85c\uc6b4 \ub77c\uc778\uc5c5 \ucd9c\uc2dc:** **'\ud504\ub85c\ud0c0\uc8fc \uae00\ub85c\uc6b0 \uc2a4\ud2f1'** \ub610\ub294 **'\ud504\ub85c\ud0c0\uc8fc \uc18c\ud504\ud2b8 \ud39c\uc2ac'**\uacfc \uac19\uc740 \uc0c8\ub85c\uc6b4 \uba85\uce6d\uc73c\ub85c, \uae30\uc874 \ud39c\uc2ac \uc81c\ud615\uc758 \ub2e8\uc810\uc744 \ubcf4\uc644\ud55c \uc0c8\ub85c\uc6b4 \ud615\ud0dc\uc758 \uc560\uad50\uc0b4 \uba54\uc774\ud06c\uc5c5 \uc81c\ud488\uc744 \ucd9c\uc2dc\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc2a4\ud2f1 \ud0c0\uc785\uc740 \uac74\uc870\ud568\uc744 \uc904\uc774\uace0 \ub367\ubc14\ub974\uae30 \uc26c\uc6b0\uba70, \ub354 \ubd80\ub4dc\ub7ec\uc6b4 \uc9c8\uac10\uc758 \ud39c\uc2ac\uc740 \ubbfc\uac10\ud55c \ub208\uac00\uc5d0 \uc790\uadf9\uc744 \uc904\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n    *   **\ud0c0\uac9f \uace0\uac1d \ud655\uc7a5:** \uae30\uc874 '\ud504\ub85c\ud0c0\uc8fc \ud39c\uc2ac'\uc774 \ucda9\uc871\uc2dc\ud0a4\uc9c0 \ubabb\ud588\ub358 **\uc9c0\uc131/\ubcf5\ud569\uc131 \ud53c\ubd80 \uc0ac\uc6a9\uc790, \ubbfc\uac10\uc131 \ud53c\ubd80 \uc0ac\uc6a9\uc790, \uadf8\ub9ac\uace0 \ubcf4\ub2e4 \uc26c\uc6b4 \uc0ac\uc6a9\uac10\uc744 \uc6d0\ud558\ub294 \uba54\uc774\ud06c\uc5c5 \ucd08\ubcf4\uc790\uae4c\uc9c0 \ud3ec\uad04\ud558\ub294 \ud655\uc7a5\ub41c \ud0c0\uac9f \uace0\uac1d\uce35\uc744 \uacf5\ub7b5**\ud569\ub2c8\ub2e4.\n    *   **\ucc28\ubcc4\ud654\ub41c \ub9c8\ucf00\ud305:** \uc2e0\uaddc \ub77c\uc778\uc5c5\uc740 '\ud504\ub85c\ud0c0\uc8fc \ud39c\uc2ac'\uacfc\ub294 \ubcc4\uac1c\ub85c, **'\ud558\ub8e8 \uc885\uc77c \uc9c0\uc18d\ub418\ub294 \ucd09\ucd09\ud55c \uc560\uad50\uc0b4', '\uc790\uadf9 \uc5c6\uc774 \ubd80\ub4dc\ub7fd\uac8c \ubc1c\ub9ac\ub294 \ub9c8\ubc95', '\uc5b4\ub5a4 \ud53c\ubd80\uc5d0\ub3c4 \ud3b8\uc548\ud558\uac8c'** \uc640 \uac19\uc740 \uba54\uc2dc\uc9c0\ub97c \ud1b5\ud574 \uae30\uc874 \uc81c\ud488\uacfc\uc758 \ucc28\ubcc4\uc131\uc744 \uac15\uc870\ud569\ub2c8\ub2e4.\n\n**\uad8c\uace0:** \ub450 \uac00\uc9c0 \uc635\uc158 \ubaa8\ub450 \uc7a5\ub2e8\uc810\uc774 \uc788\uc73c\ub098, \ud604\uc7ac '\ud504\ub85c\ud0c0\uc8fc \ud39c\uc2ac' \uc790\uccb4\uc5d0 \ub300\ud55c \ubd80\uc815\uc801\uc778 \uacbd\ud5d8\uc774 \ub2e4\uc218 \ucd95\uc801\ub41c \uc810\uc744 \uace0\ub824\ud560 \ub54c, **\uc635\uc158 A(\uac1c\uc120 \ubc0f \ub9ac\ud3ec\uc9c0\uc154\ub2dd)**\ub97c \ud1b5\ud574 \uae30\uc874 \ube0c\ub79c\ub4dc \uc790\uc0b0\uc744 \ud65c\uc6a9\ud558\uba74\uc11c\ub3c4 \uace0\uac1d \ub9cc\uc871\ub3c4\ub97c \ud68d\uae30\uc801\uc73c\ub85c \uac1c\uc120\ud558\ub294 \uac83\uc774 \ub2e8\uae30\uc801\uc73c\ub85c \ud6a8\uacfc\uc801\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e4\ub9cc, \uc7a5\uae30\uc801\uc73c\ub85c\ub294 **\uc635\uc158 B(\uc2e0\uaddc \ub77c\uc778 \ud655\uc7a5)**\ub97c \ud1b5\ud574 \uc2dc\uc7a5\uc758 \ubcc0\ud654\uc640 \uc0c8\ub85c\uc6b4 \uace0\uac1d \ub2c8\uc988\ub97c \ucda9\uc871\uc2dc\ud0a4\ub294 \ubc29\uc548\uc744 \ud568\uaed8 \uac80\ud1a0\ud574\uc57c \ud569\ub2c8\ub2e4.\n\n#### [\uc804\ub7b5 \uc81c\uc548 3] \ub9c8\ucf00\ud305 \ubc0f \ucee4\ubba4\ub2c8\ucf00\uc774\uc158 \ucd5c\uc801\ud654\n\n\uace0\uac1d\uc758 \uae30\ub300\ub97c \uad00\ub9ac\ud558\uace0 \ube0c\ub79c\ub4dc \uc2e0\ub8b0\ub3c4\ub97c \ud68c\ubcf5\ud558\uae30 \uc704\ud55c \ucee4\ubba4\ub2c8\ucf00\uc774\uc158 \uc804\ub7b5\uc740 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4.\n\n*   **\uac00\uce58 \uc81c\uc548(Promise) \uc7ac\uc815\uc758:**\n    *   **\"\uac74\uc870\ud568 \uc5c6\uc774 \ubd80\ub4dc\ub7fd\uac8c, \ud558\ub8e8 \uc885\uc77c \ub610\ub837\ud558\uac8c, \uc12c\uc138\ud55c \uc560\uad50\uc0b4\uc744 \uc644\uc131\ud574 \uc8fc\ub294 \ud504\ub85c\ud0c0\uc8fc \ud39c\uc2ac\"** \uacfc \uac19\uc774, \uc81c\ud488\uc758 \ud575\uc2ec \uac15\uc810(\uac1c\uc120\ub41c \ubc1c\ub9bc\uc131, \uc9c0\uc18d\ub825, \uc12c\uc138\ud55c \ud45c\ud604)\uacfc \ud0c0\uac9f \uc0ac\uc6a9\uc790(\uc560\uad50\uc0b4 \uc5f0\ucd9c\uc744 \uc6d0\ud558\ub294 \ubaa8\ub4e0 \ud53c\ubd80 \ud0c0\uc785)\ub97c \uba85\ud655\ud788 \uc815\uc758\ud558\uc5ec \uc804\ub2ec\ud569\ub2c8\ub2e4.\n    *   **\"\ud2b9\ud788 \uc9c0\uc131/\ubcf5\ud569\uc131 \ud53c\ubd80\ub3c4 \uc548\uc2ec\ud558\uace0 \uc0ac\uc6a9\ud560 \uc218 \uc788\ub294 \uc9c0\uc18d\ub825\"** \uacfc \uac19\uc774, \ud2b9\uc815 \ud53c\ubd80 \ud0c0\uc785\uc758 \ub2c8\uc988\ub97c \ucda9\uc871\uc2dc\ud0a8\ub2e4\ub294 \uc810\uc744 \uad6c\uccb4\uc801\uc73c\ub85c \uc5b8\uae09\ud558\uc5ec \uc2e0\ub8b0\ub3c4\ub97c \ub192\uc785\ub2c8\ub2e4.\n\n*   **\uae30\ub300\uce58 \uad00\ub9ac \uac00\uc774\ub4dc(Proactive Guide):**\n    *   \uc81c\ud488 \uc0c1\uc138 \ud398\uc774\uc9c0, \uad11\uace0, SNS \ucc44\ub110 \ub4f1\uc744 \ud1b5\ud574 **'\ud504\ub85c\ud0c0\uc8fc \ud39c\uc2ac, \ub354 \uc624\ub798, \ub354 \uc608\uc058\uac8c \uc0ac\uc6a9\ud558\ub294 \ubc29\ubc95'** \uacfc \uac19\uc740 \ucf58\ud150\uce20\ub97c \uc801\uadf9\uc801\uc73c\ub85c \ub178\ucd9c\ud569\ub2c8\ub2e4.\n    *   **\"\ubd80\ub4dc\ub7fd\uac8c 2~3\ud68c \ud130\uce58\ud558\uc5ec \ubc1c\uc0c9\", \"\ub0b4\uc7a5\ub41c \uc0e4\ud504\ub108 \ub610\ub294 \uc804\uc6a9 \uc0e4\ud504\ub108\ub97c \uc0ac\uc6a9\ud558\uc5ec \ubfb0\uc871\ud558\uac8c \uae4e\uc544 \uc0ac\uc6a9\", \"\uc0ac\uc6a9 \ud6c4 \ub69c\uaed1\uc744 \uc644\uc804\ud788 \ub2eb\uc544 \ubcf4\uad00\"** \uacfc \uac19\uc740 \uad6c\uccb4\uc801\uc778 \uc0ac\uc6a9 \ud301\uacfc \uc8fc\uc758\uc0ac\ud56d\uc744 \uc2dc\uac01 \uc790\ub8cc\uc640 \ud568\uaed8 \uc81c\uacf5\ud558\uc5ec \uc18c\ube44\uc790\ub4e4\uc774 \uc81c\ud488\uc758 \ud2b9\uc131\uc744 \ubbf8\ub9ac \uc778\uc9c0\ud558\uace0 \uc62c\ubc14\ub974\uac8c \uc0ac\uc6a9\ud560 \uc218 \uc788\ub3c4\ub85d \uc548\ub0b4\ud569\ub2c8\ub2e4. \ud2b9\ud788 \uc81c\ud488 \ud30c\uc190 \uc608\ubc29\uc744 \uc704\ud55c \ubcf4\uad00\ubc95\uc744 \uac15\uc870\ud558\ub294 \uac83\uc774 \uc911\uc694\ud569\ub2c8\ub2e4.\n\n*   **\uad11\uace0 \uba54\uc2dc\uc9c0 \ud604\uc2e4\ud654:**\n    *   \uacfc\uc7a5\ub41c \ud45c\ud604 \ub300\uc2e0, **\"\ubc14\ub974\ub294 \uc989\uc2dc \uc740\uc740\ud558\uac8c \ube5b\ub098\ub294 \uc560\uad50\uc0b4\", \"\ud558\ub8e8 \uc885\uc77c \uc790\uc5f0\uc2a4\ub7fd\uac8c \uc720\uc9c0\ub418\ub294 \ubcfc\ub968\uac10\"** \uacfc \uac19\uc774 \uc81c\ud488\uc758 \uc2e4\uc81c \ud6a8\uacfc\ub97c \uc788\ub294 \uadf8\ub300\ub85c \uc804\ub2ec\ud569\ub2c8\ub2e4.\n    *   **\ud604\uc2e4\uc801\uc778 \uc804\ud6c4 \ube44\uad50:** \uc81c\ud488 \uac1c\uc120 \ud6c4, \ub2e4\uc591\ud55c \ud53c\ubd80 \ud0c0\uc785\uc758 \ubaa8\ub378\uc774 \uc81c\ud488\uc744 \uc0ac\uc6a9\ud55c \ubaa8\uc2b5\uc744 \ub2f4\uc740 \ud604\uc2e4\uc801\uc778 \uc804\ud6c4 \ube44\uad50 \ucf58\ud150\uce20\ub97c \uc81c\uc791\ud558\uc5ec \uc81c\uacf5\ud569\ub2c8\ub2e4. \ud2b9\ud788 \uc560\uad50\uc0b4\uc774 \uc5c6\ub294 \ubaa8\ub378\uc774 \uc81c\ud488 \uc0ac\uc6a9 \ud6c4 \uc790\uc5f0\uc2a4\ub7fd\uac8c \uc560\uad50\uc0b4\uc774 \ubd80\uac01\ub418\ub294 \ubaa8\uc2b5\uc744 \ubcf4\uc5ec\uc90c\uc73c\ub85c\uc368 \uc81c\ud488\uc758 \ud6a8\uacfc\ub97c \ud6a8\uacfc\uc801\uc73c\ub85c \uc99d\uba85\ud558\uace0, \uc18c\ube44\uc790\ub4e4\uc758 \uae30\ub300\uce58\ub97c \ud604\uc2e4\uc801\uc73c\ub85c \uad00\ub9ac\ud569\ub2c8\ub2e4.\n    *   **\uc194\uc9c1\ud55c \uc131\ubd84 \uc815\ubcf4 \uc81c\uacf5:** \uc81c\ud488\uc758 \uc8fc\uc694 \uc131\ubd84\uacfc \uadf8 \ud6a8\ub2a5\uc5d0 \ub300\ud55c \uc815\ubcf4\ub97c \ud22c\uba85\ud558\uac8c \uacf5\uac1c\ud558\uc5ec \uc18c\ube44\uc790\ub4e4\uc774 \uc81c\ud488\uc5d0 \ub300\ud55c \uc2e0\ub8b0\ub97c \uac00\uc9c8 \uc218 \uc788\ub3c4\ub85d \ud569\ub2c8\ub2e4.\n\n\uc774\ub7ec\ud55c \uc804\ub7b5\ub4e4\uc744 \ud1b5\ud574 \ud22c\ucfe8\ud3ec\uc2a4\ucfe8 \ud504\ub85c\ud0c0\uc8fc \ud39c\uc2ac\uc740 \uc18c\ube44\uc790\ub4e4\uc758 \ubd80\uc815\uc801\uc778 \uacbd\ud5d8\uc744 \uadf9\ubcf5\ud558\uace0, \ub2e4\uc2dc\uae08 \uc2e0\ub8b0\ubc1b\ub294 \uc81c\ud488\uc73c\ub85c \uc790\ub9ac\ub9e4\uae40\ud560 \uc218 \uc788\uc744 \uac83\uc785\ub2c8\ub2e4.", "ingredients": "[1\ud638]\n\ub9c8\uc774\uce74, \ud2f0\ud0c0\ub284\ub2e4\uc774\uc625\uc0ac\uc774\ub4dc, \uc801\uc0c9\uc0b0\ud654\ucca0, \ud669\uc0c9\uc0b0\ud654\ucca0, \ud751\uc0c9\uc0b0\ud654\ucca0, \ub2e4\uc774\uba54\ud2f0\ucf58/\ub2e4\uc774\ube44\ub2d0\ub2e4\uc774\uba54\ud2f0\ucf58/\uc2e4\uc138\uc2a4\ud034\uc625\uc138\uc778\ud06c\ub85c\uc2a4\ud3f4\ub9ac\uba38, \uc2e4\ub9ac\uce74, \ub098\uc77c\ub860-12, \ud3f4\ub9ac\uba54\ud2f8\uba54\ud0c0\ud06c\ub9b4\ub808\uc774\ud2b8, \ubca0\ud5e4\ub179\uc2dc\ud53c\uc774\uc9c0-10\ub2e4\uc774\uba54\ud2f0\ucf58, \uc544\uc774\uc18c\uc544\ubc00\ucf54\ucf54\uc5d0\uc774\ud2b8, \ub2e4\uc774\uba54\ud2f0\ucf58, \ubcf4\ub860\ub098\uc774\ud2b8\ub77c\uc774\ub4dc, \ud569\uc131\ud50c\ub8e8\