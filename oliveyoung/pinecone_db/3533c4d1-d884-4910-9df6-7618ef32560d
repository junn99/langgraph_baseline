{"lc": 1, "type": "constructor", "id": ["langchain", "schema", "document", "Document"], "kwargs": {"metadata": {"name": "[NEW][\ub371\uc2a4 PICK]\uc624\ube0c\uc81c \uc6b8\ud2b8\ub77c \ud640\ub4dc \uc2a4\ud504\ub808\uc774 180ml", "brand": "\uc624\ube0c\uc81c", "category": ["\ub9e8\uc988\ucf00\uc5b4", "\ud5e4\uc5b4\ucf00\uc5b4", "\uc2a4\ud504\ub808\uc774/\uc641\uc2a4/\uc824"], "price": 18000, "volume": "180ml", "manufacturer": "\ud55c\uad6d\ucf5c\ub9c8(\uc8fc) / \u321c\uc5b4\ub311\ud2b8", "review": "## '[NEW][\ub371\uc2a4 PICK] \uc624\ube0c\uc81c \uc6b8\ud2b8\ub77c \ud640\ub4dc \uc2a4\ud504\ub808\uc774 180ml' \uc81c\ud488 \ub9ac\ubdf0 \ubd84\uc11d \ubc0f \uc131\uc7a5 \uc804\ub7b5 \uc81c\uc5b8\n\n### \ud575\uc2ec \uc694\uc57d (Executive Summary)\n\n\ubcf8 \ubcf4\uace0\uc11c\ub294 '[NEW][\ub371\uc2a4 PICK] \uc624\ube0c\uc81c \uc6b8\ud2b8\ub77c \ud640\ub4dc \uc2a4\ud504\ub808\uc774 180ml' \uc81c\ud488\uc5d0 \ub300\ud55c \uc18c\ube44\uc790 \ub9ac\ubdf0 \ub370\uc774\ud130\ub97c \uc2ec\uce35 \ubd84\uc11d\ud558\uc5ec, \uc81c\ud488\uc758 \uc8fc\uc694 \ubb38\uc81c\uc810\uc744 \ud30c\uc545\ud558\uace0 \uc774\ub97c \uc131\uc7a5 \ub3d9\ub825\uc73c\ub85c \uc804\ud658\ud558\uae30 \uc704\ud55c \uad6c\uccb4\uc801\uc778 \uc804\ub7b5\uc744 \uc81c\uc548\ud569\ub2c8\ub2e4. \ub9ac\ubdf0 \ubd84\uc11d \uacb0\uacfc, \uc18c\ube44\uc790\ub4e4\uc774 \uac00\uc7a5 \ud06c\uac8c \ubd88\ud3b8\uc744 \ub290\ub07c\ub294 \ubd80\ubd84\uc740 '\uac15\ud558\uace0 \ubd88\ucf8c\ud55c \ud5a5', '\ub0ae\uc740 \uc9c0\uc18d\ub825 \ubc0f \uae30\ub300 \ub300\ube44 \ubbf8\ud761\ud55c \uace0\uc815\ub825', \uadf8\ub9ac\uace0 '\ub5a1\uc9c0\uac70\ub098 \ud558\uc597\uac8c \ubb49\uce58\ub294 \uc0ac\uc6a9\uac10'\uc774\uc5c8\uc2b5\ub2c8\ub2e4. \ud2b9\ud788, \ud5a5\uc5d0 \ub300\ud55c \ubd80\uc815\uc801\uc778 \ud53c\ub4dc\ubc31\uc740 \uacf5\uac10\ub3c4\uac00 \ub192\uc558\uc73c\uba70, \uc77c\ubd80 \uc0ac\uc6a9\uc790\ub294 \ud53c\ubd80 \ud2b8\ub7ec\ube14\uae4c\uc9c0 \uacbd\ud5d8\ud55c \uac83\uc73c\ub85c \ub098\ud0c0\ub0ac\uc2b5\ub2c8\ub2e4.\n\n\uc774\ub7ec\ud55c \ubb38\uc81c\uc810\ub4e4\uc744 \ud574\uacb0\ud558\uace0 \uc7a0\uc7ac\uc801\uc778 \uc2dc\uc7a5 \uae30\ud68c\ub97c \ud3ec\ucc29\ud558\uae30 \uc704\ud574 \ubcf8 \ubcf4\uace0\uc11c\ub294 \ub2e4\uc74c\uacfc \uac19\uc740 \uc138 \uac00\uc9c0 \ud575\uc2ec \uc804\ub7b5\uc744 \uc81c\uc548\ud569\ub2c8\ub2e4. \uccab\uc9f8, \ubd80\uc815\uc801\uc778 \uacbd\ud5d8\uc744 \uc720\ubc1c\ud558\ub294 \ud5a5\ub8cc\ub97c \uc800\uc790\uadf9 \ub300\uccb4\uc7ac\ub85c \ubcc0\uacbd\ud558\uace0, \ub5a1\uc9d0 \ud604\uc0c1\uc744 \uc644\ud654\ud558\ub294 \uc81c\ud615 \uac1c\uc120\uc744 \ud3ec\ud568\ud55c R&D \uc804\ub7b5\uc785\ub2c8\ub2e4. \ub458\uc9f8, '\uac15\ub825\ud55c \uace0\uc815\ub825'\uc774\ub77c\ub294 \ud575\uc2ec \uac15\uc810\uc740 \uc720\uc9c0\ud558\ub418, \uc81c\ud488\uc758 \ud2b9\uc131\uc744 \uba85\ud655\ud788 \ud558\uace0 \ud0c0\uac9f \uc0ac\uc6a9\uc790\ub97c \uc7ac\uc815\uc758\ud558\ub294 \ud3ec\ud2b8\ud3f4\ub9ac\uc624 \ubc0f \uacbd\uc7c1 \uc804\ub7b5\uc785\ub2c8\ub2e4. \uc14b\uc9f8, \uacfc\uc7a5\ub41c \uad11\uace0\ub97c \uc9c0\uc591\ud558\uace0 \uc2e4\uc81c \uc0ac\uc6a9 \uacbd\ud5d8\uc744 \uae30\ubc18\uc73c\ub85c \ud55c \uc194\uc9c1\ud55c \uc815\ubcf4 \uc804\ub2ec\uacfc \uae30\ub300\uce58 \uad00\ub9ac\ub97c \ud1b5\ud574 \ube0c\ub79c\ub4dc \uc2e0\ub8b0\ub3c4\ub97c \ud68c\ubcf5\ud558\ub294 \ub9c8\ucf00\ud305 \ubc0f \ucee4\ubba4\ub2c8\ucf00\uc774\uc158 \uc804\ub7b5\uc785\ub2c8\ub2e4. \ubcf8 \ubcf4\uace0\uc11c\uc5d0 \uc81c\uc2dc\ub41c \uc804\ub7b5\ub4e4\uc744 \uc2e4\ud589\ud568\uc73c\ub85c\uc368, \uc6b0\ub9ac\ub294 \uc2e4\ud328 \uacbd\ud5d8\uc744 \uc81c\ud488 \uac1c\uc120 \ubc0f \ube0c\ub79c\ub4dc \uc131\uc7a5\uc758 \uc911\uc694\ud55c \ubc1c\ud310\uc73c\ub85c \uc0bc\uc744 \uc218 \uc788\uc744 \uac83\uc785\ub2c8\ub2e4.\n\n### \uc0c1\uc138 \ubd84\uc11d \ubc0f \uc6b0\uc120\uc21c\uc704 (Detailed Analysis & Prioritization)\n\n**1. \ud575\uc2ec \ubb38\uc81c\uc810 \uc2dd\ubcc4 \ubc0f \uc6b0\uc120\uc21c\uc704\ud654**\n\n\uc18c\ube44\uc790 \ub9ac\ubdf0 \ub370\uc774\ud130\ub97c \ubd84\uc11d\ud55c \uacb0\uacfc, \ub2e4\uc74c\uacfc \uac19\uc740 \ub2e4\uc12f \uac00\uc9c0 \uc8fc\uc694 \uc601\uc5ed\uc5d0\uc11c \ubb38\uc81c\uc810\ub4e4\uc774 \uc2dd\ubcc4\ub418\uc5c8\uc2b5\ub2c8\ub2e4.\n\n*   **\uc81c\ud615 \ubc0f \uc0ac\uc6a9\uac10 \uc601\uc5ed:** \ub9ce\uc740 \uc0ac\uc6a9\uc790\uac00 \uc81c\ud488 \uc0ac\uc6a9 \ud6c4 '\ub5a1\uc9c0\uac70\ub098', '\ub531\ub531\ud558\uac8c \uad73\ub294' \ub290\ub08c\uc744 \uc5b8\uae09\ud588\uc73c\uba70, \uc77c\ubd80\ub294 '\ud558\uc597\uac8c \uac00\ub8e8\uac00 \uc549\ub294' \ud604\uc0c1\ub3c4 \uc9c0\uc801\ud588\uc2b5\ub2c8\ub2e4. \ub610\ud55c, \uac00\uc2a4 \ud0c0\uc785 \uc2a4\ud504\ub808\uc774\uc758 \ubd84\uc0ac\ub825\uc774 \uc77c\uc815\ud558\uc9c0 \uc54a\uc544 '\uc591 \uc870\uc808\uc774 \uc5b4\ub835\ub2e4'\ub294 \uc758\uacac\ub3c4 \uc788\uc5c8\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ubb38\uc81c\uc810\ub4e4\uc740 \uc81c\ud488\uc758 \ub9cc\uc871\uc2a4\ub7ec\uc6b4 \uc0ac\uc6a9 \uacbd\ud5d8\uc744 \uc800\ud574\ud558\ub294 \uc8fc\uc694 \uc694\uc778\uc73c\ub85c \uc791\uc6a9\ud588\uc2b5\ub2c8\ub2e4. '\ub5a1\uc9d0' \ud604\uc0c1\uc740 \ud2b9\ud788 \uc587\uac70\ub098 \ud798\uc5c6\ub294 \ubaa8\ubc1c\uc744 \uac00\uc9c4 \uc0ac\uc6a9\uc790\uc5d0\uac8c \ub354 \ub450\ub4dc\ub7ec\uc9c0\ub294 \uac83\uc73c\ub85c \ub098\ud0c0\ub0ac\uc73c\uba70, \uc774\ub294 \uc81c\ud488\uc758 \uc8fc\uc694 \ud310\ub9e4 \ud3ec\uc778\ud2b8\uc778 '\uace0\uc815\ub825'\uc744 \uc624\ud788\ub824 \ubc18\uac10\uc2dc\ud0a4\ub294 \uacb0\uacfc\ub97c \ucd08\ub798\ud588\uc2b5\ub2c8\ub2e4. (\uc5b8\uae09 \ube48\ub3c4: \ub192\uc74c, \ube44\uc988\ub2c8\uc2a4 \uc784\ud329\ud2b8: \ub192\uc74c - \uc0ac\uc6a9\uac10 \uc800\ud558 \ubc0f \uc7ac\uad6c\ub9e4 \uc758\uc0ac \uac10\uc18c \uc57c\uae30)\n\n*   **\uc131\ub2a5 \ubc0f \ud6a8\uacfc \uc601\uc5ed:** '\uace0\uc815\ub825\uc774 \uae30\ub300\ubcf4\ub2e4 \uc9e7\ub2e4', '3\uc2dc\uac04\ub3c4 \uc548 \uac00\uc11c \ud480\ub9b0\ub2e4', '\uc55e\uba38\ub9ac \uace0\uc815\uc774 \uc798 \uc548 \ub41c\ub2e4' \ub4f1 \uc81c\ud488\uc758 \ud575\uc2ec \uae30\ub2a5\uc778 '\uace0\uc815\ub825'\uacfc '\uc9c0\uc18d\ub825'\uc5d0 \ub300\ud55c \ubd88\ub9cc\uc774 \ub2e4\uc218 \uc874\uc7ac\ud588\uc2b5\ub2c8\ub2e4. \uc77c\ubd80 \uc0ac\uc6a9\uc790\ub294 '\uac15\ub825\ud55c \uace0\uc815\ub825'\uc744 \uce6d\ucc2c\ud558\uae30\ub3c4 \ud588\uc73c\ub098, \uc774\ub294 \uc808\ub300\uc801\uc778 \uc9c0\uc18d\ub825\ubcf4\ub2e4\ub294 \uc77c\uc2dc\uc801\uc778 \ud6a8\uacfc\uc5d0 \ub300\ud55c \ud3c9\uac00\ub85c \ubcf4\uc785\ub2c8\ub2e4. \ud2b9\ud788 \uc5ec\ub984\ucca0\uc774\ub098 \uc2b5\ud55c \ub0a0\uc528\uc5d0 \uace0\uc815\ub825\uc774 \ud604\uc800\ud788 \ub5a8\uc5b4\uc9c4\ub2e4\ub294 \uc758\uacac\uc740 \uc81c\ud488\uc758 \uc131\ub2a5 \ud3b8\ucc28\uac00 \ud06c\ub2e4\ub294 \uac83\uc744 \uc2dc\uc0ac\ud569\ub2c8\ub2e4. (\uc5b8\uae09 \ube48\ub3c4: \ub192\uc74c, \ube44\uc988\ub2c8\uc2a4 \uc784\ud329\ud2b8: \ub192\uc74c - \ud575\uc2ec \uae30\ub2a5\uc5d0 \ub300\ud55c \uc2e4\ub9dd\uc73c\ub85c \uc778\ud55c \ube0c\ub79c\ub4dc \ubd88\uc2e0 \ucd08\ub798)\n\n*   **\uc2e0\uccb4\uc801/\uc0dd\ub9ac\uc801 \ubc18\uc751 \uc601\uc5ed:** \ud2b9\uc815 \uc0ac\uc6a9\uc790\ub294 \uc81c\ud488 \uc0ac\uc6a9 \ud6c4 '\ud2b8\ub7ec\ube14\uc774 \uc798 \uc0dd\uae34\ub2e4', '\ud53c\ubd80\uac00 \ub4a4\uc9d1\uc5b4\uc84c\ub2e4'\ub294 \uc2ec\uac01\ud55c \ubd80\uc791\uc6a9\uc744 \uacbd\ud5d8\ud588\ub2e4\uace0 \ubcf4\uace0\ud588\uc2b5\ub2c8\ub2e4. \uc774\ub294 \uc81c\ud488\uc5d0 \ud3ec\ud568\ub41c \ud2b9\uc815 \uc131\ubd84\uc774 \ud53c\ubd80\uc5d0 \uc790\uadf9\uc744 \uc720\ubc1c\ud560 \uac00\ub2a5\uc131\uc744 \uc2dc\uc0ac\ud558\uba70, \ud2b9\ud788 \ubbfc\uac10\uc131 \ud53c\ubd80\ub97c \uac00\uc9c4 \uc0ac\uc6a9\uc790\uc5d0\uac8c \uce58\uba85\uc801\uc778 \ubb38\uc81c\ub85c \uc791\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. (\uc5b8\uae09 \ube48\ub3c4: \ub0ae\uc74c, \ube44\uc988\ub2c8\uc2a4 \uc784\ud329\ud2b8: \ub9e4\uc6b0 \ub192\uc74c - \ube0c\ub79c\ub4dc \uc774\ubbf8\uc9c0 \uc2ec\uac01\ud55c \ud6fc\uc190 \ubc0f \ubc95\uc801 \uc774\uc288 \uac00\ub2a5\uc131)\n\n*   **\ud3ec\uc7a5 \ubc0f \uc0ac\uc6a9 \ud3b8\uc758\uc131 \uc601\uc5ed:** \uac00\uc2a4 \ud0c0\uc785 \uc2a4\ud504\ub808\uc774\uc758 \ubd84\uc0ac\ub7c9 \uc870\uc808\uc774 \uc5b4\ub835\ub2e4\ub294 \uc758\uacac\uc774 \uc788\uc5c8\uc9c0\ub9cc, \uc774\ub294 \uc81c\ud615 \ubc0f \uc0ac\uc6a9\uac10 \uc601\uc5ed\uc758 '\uc591 \uc870\uc808\uc758 \uc5b4\ub824\uc6c0'\uacfc \ub9e5\uc744 \uac19\uc774 \ud569\ub2c8\ub2e4. \ubcc4\ub3c4\uc758 \ud3ec\uc7a5 \ubd88\ub7c9\uc5d0 \ub300\ud55c \uc5b8\uae09\uc740 \uc5c6\uc5c8\uc2b5\ub2c8\ub2e4. (\uc5b8\uae09 \ube48\ub3c4: \ub0ae\uc74c, \ube44\uc988\ub2c8\uc2a4 \uc784\ud329\ud2b8: \uc911\uac04 - \uc0ac\uc6a9 \ubd88\ud3b8\ud568 \ucd08\ub798)\n\n*   **\uac00\uce58 \ubc0f \uc804\ubc18\uc801 \uc778\uc2dd \uc601\uc5ed:** '\ud5a5\uc774 \ub108\ubb34 \uc138\ub2e4', '\uc88b\uc740 \ud5a5\ub3c4 \uc544\ub2c8\uace0 \ud638\ubd88\ud638 \uac08\ub9b4\ub9cc\ud558\ub2e4', '\ub0a8\uc790 \ud5a5\uc218 \ub0c4\uc0c8\uac00 \uc9c4\ud558\ub2e4' \ub4f1 \ud5a5\uc5d0 \ub300\ud55c \ubd80\uc815\uc801\uc778 \uc758\uacac\uc774 \uc555\ub3c4\uc801\uc73c\ub85c \ub9ce\uc558\uc2b5\ub2c8\ub2e4. \uc774\ub294 \ub2e8\uc21c\ud55c \uac1c\uc778\uc758 \ucde8\ud5a5 \ubb38\uc81c\ub97c \ub118\uc5b4, \ub9ce\uc740 \uc0ac\uc6a9\uc790\uac00 \uacf5\ud1b5\uc801\uc73c\ub85c \ub290\ub07c\ub294 \ubd88\ud3b8\ud568\uc73c\ub85c \ud30c\uc545\ub429\ub2c8\ub2e4. \ub610\ud55c, \uc77c\ubd80 \uc0ac\uc6a9\uc790\ub294 '\ud0d5\ud6c4\ub8e8 \uac19\ub2e4'\uac70\ub098 '\uba38\ub9bf\uacb0\uc774 \uc548 \uc88b\uc544 \ubcf4\uc778\ub2e4'\ub294 \ub4f1\uc758 \uc804\ubc18\uc801\uc778 \uc678\uad00 \ubc0f \uc778\uc2dd\uc5d0 \ub300\ud55c \ubd80\uc815\uc801\uc778 \ud53c\ub4dc\ubc31\ub3c4 \uc788\uc5c8\uc2b5\ub2c8\ub2e4. (\uc5b8\uae09 \ube48\ub3c4: \ub9e4\uc6b0 \ub192\uc74c, \ube44\uc988\ub2c8\uc2a4 \uc784\ud329\ud2b8: \ub9e4\uc6b0 \ub192\uc74c - \ube0c\ub79c\ub4dc \uc774\ubbf8\uc9c0 \uc800\ud558 \ubc0f \ud0c0\uac9f \uace0\uac1d\uce35 \ucd95\uc18c)\n\n**2. '\ub3c4\uc6c0\ub3fc\uc694' \uc9c0\ud45c\ub97c \ud65c\uc6a9\ud55c \ud575\uc2ec \ubb38\uc81c \uc6b0\uc120\uc21c\uc704\ud654**\n\n'\ub3c4\uc6c0\ub3fc\uc694' \uc9c0\ud45c\uac00 0\uc73c\ub85c \uc124\uc815\ub418\uc5b4 \uc788\uc5b4, \uc5b8\uae09 \ube48\ub3c4\uc640 \ube44\uc988\ub2c8\uc2a4 \uc784\ud329\ud2b8 \uac00\uc124\uc744 \uae30\ubc18\uc73c\ub85c \uc6b0\uc120\uc21c\uc704\ub97c \ub3c4\ucd9c\ud588\uc2b5\ub2c8\ub2e4.\n\n*   **1\uc21c\uc704: \ud5a5\uc5d0 \ub300\ud55c \ubd88\ub9cc (\uac00\uce58 \ubc0f \uc804\ubc18\uc801 \uc778\uc2dd \uc601\uc5ed):** \uac00\uc7a5 \ub192\uc740 \uc5b8\uae09 \ube48\ub3c4\ub97c \ubcf4\uc774\uba70, \ub9ce\uc740 \uc0ac\uc6a9\uc790\uac00 '\ub9e4\uc6b0 \ubcc4\ub85c', '\uadf9\ubd88\ud638' \ub4f1\uc73c\ub85c \ud45c\ud604\ud560 \uc815\ub3c4\ub85c \uac15\ud55c \ubd80\uc815\uc801 \uacbd\ud5d8\uc744 \uacf5\uc720\ud588\uc2b5\ub2c8\ub2e4. \ub610\ud55c, \ud5a5\uc740 \uc81c\ud488\uc758 \uc804\ubc18\uc801\uc778 \uc778\uc0c1\uacfc \uc0ac\uc6a9 \uacbd\ud5d8\uc5d0 \uc9c1\uc811\uc801\uc778 \uc601\ud5a5\uc744 \ubbf8\uce58\ubbc0\ub85c \ube44\uc988\ub2c8\uc2a4 \uc784\ud329\ud2b8\uac00 \ub9e4\uc6b0 \ub192\uc2b5\ub2c8\ub2e4. \uc774 \ubb38\uc81c\ub294 \uae0d\uc815\uc801\uc778 \uc0ac\uc6a9 \uacbd\ud5d8\uc744 \ubc29\ud574\ud558\uace0 \uc7ac\uad6c\ub9e4 \uc758\uc0ac\ub97c \ub0ae\ucd94\ub294 \uac00\uc7a5 \ud070 \uc694\uc778\uc73c\ub85c \ud310\ub2e8\ub429\ub2c8\ub2e4.\n\n*   **2\uc21c\uc704: \ub0ae\uc740 \uc9c0\uc18d\ub825 \ubc0f \uae30\ub300 \ub300\ube44 \ubbf8\ud761\ud55c \uace0\uc815\ub825 (\uc131\ub2a5 \ubc0f \ud6a8\uacfc \uc601\uc5ed):** '\uace0\uc815\ub825'\uc740 \ud5e4\uc5b4 \uc2a4\ud504\ub808\uc774\uc758 \uac00\uc7a5 \uc911\uc694\ud55c \uae30\ub2a5\uc784\uc5d0\ub3c4 \ubd88\uad6c\ud558\uace0, \uc0c1\ub2f9\uc218\uc758 \uc0ac\uc6a9\uc790\uac00 \uae30\ub300\uc5d0 \ubbf8\uce58\uc9c0 \ubabb\ud55c\ub2e4\uace0 \ud3c9\uac00\ud588\uc2b5\ub2c8\ub2e4. \uc774\ub294 \uc81c\ud488\uc758 \ud575\uc2ec \uac00\uce58 \uc81c\uc548\uc5d0 \ub300\ud55c \uc9c1\uc811\uc801\uc778 \ubd88\ub9cc\uc73c\ub85c \uc774\uc5b4\uc9c0\uba70, \uc18c\ube44\uc790\uc758 \uc2e0\ub8b0\ub97c \uc800\ud558\uc2dc\ud0b5\ub2c8\ub2e4. \ub530\ub77c\uc11c \ub192\uc740 \ube44\uc988\ub2c8\uc2a4 \uc784\ud329\ud2b8\ub97c \uac00\uc9c0\ub294 \ubb38\uc81c\ub85c \ubd84\ub958\ub429\ub2c8\ub2e4.\n\n*   **3\uc21c\uc704: \ub5a1\uc9d0 \ubc0f \uc0ac\uc6a9\uac10 \uc800\ud558 (\uc81c\ud615 \ubc0f \uc0ac\uc6a9\uac10 \uc601\uc5ed):** \ub5a1\uc9d0, \ub531\ub531\ud568, \uac00\ub8e8 \ub0a0\ub9bc \ub4f1\uc758 \uc0ac\uc6a9\uac10 \ubb38\uc81c\ub294 \uace0\uc815\ub825 \uc800\ud558\uc640\ub3c4 \uc5f0\uacb0\ub418\uba70, \uc81c\ud488\uc744 \uc0ac\uc6a9\ud558\uace0 \uc2f6\uc9c0 \uc54a\uac8c \ub9cc\ub4dc\ub294 \uc9c1\uc811\uc801\uc778 \uc6d0\uc778\uc774 \ub429\ub2c8\ub2e4. \ud2b9\ud788 \uc0ac\uc6a9\uc790 \uacbd\ud5d8\uc744 \ud06c\uac8c \uc800\ud574\ud558\ubbc0\ub85c \uc2dc\uae09\ud55c \uac1c\uc120\uc774 \ud544\uc694\ud569\ub2c8\ub2e4.\n\n**\ucd94\uac00\uc801\uc73c\ub85c, '\ud53c\ubd80 \ud2b8\ub7ec\ube14 \uc720\ubc1c'\uc740 \uc5b8\uae09 \ube48\ub3c4\ub294 \ub0ae\uc9c0\ub9cc \ube44\uc988\ub2c8\uc2a4 \uc784\ud329\ud2b8\uac00 \ub9e4\uc6b0 \uce58\uba85\uc801\uc778 \uc228\uaca8\uc9c4 \ubb38\uc81c\ub85c \uac04\uc8fc\ub429\ub2c8\ub2e4.** \uc774\ub294 \ube0c\ub79c\ub4dc \uc774\ubbf8\uc9c0\uc5d0 \uce58\uba85\uc801\uc778 \uc190\uc0c1\uc744 \uc785\ud790 \uc218 \uc788\uc73c\uba70, \uc989\uac01\uc801\uc778 \uc6d0\uc778 \uaddc\uba85 \ubc0f \uac1c\uc120 \ub178\ub825\uc774 \ud544\uc694\ud569\ub2c8\ub2e4.\n\n### \uad6c\uccb4\uc801\uc778 \uc131\uc7a5 \uc804\ub7b5 \uc81c\uc5b8 (Actionable Growth Strategies)\n\n**[\uc804\ub7b5 \uc81c\uc548 1] \ud3ec\ubbac\ub7ec \ubc0f \uad6c\uc131 \uc694\uc18c \uac1c\uc120 (Formula & Component Improvement)**\n\n**\uac00\uc7a5 \uc2dc\uae09\ud55c Top 3 \ubb38\uc81c(\ud5a5, \uc9c0\uc18d\ub825/\uace0\uc815\ub825, \uc0ac\uc6a9\uac10)\ub97c \ud574\uacb0\ud558\uae30 \uc704\ud55c R&D \uac1c\uc120\uc548:**\n\n*   **\ud5a5 \ubb38\uc81c \ud574\uacb0:**\n    *   **\ud575\uc2ec \ubb38\uc81c \ud574\uacb0:** \ud604\uc7ac \uc0ac\uc6a9\ub41c \ud5a5\ub8cc\uc758 \uc885\ub958\uc640 \ud568\ub7c9\uc744 \uc804\uba74 \uc7ac\uac80\ud1a0\ud558\uc5ec, \ubd88\ucf8c\uac10\uc744 \uc720\ubc1c\ud558\ub294 \uac83\uc73c\ub85c \ucd94\uc815\ub418\ub294 \ud2b9\uc815 \ud5a5\ub8cc\ub97c \uc800\uc790\uadf9\uc801\uc774\uac70\ub098 \uc740\uc740\ud558\uace0 \uc0b0\ub73b\ud55c \ud5a5\ub8cc\ub85c \ub300\uccb4\ud574\uc57c \ud569\ub2c8\ub2e4. \ud2b9\ud788 '\ub0a8\uc790 \ud5a5\uc218 \ub0c4\uc0c8'\ub77c\ub294 \ud53c\ub4dc\ubc31\uc744 \uace0\ub824\ud558\uc5ec, \uc131\ubcc4\uc5d0 \uad00\uacc4\uc5c6\uc774 \ud638\ubd88\ud638\uac00 \uc801\uc740 \ud50c\ub85c\ub7f4, \uc2dc\ud2b8\ub7ec\uc2a4 \uacc4\uc5f4 \ub610\ub294 \ubb34\ud5a5\uc5d0 \uac00\uae4c\uc6b4 \ud5a5\uc73c\ub85c \ubcc0\uacbd\ud558\ub294 \uac83\uc744 \uc81c\uc548\ud569\ub2c8\ub2e4. \uc774\ub294 \uc0ac\uc6a9\uc790\uc758 \ub450\ud1b5 \uc720\ubc1c \ubc0f \ubd88\ucf8c\uac10\uc744 \uc989\uac01\uc801\uc73c\ub85c \ud574\uc18c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n*   **\uc9c0\uc18d\ub825/\uace0\uc815\ub825 \uac1c\uc120 \ubc0f \uc0ac\uc6a9\uac10 \ucd5c\uc801\ud654:**\n    *   **\ud575\uc2ec \ubb38\uc81c \ud574\uacb0:** \ud604\uc7ac \uc0ac\uc6a9\ub41c \uace0\uc815\ub825 \uad00\ub828 \ud3f4\ub9ac\uba38\uc758 \uc885\ub958 \ubc0f \ud568\ub7c9\uc744 \uc870\uc808\ud558\uc5ec, \ub048\uc801\uc784\uc774\ub098 \ub5a1\uc9d0 \ud604\uc0c1\uc744 \ucd5c\uc18c\ud654\ud558\uba74\uc11c\ub3c4 \uc6d0\ud558\ub294 \uace0\uc815\ub825\uc744 \uc720\uc9c0\ud560 \uc218 \uc788\ub3c4\ub85d \ud3ec\ubbac\ub7ec\ub97c \ucd5c\uc801\ud654\ud574\uc57c \ud569\ub2c8\ub2e4. \ub610\ud55c, '\uac00\ub8e8 \ub0a0\ub9bc' \ud604\uc0c1\uc740 \uace0\uc815 \uc131\ubd84\uc758 \uc785\uc790 \ud06c\uae30\ub098 \ubd84\uc0b0\uc131\uc5d0 \ubb38\uc81c\uac00 \uc788\uc744 \uc218 \uc788\uc73c\ubbc0\ub85c, \uc785\uc790\ub97c \ubbf8\uc138\ud558\uac8c \uc870\uc808\ud558\uac70\ub098 \ubd84\uc0b0\uc81c\ub97c \ucd94\uac00\ud558\ub294 \ubc29\uc548\uc744 \uac80\ud1a0\ud574\uc57c \ud569\ub2c8\ub2e4. **(\ucd94\uc815) \ud3f4\ub9ac\uba38 \uc885\ub958 \ubc0f \ud568\ub7c9 \uc870\uc808, \uc785\uc790 \ud06c\uae30 \ubbf8\uc138\ud654 \ubc0f \ubd84\uc0b0\uc81c \ucd94\uac00 \uac80\ud1a0**\n    *   **\uc0ac\uc6a9\uc790 \uadf8\ub8f9\ubcc4 \ucd5c\uc801\ud654:** \uc587\uc740 \ubaa8\ubc1c \uc0ac\uc6a9\uc790\ub97c \uc704\ud574 \ubcf4\ub2e4 \uac00\ubcbc\uc6b4 \ubc00\ucc29\uac10\uc744 \uc81c\uacf5\ud558\ub294 \uc81c\ud615\uc73c\ub85c \uac1c\uc120\ud560 \ud544\uc694\uac00 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub294 \uae30\uc874 \uc0ac\uc6a9\uc790\ub4e4\uc774 \uacbd\ud5d8\ud588\ub358 '\ub5a1\uc9d0' \ud604\uc0c1\uc744 \uc644\ud654\ud558\uace0, \uac00\ubccd\uace0 \uc790\uc5f0\uc2a4\ub7ec\uc6b4 \uc2a4\ud0c0\uc77c\ub9c1\uc744 \uac00\ub2a5\ud558\uac8c \ud560 \uac83\uc785\ub2c8\ub2e4. \ubb49\uce68 \ubc29\uc9c0\ub97c \uc704\ud574 \ubd84\uc0ac \uc785\uc790\ub97c \ub354\uc6b1 \ubbf8\uc138\ud558\uac8c \uc870\uc808\ud558\ub294 \uae30\uc220\uc744 \ub3c4\uc785\ud558\ub294 \uac83\ub3c4 \uace0\ub824\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n    *   **\ubd88\ud544\uc694 \uc694\uc18c \uc81c\uac70:** \ub9cc\uc57d \ud5a5\uc774 \uc81c\uac70\ub41c\ub2e4\uba74 \uace0\uac1d \ub9cc\uc871\ub3c4\uac00 \ud06c\uac8c \ud5a5\uc0c1\ub420 \uac83\uc774\ubbc0\ub85c, \uac15\ud55c \ud5a5\uc740 \uacfc\uac10\ud788 \uc81c\uac70\ud558\uac70\ub098 \ub9e4\uc6b0 \uc740\uc740\ud558\uac8c \uc870\uc815\ud558\ub294 \uac83\uc774 \ubc14\ub78c\uc9c1\ud569\ub2c8\ub2e4.\n\n**[\uc804\ub7b5 \uc81c\uc548 2] \uc81c\ud488 \ud3ec\ud2b8\ud3f4\ub9ac\uc624 \ubc0f \uacbd\uc7c1 \uc804\ub7b5 (Product Portfolio & Competitive Strategy)**\n\n**\uc2dc\uc7a5 \uae30\ud68c \uc815\uc758:**\n\ubcf8 \uc81c\ud488\uc740 '\uac15\ub825\ud55c \uace0\uc815\ub825'\uc744 \uc6d0\ud558\ub294 \uc0ac\uc6a9\uc790\uc5d0\uac8c \uc5b4\ud544\ud558\ub824 \ud588\uc73c\ub098, \uc2e4\uc81c\ub85c\ub294 \ud5a5, \uc0ac\uc6a9\uac10, \uc9c0\uc18d\ub825 \ub4f1 \uc804\ubc18\uc801\uc778 \uc0ac\uc6a9 \uacbd\ud5d8\uc5d0\uc11c \ud070 \uc2e4\ub9dd\uac10\uc744 \uc548\uaca8\uc8fc\uc5c8\uc2b5\ub2c8\ub2e4. \uc774\ub294 '\uac15\ub825\ud55c \uace0\uc815\ub825'\uc774\ub77c\ub294 \uae30\ub2a5 \uc790\uccb4\uc5d0 \ub300\ud55c \uc218\uc694\uac00 \uc5c6\ub2e4\ub294 \uc758\ubbf8\uac00 \uc544\ub2c8\ub77c, \ud604\uc7ac \uc81c\ud488\uc774 \uadf8 \uc694\uad6c\ub97c \ucda9\uc871\uc2dc\ud0a4\uc9c0 \ubabb\ud558\uace0 \uc788\ub2e4\ub294 \ubc29\uc99d\uc785\ub2c8\ub2e4.\n\n\ud2b9\ud788, '\uc55e\uba38\ub9ac \uace0\uc815'\uc5d0 \uc5b4\ub824\uc6c0\uc744 \uacaa\ub294 \uc18c\ube44\uc790, \ud639\uc740 '\ud558\ub8e8 \uc885\uc77c \uc2a4\ud0c0\uc77c\uc744 \uc720\uc9c0\ud574\uc57c \ud558\ub294' \uc804\ubb38\uac00 \uc9c1\uc5c5\uad70 \ub4f1 \ud2b9\uc815 \ub2c8\uc988\ub97c \uac00\uc9c4 \uc18c\ube44\uc790\uce35\uc774 \uc874\uc7ac\ud558\uba70, \ud604\uc7ac \uc81c\ud488\uc740 \uc774\ub4e4\uc758 \uae30\ub300\ub97c \ucda9\uc871\uc2dc\ud0a4\uc9c0 \ubabb\ud558\uace0 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ud55c, '\ub5a1\uc9d0'\uc774\ub098 '\ubee3\ubee3\ud568' \uc5c6\uc774 \uc790\uc5f0\uc2a4\ub7ec\uc6b4 \uace0\uc815\ub825\uc744 \uc6d0\ud558\ub294 \uc18c\ube44\uc790\uc640, \ubc18\ub300\ub85c \uc5b4\ub5a4 \uc2a4\ud0c0\uc77c\uc774\ub4e0 '\ubb34\ub108\uc9c0\uc9c0 \uc54a\uac8c' \uace0\uc815\ud558\uace0 \uc2f6\uc740 \uc18c\ube44\uc790\ub97c \uad6c\ubd84\ud558\uc5ec \uc811\uadfc\ud560 \ud544\uc694\uac00 \uc788\uc2b5\ub2c8\ub2e4. \ud604\uc7ac \ub9ac\ubdf0\ub294 \ud6c4\uc790\uc758 \ub2c8\uc988\ub97c \uac00\uc9c4 \uc18c\ube44\uc790\uac00 \uc774 \uc81c\ud488\uc5d0 \ub300\ud55c \uc2e4\ub9dd\uac10\uc744 \ud45c\ud604\ud558\uace0 \uc788\ub294 \uac83\uc73c\ub85c \ubcf4\uc785\ub2c8\ub2e4. \uc774\ub294 \uc6b0\ub9ac\uac00 \uae30\uc874\uc758 '\ubaa8\ub4e0 \uc774\ub97c \uc704\ud55c \uac15\ub825\ud55c \uace0\uc815\ub825'\uc774\ub77c\ub294 \ubaa8\ud638\ud55c \ud3ec\uc9c0\uc154\ub2dd\uc5d0\uc11c \ubc97\uc5b4\ub098, \ud2b9\uc815 \ub2c8\uc988\ub97c \uba85\ud655\ud788 \ud0c0\uac9f\ud305\ud560 \uc218 \uc788\ub294 \uc0c8\ub85c\uc6b4 \uae30\ud68c\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4.\n\n**\ub450 \uac00\uc9c0 \uc804\ub7b5 \uc635\uc158 \uc81c\uc2dc:**\n\n*   **\uc635\uc158 A: \uac1c\uc120 \ubc0f \ub9ac\ud3ec\uc9c0\uc154\ub2dd \uc804\ub7b5 (\ud575\uc2ec \uace0\uc815\ub825 \uac15\ud654, \uc0ac\uc6a9\uc790 \uacbd\ud5d8 \uac1c\uc120)**\n    *   **\uac1c\uc120:** \uc704\uc5d0\uc11c \uc81c\uc548\ud55c R&D \uc804\ub7b5\uc744 \ud1b5\ud574 \ud5a5\uc744 \uac1c\uc120\ud558\uace0, \ub5a1\uc9d0 \ud604\uc0c1 \ubc0f \uac00\ub8e8 \ub0a0\ub9bc\uc744 \uc5c6\uc560\uba70, \uc9c0\uc18d\ub825\uc744 \uac15\ud654\ud55c '\uc2dc\uc98c 2' \uc81c\ud488\uc744 \uac1c\ubc1c\ud569\ub2c8\ub2e4.\n    *   **\ub9ac\ud3ec\uc9c0\uc154\ub2dd:** \uc81c\ud488\uc758 \ud575\uc2ec \uac15\uc810\uc778 '\uac15\ub825\ud55c \uace0\uc815\ub825'\uc744 \uc720\uc9c0\ud558\ub418, '\ud558\ub8e8 \uc885\uc77c \uc644\ubcbd\ud558\uac8c \uc2a4\ud0c0\uc77c\uc744 \uace0\uc815\ud574\uc57c \ud558\ub294' \ud2b9\uc815 \ub2c8\uc988\ub97c \uac00\uc9c4 \uc0ac\uc6a9\uc790(\uc608: \uc2b5\ud55c \ub0a0\uc528\uc5d0\ub3c4 \uc2a4\ud0c0\uc77c \uc720\uc9c0\uac00 \uc911\uc694\ud55c \uc0ac\ub78c, \ubb34\ub300\ub098 \uacf5\uc5f0 \ub4f1 \uc7a5\uc2dc\uac04 \uc2a4\ud0c0\uc77c \uc720\uc9c0\uac00 \ud544\uc694\ud55c \uc0ac\ub78c, \ud2b9\uc815 \ud5e4\uc5b4\uc2a4\ud0c0\uc77c\uc744 \uc624\ub7ab\ub3d9\uc548 \uc720\uc9c0\ud558\uace0 \uc2f6\uc740 \uc0ac\ub78c)\ub97c \uba85\ud655\ud55c \ud0c0\uac9f\uc73c\ub85c \uc124\uc815\ud569\ub2c8\ub2e4. \uad11\uace0 \ubc0f \ub9c8\ucf00\ud305 \uba54\uc2dc\uc9c0 \uc5ed\uc2dc '\uac15\ub825\ud55c \uc9c0\uc18d\ub825'\uacfc \ud568\uaed8 '\ubcf4\uc1a1\ud558\uace0 \uae54\ub054\ud55c \ub9c8\ubb34\ub9ac\uac10'\uc744 \uac15\uc870\ud558\uc5ec \uc774\uc804\uc758 \ubd80\uc815\uc801 \uacbd\ud5d8\uc744 \uc0c1\uc1c4\ud558\ub3c4\ub85d \ud569\ub2c8\ub2e4.\n\n*   **\uc635\uc158 B: \uc2e0\uaddc \ub77c\uc778 \ud655\uc7a5 \uc804\ub7b5 (\uc138\ubd84\ud654\ub41c \ub2c8\uc988 \uacf5\ub7b5)**\n    *   **\uc2e0\uaddc \ub77c\uc778 \ucd9c\uc2dc:** \uae30\uc874 \uc81c\ud488\uc758 '\uac15\ub825\ud55c \uace0\uc815\ub825'\uc774\ub77c\ub294 \uac15\uc810\uc740 \uc720\uc9c0\ud558\ub418, \ud5a5, \uc0ac\uc6a9\uac10 \ub4f1 \ubd80\uc815\uc801\uc778 \uc694\uc18c\ub97c \uac1c\uc120\ud55c \uc0c8\ub85c\uc6b4 \ub77c\uc778\uc5c5\uc744 \ucd9c\uc2dc\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ud504\ub85c\ud398\uc154\ub110 \uace0\uc815 \ub77c\uc778' (\uac15\ub825\ud55c \ud640\ub529\ub825), '\ub370\uc77c\ub9ac \uc790\uc5f0\uc2a4\ub7ec\uc6c0 \ub77c\uc778' (\uac00\ubcbc\uc6b4 \uc0ac\uc6a9\uac10, \uc740\uc740\ud55c \ud5a5), '\ubcfc\ub968&\ud14d\uc2a4\ucc98 \ub77c\uc778' (\ubaa8\ubc1c \ubcfc\ub968 \ubd80\uc5ec \ubc0f \uc9c8\uac10 \ud45c\ud604) \ub4f1 \ud0c0\uac9f \uace0\uac1d\uc758 \ub2c8\uc988\ub97c \uc138\ubd84\ud654\ud55c \ub2e4\uc591\ud55c \uc81c\ud488 \ub77c\uc778\uc744 \uad6c\ucd95\ud569\ub2c8\ub2e4.\n    *   **\uae30\uc874 \uc81c\ud488 \ud65c\uc6a9 \ubc29\uc548:** \ud604\uc7ac \uc81c\ud488\uc758 '\uac15\ub825\ud55c \uace0\uc815\ub825'\uc774\ub77c\ub294 \ud2b9\uc131\uc744 \uc0b4\ub824, \ud2c8\uc0c8 \uc2dc\uc7a5\uc744 \uacf5\ub7b5\ud558\uac70\ub098 \ud639\uc740 \ud2b9\uc815 \uc0ac\uc6a9\uc790 \uadf8\ub8f9(\uc608: \ubaa8\ubc1c\uc774 \ub9e4\uc6b0 \uad75\uace0 \uc231\uc774 \ub9ce\uc740 \uc0ac\ub78c)\uc5d0\uac8c\ub294 \uc5ec\uc804\ud788 \uc720\uc6a9\ud560 \uc218 \uc788\uc74c\uc744 \uac15\uc870\ud558\ub294 \ubc29\uc2dd\uc73c\ub85c \ub9c8\ucf00\ud305 \ucc44\ub110\uc744 \uc81c\ud55c\uc801\uc73c\ub85c \uc6b4\uc601\ud560 \uc218\ub3c4 \uc788\uc2b5\ub2c8\ub2e4. \uadf8\ub7ec\ub098 \uc804\ubc18\uc801\uc778 \ube0c\ub79c\ub4dc \uc774\ubbf8\uc9c0 \ud68c\ubcf5\uc744 \uc704\ud574\uc11c\ub294 \ub9ac\ub274\uc5bc \ub610\ub294 \uc2e0\uaddc \ub77c\uc778 \ucd9c\uc2dc\uac00 \ub354 \ud6a8\uacfc\uc801\uc77c \uac83\uc785\ub2c8\ub2e4.\n\n**[\uc804\ub7b5 \uc81c\uc548 3] \ub9c8\ucf00\ud305 \ubc0f \ucee4\ubba4\ub2c8\ucf00\uc774\uc158 \ucd5c\uc801\ud654 (Marketing & Communication Optimization)**\n\n**\uace0\uac1d\uc758 \uae30\ub300\ub97c \uad00\ub9ac\ud558\uace0 \uc2e0\ub8b0\ub97c \ud68c\ubcf5\ud558\uae30 \uc704\ud55c \ucee4\ubba4\ub2c8\ucf00\uc774\uc158 \uc804\ub7b5:**\n\n*   **\uac00\uce58 \uc81c\uc548(Promise) \uc7ac\uc815\uc758:**\n    *   '\uac15\ub825\ud55c \uace0\uc815\ub825'\uc774\ub77c\ub294 \ud575\uc2ec \uac00\uce58\ub294 \uc720\uc9c0\ud558\ub418, '\uc5b4\ub5a4 \ubaa8\ubc1c \ud0c0\uc785, \uc5b4\ub5a4 \uc2a4\ud0c0\uc77c\uc744 \uac00\uc9c4 \uc0ac\ub78c\uc774, \uc5b4\ub5a4 \ud658\uacbd\uc5d0\uc11c \uc0ac\uc6a9\ud588\uc744 \ub54c, \uc5bc\ub9cc\ud07c\uc758 \uc2dc\uac04 \ub3d9\uc548, \uc5b4\ub5a4 \uacb0\uacfc(\uc608: \ud750\ud2b8\ub7ec\uc9d0 \uc5c6\ub294 \uc644\ubcbd\ud55c \uace0\uc815\ub825, \ub5a1\uc9d0 \uc5c6\ub294 \ubcf4\uc1a1\ud55c \ub9c8\ubb34\ub9ac\uac10 \ub4f1)'\ub97c \uc5bb\uc744 \uc218 \uc788\ub294\uc9c0 \uad6c\uccb4\uc801\uc774\uace0 \uba85\ud655\ud558\uac8c \uc804\ub2ec\ud574\uc57c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \"\ub540\uacfc \uc2b5\ub3c4\uc5d0\ub3c4 \ubb34\ub108\uc9c0\uc9c0 \uc54a\ub294 24\uc2dc\uac04 \uac15\ub825 \uace0\uc815\ub825\", \"\uc587\uc740 \ubaa8\ubc1c\ub3c4 \ub5a1\uc9d0 \uc5c6\uc774 \uac00\ubccd\uac8c \uace0\uc815\"\uacfc \uac19\uc774 \ud0c0\uac9f \uc0ac\uc6a9\uc790\uc758 \uc0c1\ud669\uacfc \uae30\ub300 \uacb0\uacfc\uac00 \uba85\ud655\ud788 \uc5f0\uacb0\ub418\ub3c4\ub85d \uba54\uc2dc\uc9c0\ub97c \ub2e4\ub4ec\uc5b4\uc57c \ud569\ub2c8\ub2e4.\n*   **\uae30\ub300\uce58 \uad00\ub9ac \uac00\uc774\ub4dc(Proactive Guide):**\n    *   \ubc18\ubcf5\ub418\ub294 '\ub5a1\uc9d0', '\uc591 \uc870\uc808 \uc2e4\ud328' \ub4f1\uc758 \ubd88\ub9cc\uc744 \uc608\ubc29\ud558\uae30 \uc704\ud574 \uc81c\ud488 \uc0c1\uc138 \ud398\uc774\uc9c0, \ud64d\ubcf4 \uc601\uc0c1, SNS \ucf58\ud150\uce20 \ub4f1 \ub2e4\uc591\ud55c \ucc44\ub110\uc5d0 '\uc62c\ubc14\ub978 \uc0ac\uc6a9\ubc95' \ub610\ub294 '\ucd5c\uc801\uc758 \uc0ac\uc6a9 \ud301'\uc744 \uc0c1\uc138\ud558\uace0 \uba85\ud655\ud558\uac8c \uc548\ub0b4\ud574\uc57c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ub450\ud53c\uc5d0\uc11c 20-30cm \uc774\uc0c1 \uac70\ub9ac\ub97c \ub450\uace0 \ubd84\uc0ac\ud558\uc138\uc694', '\ud55c \uacf3\uc5d0 \ub108\ubb34 \ub9ce\uc774 \ubfcc\ub9ac\uc9c0 \ub9d0\uace0 \uc5ec\ub7ec \ubc88 \ub098\ub204\uc5b4 \uac00\ubccd\uac8c \ubd84\uc0ac\ud558\uc138\uc694', '\uace0\uc815 \ud6c4\uc5d0\ub294 \uc190\uc73c\ub85c \uac00\ubccd\uac8c \ub9cc\uc838\uc11c \ubb49\uce5c \ubd80\ubd84\uc744 \ud480\uc5b4\uc8fc\uc138\uc694'\uc640 \uac19\uc740 \uad6c\uccb4\uc801\uc778 \uac00\uc774\ub4dc\ub77c\uc778\uc744 \uc81c\uacf5\ud574\uc57c \ud569\ub2c8\ub2e4.\n*   **\uad11\uace0 \uba54\uc2dc\uc9c0 \ud604\uc2e4\ud654:**\n    *   '\uae30\uc801 \uac19\uc740 \ud6a8\uacfc', '\uc644\ubcbd\ud55c \uc2a4\ud0c0\uc77c\ub9c1 \ub9c8\ubc95'\uacfc \uac19\uc740 \uacfc\uc7a5\ub41c \ud45c\ud604\uc740 \uc9c0\uc591\ud574\uc57c \ud569\ub2c8\ub2e4. \ub300\uc2e0, \uc81c\ud488\uc758 \uc2e4\uc81c \uace0\uc815\ub825\uacfc \uc0ac\uc6a9\uac10\uc744 \uc194\uc9c1\ud558\uac8c \ubcf4\uc5ec\uc8fc\ub294 \ucf58\ud150\uce20\ub97c \uc81c\uc791\ud574\uc57c \ud569\ub2c8\ub2e4. \ud2b9\ud788, \ub2e4\uc591\ud55c \ubaa8\ubc1c \ud0c0\uc785(\uac00\ub294 \ubaa8\ubc1c, \uacf1\uc2ac \ubaa8\ubc1c \ub4f1)\uacfc \uc2a4\ud0c0\uc77c\ub9c1(\uc55e\uba38\ub9ac \uace0\uc815, \uc804\uccb4\uc801\uc778 \ubcfc\ub968 \uc720\uc9c0 \ub4f1)\uc5d0 \ub300\ud55c **\ud604\uc2e4\uc801\uc778 \uc804\ud6c4 \ube44\uad50** \uc601\uc0c1\uc744 \uc81c\uacf5\ud568\uc73c\ub85c\uc368 \uc18c\ube44\uc790\uac00 \uc81c\ud488\uc758 \uc131\ub2a5\uc744 \uac1d\uad00\uc801\uc73c\ub85c \ud310\ub2e8\ud558\uace0 \uc2e0\ub8b0\ub97c \ud615\uc131\ud560 \uc218 \uc788\ub3c4\ub85d \uc9c0\uc6d0\ud574\uc57c \ud569\ub2c8\ub2e4. \ub610\ud55c, \ud5a5\uc5d0 \ub300\ud55c \ubd80\uc815\uc801\uc778 \ud53c\ub4dc\ubc31\uc744 \uace0\ub824\ud558\uc5ec '\uc740\uc740\ud558\uace0 \uc0b0\ub73b\ud55c \ud5a5' \ub610\ub294 '\uc800\uc790\uadf9 \ubb34\ud5a5'\uacfc \uac19\uc740 \uc2e4\uc81c \uac1c\uc120 \uc0ac\ud56d\uc744 \uba85\ud655\ud788 \ucee4\ubba4\ub2c8\ucf00\uc774\uc158\ud558\ub294 \uac83\ub3c4 \uc911\uc694\ud569\ub2c8\ub2e4.\n\n\uc774\ub7ec\ud55c \uc804\ub7b5\ub4e4\uc744 \ud1b5\ud574 \uc6b0\ub9ac\ub294 \uc81c\ud488\uc758 \uc57d\uc810\uc744 \ubcf4\uc644\ud558\uace0, \uace0\uac1d\uc758 \uae30\ub300\ub97c \ud6a8\uacfc\uc801\uc73c\ub85c \uad00\ub9ac\ud558\uba70, \uad81\uadf9\uc801\uc73c\ub85c\ub294 \ube0c\ub79c\ub4dc\uc5d0 \ub300\ud55c \uc2e0\ub8b0\ub97c \ud68c\ubcf5\ud558\uace0 \uc2dc\uc7a5\uc5d0\uc11c\uc758 \uacbd\uc7c1\ub825\uc744 \uac15\ud654\ud560 \uc218 \uc788\uc744 \uac83\uc785\ub2c8\ub2e4.", "ingredients": "\"\uc5d0\ud0c4\uc62c, \uc5d0\uc774\uc5e0\ud53c-\uc544\ud06c\ub9b4\ub808\uc774\ud2b8\ucf54\ud3f4\ub9ac\uba38, \uc815\uc81c\uc218, \uadc0\ub9ac\ucee4\ub12c\ucd94\ucd9c\ubb3c, \ubcf4\ub9ac\ucd94\ucd9c\ubb3c, \uc694\uc5fd\ud6c4\ubc15\ub098\ubb34\uaecd\uc9c8\ucd94\ucd9c\ubb3c, \uc0ac\ud0d5\uc218\uc218\ucd94\ucd9c\ubb3c, \ubc00\ucd94\ucd9c\ubb3c, 1-\uba54\ud2f8\ud558\uc774\ub2e8\ud1a0\uc778-2-\uc774\ubbf8\ub4dc, \uc54c\ub77c\ub2cc, \uc554\ubaa8\ub2c8\uc544, \uc54c\uc9c0\ub2cc, \uc544\uc2a4\ud30c\ub77c\uc9c4, \uc544\uc2a4\ud30c\ud2f1\uc560\uc528\ub4dc, \uadc0\ub9ac\ucee4\ub12c\ub2e8\ubc31\uc9c8, \ubd80\ud2f8\ub80c\uae00\ub77c\uc774\ucf5c, \uce7c\uc298\ud074\ub85c\ub77c\uc774\ub4dc, \uc2dc\ud2b8\ub8f0\ub9b0, \uce74\ud37c\ud2b8\ub77c\uc774\ud3a9\ud0c0\uc774\ub4dc-1, \uc2dc\uc2a4\ud14c\uc778, \ub2e4\uc774\ud3ec\ud0c0\uc298\ud3ec\uc2a4\ud398\uc774\ud2b8, \ub2e4\uc774\uc2e4\ub85d\uc138\uc778, \uc824\ub77c\ud2f4, \uae00\ub8e8\ucf54\uc0ac\ubbfc\uc5d0\uc774\uce58\uc528\uc5d8, \uae00\ub8e8\ud0c0\ubbf9\uc560\uc528\ub4dc, \uae00\ub8e8\ud0c0\ubbfc, \uae00\ub77c\uc774\uc2e0, \ud788\uc2a4\ud2f0\ub518, \ud558\uc774\ub4dc\ub864\ub77c\uc774\uc988\ub4dc\ubcf4\ub9ac\ub2e8\ubc31\uc9c8, \ud558\uc774\ub4dc\ub864\ub77c\uc774\uc988\ub4dc\ucf5c\ub77c\uac90, \ud558\uc774\ub4dc\ub864\ub77c\uc774\uc988\ub4dc\uc625\uc218\uc218\ub2e8\ubc31\uc9c8, \ud558\uc774\ub4dc\ub864\ub77c\uc774\uc988\ub4dc\ucf00\ub77c\ud2f4, \ud558\uc774\ub4dc\ub864\ub77c\uc774\uc988\ub4dc\uadc0\ub9ac\ub2e8\ubc31\uc9c8, \ud558\uc774\ub4dc\ub864\ub77c\uc774\uc988\ub4dc\uc644\ub450\ucf69\ub2e8\ubc31\uc9c8, \ud558\uc774\ub4dc\ub864\ub77c\uc774\uc988\ub4dc\uac10\uc790\ub2e8\ubc31\uc9c8, \ud558\uc774\ub4dc\ub864\ub77c\uc774\uc988\ub4dc\uc300\uaca8\ub2e8\ubc31\uc9c8, \ud558\uc774\ub4dc\ub8